# DESC: Show available DBA functions or detailed help for a specific function
function dbahelp() {
    local full_mode=0 target_fn="" source_file
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc
    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --full)
                full_mode=1
                ;;
            -h|--help)
                cat <<'EOF'
Usage:
  dbahelp [--full] [--csv|--json|--raw] [--no-header] [--grep PATTERN] [--grep-v PATTERN]
  dbahelp <function_name>

Behavior:
  dbahelp
      Show functions that have a '# DESC:' line directly above them.
  dbahelp --full
      Show ALL functions in the file (except _internal helpers).
      Functions without '# DESC:' have an empty DESCRIPTION.
  dbahelp <function_name>
      Run: <function_name> --help

Notes:
  - To include a function in the default output, add
        # DESC: description text
    immediately above the function definition.
  - Function definitions are only recognized at column 0, with or
    without the 'function' keyword and with or without '()'.
EOF
                return 0
                ;;
            --*)
                _dba_err "Unknown option: $1"
                return 1
                ;;
            *)
                if [[ -n "$target_fn" ]]; then
                    echo "Usage: dbahelp [--full] [function_name]" >&2
                    return 1
                fi
                target_fn="$1"
                ;;
        esac
        shift
    done
    _dba_check_modes || return 1

    if [[ -n "$target_fn" ]]; then
        if ! declare -F "$target_fn" >/dev/null 2>&1; then
            _dba_err "Function not found: $target_fn"
            return 1
        fi
        "$target_fn" --help
        return $?
    fi

    source_file="${DBA_FUNCTIONS_FILE:-$_DBA_FUNCTIONS_FILE}"
    if [[ ! -r "$source_file" ]]; then
        _dba_err "Cannot read DBA function file: $source_file"
        return 1
    fi

    local -a with_desc=() without_desc=()
    local fn desc row data
    while IFS='|' read -r fn desc; do
        [[ -z "$fn" || "$fn" == _* ]] && continue
        if [[ -n "$desc" ]]; then
            with_desc+=("$fn|$desc")
        elif (( full_mode )); then
            without_desc+=("$fn|")
        fi
    done < <(
        awk '
            /^#[[:space:]]*DESC:/ {
                d = $0
                sub(/^#[[:space:]]*DESC:[[:space:]]*/, "", d)
                gsub(/\|/, "/", d)
                desc = d
                next
            }
            /^function[[:space:]]+[A-Za-z_][A-Za-z0-9_]*/ {
                name = $2
                sub(/\(.*$/, "", name)
                sub(/\{.*$/, "", name)
                print name "|" desc
                desc = ""
                next
            }
            /^[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\(\)/ {
                name = $0
                sub(/[[:space:]]*\(\).*$/, "", name)
                print name "|" desc
                desc = ""
                next
            }
            /^[[:space:]]*$/ { next }
            /^#/ { next }
            { desc = "" }
        ' "$source_file"
    )

    data="COMMAND|DESCRIPTION"
    if (( ${#with_desc[@]} )); then
        while IFS= read -r row; do data+=$'\n'"$row"; done < <(printf '%s\n' "${with_desc[@]}" | sort -u)
    fi
    if (( ${#without_desc[@]} )); then
        while IFS= read -r row; do data+=$'\n'"$row"; done < <(printf '%s\n' "${without_desc[@]}" | sort -u)
    fi
    _dba_emit "$data"
}

# DESC: Copy stdin into the Windows clipboard (modified PuTTY or KiTTY with printer passthrough)
