#####          Shared helpers added in v3.5 (_dba_*)            ######
#####   OS / release awareness: RHEL/OL 8-10, 19c and 26ai       ######
######################################################################

# Certification rules (from the Oracle installation guides and release notes, Nov 2026).
# Kept here so they are easy to update when Oracle changes them.
#   _DBA_CERT_KERNEL_<rel>_el<N>   minimum Red Hat compatible kernel (RHCK), without the .elN suffix
#   _DBA_CERT_RU_19_el<N>          minimum 19c Release Update on that OS
#   _DBA_CERT_OS_23_el<N>          minimum OS minor release for 26ai
#   _DBA_CERT_ONEOFF_*             one-off patches Oracle requires on top of a specific RU
_DBA_CERT_KERNEL_19_el8="4.18.0-80"
_DBA_CERT_KERNEL_19_el9="5.14.0-70.22.1"
_DBA_CERT_KERNEL_19_el10="6.12.0-55.40.1"
_DBA_CERT_KERNEL_23_el8="4.18.0-372.26.1"
_DBA_CERT_KERNEL_23_el9="5.14.0-284.30.1"
_DBA_CERT_KERNEL_23_el10="6.12.0-55.40.1"
_DBA_CERT_RU_19_el9="19.19"
_DBA_CERT_RU_19_el10="19.32"
_DBA_CERT_RU_23_el10="23.26.2"
_DBA_CERT_OS_23_el8="8.6"
# New installations: RU Oracle's release notes tell you to apply during installation (pre-install check only;
# existing homes are not failed against this value). 19c on RHEL/OL 8: install 19.3 with -applyRU 19.18.
_DBA_CERT_INSTALL_RU_19_el8="19.18"
_DBA_CERT_OS_23_el9="9.2"
# 19c 19.32 on RHEL/OL 10: one-offs listed in the 19c release notes (DB home / Grid home)
_DBA_CERT_ONEOFF_19_32_el10_DB="39894800,38622857,39153061,39388682,39928540"
_DBA_CERT_ONEOFF_19_32_el10_GRID="39894800,39153061,39388682,39928540"
# 26ai on RHEL/OL 10: patch required on top of 23.26.2 (26ai release notes)
_DBA_CERT_ONEOFF_23_el10="39268330"

# _dba_os_info : "ID|MAJOR|MINOR|KERNEL|UEK(0/1)" (ID from /etc/os-release: rhel, ol, centos, rocky, almalinux, sles ...)
_dba_os_info() {
    local id="" ver="" k uek=0 f="${DBA_OS_RELEASE_FILE:-/etc/os-release}"
    if [[ -r "$f" ]]; then
        id="$(sed -n 's/^ID=//p' "$f" | tr -d '"')"
        ver="$(sed -n 's/^VERSION_ID=//p' "$f" | tr -d '"')"
    fi
    k="${DBA_KERNEL:-$(uname -r)}"
    [[ "$k" == *uek* ]] && uek=1
    printf '%s|%s|%s|%s|%s\n' "${id:-unknown}" "${ver%%.*}" "$( [[ "$ver" == *.* ]] && echo "${ver#*.}" | cut -d. -f1 || echo 0)" "$k" "$uek"
}

# _dba_ver_ge <a> <b> : true when version a >= b (sort -V, works for 19.32.0.0.0 and kernel strings)
_dba_ver_ge() {
    [[ "$1" == "$2" ]] && return 0
    [[ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -1)" == "$2" ]]
}

# _dba_home_release <ORACLE_HOME> : full release of a home, e.g. 19.32.0.0.0 or 23.26.2.0.0
_dba_home_release() {
    local h="$1" v=""
    [[ -x "$h/bin/oraversion" ]] && v="$(_dba_env_run "" "$h" "$h/bin/oraversion" -compositeVersion 2>/dev/null | tail -1)"
    if [[ ! "$v" =~ ^[0-9]+\.[0-9]+ ]]; then
        v="$(_dba_xml_attr "$(grep -m1 'PATCH NAME="oracle.server"\|PATCH NAME="oracle.crs"' "$h/inventory/ContentsXML/comps.xml" 2>/dev/null)" VER)"
    fi
    if [[ ! "$v" =~ ^[0-9]+\.[0-9]+ ]]; then
        v="$(_dba_xml_attr "$(grep -m1 'COMP NAME' "$h/inventory/ContentsXML/comps.xml" 2>/dev/null)" VER)"
    fi
    printf '%s\n' "$v"
}

# _dba_release_name <version> : 19c / 26ai / <major>
_dba_release_name() {
    case "${1%%.*}" in
        19) echo 19c ;;
        23) echo 26ai ;;
        *)  echo "${1%%.*}" ;;
    esac
}

# _dba_cert_eval <version> <home|""> <DB|GRID> : "STATUS|DETAIL" for this OS
#   home empty = evaluate the release only (no patch inventory check)
_dba_cert_eval() {
    local ver="$1" home="$2" kind="${3:-DB}" osid maj min kern uek rel
    IFS='|' read -r osid maj min kern uek <<< "$(_dba_os_info)"
    rel="${ver%%.*}"
    case "$osid" in
        rhel|ol|centos|rocky|almalinux) ;;
        *) printf 'WARN|OS %s %s.%s - no certification rule in this script, check MOS certification\n' "$osid" "$maj" "$min"; return ;;
    esac
    local name; name="$(_dba_release_name "$ver")"
    if [[ "$rel" != 19 && "$rel" != 23 ]]; then
        printf 'WARN|release %s - no certification rule in this script\n' "${ver:-unknown}"; return
    fi
    if [[ "$maj" == 7 ]]; then
        if [[ "$rel" == 19 ]]; then printf 'WARN|19c on RHEL/OL 7 is supported, but Oracle recommends RHEL/OL 8 or later\n'
        else printf 'FAIL|26ai is not certified on RHEL/OL 7\n'; fi
        return
    fi
    if [[ "$maj" != 8 && "$maj" != 9 && "$maj" != 10 ]]; then
        printf 'WARN|RHEL/OL %s - no certification rule in this script\n' "$maj"; return
    fi
    local problems="" notes=""
    # OS minor (26ai)
    local osmin_var="_DBA_CERT_OS_${rel}_el${maj}"
    if [[ -n "${!osmin_var:-}" ]] && ! _dba_ver_ge "$maj.$min" "${!osmin_var}"; then
        problems+="; OS $maj.$min < ${!osmin_var}"
    fi
    # Release Update
    local ru_var="_DBA_CERT_RU_${rel}_el${maj}"
    if [[ -n "${!ru_var:-}" ]] && [[ -n "$ver" ]] && ! _dba_ver_ge "$ver" "${!ru_var}"; then
        problems+="; $name RU $ver < ${!ru_var} required on RHEL/OL $maj"
    fi
    # Kernel (RHCK only)
    local k_var="_DBA_CERT_KERNEL_${rel}_el${maj}" kbase="${kern%%.el*}"
    if (( uek )); then
        notes+="; UEK kernel $kern not compared (check the UEK minimum in the install guide)"
    elif [[ -n "${!k_var:-}" ]] && ! _dba_ver_ge "$kbase" "${!k_var}"; then
        problems+="; kernel $kbase < ${!k_var}"
    fi
    # Required one-off patches
    local need=""
    if [[ "$rel" == 19 && "$maj" == 10 && "$ver" == 19.32.* ]]; then
        if [[ "$kind" == GRID ]]; then need="$_DBA_CERT_ONEOFF_19_32_el10_GRID"; else need="$_DBA_CERT_ONEOFF_19_32_el10_DB"; fi
    elif [[ "$rel" == 19 && "$maj" == 10 ]] && _dba_ver_ge "$ver" "19.33"; then
        notes+="; check the 19c release notes for one-offs still required on RHEL/OL 10"
    elif [[ "$rel" == 23 && "$maj" == 10 ]]; then
        need="$_DBA_CERT_ONEOFF_23_el10"
    fi
    if [[ -n "$need" ]]; then
        if [[ -z "$home" ]]; then
            notes+="; requires patch(es) $need in the home"
        else
            local ids missing="" p
            ids="$(_dba_opatch_ids "$home" | cut -d';' -f1 | tr '\n' ',')"
            for p in ${need//,/ }; do [[ ",$ids" == *",$p,"* ]] || missing+="${missing:+,}$p"; done
            if [[ -z "$ids" ]]; then notes+="; could not read opatch lspatches (needs $need)"
            elif [[ -n "$missing" ]]; then problems+="; missing required patch(es) $missing"; fi
        fi
    fi
    if [[ -n "$problems" ]]; then
        printf 'FAIL|%s on RHEL/OL %s.%s: %s%s\n' "$name" "$maj" "$min" "${problems#; }" "$notes"
    elif [[ -n "$notes" ]]; then
        printf 'WARN|%s %s on RHEL/OL %s.%s certified%s\n' "$name" "$ver" "$maj" "$min" "$notes"
    else
        printf 'PASS|%s %s on RHEL/OL %s.%s (kernel %s) certified\n' "$name" "$ver" "$maj" "$min" "$kbase"
    fi
}


# _dba_ver_pad <version> : pad to 5 components (19.32 -> 19.32.0.0.0)
_dba_ver_pad() {
    local v="$1" n
    n="$(awk -F. '{ print NF }' <<< "$v")"
    while (( n < 5 )); do v+=".0"; n=$(( n + 1 )); done
    printf '%s\n' "$v"
}

# _dba_parse_ru <text> : "REL|RU" from 19c / 26ai / 19.32 / 23.26.2 (RU empty for a plain release)
_dba_parse_ru() {
    local t="${1,,}"
    case "$t" in
        19c|19)                 echo "19|" ;;
        26ai|23ai|26|23)        echo "23|" ;;
        *)
            if [[ "$t" =~ ^19\.[0-9]+(\.[0-9]+){0,3}$ ]]; then echo "19|$(_dba_ver_pad "$t")"
            elif [[ "$t" =~ ^23\.[0-9]+(\.[0-9]+){0,3}$ ]]; then echo "23|$(_dba_ver_pad "$t")"
            else return 1; fi
            ;;
    esac
}

# _dba_ver_short <version> : display form (19.32.0.0.0 -> 19.32, 23.26.2.0.0 -> 23.26.2)
_dba_ver_short() {
    awk -F. -v OFS=. '{ keep = ($1 == 19) ? 2 : 3; n = NF; while (n > keep && $n == "0") n--; o = $1; for (i = 2; i <= n; i++) o = o OFS $i; print o }' <<< "$1"
}

# _dba_cert_min_ru <19|23> <OS major> : minimum RU for a NEW installation of a release on that OS major
_dba_cert_min_ru() {
    local ivar="_DBA_CERT_INSTALL_RU_${1}_el${2}" var="_DBA_CERT_RU_${1}_el${2}"
    if [[ -n "${!ivar:-}" ]]; then _dba_ver_pad "${!ivar}"
    elif [[ -n "${!var:-}" ]]; then _dba_ver_pad "${!var}"
    elif [[ "$1" == 19 ]]; then echo "19.3.0.0.0"
    else echo "23.26.0.0.0"; fi
}

# _dba_cert_planned <19|23> [RU] : "STATUS|DETAIL" for a release that is NOT installed yet.
# Without RU the minimum RU for a new installation on this OS is evaluated and reported. Patch requirements
# are those of a database home (the Grid home list can differ - see the release notes).
_dba_cert_planned() {
    local rel="$1" ru="${2:-}" osid maj min kern uek minru st det
    IFS='|' read -r osid maj min kern uek <<< "$(_dba_os_info)"
    minru="$(_dba_cert_min_ru "$rel" "$maj")"
    if [[ -n "$ru" ]]; then
        IFS='|' read -r st det <<< "$(_dba_cert_eval "$ru" "" DB)"
        local ivar="_DBA_CERT_INSTALL_RU_${rel}_el${maj}"
        if [[ "$st" == PASS && -n "${!ivar:-}" ]] && ! _dba_ver_ge "$ru" "$(_dba_ver_pad "${!ivar}")"; then
            st="WARN"; det+="; for a new installation Oracle's release notes apply RU ${!ivar} or later on RHEL/OL $maj"
        fi
        printf '%s|%s\n' "$st" "$det"
    else
        IFS='|' read -r st det <<< "$(_dba_cert_eval "$minru" "" DB)"
        printf '%s|minimum RU for a new install on RHEL/OL %s: %s - %s\n' "$st" "${maj:-?}" "$(_dba_ver_short "$minru")" "$det"
    fi
}
# _dba_homes_in_use : "HOME|KIND" (KIND = DB or GRID) of running databases, ASM / Grid home.
# When nothing runs: every DBMS / GRID home from the inventory.
_dba_homes_in_use() {
    local -A seen=()
    local sid h line g
    while IFS='|' read -r sid h; do
        h="${h%/}"; [[ -n "$h" && -z "${seen[$h]:-}" ]] && { seen[$h]=1; printf '%s|DB\n' "$h"; }
    done < <(_dba_running_dbs)
    if g="$(_dba_grid_home 2>/dev/null)"; then
        g="${g%/}"; [[ -z "${seen[$g]:-}" ]] && { seen[$g]=1; printf '%s|GRID\n' "$g"; }
    fi
    if (( ${#seen[@]} == 0 )); then
        while IFS=$'\t' read -r h line; do
            h="${h%/}"; [[ -z "$h" || -n "${seen[$h]:-}" ]] && continue
            seen[$h]=1
            if [[ "$line" == GRID* ]]; then printf '%s|GRID\n' "$h"; else printf '%s|DB\n' "$h"; fi
        done < <(lsoh --raw --type '^(DBMS|GRID)' 2>/dev/null | awk -F'\t' '{ print $2 "\t" $4 }')
    fi
}

# _dba_net_admin <ORACLE_HOME> : network/admin directory of a home (ORACLE_BASE_HOME aware,
# so read-only Oracle homes are handled; for read/write homes this is <home>/network/admin)
_dba_net_admin() {
    local h="${1%/}" b=""
    [[ -x "$h/bin/orabasehome" ]] && b="$(_dba_env_run "" "$h" "$h/bin/orabasehome" 2>/dev/null | tail -1)"
    [[ -n "$b" && -d "$b" ]] || b="$h"
    printf '%s/network/admin\n' "${b%/}"
}
