# DESC: OEM agent status - state, uploads, pending files, heartbeat and blackouts
function lsagent() {
    local detail=0 pend_max=100 upl_mins=60
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc
    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --detail)      detail=1 ;;
            --pending)     _dba_need_val "$1" "${2-}" || return 1; pend_max="$2"; shift ;;
            --upload-mins) _dba_need_val "$1" "${2-}" || return 1; upl_mins="$2"; shift ;;
            -h|--help)
                cat <<'EOF'
Usage: lsagent [--detail] [--pending N] [--upload-mins N]
               [--grep PATTERN] [--grep-v PATTERN] [--csv|--json|--raw] [--no-header] [--no-color]

Status of the local OEM agent from 'emctl status agent' and 'emctl status blackout'.

Default columns:
  AGENT_INST, VERSION, STATE, TARGETS, LAST_UPLOAD, UPLOAD_AGE_MIN, PENDING_FILES,
  HEARTBEAT, BLACKOUTS, STATUS
STATUS rules:
  DOWN   agent not running
  CRIT   heartbeat status is not Ok
  WARN   pending upload files > --pending, last upload older than --upload-mins,
         or an active agent-side blackout
  OK     otherwise

Options:
  --detail          Every 'emctl status agent' field as KEY | VALUE
  --pending N       Pending XML files threshold (default: 100)
  --upload-mins N   Last successful upload age threshold in minutes (default: 60)
  --grep / --grep-v, --csv|--json|--raw, --no-header, --no-color

Notes:
  - Agent discovery: DBA_AGENT_INST, the running agent process, then lsoh (AGNT home).

Examples:
  lsagent
  lsagent --detail
EOF
                return 0
                ;;
            *) _dba_err "Unknown option: $1 (see lsagent --help)"; return 1 ;;
        esac
        shift
    done
    _dba_check_modes || return 1
    [[ "$pend_max" =~ ^[0-9]+$ && "$upl_mins" =~ ^[0-9]+$ ]] || { _dba_err "--pending/--upload-mins must be whole numbers"; return 1; }

    local emctl ai out bo
    emctl="$(_dba_emctl)" || { _dba_err "OEM agent not found (set DBA_AGENT_INST=/path/to/agent_inst)."; return 1; }
    ai="$(dirname "$(dirname "$emctl")")"
    out="$("$emctl" status agent 2>&1)"

    if (( detail )); then
        local data="KEY|VALUE"
        data+=$'\n'"$(awk -F' : ' 'NF >= 2 { k = $1; v = $2; for (i = 3; i <= NF; i++) v = v " : " $i
                                             gsub(/^[ \t]+|[ \t]+$/, "", k); gsub(/^[ \t]+|[ \t]+$/, "", v); gsub(/\|/, "/", v)
                                             print k "|" v }' <<< "$out")"
        data+=$'\n'"State|$(grep -m1 -E 'Agent is ' <<< "$out" | sed 's/^[[:space:]]*//')"
        _dba_emit "$data"
        return 0
    fi

    _lsagent_kv() { awk -F' : ' -v k="$1" '{ x = $1; gsub(/^[ \t]+|[ \t]+$/, "", x) } x == k { v = $2; gsub(/^[ \t]+|[ \t]+$/, "", v); print v; exit }' <<< "$out"; }
    local state ver tg lu pend hb age st
    if grep -q 'Agent is Running and Ready' <<< "$out"; then state="Running and Ready"
    elif grep -q 'Agent is Running but Not Ready' <<< "$out"; then state="Running but Not Ready"
    elif grep -q 'Agent is Not Running' <<< "$out"; then state="Not Running"
    else state="$(grep -m1 'Agent is' <<< "$out" | sed 's/^[[:space:]]*//')"; state="${state:-unknown}"; fi
    ver="$(_lsagent_kv "Agent Version")"; tg="$(_lsagent_kv "Number of Targets")"
    lu="$(_lsagent_kv "Last successful upload")"; pend="$(_lsagent_kv "Number of XML files pending upload")"
    hb="$(_lsagent_kv "Heartbeat Status")"
    age="-"
    if [[ -n "$lu" && "$lu" != "(none)" ]]; then
        local e; e="$(date -d "$lu" +%s 2>/dev/null)" && age=$(( ( $(date +%s) - e ) / 60 ))
    fi
    bo="$("$emctl" status blackout 2>&1 | grep -c '^[[:space:]]*Blackoutname[[:space:]]*=')"

    if [[ "$state" != Running* ]]; then st="DOWN"
    elif [[ -n "$hb" && "${hb,,}" != "ok" ]]; then st="CRIT (heartbeat: $hb)"
    elif [[ "$state" == *"Not Ready"* ]]; then st="WARN (not ready)"
    elif [[ "$pend" =~ ^[0-9]+$ ]] && (( pend > pend_max )); then st="WARN ($pend files pending)"
    elif [[ "$age" =~ ^[0-9]+$ ]] && (( age > upl_mins )); then st="WARN (last upload ${age} min ago)"
    elif (( bo > 0 )); then st="WARN ($bo blackout(s) active)"
    else st="OK"; fi

    _dba_emit "AGENT_INST|VERSION|STATE|TARGETS|LAST_UPLOAD|UPLOAD_AGE_MIN|PENDING_FILES|HEARTBEAT|BLACKOUTS|STATUS"$'\n'"$ai|${ver:--}|$state|${tg:--}|${lu:--}|$age|${pend:--}|${hb:--}|$bo|$st"
    [[ "$st" == DOWN || "$st" == CRIT* ]] && return 2
    return 0
}

# DESC: List, start and stop OEM agent-side blackouts with a standard name, required reason and duration
function emblackout() {
    local action="${1-}" reason="" duration="" name="" assume_yes=0 dry_run=0 max_h=72
    local -a tgts=()
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc
    case "$action" in
        list|start|stop) shift ;;
        -h|--help|"")
            cat <<'EOF'
Usage:
  emblackout list  [--csv|--json|--raw] [--no-header]
  emblackout start --reason "TEXT" --duration DUR [--target NAME:TYPE ...] [--name NAME]
                   [--max-hours N] [--dry-run] [--yes]
  emblackout stop  --name NAME [--yes]

Agent-side (emctl) blackouts on this host.

start:
  --reason TEXT      Required. Becomes part of the blackout name.
  --duration DUR     Required. 30m, 2h, 1d ... (the blackout ends automatically)
  --target N:T       Black out only this target (repeatable), e.g. PRD_host:oracle_database
                     Without --target the whole node is blacked out (-nodeLevel).
  --name NAME        Override the generated name
                     (default: DBA_<user>_<YYYYMMDD_HHMM>_<reason>)
  --max-hours N      Safety limit for --duration (default: 72)
  --dry-run          Show the emctl command, do not run it
  --yes, -y          Do not ask for confirmation

stop:
  --name NAME        Blackout to stop (see: emblackout list)

Notes:
  - Agent-side blackouts are only known to this agent; OMS-side blackouts are not listed.
  - Agent discovery: DBA_AGENT_INST, the running agent process, then lsoh (AGNT home).

Examples:
  emblackout list
  emblackout start --reason "OOP patch 19.32" --duration 3h
  emblackout start --reason "PRD restart" --duration 45m --target PRD_host1:oracle_database
  emblackout stop --name DBA_oracle_20261113_2100_OOP_patch_19_32
EOF
            [[ -z "$action" ]] && return 1
            return 0
            ;;
        *) _dba_err "Unknown action: $action (list, start or stop)"; return 1 ;;
    esac
    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --reason)    _dba_need_val "$1" "${2-}" || return 1; reason="$2"; shift ;;
            --duration)  _dba_need_val "$1" "${2-}" || return 1; duration="$2"; shift ;;
            --target)    _dba_need_val "$1" "${2-}" || return 1; tgts+=("$2"); shift ;;
            --name)      _dba_need_val "$1" "${2-}" || return 1; name="$2"; shift ;;
            --max-hours) _dba_need_val "$1" "${2-}" || return 1; max_h="$2"; shift ;;
            --dry-run)   dry_run=1 ;;
            --yes|-y)    assume_yes=1 ;;
            *) _dba_err "Unknown option: $1 (see emblackout --help)"; return 1 ;;
        esac
        shift
    done
    _dba_check_modes || return 1

    local emctl out
    emctl="$(_dba_emctl)" || { _dba_err "OEM agent not found (set DBA_AGENT_INST=/path/to/agent_inst)."; return 1; }

    case "$action" in
        list)
            out="$("$emctl" status blackout 2>&1)"
            if ! grep -q 'Blackoutname' <<< "$out"; then
                echo "No agent-side blackouts registered."
                return 0
            fi
            _dba_emit "$(awk -F'=' '
                BEGIN { print "NAME|TARGETS|TIME|EXPIRED" }
                function flush() { if (n != "") print n "|" t "|" tm "|" ex; n = t = tm = ex = "" }
                {
                    k = $1; gsub(/^[ \t]+|[ \t]+$/, "", k)
                    v = substr($0, index($0, "=") + 1); gsub(/^[ \t]+|[ \t]+$/, "", v); gsub(/\|/, " ", v)
                }
                k == "Blackoutname" { flush(); n = v; next }
                k == "Targets"      { t = v }
                k == "Time"         { tm = v }
                k == "Expired"      { ex = v }
                END { flush() }' <<< "$out")"
            ;;
        start)
            [[ -n "$reason" ]] || { _dba_err "--reason is required"; return 1; }
            [[ -n "$duration" ]] || { _dba_err "--duration is required"; return 1; }
            [[ "$max_h" =~ ^[0-9]+$ ]] || { _dba_err "--max-hours must be a whole number"; return 1; }
            local secs; secs="$(_dba_dur_secs "$duration")"
            [[ -n "$secs" ]] && (( secs >= 60 )) || { _dba_err "Invalid --duration: $duration (examples: 30m, 2h, 1d)"; return 1; }
            (( secs <= max_h * 3600 )) || { _dba_err "--duration exceeds --max-hours ($max_h)"; return 1; }
            local mins=$(( (secs + 59) / 60 )) dd hh mm dstr
            dd=$(( mins / 1440 )); hh=$(( (mins % 1440) / 60 )); mm=$(( mins % 60 ))
            if (( dd > 0 )); then dstr="$dd $(printf '%02d:%02d' "$hh" "$mm")"; else dstr="$(printf '%02d:%02d' "$hh" "$mm")"; fi
            if [[ -z "$name" ]]; then
                local slug; slug="$(tr -c 'A-Za-z0-9\n' '_' <<< "$reason" | tr -s '_' | sed 's/^_//; s/_$//' | cut -c1-40)"
                name="DBA_$(id -un)_$(date +%Y%m%d_%H%M)_${slug}"
            fi
            [[ "$name" =~ ^[A-Za-z0-9_.-]+$ ]] || { _dba_err "Invalid blackout name: $name"; return 1; }
            local -a cmd=("$emctl" start blackout "$name")
            if (( ${#tgts[@]} )); then cmd+=("${tgts[@]}"); else cmd+=(-nodeLevel); fi
            cmd+=(-d "$dstr")
            echo "Blackout : $name"
            echo "Scope    : $( (( ${#tgts[@]} )) && echo "${tgts[*]}" || echo "whole node (-nodeLevel)")"
            echo "Duration : $duration (emctl -d '$dstr')"
            echo "Command  : ${cmd[*]}"
            (( dry_run )) && { echo "Dry run - nothing started."; return 0; }
            if (( ! assume_yes )); then _dba_confirm "Start this blackout?" || { echo "Aborted."; return 1; }; fi
            "${cmd[@]}"
            ;;
        stop)
            [[ -n "$name" ]] || { _dba_err "--name is required (see: emblackout list)"; return 1; }
            if (( ! assume_yes )); then _dba_confirm "Stop blackout '$name'?" || { echo "Aborted."; return 1; }; fi
            "$emctl" stop blackout "$name"
            ;;
    esac
}

# DESC: Data Guard broker health per member: switchover/failover readiness, protection mode and key properties
function dbdgcheck() {
    local dbre="" props="${DBA_DG_PROPS:-LogXptMode,DelayMins,NetTimeout,ApplyLagThreshold,TransportLagThreshold,StandbyFileManagement}"
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc
    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --props) _dba_need_val "$1" "${2-}" || return 1; props="$2"; shift ;;
            --db)    _dba_need_val "$1" "${2-}" || return 1; dbre="$2"; shift ;;
            -h|--help)
                cat <<'EOF'
Usage: dbdgcheck [--props P1,P2,...] [--db REGEX] [--grep PATTERN] [--grep-v PATTERN]
                 [--csv|--json|--raw] [--no-header] [--no-color]

For every running database with a Data Guard broker configuration, one row per
configuration member:
  DB, MEMBER, ROLE, PROTECTION, FSFO, SWITCHOVER, FAILOVER, <properties>, STATUS

  SWITCHOVER / FAILOVER   'Ready for Switchover / Failover' from VALIDATE DATABASE
                          (standby members only)
  <properties>            Broker properties from SHOW DATABASE VERBOSE - use this to
                          confirm that a property policy (e.g. one applied by your
                          OEM onboarding tool) really took effect.
  STATUS                  CRIT  configuration status ERROR
                          WARN  configuration status WARNING, or not ready for switchover
                          OK    otherwise

Options:
  --props LIST   Comma-separated broker properties to show
                 (default: LogXptMode,DelayMins,NetTimeout,ApplyLagThreshold,
                  TransportLagThreshold,StandbyFileManagement; override with DBA_DG_PROPS)
  --db REGEX     Only check SIDs matching REGEX (case-insensitive)
  --grep / --grep-v, --csv|--json|--raw, --no-header, --no-color

Notes:
  - VALIDATE DATABASE needs Oracle 12.1+. Databases without a broker configuration
    are listed with STATUS NO_BROKER.

Return code: 0 = all OK, 2 = WARN/CRIT found, 1 = error

Examples:
  dbdgcheck
  dbdgcheck --props LogXptMode,DelayMins,ApplyInstanceTimeout
EOF
                return 0
                ;;
            *) _dba_err "Unknown option: $1 (see dbdgcheck --help)"; return 1 ;;
        esac
        shift
    done
    _dba_check_modes || return 1
    [[ "$props" =~ ^[A-Za-z0-9_,]+$ ]] || { _dba_err "--props: invalid property list"; return 1; }

    local -a plist=()
    IFS=',' read -r -a plist <<< "$props"
    local hdr="DB|MEMBER|ROLE|PROTECTION|FSFO|SWITCHOVER|FAILOVER" p
    for p in "${plist[@]}"; do hdr+="|$p"; done
    hdr+="|STATUS"
    local data="$hdr" empty_props=""
    for p in "${plist[@]}"; do empty_props+="|-"; done

    local sid home cfg cstat prot fsfo member role verb val sw fo st any=0 overall=0 line
    local -a members=()
    local -A mrole=()
    _dbdgcheck_cmd() { _dba_env_run "$sid" "$home" "$home/bin/dgmgrl" -silent / "$1" 2>&1; }
    while IFS='|' read -r sid home; do
        [[ -z "$sid" ]] && continue
        any=1
        if [[ ! -x "$home/bin/dgmgrl" ]]; then
            data+=$'\n'"$sid|-|-|-|-|-|-$empty_props|ERROR: dgmgrl not found"; overall=1; continue
        fi
        cfg="$(_dbdgcheck_cmd "show configuration")"
        if grep -q 'ORA-16532' <<< "$cfg"; then
            data+=$'\n'"$sid|-|-|-|-|-|-$empty_props|NO_BROKER"; continue
        fi
        if ! grep -q 'Configuration Status' <<< "$cfg"; then
            data+=$'\n'"$sid|-|-|-|-|-|-$empty_props|ERROR: $(_dba_clean "$(grep -m1 -E 'ORA-|Error' <<< "$cfg" || echo 'broker not available')")"
            overall=1; continue
        fi
        cstat="$(awk '/Configuration Status:/ { getline; print $1; exit }' <<< "$cfg")"
        prot="$(sed -n 's/^[[:space:]]*Protection Mode:[[:space:]]*//p' <<< "$cfg" | head -1)"
        fsfo="$(sed -n 's/^[[:space:]]*Fast-Start Failover:[[:space:]]*//p' <<< "$cfg" | head -1 | awk '{ print $1 }')"
        members=(); mrole=()
        while IFS= read -r line; do
            if [[ "$line" =~ ^[[:space:]]*([^[:space:]]+)[[:space:]]+-[[:space:]]+(.*([Dd]atabase|[Ff]ar[[:space:]][Ss]ync).*)$ ]] \
               && [[ "${BASH_REMATCH[1]}" != "Configuration" ]]; then
                members+=("${BASH_REMATCH[1]}")
                mrole["${BASH_REMATCH[1]}"]="$(sed 's/[[:space:]]*$//; s/ database$//; s/ Database$//' <<< "${BASH_REMATCH[2]}")"
            fi
        done <<< "$cfg"
        for member in "${members[@]}"; do
            role="${mrole[$member]}"
            verb="$(_dbdgcheck_cmd "show database verbose '$member'")"
            local pv=""
            for p in "${plist[@]}"; do
                val="$(awk -v k="$p" '{ x = $1 } x == k && $2 == "=" { v = $0; sub(/^[^=]*=[ \t]*/, "", v); gsub(/^'"'"'|'"'"'[ \t]*$/, "", v); print v; exit }' <<< "$verb")"
                pv+="|$(_dba_clean "${val:--}")"
            done
            sw="-"; fo="-"
            if [[ "$role" != *[Pp]rimary* ]]; then
                local vout
                vout="$(_dbdgcheck_cmd "validate database '$member'")"
                sw="$(sed -n 's/^[[:space:]]*Ready for Switchover:[[:space:]]*//p' <<< "$vout" | head -1)"
                fo="$(sed -n 's/^[[:space:]]*Ready for Failover:[[:space:]]*//p' <<< "$vout" | head -1)"
                sw="${sw:-unknown}"; fo="${fo:-unknown}"
            fi
            case "$cstat" in
                ERROR*)   st="CRIT (configuration ERROR)" ;;
                WARNING*) st="WARN (configuration WARNING)" ;;
                *)        st="OK" ;;
            esac
            if [[ "$st" == OK && "$sw" != "-" && "${sw,,}" != yes* ]]; then st="WARN (not ready for switchover)"; fi
            [[ "$st" != OK && $overall -eq 0 ]] && overall=2
            data+=$'\n'"$sid|$member|$(_dba_clean "$role")|${prot:--}|${fsfo:--}|$(_dba_clean "$sw")|$(_dba_clean "$fo")$pv|$st"
        done
    done < <(_dba_up_targets "$dbre")
    (( any )) || { _dba_err "No running databases found${dbre:+ matching '$dbre'}."; return 1; }
    _dba_emit "$data"
    return "$overall"
}

