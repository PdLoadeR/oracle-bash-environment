        shift
    done
    _dba_check_modes || return 1

    local data="DB|CON|KEYSTORE|WRL_TYPE|LOCATION|KS_STATUS|WALLET_TYPE|KEYSTORE_MODE|BACKED_UP|ENC_TS|STATUS"
