        shift
    done
    _dba_check_modes || return 1

    local all_columns="DB_NAME,INSTANCE_NAME,HOST_NAME,STATUS,DATABASE_ROLE,OPEN_MODE,MEMORY_MODE,MEMORY_TARGET_GB,MEMORY_MAX_TARGET_GB,SGA_TARGET_GB,SGA_MAX_SIZE_GB,SGA_CUR_GB,PGA_TARGET_GB,PGA_LIMIT_GB,PGA_ALLOC_GB,PGA_MAX_ALLOC_GB,SHARED_POOL_GB,SHARED_POOL_CUR_GB,DB_CACHE_GB,DB_CACHE_CUR_GB,LARGE_POOL_GB,JAVA_POOL_GB,STREAMS_POOL_GB,RESULT_CACHE_MB,PROCESSES,SESSIONS"
    local default_columns="DB_NAME,INSTANCE_NAME,STATUS,MEMORY_MODE,MEMORY_TARGET_GB,SGA_TARGET_GB,SGA_MAX_SIZE_GB,SGA_CUR_GB,PGA_TARGET_GB,PGA_LIMIT_GB,PGA_ALLOC_GB,SHARED_POOL_CUR_GB,DB_CACHE_CUR_GB,PROCESSES,SESSIONS"
    local selected="${columns:-$default_columns}"
    selected="$(tr '[:lower:]' '[:upper:]' <<< "$selected" | tr -d '[:space:]')"

    if [[ -n "$cgrep_pattern" || -n "$cgrep_v_pattern" ]]; then
        selected="$(awk -v cols="$selected" -v inc="$cgrep_pattern" -v exc="$cgrep_v_pattern" 'BEGIN {
            n = split(cols, a, ","); o = ""
            for (i = 1; i <= n; i++) {
                c = a[i]; if (c == "") continue
                if (inc != "" && c !~ toupper(inc)) continue
                if (exc != "" && c ~ toupper(exc)) continue
                o = o (o == "" ? "" : ",") c
            }
            print o }')"
    fi
    # Always keep DB_NAME and INSTANCE_NAME as leading columns
    selected="$(awk -v cols="$selected" 'BEGIN {
        n = split(cols, a, ","); o = "DB_NAME,INSTANCE_NAME"
        for (i = 1; i <= n; i++) if (a[i] != "" && a[i] != "DB_NAME" && a[i] != "INSTANCE_NAME") o = o "," a[i]
        print o }')"

    local ncols empties
    ncols="$(awk -F, '{print NF}' <<< "$all_columns")"
    empties="$(printf '%*s' $(( ncols - 4 )) '' | tr ' ' '|')"

    local data="${all_columns//,/|}" sid home state out row host
    host="$(hostname -s 2>/dev/null || uname -n)"
    while IFS='|' read -r sid home state; do
        [[ -z "$sid" || "$state" != "UP" ]] && continue
        if [[ -z "$home" || ! -x "$home/bin/sqlplus" ]]; then
            data+=$'\n'"UNKNOWN|$sid|$host|ORACLE_HOME_NOT_FOUND$empties"
            continue
        fi
        out="$(_dba_sql "$sid" "$home" 2>&1 <<'SQL'
set pagesize 0 feedback off heading off verify off echo off trimspool on linesize 32767 tab off
whenever sqlerror exit 1
WITH p AS (
    SELECT
        MAX(CASE WHEN name = 'memory_target'         THEN TO_NUMBER(value) END) AS memory_target,
        MAX(CASE WHEN name = 'memory_max_target'     THEN TO_NUMBER(value) END) AS memory_max_target,
        MAX(CASE WHEN name = 'sga_target'            THEN TO_NUMBER(value) END) AS sga_target,
        MAX(CASE WHEN name = 'sga_max_size'          THEN TO_NUMBER(value) END) AS sga_max_size,
        MAX(CASE WHEN name = 'pga_aggregate_target'  THEN TO_NUMBER(value) END) AS pga_target,
        MAX(CASE WHEN name = 'pga_aggregate_limit'   THEN TO_NUMBER(value) END) AS pga_limit,
        MAX(CASE WHEN name = 'shared_pool_size'      THEN TO_NUMBER(value) END) AS shared_pool_size,
        MAX(CASE WHEN name = 'db_cache_size'         THEN TO_NUMBER(value) END) AS db_cache_size,
        MAX(CASE WHEN name = 'large_pool_size'       THEN TO_NUMBER(value) END) AS large_pool_size,
        MAX(CASE WHEN name = 'java_pool_size'        THEN TO_NUMBER(value) END) AS java_pool_size,
        MAX(CASE WHEN name = 'streams_pool_size'     THEN TO_NUMBER(value) END) AS streams_pool_size,
        MAX(CASE WHEN name = 'result_cache_max_size' THEN TO_NUMBER(value) END) AS result_cache_max_size,
        MAX(CASE WHEN name = 'processes'             THEN TO_NUMBER(value) END) AS processes,
        MAX(CASE WHEN name = 'sessions'              THEN TO_NUMBER(value) END) AS sessions
    FROM v$parameter
    WHERE name IN ('memory_target','memory_max_target','sga_target','sga_max_size',
                   'pga_aggregate_target','pga_aggregate_limit','shared_pool_size','db_cache_size',
                   'large_pool_size','java_pool_size','streams_pool_size','result_cache_max_size',
                   'processes','sessions')
),
c AS (
    SELECT
        MAX(CASE WHEN component = 'shared pool'          THEN current_size END) AS sp_cur,
        MAX(CASE WHEN component = 'DEFAULT buffer cache' THEN current_size END) AS bc_cur
    FROM v$sga_dynamic_components
),
g AS (SELECT SUM(value) AS sga_cur FROM v$sga),
pg AS (
    SELECT
        MAX(CASE WHEN name = 'total PGA allocated'   THEN value END) AS pga_alloc,
        MAX(CASE WHEN name = 'maximum PGA allocated' THEN value END) AS pga_max
    FROM v$pgastat
)
SELECT 'ROW|' ||
    SYS_CONTEXT('USERENV','DB_NAME') || '|' || i.instance_name || '|' || i.host_name || '|' ||
    i.status || '|' || d.database_role || '|' || d.open_mode || '|' ||
    CASE WHEN NVL(p.memory_target,0) > 0 THEN 'AMM'
         WHEN NVL(p.sga_target,0) > 0 THEN 'ASMM'
         ELSE 'MANUAL' END || '|' ||
    TO_CHAR(ROUND(NVL(p.memory_target,0)/1073741824,2),'FM9999999990.00') || '|' ||
    TO_CHAR(ROUND(NVL(p.memory_max_target,0)/1073741824,2),'FM9999999990.00') || '|' ||
    TO_CHAR(ROUND(NVL(p.sga_target,0)/1073741824,2),'FM9999999990.00') || '|' ||
    TO_CHAR(ROUND(NVL(p.sga_max_size,0)/1073741824,2),'FM9999999990.00') || '|' ||
    TO_CHAR(ROUND(NVL(g.sga_cur,0)/1073741824,2),'FM9999999990.00') || '|' ||
    TO_CHAR(ROUND(NVL(p.pga_target,0)/1073741824,2),'FM9999999990.00') || '|' ||
    TO_CHAR(ROUND(NVL(p.pga_limit,0)/1073741824,2),'FM9999999990.00') || '|' ||
    TO_CHAR(ROUND(NVL(pg.pga_alloc,0)/1073741824,2),'FM9999999990.00') || '|' ||
    TO_CHAR(ROUND(NVL(pg.pga_max,0)/1073741824,2),'FM9999999990.00') || '|' ||
    TO_CHAR(ROUND(NVL(p.shared_pool_size,0)/1073741824,2),'FM9999999990.00') || '|' ||
    TO_CHAR(ROUND(NVL(c.sp_cur,0)/1073741824,2),'FM9999999990.00') || '|' ||
    TO_CHAR(ROUND(NVL(p.db_cache_size,0)/1073741824,2),'FM9999999990.00') || '|' ||
    TO_CHAR(ROUND(NVL(c.bc_cur,0)/1073741824,2),'FM9999999990.00') || '|' ||
    TO_CHAR(ROUND(NVL(p.large_pool_size,0)/1073741824,2),'FM9999999990.00') || '|' ||
    TO_CHAR(ROUND(NVL(p.java_pool_size,0)/1073741824,2),'FM9999999990.00') || '|' ||
    TO_CHAR(ROUND(NVL(p.streams_pool_size,0)/1073741824,2),'FM9999999990.00') || '|' ||
    TO_CHAR(ROUND(NVL(p.result_cache_max_size,0)/1048576,2),'FM9999999990.00') || '|' ||
    NVL(p.processes,0) || '|' || NVL(p.sessions,0)
FROM v$instance i CROSS JOIN v$database d CROSS JOIN p CROSS JOIN c CROSS JOIN g CROSS JOIN pg;
exit
SQL
)"
        row="$(grep -m1 '^ROW|' <<< "$out")"
        if [[ -z "$row" ]]; then
            data+=$'\n'"UNKNOWN|$sid|$host|SQL_ERROR$empties"
        else
            data+=$'\n'"${row#ROW|}"
        fi
    done < <(_dba_db_targets | sort -t'|' -k1,1)

    if [[ "$data" != *$'\n'* ]]; then
        echo "No running Oracle database instances found on this server."
        return 1
    fi

    data="$(_dba_filter_rows "$data" "$_o_grep" "$_o_grepv" "1,2")"
    data="$(_dba_select_columns "$data" "$selected")" || { echo "Run: dbmemory --help" >&2; return 1; }

    # TOTAL row (sum of numeric columns)
    data="$(awk -F'|' -v OFS='|' '
        NR == 1 { print; nc = NF; next }
        {
            rows++
            for (i = 3; i <= NF; i++) if ($i ~ /^-?[0-9]+([.][0-9]+)?$/) { sum[i] += $i; num[i] = 1 }
            print
        }
        END {
            if (rows > 0) {
                o = "TOTAL|"
                for (i = 3; i <= nc; i++) {
                    v = ""
                    if (num[i]) { v = sprintf("%.2f", sum[i]); sub(/\.00$/, "", v) }
                    o = o "|" v
                }
                print o
            }
        }' <<< "$data")"

    if [[ "$summary_mode" == "Y" ]]; then
        data="$(awk -F'|' 'NR == 1 || $1 == "TOTAL"' <<< "$data")"
    fi
    # Table mode: wrap long column names at '_' to keep the table narrow
    [[ "$_o_mode" == table ]] && data="$(_dba_wrap_header "$data" 12)"
    _dba_render "$_o_mode" "$_o_nohdr" "$data"
}
# DESC: Displays CPU utilization for all Oracle databases on the server (sampled)
function dbcpu() {
    local explain=0 sort_col=1 interval=2
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc
    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --sort)
                _dba_need_val "$1" "${2-}" || return 1
                case "$2" in 1|2) sort_col="$2" ;; *) _dba_err "Invalid --sort value: $2 (valid: 1 or 2)"; return 1 ;; esac
                shift
                ;;
            --interval)
                _dba_need_val "$1" "${2-}" || return 1
                [[ "$2" =~ ^[0-9]+$ ]] && (( $2 >= 1 && $2 <= 60 )) || { _dba_err "--interval must be 1-60 seconds"; return 1; }
                interval="$2"; shift
                ;;
            --explain)     explain=1 ;;
            --fullexplain) explain=2 ;;
            -h|--help)
                cat <<'EOF'
Usage: dbcpu [--sort 1|2] [--interval SECONDS] [--explain|--fullexplain]
             [--grep PATTERN] [--grep-v PATTERN] [--csv|--json|--raw] [--no-header]

Description:
  Displays CPU utilization for all Oracle databases on the server.

  OS_CPU%      CPU used by ALL processes of the instance (background ora_*_SID and
               foreground oracleSID server processes) measured over the sampling
               interval from /proc/<pid>/stat. 100% = one full CPU core.
  HOST_CPU%    OS_CPU% divided by the number of CPUs on the host.
  PROCS        Number of Oracle processes found for the instance.
  DB_CPU/sec   Oracle "CPU Usage Per Sec" from v$sysmetric (60-second group),
               converted from centiseconds to CPU-seconds per second (= cores).
               STATUS:DOWN     - instance could not be queried / not running
               STATUS:STARTED  - instance reachable but not OPEN
               STATUS:MOUNTED

Options:
  --sort 1            Sort by OS_CPU% descending (default)
  --sort 2            Sort by DB_CPU/sec descending
  --interval N        Sampling interval in seconds, 1-60 (default: 2)
  --explain           Short explanation of the metrics
  --fullexplain       Detailed explanation and troubleshooting workflow
  --grep / --grep-v   Filter by DB name (case-insensitive regex)
  -h, --help          Show this help message

Examples:
  dbcpu
  dbcpu --sort 2
  dbcpu --interval 5
  dbcpu --fullexplain
EOF
                return 0
                ;;
            *)
                _dba_err "Unknown option: $1 (see dbcpu --help)"
                return 1
                ;;
        esac
        shift
    done
    _dba_check_modes || return 1

    local -a targets=()
    mapfile -t targets < <(_dba_db_targets | sort -t'|' -k1,1)
    if (( ${#targets[@]} == 0 )); then
        echo "No Oracle databases found (no PMON processes and no database entries in oratab)."
        return 1
    fi

    local -A want=() t1=() psid=()
    local t sid
    for t in "${targets[@]}"; do want["${t%%|*}"]=1; done

    # _dbcpu_sample: prints "pid sid ticks" for Oracle processes of the target SIDs
    _dbcpu_sample() {
        local pid pname s stat
        local -a f
        while read -r pid pname; do
            case "$pname" in
                ora_*_*) s="${pname#ora_}"; s="${s#*_}" ;;
                oracle?*) s="${pname#oracle}" ;;
                *) continue ;;
            esac
            [[ -n "${want[$s]:-}" ]] || continue
            read -r stat < "/proc/$pid/stat" 2>/dev/null || continue
            read -r -a f <<< "${stat##*) }"
            printf '%s %s %s\n' "$pid" "$s" "$(( f[11] + f[12] ))"
        done < <(ps -eo pid=,args= | awk '$2 ~ /^ora_[[:alnum:]]+_/ || $2 ~ /^oracle[^\/[:space:]]/ { print $1, $2 }')
    }

    local pid ticks
    while read -r pid sid ticks; do
        t1["$pid"]="$ticks"
        psid["$pid"]="$sid"
    done < <(_dbcpu_sample)
    sleep "$interval"
    local -A delta=() nproc=()
    while read -r pid sid ticks; do
        nproc["$sid"]=$(( ${nproc[$sid]:-0} + 1 ))
        if [[ -n "${t1[$pid]:-}" ]]; then
            delta["$sid"]=$(( ${delta[$sid]:-0} + ticks - ${t1[$pid]} ))
        fi
    done < <(_dbcpu_sample)

    local hz ncpu
    hz="$(getconf CLK_TCK 2>/dev/null)"; [[ "$hz" =~ ^[0-9]+$ ]] || hz=100
    ncpu="$(nproc 2>/dev/null)"; [[ "$ncpu" =~ ^[0-9]+$ ]] || ncpu=1

    local data="DB_NAME|PROCS|OS_CPU%|HOST_CPU%|DB_CPU/sec"
    local home state os_pct host_pct db_cpu out st
    for t in "${targets[@]}"; do
        IFS='|' read -r sid home state <<< "$t"
        if [[ -n "$_o_grep" || -n "$_o_grepv" ]]; then
            [[ "$(_dba_filter_rows "H"$'\n'"$sid" "$_o_grep" "$_o_grepv")" == *$'\n'* ]] || continue
        fi
        read -r os_pct host_pct < <(awk -v d="${delta[$sid]:-0}" -v hz="$hz" -v iv="$interval" -v n="$ncpu" \
            'BEGIN { p = d * 100 / (hz * iv); if (p < 0) p = 0; printf "%.1f %.1f\n", p, p / n }')
        db_cpu="STATUS:DOWN"
        if [[ "$state" == "UP" && -x "$home/bin/sqlplus" ]]; then
            out="$(_dba_sql "$sid" "$home" 2>&1 <<'SQL'
set pages 0 feedback off heading off verify off echo off
whenever sqlerror continue
select 'ST|' || status from v$instance;
select 'CPU|' || to_char(round(value / 100, 2), 'FM9999990.00')
  from v$sysmetric
 where metric_name = 'CPU Usage Per Sec'
   and group_id = 2;
exit
SQL
)"
            st="$(sed -n 's/^ST|//p' <<< "$out" | head -1 | tr -d '[:space:]')"
            if [[ -z "$st" ]]; then
                db_cpu="STATUS:DOWN"
            elif [[ "$st" != "OPEN" ]]; then
                db_cpu="STATUS:$st"
            else
                db_cpu="$(sed -n 's/^CPU|//p' <<< "$out" | head -1 | tr -d '[:space:]')"
                [[ -z "$db_cpu" ]] && db_cpu="n/a"
            fi
        fi
        data+=$'\n'"$sid|${nproc[$sid]:-0}|$os_pct|$host_pct|$db_cpu"
    done

    if (( sort_col == 1 )); then
        data="$(_dba_sort_body "$data" -k3,3nr -k1,1)"
    else
        data="$(printf '%s\n' "$data" | awk -F'|' 'NR == 1 { print "-9|" $0; next }
            { v = ($5 ~ /^[0-9]+([.][0-9]+)?$/) ? $5 : -1; print v "|" $0 }' \
            | { IFS= read -r h; printf '%s\n' "$h"; sort -t'|' -k1,1gr -k4,4nr; } | cut -d'|' -f2-)"
    fi

    _dba_render "$_o_mode" "$_o_nohdr" "$data"
    [[ "$_o_mode" == "table" ]] || return 0

    case "$explain" in
        0)
            cat <<EOF

Sampled over ${interval}s on ${ncpu} CPUs. Run 'dbcpu --explain' or 'dbcpu --fullexplain' for how to read these numbers.
EOF
            ;;
        1)
            cat <<'EOF'
------------------------------------------------------------------------------
DBCPU Metric Explanation
------------------------------------------------------------------------------
  OS_CPU%     = CPU used by all background AND foreground (dedicated server)
                processes of the instance during the sampling interval,
                from /proc/<pid>/stat. 100% = one core.
  HOST_CPU%   = OS_CPU% / number of CPUs on the host.
  DB_CPU/sec  = Oracle's own CPU consumption from v$sysmetric
                ('CPU Usage Per Sec', 60-second group) in cores.

  STATUS:DOWN means the instance could not be queried.
  STATUS:STARTED / STATUS:MOUNTED means it is reachable but not OPEN.

  OS_CPU% / 100 and DB_CPU/sec are both in "cores", so they are roughly
  comparable, but OS_CPU% is the last few seconds and DB_CPU/sec is the
  last minute, and DB_CPU/sec excludes some background CPU.
------------------------------------------------------------------------------
Tip: Run 'dbcpu --fullexplain' for full details.
EOF
            ;;
        2)
            cat <<'EOF'
------------------------------------------------------------------------------
DBCPU Metric Explanation
------------------------------------------------------------------------------
OS_CPU%
-------
Sum of CPU used by every OS process of the instance during the sampling
interval (default 2 seconds):
  - Background processes:  ora_pmon_SID, ora_dbw0_SID, ora_lgwr_SID, ora_j000_SID ...
  - Foreground processes:  oracleSID (LOCAL=NO) / (LOCAL=YES) dedicated servers
utime+stime is read from /proc/<pid>/stat at the start and at the end of the
interval; the difference is divided by the elapsed time.

  PROD1 = 320.0  ->  PROD1 used about 3.2 CPU cores during the interval.

This is a current measurement. (ps %CPU, used by older versions, is a
lifetime average per process and badly under-reports busy long-running
background processes.) Processes that started during the interval are
counted in PROCS but not in OS_CPU%.

HOST_CPU%
---------
OS_CPU% divided by the number of CPUs (nproc). 100% = whole host.

DB_CPU/sec
----------
From v$sysmetric, metric 'CPU Usage Per Sec', group_id 2 (60-second
interval). Oracle reports it in centiseconds per second; dbcpu divides by
100, so the value is CPU cores used by the database workload.

  PROD1 = 2.84  ->  the workload used about 2.84 cores over the last minute.

Instance Status Handling
------------------------
v$instance.status is checked first in the same SQL*Plus session.
  STATUS:DOWN               not running / cannot connect
  STATUS:STARTED|MOUNTED    reachable but not OPEN (metric not queried)

How to Interpret Results
------------------------
  OS_CPU%/100 ~ DB_CPU/sec, both high
    -> Database workload is consuming the CPU. Check ASH/AWR, top SQL_IDs.
  OS_CPU% high, DB_CPU/sec low
    -> Spike in the last seconds, or CPU spent outside DB calls (parsing
       storms, background work, connection storms, GoldenGate/OEM sessions).
  OS_CPU% low, DB_CPU/sec high
    -> Load was higher during the last minute than right now.
  One database dominates OS_CPU%
    -> Usually the first one to investigate during a host CPU incident.

Recommended Workflow
--------------------
  top / mpstat -P ALL 1
  dbcpu --interval 5
  Then on the busiest database:
    v$session (status='ACTIVE'), v$active_session_history, v$sqlstats, AWR
------------------------------------------------------------------------------
EOF
            ;;
    esac
}

# DESC: Show HugePages allocation status for all running Oracle databases on the host
function dbhpaloc() {
    local sort_by="%allocated" sort_dir="asc" status_filter="" summary_mode="N"
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc
    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --sort)     _dba_need_val "$1" "${2-}" || return 1; sort_by="${2,,}"; shift ;;
            --sort=*)   sort_by="${1#*=}"; sort_by="${sort_by,,}"; _dba_need_val "--sort" "$sort_by" || return 1 ;;
            --status)   _dba_need_val "$1" "${2-}" || return 1; status_filter="${2,,}"; shift ;;
            --status=*) status_filter="${1#*=}"; status_filter="${status_filter,,}" ;;
            --summary)  summary_mode="Y" ;;
            -h|--help)
                cat <<'EOF'
Usage:
  dbhpaloc [--grep PATTERN] [--grep-v PATTERN] [--status ok|fail|error]
           [--sort COLUMN[:desc]] [--summary] [--csv|--json|--raw] [--no-header]

Description:
  Displays HugePages allocation for all running Oracle databases, based on the
  latest "Huge Pages Information" section in each database alert log
  (read from the end of the file, so large alert logs are fast).
  One row per huge page size found (2048K and/or 1048576K = 1GB pages).

Filter Options:
  --grep <pattern>       Include only instances matching pattern
  --grep-v <pattern>     Exclude instances matching pattern
  --status <status>      ok, fail, error

Sort Columns (append :desc for descending):
  instance | db | dbname | database     Instance name
  %allocated | pct (default)             Allocation percentage
  expected                               Expected pages
  allocated                              Allocated pages
  status                                 OK / FAIL / ERROR

Output Options:
  --summary              Summary after the table (ERROR rows are excluded from the average)
  --csv / --json / --raw Output the instance table only

The table view always ends with system HugePages (/proc/meminfo), the total
pages expected by the running instances, and the Transparent HugePages setting.

Examples:
  dbhpaloc
  dbhpaloc --status fail
  dbhpaloc --grep awm --status fail
  dbhpaloc --sort allocated:desc
  dbhpaloc --summary
EOF
                return 0
                ;;
            *)
                _dba_err "Unknown option: $1 (see dbhpaloc --help)"
                return 1
                ;;
        esac
        shift
    done
    _dba_check_modes || return 1

    # Validate sort and status up front (before any work)
    if [[ "$sort_by" == *:* ]]; then
        sort_dir="${sort_by#*:}"
        sort_by="${sort_by%%:*}"
    fi
    case "$sort_dir" in asc|desc) ;; *) _dba_err "Invalid sort direction: $sort_dir (valid: asc, desc)"; return 1 ;; esac
    local sort_key
    case "$sort_by" in
        instance|db|dbname|database)                          sort_key="-k1,1" ;;
        %allocated|allocated_pct|pct|pct_allocated|percent|percentage) sort_key="-k6,6n" ;;
        expected)                                             sort_key="-k4,4n" ;;
        allocated)                                            sort_key="-k5,5n" ;;
        status)                                               sort_key="-k7,7" ;;
        *) _dba_err "Invalid sort column: $sort_by (valid: instance, db, %allocated, expected, allocated, status)"; return 1 ;;
    esac
    [[ "$sort_dir" == "desc" ]] && sort_key="${sort_key}r"
    case "$status_filter" in ""|ok|fail|error) ;; *) _dba_err "Invalid status filter: $status_filter (valid: ok, fail, error)"; return 1 ;; esac

    local data="INSTANCE|PAGESIZE|AVAILABLE|EXPECTED|ALLOCATED|%ALLOCATED|STATUS|ERROR"
    local sid home state obase alert f hp_rows psz avail exp alloc errs pct st
    while IFS='|' read -r sid home state; do
        [[ -z "$sid" || "$state" != "UP" ]] && continue
        if [[ -z "$home" || ! -d "$home" ]]; then
            data+=$'\n'"$sid|-|-|-|-|-|ERROR|ORACLE_HOME not found"
            continue
        fi
        obase=""
        [[ -x "$home/bin/orabase" ]] && obase="$(_dba_env_run "$sid" "$home" "$home/bin/orabase" 2>/dev/null)"
        [[ -z "$obase" ]] && obase="$(dirname "$(dirname "$home")")"
        alert=""
        for f in "$obase"/diag/rdbms/*/"$sid"/trace/alert_"$sid".log; do
            [[ -f "$f" ]] || continue
            if [[ -z "$alert" || "$f" -nt "$alert" ]]; then alert="$f"; fi
        done
        if [[ -z "$alert" ]]; then
            data+=$'\n'"$sid|-|-|-|-|-|ERROR|Alert log not found under $obase/diag (check diagnostic_dest)"
            continue
        fi
        # Read the alert log backwards: rows of the latest section appear BEFORE its header
        hp_rows="$(tac "$alert" 2>/dev/null | awk '
            /^[[:space:]]*\*+/ { delete r; n = 0; next }
            /^[[:space:]]*[0-9]+K[[:space:]]+/ {
                line = $0; gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
                if ($1 != "4K") r[++n] = line
                next
            }
            /PAGESIZE[[:space:]]+AVAILABLE_PAGES[[:space:]]+EXPECTED_PAGES[[:space:]]+ALLOCATED_PAGES/ {
                if (n > 0) { for (i = n; i >= 1; i--) print r[i]; exit }
                delete r; n = 0
            }')"
        if [[ -z "$hp_rows" ]]; then
            data+=$'\n'"$sid|-|-|-|-|-|ERROR|No HugePages entry found in alert log"
            continue
        fi
        while read -r psz avail exp alloc errs; do
            [[ -z "$errs" ]] && errs="-"
            if [[ "$exp" =~ ^[0-9]+$ && "$alloc" =~ ^[0-9]+$ ]] && (( exp > 0 )); then
                pct="$(awk -v a="$alloc" -v e="$exp" 'BEGIN { printf "%.1f", a * 100 / e }')"
            else
                pct="0.0"
            fi
            if [[ "$exp" == "$alloc" && "$errs" == "NONE" ]]; then st="OK"; else st="FAIL"; fi
            data+=$'\n'"$sid|$psz|$avail|$exp|$alloc|$pct|$st|$errs"
        done <<< "$hp_rows"
    done < <(_dba_db_targets | sort -t'|' -k1,1)

    data="$(_dba_filter_rows "$data" "$_o_grep" "$_o_grepv" "1")"
    if [[ -n "$status_filter" ]]; then
        data="$(awk -F'|' -v s="$status_filter" 'NR == 1 || tolower($7) == s' <<< "$data")"
    fi
    data="$(_dba_sort_body "$data" $sort_key)"

    if [[ "$_o_mode" != "table" ]]; then
        _dba_render "$_o_mode" "$_o_nohdr" "$data"
        return 0
    fi

    # Table view: show % sign on the percentage column
    _dba_render table "$_o_nohdr" "$(awk -F'|' -v OFS='|' 'NR > 1 && $6 != "-" { $6 = $6 "%" } 1' <<< "$data")"

    if [[ "$summary_mode" == "Y" ]]; then
        echo
        echo "Summary"
        echo "-------"
        awk -F'|' 'NR > 1 {
                total++
                if ($7 == "OK")         ok++
                else if ($7 == "FAIL")  fail++
                else if ($7 == "ERROR") err++
                if ($7 != "ERROR") { pct_sum += $6; measured++ }
            }
            END {
                printf "Rows Checked       : %d\n", total
                printf "OK                 : %d\n", ok
                printf "FAIL               : %d\n", fail
                printf "ERROR              : %d\n", err
                if (measured > 0) printf "Average Allocation : %.1f%% (excluding ERROR rows)\n", pct_sum / measured
                else              printf "Average Allocation : n/a\n"
            }' <<< "$data"
    fi

    local hp_size_kb expected_2m thp
    hp_size_kb="$(awk '/^Hugepagesize:/ { print $2 }' /proc/meminfo)"
    expected_2m="$(awk -F'|' -v sz="${hp_size_kb}K" 'NR > 1 && $2 == sz && $4 ~ /^[0-9]+$/ { s += $4 } END { print s + 0 }' <<< "$data")"
    thp="$(sed -n 's/.*\[\(.*\)\].*/\1/p' /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null)"

    echo
    echo "System HugePages"
    echo "----------------"
    awk -v expd="$expected_2m" -v thp="${thp:-unknown}" '
        /^HugePages_Total/ { total = $2 }
        /^HugePages_Free/  { free = $2 }
        /^HugePages_Rsvd/  { rsvd = $2 }
        /^HugePages_Surp/  { surp = $2 }
        /^Hugepagesize/    { size = $2 " " $3 }
        END {
            printf "Total Pages        : %s\n", total
            printf "Free Pages         : %s\n", free
            printf "Reserved           : %s\n", rsvd
            printf "Surplus            : %s\n", surp
            printf "Page Size          : %s\n", size
            printf "Expected by DBs    : %s  (sum of EXPECTED for rows shown above, default page size)\n", expd
            printf "Headroom           : %d pages\n", total - expd
            printf "Transparent HP     : %s%s\n", thp, (thp == "never" ? "" : "   <-- Oracle recommends: never")
        }' /proc/meminfo
    echo
}

# DESC: Execute a SQL query or SQL file on all databases running on the host
function dbsqlall() {
    local sql_query="" sql_file="" include_down=0 dry_run=0 assume_yes=0 stop_on_error=0 pdbs=0
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1
    local c_cyan="" c_green="" c_yellow="" c_red="" c_reset=""
    if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
        c_cyan=$'\033[1;36m'; c_green=$'\033[1;32m'; c_yellow=$'\033[1;33m'; c_red=$'\033[1;31m'; c_reset=$'\033[0m'
    fi

    _dbsqlall_usage() {
        cat <<'EOF'
Usage:
  dbsqlall --query 'select name, open_mode from v$database'
  dbsqlall --file sqlfile.sql

Options:
  --query | -q SQL     SQL statement (or PL/SQL block) to execute
  --file  | -f FILE    SQL file to execute
  --grep  | -g PATTERN Include only SIDs matching PATTERN (case-insensitive regex)
  --grep-v PATTERN     Exclude SIDs matching PATTERN
  --all                Also try oratab databases whose instance is not running
  --pdbs               Run in every OPEN PDB (alter session set container) instead of
                       the CDB root. Non-CDBs run normally.
  --stop-on-error      Use WHENEVER SQLERROR EXIT and stop at the first failing database
  --dry-run            Only list the target databases, run nothing
  --yes | -y           Do not ask for confirmation for statements that can change data
  --help | -h          Show this help

Safety:
  If the SQL contains anything other than queries (INSERT/UPDATE/DELETE/MERGE, DDL,
  GRANT/REVOKE, PL/SQL blocks, EXEC, SHUTDOWN/STARTUP, nested @scripts ...), the target
  list is shown and you must type YES to continue (or pass --yes). Without a terminal
  and without --yes such SQL is refused.

Result detection:
  A database is reported as FAILED when SQL*Plus exits non-zero or the output contains
  ORA-, SP2-, PLS- or TNS- errors (e.g. "Connected to an idle instance").
  A summary table is printed at the end; the return code is 1 if any database failed.

PL/SQL:
  For --query, a block starting with BEGIN / DECLARE / CREATE [OR REPLACE] PROCEDURE|
  FUNCTION|PACKAGE|TRIGGER|TYPE gets a terminating "/" automatically.

Important:
  Use single quotes around SQL containing $ characters:
    dbsqlall --query 'select name from v$database'
EOF
    }

    if [[ $# -eq 0 ]]; then
        _dbsqlall_usage
        return 1
    fi
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --query|-q)  _dba_need_val "$1" "${2-}" || return 1; sql_query="$2"; shift ;;
            --file|-f)   _dba_need_val "$1" "${2-}" || return 1; sql_file="$2"; shift ;;
            --grep|-g)   _dba_need_val "$1" "${2-}" || return 1; _o_grep="$2"; shift ;;
            --grep-v)    _dba_need_val "$1" "${2-}" || return 1; _o_grepv="$2"; shift ;;
            --all)           include_down=1 ;;
            --pdbs)          pdbs=1 ;;
            --stop-on-error) stop_on_error=1 ;;
            --dry-run)       dry_run=1 ;;
            --yes|-y)        assume_yes=1 ;;
            --help|-h)       _dbsqlall_usage; return 0 ;;
            *)
                _dba_err "Unknown option: $1"
                _dbsqlall_usage
                return 1
                ;;
        esac
        shift
    done

    if [[ -n "$sql_query" && -n "$sql_file" ]]; then
        _dba_err "Use either --query or --file, not both."
        return 1
    fi
    if [[ -z "$sql_query" && -z "$sql_file" ]]; then
        _dba_err "You must provide either --query or --file."
        return 1
    fi
    if [[ -n "$sql_file" && ( ! -f "$sql_file" || ! -r "$sql_file" ) ]]; then
        _dba_err "SQL file does not exist or is not readable: $sql_file"
        return 1
    fi

    # Build the script that will be run
    local sql_text
    if [[ -n "$sql_query" ]]; then
        sql_text="$sql_query"
        local last_line
        last_line="$(printf '%s\n' "$sql_text" | sed '/^[[:space:]]*$/d' | tail -1 | sed 's/[[:space:]]*$//')"
        if grep -Eiq '^[[:space:]]*(begin|declare|create[[:space:]]+(or[[:space:]]+replace[[:space:]]+)?(editionable[[:space:]]+|noneditionable[[:space:]]+)?(procedure|function|package|trigger|type))([[:space:]]|$)' <<< "$sql_text"; then
            [[ "$last_line" == "/" ]] || sql_text+=$'\n/'
        else
            case "${last_line: -1}" in
                ";"|"/") ;;
                *) sql_text+=";" ;;
            esac
        fi
    else
        sql_text="$(cat "$sql_file")"
    fi

    # Safety classification: strip comments and look for anything that is not a plain query
    local stripped modifying=0
    stripped="$(printf '%s\n' "$sql_text" | sed 's/--.*$//' | awk 'BEGIN { RS = "\0" } { gsub(/\/\*([^*]|\*+[^*\/])*\*+\//, " "); print }')"
    if grep -Eiq '(^|[^a-z0-9_$#])(insert|update|delete|merge|create|alter|drop|truncate|grant|revoke|begin|declare|exec|execute|call|shutdown|startup|purge|flashback|rename|recover|host|commit)([^a-z0-9_$#]|$)' <<< "$stripped" \
       || grep -Eq '^[[:space:]]*(@|!)' <<< "$stripped"; then
        modifying=1
    fi

    # Targets
    local -a targets=() skipped=()
    local sid home state t
    while IFS='|' read -r sid home state; do
        [[ -z "$sid" ]] && continue
        if [[ -n "$_o_grep" || -n "$_o_grepv" ]]; then
            [[ "$(_dba_filter_rows "H"$'\n'"$sid" "$_o_grep" "$_o_grepv")" == *$'\n'* ]] || continue
        fi
        if [[ "$state" != "UP" && $include_down -eq 0 ]]; then
            skipped+=("$sid|$home")
            continue
        fi
        targets+=("$sid|$home|$state")
    done < <(_dba_db_targets | sort -t'|' -k1,1)

    if (( ${#targets[@]} == 0 )); then
        _dba_err "No target databases found."
        return 1
    fi

    local tdata="SID|ORACLE_HOME|STATE"
    for t in "${targets[@]}"; do tdata+=$'\n'"$t"; done

    if (( dry_run )); then
        echo "Target databases (dry run - nothing executed):"
        _dba_render table 0 "$tdata"
        (( modifying )) && echo "NOTE: the SQL was classified as potentially modifying data/structure."
        return 0
    fi

    if (( modifying && ! assume_yes )); then
        echo "${c_yellow}WARNING:${c_reset} the SQL can change data or structure and will run on these databases:"
        _dba_render table 0 "$tdata"
        if [[ ! -t 0 ]]; then
            _dba_err "Refusing to run modifying SQL without a terminal. Re-run with --yes."
            return 1
        fi
        local answer
        read -r -p "Type YES to continue: " answer
        [[ "$answer" == "YES" ]] || { echo "Aborted."; return 1; }
    fi

    local sql_tmp
    sql_tmp="$(mktemp "${TMPDIR:-/tmp}/dbsqlall.XXXXXX.sql")" || return 1
    printf '%s\n' "$sql_text" > "$sql_tmp"
    chmod 600 "$sql_tmp"

    local errmode="whenever sqlerror continue"
    (( stop_on_error )) && errmode=$'whenever sqlerror exit failure\nwhenever oserror exit failure'

    local summary="SID|CONTAINER|ORACLE_HOME|RESULT"
    local overall_rc=0 out sp_rc result pdb stop=0
    local -a containers

    for t in "${targets[@]}"; do
        (( stop )) && break
        IFS='|' read -r sid home state <<< "$t"

        containers=("")
        if (( pdbs )); then
            local pdb_out
            pdb_out="$(_dba_sql "$sid" "$home" 2>&1 <<'SQL'
set pages 0 feedback off heading off verify off echo off
whenever sqlerror continue
select 'PDB|' || name from v$pdbs where open_mode like 'READ%' and name <> 'PDB$SEED' order by con_id;
exit
SQL
)"
            mapfile -t containers < <(sed -n 's/^PDB|//p' <<< "$pdb_out" | sed 's/[[:space:]]*$//')
            (( ${#containers[@]} == 0 )) && containers=("")
        fi

        for pdb in "${containers[@]}"; do
            printf '\n%s======================================================================%s\n' "$c_cyan" "$c_reset"
            printf '%sDatabase   :%s %s%s\n' "$c_cyan" "$c_reset" "$sid" "${pdb:+  (container: $pdb)}"
            printf '%sOracle Home:%s %s\n' "$c_cyan" "$c_reset" "$home"
            printf '%s======================================================================%s\n' "$c_cyan" "$c_reset"

            out="$(
                {
                    printf '%s\n' "set pagesize 50000" "set linesize 300" "set trimspool on" "set tab off" \
                        "set feedback on" "set verify off" "set heading on" "set echo off" "set termout on" \
                        "set serveroutput on size unlimited" "set define off" "set sqlblanklines on" "$errmode"
                    [[ -n "$pdb" ]] && printf 'alter session set container = "%s";\n' "$pdb"
                    printf '@"%s"\nexit\n' "$sql_tmp"
                } | _dba_sql "$sid" "$home" 2>&1
            )"
            sp_rc=$?
            printf '%s\n' "$out"

            if (( sp_rc != 0 )) || grep -Eq '(^|[^A-Z])(ORA|SP2|PLS|TNS)-[0-9]+' <<< "$out" || grep -q 'Connected to an idle instance' <<< "$out"; then
                result="FAILED (rc=$sp_rc)"
                printf '%sERROR:%s errors detected for %s%s\n' "$c_red" "$c_reset" "$sid" "${pdb:+/$pdb}"
                overall_rc=1
                (( stop_on_error )) && stop=1
            else
                result="OK"
                printf '%sCompleted:%s %s%s\n' "$c_green" "$c_reset" "$sid" "${pdb:+/$pdb}"
            fi
            summary+=$'\n'"$sid|${pdb:-${state/UP/-}}|$home|$result"
            (( stop )) && break
        done
    done
    rm -f -- "$sql_tmp"

    for t in "${skipped[@]}"; do
        summary+=$'\n'"${t%%|*}|-|${t#*|}|SKIPPED (not running)"
    done
    (( stop )) && echo "${c_red}Stopped after the first failure (--stop-on-error).${c_reset}"

    echo
    echo "Summary"
    _dba_render table 0 "$summary"
    return "$overall_rc"
}

# DESC: Show the Data Guard lag for one or all running databases (tabular)
function dbdglag() {
    local mode="" requested_db="" warn_s=300 crit_s=1800
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc
    local usage
    usage='
Usage: dbdglag [--db] <ORACLE_SID> | --all
               [--warn SECONDS] [--crit SECONDS]
               [--grep PATTERN] [--grep-v PATTERN] [--csv|--json|--raw] [--no-header]

Description:
  Shows the Data Guard Broker configuration status and the transport/apply lag
  of every standby member, as a table (one row per member).

Options:
  --db <ORACLE_SID>   Check one database (RAC: DB name or instance name)
  <ORACLE_SID>        Same as --db
  --all               Check all running databases on the host
  --warn SECONDS      Lag threshold for WARN (default: 300)
  --crit SECONDS      Lag threshold for CRIT (default: 1800)
  --grep / --grep-v   Filter rows (case-insensitive regex)
  -h, --help          Show help

Columns:
  SID, DB_ROLE, CONFIG_STATUS, MEMBER, MEMBER_ROLE, TRANSPORT_LAG, APPLY_LAG, LAG_STATUS
  LAG_STATUS: OK / WARN / CRIT from the larger of the two lags; PRIMARY for the
  primary member; UNKNOWN when the lag could not be determined.
  CONFIG_STATUS NO_BROKER means the database has no broker configuration (not an error).

Return code:
  0 = all OK/WARN, 1 = an error occurred, 2 = at least one member is CRIT

Examples:
  dbdglag --db PRDDB
  dbdglag PRDDB1
  dbdglag --all
  dbdglag --all --warn 60 --crit 600 --csv'

    if [[ $# -eq 0 ]]; then
        _dba_err "Missing argument."
        echo "$usage"
        return 1
    fi
    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --all)
                [[ -n "$requested_db" ]] && { _dba_err "--all cannot be used together with a database name."; return 1; }
                mode="all"
                ;;
            --db|--db=*)
                if [[ "$1" == --db=* ]]; then requested_db="${1#--db=}"; else requested_db="${2-}"; shift; fi
                _dba_need_val "--db" "$requested_db" || return 1
                [[ "$mode" == "all" ]] && { _dba_err "--db cannot be used together with --all."; return 1; }
                mode="single"
                ;;
            --warn) _dba_need_val "$1" "${2-}" || return 1; warn_s="$2"; shift ;;
            --crit) _dba_need_val "$1" "${2-}" || return 1; crit_s="$2"; shift ;;
            -h|--help) echo "$usage"; return 0 ;;
            --*) _dba_err "Unknown option: $1"; echo "$usage"; return 1 ;;
            *)
                [[ "$mode" == "all" ]] && { _dba_err "Database name cannot be provided together with --all."; return 1; }
                [[ -n "$requested_db" ]] && { _dba_err "Multiple database names provided: $requested_db and $1"; return 1; }
                requested_db="$1"
                mode="single"
                ;;
        esac
        shift
    done
    _dba_check_modes || return 1
    [[ "$warn_s" =~ ^[0-9]+$ && "$crit_s" =~ ^[0-9]+$ ]] || { _dba_err "--warn/--crit must be numbers of seconds"; return 1; }
    [[ -z "$mode" ]] && { _dba_err "You must specify either --all or a database name."; return 1; }

    # Resolve targets (SID|HOME)
    local -a targets=()
    local sid home state line
    if [[ "$mode" == "all" ]]; then
        mapfile -t targets < <(_dba_running_dbs)
        (( ${#targets[@]} )) || { _dba_err "No running databases found."; return 1; }
    else
        while IFS='|' read -r sid home; do
            if [[ "$sid" == "$requested_db" || "$sid" =~ ^"$requested_db"_?[0-9]+$ ]]; then
                targets+=("$sid|$home")
                break
            fi
        done < <(_dba_running_dbs)
        if (( ${#targets[@]} == 0 )); then
            home="$(_dba_oratab_home "$requested_db")"
            if [[ -z "$home" ]]; then
                _dba_err "'$requested_db' is not running and was not found in oratab."
                return 1
            fi
            targets+=("$requested_db|$home")
        fi
    fi

    # Convert broker lag text ("1 minute 5 seconds (computed 1 second ago)") to seconds; -1 = unknown
    _dbdglag_secs() {
        awk -v s="$1" 'BEGIN {
            sub(/\(computed.*$/, "", s)
            if (s !~ /[0-9]/) { print -1; exit }
            n = split(s, w, /[[:space:]]+/); t = 0
            for (i = 1; i < n; i++) if (w[i] ~ /^[0-9]+$/) {
                u = tolower(w[i+1])
                if (u ~ /^day/) t += w[i] * 86400
                else if (u ~ /^hour/) t += w[i] * 3600
                else if (u ~ /^min/) t += w[i] * 60
                else t += w[i]
            }
            print t }'
    }

    local data="SID|DB_ROLE|CONFIG_STATUS|MEMBER|MEMBER_ROLE|TRANSPORT_LAG|APPLY_LAG|LAG_STATUS"
    local overall_rc=0 out db_role broker conf_status member mrole tlag alag ts as worst lstat
    local -a members=()
    local -A m_role=() m_tlag=() m_alag=()

    for line in "${targets[@]}"; do
        IFS='|' read -r sid home <<< "$line"
        if [[ -z "$home" || ! -x "$home/bin/sqlplus" || ! -x "$home/bin/dgmgrl" ]]; then
            data+=$'\n'"$sid|-|ERROR: sqlplus/dgmgrl not found in '${home:-?}'|-|-|-|-|ERROR"
            overall_rc=1
            continue
        fi

        out="$(_dba_sql "$sid" "$home" 2>&1 <<'SQL'
set heading off feedback off pages 0 verify off echo off
whenever sqlerror continue
select 'ROLE|' || database_role || '|' || open_mode from v$database;
exit
SQL
)"
        db_role="$(sed -n 's/^ROLE|//p' <<< "$out" | head -1)"
        if [[ -z "$db_role" ]]; then
            data+=$'\n'"$sid|-|ERROR: database not available|-|-|-|-|ERROR"
            overall_rc=1
            continue
        fi
        db_role="${db_role%%|*}"

        broker="$(_dba_env_run "$sid" "$home" "$home/bin/dgmgrl" -silent / "show configuration lag" 2>&1)"
        if grep -qiE 'syntax error|unknown command|not recognized' <<< "$broker"; then
            # 12c and older: no "lag" keyword - fall back to show configuration + show database
            broker="$(_dba_env_run "$sid" "$home" "$home/bin/dgmgrl" -silent / "show configuration" 2>&1)"
        fi

        if grep -q 'ORA-16532' <<< "$broker"; then
            data+=$'\n'"$sid|$db_role|NO_BROKER|-|-|-|-|-"
            continue
        fi
        if ! grep -q 'Configuration Status' <<< "$broker"; then
            data+=$'\n'"$sid|$db_role|ERROR: $(_dba_clean "$(grep -m1 -E 'ORA-|Error' <<< "$broker" || echo 'broker not available')")|-|-|-|-|ERROR"
            overall_rc=1
            continue
        fi

        conf_status="$(awk '/Configuration Status:/ { getline; print $1; exit }' <<< "$broker")"
        [[ -z "$conf_status" ]] && conf_status="UNKNOWN"

        members=(); m_role=(); m_tlag=(); m_alag=()
        member=""
        while IFS= read -r line; do
            if [[ "$line" =~ ^[[:space:]]*([^[:space:]]+)[[:space:]]+-[[:space:]]+(.*([Dd]atabase|[Ff]ar [Ss]ync|[Ii]nstance).*)$ ]] \
               && [[ "${BASH_REMATCH[1]}" != "Configuration" ]]; then
                member="${BASH_REMATCH[1]}"
                members+=("$member")
                m_role["$member"]="$(sed 's/[[:space:]]*$//' <<< "${BASH_REMATCH[2]}")"
            elif [[ -n "$member" && "$line" =~ Transport[[:space:]]Lag:[[:space:]]*(.*)$ ]]; then
                m_tlag["$member"]="${BASH_REMATCH[1]}"
            elif [[ -n "$member" && "$line" =~ Apply[[:space:]]Lag:[[:space:]]*(.*)$ ]]; then
                m_alag["$member"]="${BASH_REMATCH[1]}"
            fi
        done <<< "$broker"

        for member in "${members[@]}"; do
            mrole="${m_role[$member]}"
            if [[ "$mrole" == *[Pp]rimary* ]]; then
                data+=$'\n'"$sid|$db_role|$conf_status|$member|$(_dba_clean "$mrole")|-|-|PRIMARY"
                continue
            fi
            if [[ -z "${m_tlag[$member]:-}${m_alag[$member]:-}" ]]; then
                local det
                det="$(_dba_env_run "$sid" "$home" "$home/bin/dgmgrl" -silent / "show database '$member'" 2>&1)"
                m_tlag["$member"]="$(sed -n 's/.*Transport Lag:[[:space:]]*//p' <<< "$det" | head -1)"
                m_alag["$member"]="$(sed -n 's/.*Apply Lag:[[:space:]]*//p' <<< "$det" | head -1)"
            fi
            tlag="$(sed 's/[[:space:]]*(computed.*$//; s/[[:space:]]*$//' <<< "${m_tlag[$member]:-}")"
            alag="$(sed 's/[[:space:]]*(computed.*$//; s/[[:space:]]*$//' <<< "${m_alag[$member]:-}")"
            ts="$(_dbdglag_secs "${tlag:-}")"
            as="$(_dbdglag_secs "${alag:-}")"
            worst=$(( ts > as ? ts : as ))
            if (( ts < 0 && as < 0 )); then
                lstat="UNKNOWN"
            elif (( worst >= crit_s )); then
                lstat="CRIT"
                (( overall_rc == 0 )) && overall_rc=2
            elif (( worst >= warn_s )); then
                lstat="WARN"
            else
                lstat="OK"
            fi
            data+=$'\n'"$sid|$db_role|$conf_status|$member|$(_dba_clean "$mrole")|$(_dba_clean "${tlag:-unknown}")|$(_dba_clean "${alag:-unknown}")|$lstat"
        done
        (( ${#members[@]} )) || data+=$'\n'"$sid|$db_role|$conf_status|-|no members parsed|-|-|UNKNOWN"
    done

    _dba_emit "$data"
    return "$overall_rc"
}

