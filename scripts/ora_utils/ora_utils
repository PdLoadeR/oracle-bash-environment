######################################################################

# _dba_asm_instance : "SID|ORACLE_HOME" of the running local ASM instance (empty when none)
_dba_asm_instance() {
    local pid pname sid exe home
    read -r pid pname < <(ps -eo pid=,args= | awk '$2 ~ /^asm_pmon_\+ASM/ { print $1, $2; exit }')
    [[ -z "$pid" ]] && return 1
    sid="${pname#asm_pmon_}"
    exe="$(readlink "/proc/$pid/exe" 2>/dev/null)"; exe="${exe% (deleted)}"
    home=""
    [[ "$exe" == */bin/oracle ]] && home="${exe%/bin/oracle}"
    [[ -z "$home" ]] && home="$(_dba_grid_home)"
    [[ -n "$home" ]] || return 1
    printf '%s|%s\n' "$sid" "$home"
}

# _dba_asm_q : run SQL from stdin in the local ASM instance (SYSASM, then SYSDBA). Prints raw output.
_dba_asm_q() {
    local line sid home sql out
    line="$(_dba_asm_instance)" || { echo "ASM-DBA: no running ASM instance"; return 1; }
    sid="${line%%|*}"; home="${line#*|}"
    [[ -x "$home/bin/sqlplus" ]] || { echo "ASM-DBA: sqlplus not found under $home/bin"; return 1; }
    sql="$(printf '%s\n' "set heading off feedback off pagesize 0 linesize 32767 trimspool on verify off echo off" \
                         "whenever sqlerror continue"; cat; printf '\nexit\n')"
    out="$(printf '%s\n' "$sql" | _dba_env_run "$sid" "$home" "$home/bin/sqlplus" -s -L / as sysasm 2>&1)"
    if grep -qE 'ORA-01017|ORA-01031|ORA-12547|insufficient privileges' <<< "$out"; then
        out="$(printf '%s\n' "$sql" | _dba_env_run "$sid" "$home" "$home/bin/sqlplus" -s -L / as sysdba 2>&1)"
    fi
    printf '%s\n' "$out"
}

# _dba_match_list <value> <comma-separated glob list> : true when value matches any glob
_dba_match_list() {
    local v="$1" p
    local -a pats=()
    IFS=',' read -r -a pats <<< "${2:-}"
    for p in "${pats[@]}"; do
        p="${p#"${p%%[![:space:]]*}"}"; p="${p%"${p##*[![:space:]]}"}"
        [[ -z "$p" ]] && continue
        # shellcheck disable=SC2053
        [[ "$v" == $p ]] && return 0
    done
    return 1
}

# _dba_proc_exes : "PID|EXE" for every process whose binary is readable (one 'find', no per-PID forks)
_dba_proc_exes() {
    find /proc -mindepth 2 -maxdepth 2 -name exe -printf '%h|%l\n' 2>/dev/null \
        | sed -e 's#^/proc/##' -e 's/ (deleted)$//'
}

