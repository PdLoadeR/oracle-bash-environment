    local data sid home out err any=0 row
    if (( summary )); then
        data="DB|SESSIONS|SESS_LIMIT|SESS_PCT|ACTIVE|BLOCKED|PROCESSES|PROC_LIMIT|PROC_PCT|STATUS"
    else
        data="DB|CON|SESSION|USERNAME|STATUS|SQL_ID|EVENT|SECS|BLOCKER|MACHINE|PROGRAM"
    fi
    while IFS='|' read -r sid home; do
        [[ -z "$sid" ]] && continue
        any=1
        if (( summary )); then
            out="$(_dba_q "$sid" "$home" <<'SQL'
select 'ROW|' ||
  (select count(*) from v$session) || '|' ||
  (select value from v$parameter where name = 'sessions') || '|' ||
  (select count(*) from v$session where type = 'USER' and status = 'ACTIVE') || '|' ||
  (select count(*) from v$session where blocking_session is not null) || '|' ||
  (select count(*) from v$process) || '|' ||
  (select value from v$parameter where name = 'processes')
  from dual;
SQL
)"
            row="$(_dba_tag "$out" ROW | head -1)"
            if [[ -z "$row" ]]; then
                err="$(_dba_qerr "$out")"
                data+=$'\n'"$sid|-|-|-|-|-|-|-|-|ERROR: $(_dba_clean "${err:-no output}")"
                continue
            fi
            data+=$'\n'"$(awk -F'|' -v OFS='|' -v s="$sid" -v w="$warn" -v c="$crit" '{
                sp = ($2 > 0) ? 100 * $1 / $2 : 0
                pp = ($6 > 0) ? 100 * $5 / $6 : 0
                m = (sp > pp) ? sp : pp
                st = (m >= c) ? "CRIT" : (m >= w) ? "WARN" : "OK"
                print s, $1, $2, sprintf("%.1f", sp), $3, $4, $5, $6, sprintf("%.1f", pp), st }' <<< "$row")"
        else
            out="$(_dba_q "$sid" "$home" <<SQL
select 'ROW|' || nvl((select c.name from v\$containers c where c.con_id = s.con_id), '-') || '|' ||
       s.sid || ',' || s.serial# || '|' || nvl(s.username, '(' || s.type || ')') || '|' || s.status || '|' ||
       nvl(s.sql_id, '-') || '|' ||
       decode(s.state, 'WAITING', replace(s.event, '|', '/'), 'ON CPU') || '|' ||
       s.last_call_et || '|' ||
       nvl2(s.blocking_session, s.blocking_instance || ':' || s.blocking_session, '-') || '|' ||
       replace(nvl(s.machine, '-'), '|', '/') || '|' || replace(nvl(s.program, '-'), '|', '/')
  from v\$session s
 where s.type = 'USER'
   and s.sid <> to_number(sys_context('USERENV', 'SID'))
   and ($all = 1 or s.status = 'ACTIVE')
   and s.last_call_et >= $min_secs
 order by s.last_call_et desc;
select 'OK|done' from dual;
SQL
)"
            if ! grep -q '^OK|done' <<< "$out"; then
                err="$(_dba_qerr "$out")"
                data+=$'\n'"$sid|-|-|-|ERROR: $(_dba_clean "${err:-no output}")|-|-|-|-|-|-"
                continue
            fi
            while IFS= read -r row; do
                [[ -n "$row" ]] && data+=$'\n'"$sid|$row"
            done < <(_dba_tag "$out" ROW)
        fi
    done < <(_dba_up_targets "$dbre")
    (( any )) || { _dba_err "No running databases found${dbre:+ matching '$dbre'}."; return 1; }
    _dba_emit "$data"
}

# DESC: Blocking session chains (who blocks whom) for all running databases
function dbblock() {
    local dbre="" kill_sql=0
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc
    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --kill-sql) kill_sql=1 ;;
            --db)       _dba_need_val "$1" "${2-}" || return 1; dbre="$2"; shift ;;
            -h|--help)
                cat <<'EOF'
Usage: dbblock [--kill-sql] [--db REGEX] [--grep PATTERN] [--grep-v PATTERN]
               [--csv|--json|--raw] [--no-header] [--no-color]

Blocking chains from gv$session (RAC-aware): every root blocker followed by the
sessions waiting on it ('`->' marks the level in the chain).

Columns:
  DB, ROLE (BLOCKER / WAITER), SESSION (inst:sid,serial#), USERNAME, STATUS, SQL_ID,
  EVENT, WAIT_SECS, LAST_CALL_SECS, MACHINE, PROGRAM

Options:
  --kill-sql     Also print ALTER SYSTEM KILL SESSION statements for the root blockers.
                 Nothing is executed - review and run them yourself.
  --db REGEX     Only query SIDs matching REGEX (case-insensitive)
  --grep / --grep-v, --csv|--json|--raw, --no-header, --no-color

Return code: 0 = no blocking, 2 = blocking found, 1 = error

Examples:
  dbblock
  dbblock --kill-sql
EOF
                return 0
                ;;
            *) _dba_err "Unknown option: $1 (see dbblock --help)"; return 1 ;;
        esac
        shift
    done
    _dba_check_modes || return 1

    local data="DB|ROLE|SESSION|USERNAME|STATUS|SQL_ID|EVENT|WAIT_SECS|LAST_CALL_SECS|MACHINE|PROGRAM"
    local sid home out err row any=0 found=0 overall=0 kills=""
    while IFS='|' read -r sid home; do
        [[ -z "$sid" ]] && continue
        any=1
        out="$(_dba_q "$sid" "$home" <<'SQL'
select 'ROW|' || decode(level, 1, 'BLOCKER', rpad('`', 2 * (level - 1) - 1, '-') || '> WAITER') || '|' ||
       s.inst_id || ':' || s.sid || ',' || s.serial# || '|' || nvl(s.username, '(' || s.program || ')') || '|' ||
       s.status || '|' || nvl(s.sql_id, '-') || '|' ||
       decode(s.state, 'WAITING', replace(s.event, '|', '/'), 'ON CPU') || '|' ||
       decode(s.state, 'WAITING', round(s.wait_time_micro / 1000000), 0) || '|' || s.last_call_et || '|' ||
       replace(nvl(s.machine, '-'), '|', '/') || '|' || replace(nvl(s.program, '-'), '|', '/')
  from gv$session s
 start with s.blocking_session is null
        and exists (select 1 from gv$session w
                     where w.blocking_session = s.sid and w.blocking_instance = s.inst_id)
connect by nocycle prior s.sid = s.blocking_session and prior s.inst_id = s.blocking_instance;
select 'OK|done' from dual;
SQL
)"
        if ! grep -q '^OK|done' <<< "$out"; then
            err="$(_dba_qerr "$out")"
            data+=$'\n'"$sid|ERROR: $(_dba_clean "${err:-no output}")|-|-|-|-|-|-|-|-|-"
            overall=1
            continue
        fi
        while IFS= read -r row; do
            [[ -z "$row" ]] && continue
            found=1
            data+=$'\n'"$sid|$row"
            if [[ "$row" == BLOCKER\|* ]]; then
                local sess="${row#BLOCKER|}"; sess="${sess%%|*}"
                kills+="-- $sid: blocker ${sess}"$'\n'"ALTER SYSTEM KILL SESSION '${sess#*:},@${sess%%:*}' IMMEDIATE;"$'\n'
            fi
        done < <(_dba_tag "$out" ROW)
    done < <(_dba_up_targets "$dbre")
    (( any )) || { _dba_err "No running databases found${dbre:+ matching '$dbre'}."; return 1; }

    if (( ! found )) && (( overall == 0 )); then
        echo "No blocking sessions found."
        return 0
    fi
    _dba_emit "$data"
    if (( kill_sql )) && [[ -n "$kills" ]]; then
        echo
        echo "-- Review before running (connect to the database shown in each comment):"
        printf '%s' "$kills"
    fi
    (( found )) && (( overall == 0 )) && overall=2
    return "$overall"
}

# DESC: ORA- errors from all database alert logs within a time window (summary or detail)
function dbalert() {
    local since="24h" detail=0 pattern='ORA-[0-9]+' max=200 dbre=""
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc
    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --since)   _dba_need_val "$1" "${2-}" || return 1; since="$2"; shift ;;
            --detail)  detail=1 ;;
            --pattern) _dba_need_val "$1" "${2-}" || return 1; pattern="$2"; shift ;;
            --max)     _dba_need_val "$1" "${2-}" || return 1; max="$2"; shift ;;
            --db)      _dba_need_val "$1" "${2-}" || return 1; dbre="$2"; shift ;;
            -h|--help)
                cat <<'EOF'
Usage: dbalert [--since 24h] [--detail] [--pattern REGEX] [--max N] [--db REGEX]
               [--grep PATTERN] [--grep-v PATTERN] [--csv|--json|--raw] [--no-header] [--no-color]

Scans the alert log of every database on the host (running instances and DOWN
oratab entries) for errors logged within the time window. The file is read
backwards, so only the requested window is processed even for very large logs.

Summary (default): DB, CODE, COUNT, FIRST, LAST, SAMPLE   (one row per DB and error code)
--detail:          DB, TIME, CODE, MESSAGE                (one row per error line)

Options:
  --since DUR       Window: 30m, 2h, 1d, ... (plain number = hours; default: 24h)
  --detail          One row per error line instead of a summary
  --pattern REGEX   Error pattern (extended regex, default: 'ORA-[0-9]+').
                    Example: 'ORA-[0-9]+|TNS-[0-9]+|Checkpoint not complete'
  --max N           Detail: maximum lines per database, newest kept (default: 200)
  --db REGEX        Only scan SIDs matching REGEX (case-insensitive)
  --grep / --grep-v Filter output rows, e.g.  --grep-v 'ORA-(3136|609)'
  --csv|--json|--raw, --no-header, --no-color

Notes:
  - Both alert log timestamp formats are understood (12.2+ ISO and the older
    'Wed Nov 13 10:00:00 2026' format). Times are compared in the server's local time.

Return code: 0 = no errors in window, 2 = errors found, 1 = problem reading logs

Examples:
  dbalert
  dbalert --since 2h --detail
  dbalert --since 7d --grep ORA-00600
  dbalert --pattern 'ORA-[0-9]+|Checkpoint not complete' --grep-v 'ORA-3136'
EOF
                return 0
                ;;
            *) _dba_err "Unknown option: $1 (see dbalert --help)"; return 1 ;;
        esac
        shift
    done
    _dba_check_modes || return 1
    local secs cutoff
    secs="$(_dba_dur_secs "$since")"
    [[ -n "$secs" ]] || { _dba_err "Invalid --since value: $since (examples: 30m, 2h, 1d)"; return 1; }
    [[ "$max" =~ ^[1-9][0-9]*$ ]] || { _dba_err "--max must be a positive number"; return 1; }
    cutoff=$(( $(date +%s) - secs ))

    local data sid home state alert any=0 found=0 overall=0 rows line
    if (( detail )); then data="DB|TIME|CODE|MESSAGE"; else data="DB|CODE|COUNT|FIRST|LAST|SAMPLE"; fi
    while IFS='|' read -r sid home state; do
        [[ -z "$sid" ]] && continue
        if [[ -n "$dbre" ]]; then
            [[ "$(_dba_filter_rows "H"$'\n'"$sid" "$dbre" "")" == *$'\n'* ]] || continue
        fi
        any=1
        alert="$(_dba_alert_log "$sid" "$home")"
        if [[ -z "$alert" && "$state" != "UP" ]]; then
            _dba_warn "$sid is down and no alert log was found - skipped"
            continue
        fi
        if [[ -z "$alert" ]]; then
            if (( detail )); then data+=$'\n'"$sid|-|ERROR|alert log not found"; else data+=$'\n'"$sid|ERROR|-|-|-|alert log not found"; fi
            overall=1
            continue
        fi
        rows="$(tac "$alert" 2>/dev/null | awk -v cut="$cutoff" -v pat="$pattern" -v max="$max" '
            BEGIN {
                split("Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec", mn, " ")
                for (i = 1; i <= 12; i++) mon[mn[i]] = i
            }
            function emit_pending(ts, tstr,   i) {
                for (i = 1; i <= np; i++) {
                    if (++cnt > max) continue
                    out[cnt] = tstr "|" pend[i]
                }
                np = 0
            }
            {
                ts = -1
                if ($0 ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]/) {
                    ts = mktime(substr($0, 1, 4) " " substr($0, 6, 2) " " substr($0, 9, 2) " " \
                                substr($0, 12, 2) " " substr($0, 15, 2) " " substr($0, 18, 2))
                    tstr = substr($0, 1, 10) " " substr($0, 12, 8)
                } else if ($0 ~ /^(Mon|Tue|Wed|Thu|Fri|Sat|Sun) (Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) +[0-9]+ [0-9][0-9]:[0-9][0-9]:[0-9][0-9] [0-9][0-9][0-9][0-9]$/) {
                    split($0, a, /[ :]+/)
                    ts = mktime(a[7] " " mon[a[2]] " " a[3] " " a[4] " " a[5] " " a[6])
                    tstr = sprintf("%04d-%02d-%02d %s:%s:%s", a[7], mon[a[2]], a[3], a[4], a[5], a[6])
                }
                if (ts >= 0) {
                    if (ts < cut) exit
                    if (np > 0) emit_pending(ts, tstr)
                    next
                }
                if (match($0, pat)) {
                    code = substr($0, RSTART, RLENGTH)
                    msg = $0
                    gsub(/\|/, "/", msg); gsub(/\r/, "", msg)
                    if (length(msg) > 160) msg = substr(msg, 1, 157) "..."
                    pend[++np] = code "|" msg
                }
            }
            END { for (i = (cnt > max ? max : cnt); i >= 1; i--) print out[i] }')"
        [[ -z "$rows" ]] && continue
        found=1
        if (( detail )); then
            while IFS= read -r line; do data+=$'\n'"$sid|$line"; done <<< "$rows"
        else
            data+=$'\n'"$(awk -F'|' -v OFS='|' -v s="$sid" '
                {
                    c = $2
                    if (!(c in n)) { order[++k] = c; first[c] = $1; sample[c] = $3 }
                    n[c]++; last[c] = $1
                }
                END { for (i = 1; i <= k; i++) { c = order[i]; print s, c, n[c], first[c], last[c], sample[c] } }
            ' <<< "$rows")"
        fi
    done < <(_dba_db_targets | sort -t'|' -k1,1)
    (( any )) || { _dba_err "No databases found${dbre:+ matching '$dbre'}."; return 1; }
    if (( ! found )) && (( overall == 0 )); then
        echo "No errors matching '$pattern' in the last $since."
        return 0
    fi
    _dba_emit "$data"
    (( found )) && (( overall == 0 )) && overall=2
    return "$overall"
}

# DESC: Locked, expired, soon-to-expire and default-password accounts (CDB, every PDB and the ASM password file)
function dbusers() {
    local days=14 all=0 dbre="" watch="DBSNMP" asm=1
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc
    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --days)   _dba_need_val "$1" "${2-}" || return 1; days="$2"; shift ;;
            --all)    all=1 ;;
            --watch)  _dba_need_val "$1" "${2-}" || return 1; watch="DBSNMP,$2"; shift ;;
            --no-asm) asm=0 ;;
            --db)     _dba_need_val "$1" "${2-}" || return 1; dbre="$2"; shift ;;
            -h|--help)
                cat <<'EOF'
Usage: dbusers [--days N] [--all] [--watch USER1,USER2] [--no-asm] [--db REGEX]
               [--grep PATTERN] [--grep-v PATTERN] [--csv|--json|--raw] [--no-header] [--no-color]

Account health for:
  - the local ASM instance (users in the ASM password file, v$pwfile_users) - listed FIRST
  - every running database: CDB$ROOT (common users) and every OPEN PDB (local and
    common users as seen inside the PDB), or the non-CDB itself
By default only accounts that need attention are shown, plus the watch-list accounts.

STATUS rules (first match wins):
  CRIT  account status LOCKED(TIMED)        (locked by failed logins)
  WARN  account status EXPIRED(GRACE)       (in the grace period)
  CRIT  account status EXPIRED
  CRIT  OPEN account with a default password (CDB_USERS_WITH_DEFPWD, per container)
  WARN  account status LOCKED                (CRIT for watch-list accounts)
  CRIT  OPEN and the password expires today or has passed its expiry date
  WARN  OPEN and the password expires within --days
  OK    otherwise
ASM:
  WARN  ASMSNMP (OEM monitoring of ASM) is not in the ASM password file
  The rules above are applied when the ASM version reports ACCOUNT_STATUS (12.2+).
Containers:
  WARN  a PDB that is not OPEN (its users cannot be checked)

Accounts checked: all non Oracle-maintained users + the watch list
(default watch list: DBSNMP; ASMSNMP is always watched in ASM).

Options:
  --days N          Expiry warning window in days (default: 14)
  --all             Show every checked account, including OK ones
  --watch U1,U2     Add accounts to the watch list (always shown), e.g. C##MONITOR,OGG_ADMIN
  --no-asm          Skip the ASM password file
  --db REGEX        Only query SIDs matching REGEX (case-insensitive; ASM is always checked
                    unless --no-asm)
  --grep / --grep-v, --csv|--json|--raw, --no-header, --no-color

Notes:
  - PROFILE shows the profile for database users and the administrative privileges
    (SYSASM, SYSDBA, ...) for ASM password file users.
  - MOUNTED standbys are skipped (dictionary views need an OPEN database).

Return code: 0 = nothing CRIT, 2 = at least one CRIT, 1 = error

Examples:
  dbusers
  dbusers --days 30 --watch C##OGG_ADMIN
  dbusers --all --grep APP_
  dbusers --all --grep '^\+ASM'
EOF
                return 0
                ;;
            *) _dba_err "Unknown option: $1 (see dbusers --help)"; return 1 ;;
        esac
        shift
    done
    _dba_check_modes || return 1
    [[ "$days" =~ ^[0-9]+$ ]] || { _dba_err "--days must be a whole number"; return 1; }
    [[ "$watch" =~ ^[A-Za-z0-9_#$,]+$ ]] || { _dba_err "--watch: invalid user list"; return 1; }

    local inlist
    inlist="'$(tr '[:lower:]' '[:upper:]' <<< "$watch" | sed "s/,/','/g")'"

    # Status rules shared by ASM and database rows.
    # Input : DB|CON|USERNAME|ACCOUNT_STATUS|EXPIRY|DAYS_LEFT|LOCK_DATE|PROFILE|WATCH(Y/N)|DEFPWD(Y/N)
    _dbusers_rules() {
        awk -F'|' -v OFS='|' -v d="$days" -v all="$all" '
            {
                u = $3; a = $4; dl = $6; w = $9; dp = $10
                isopen = (a == "OPEN")
                st = "OK"
                if      (a ~ /LOCKED\(TIMED\)/)                st = "CRIT (locked by failed logins)"
                else if (a ~ /^EXPIRED\(GRACE\)/)              st = "WARN (password in grace period)"
                else if (a ~ /EXPIRED/)                        st = "CRIT (password expired)"
                else if (isopen && dp == "Y")                  st = "CRIT (default password)"
                else if (a ~ /LOCKED/)                         st = (w == "Y") ? "CRIT (watch-list account locked)" : "WARN (locked)"
                else if (isopen && dl != "-" && dl + 0 <= 0)   st = "CRIT (expires today)"
                else if (isopen && dl != "-" && dl + 0 <= d)   st = "WARN (expires in " dl " days)"
                if (st == "OK" && !all && w != "Y") next
                print $1, $2, u, a, $5, dl, $7, $8, st
            }'
    }

    local data="DB|CON|USERNAME|ACCOUNT_STATUS|EXPIRY_DATE|DAYS_LEFT|LOCK_DATE|PROFILE|STATUS"
    local sid home out err om any=0 overall=0 rows asmline

    # ASM password file users first
    if (( asm )) && asmline="$(_dba_asm_instance)"; then
        local asid="${asmline%%|*}"
        out="$(_dba_asm_q <<'SQL'
select 'ROW|' || username || '|' || nvl(account_status, 'OPEN') || '|' ||
       nvl(to_char(expiry_date, 'YYYY-MM-DD'), '-') || '|' ||
       nvl(to_char(trunc(expiry_date) - trunc(sysdate)), '-') || '|' ||
       nvl(to_char(lock_date, 'YYYY-MM-DD HH24:MI'), '-') || '|' ||
       rtrim(decode(sysasm, 'TRUE', 'SYSASM,') || decode(sysdba, 'TRUE', 'SYSDBA,') ||
             decode(sysoper, 'TRUE', 'SYSOPER,'), ',')
  from v$pwfile_users order by username;
SQL
)"
        if ! grep -q '^ROW|' <<< "$out"; then
            # Before 12.2 v$pwfile_users has no account_status / expiry_date / lock_date
            out="$(_dba_asm_q <<'SQL'
select 'ROW|' || username || '|OPEN|-|-|-|' ||
       rtrim(decode(sysasm, 'TRUE', 'SYSASM,') || decode(sysdba, 'TRUE', 'SYSDBA,') ||
             decode(sysoper, 'TRUE', 'SYSOPER,'), ',')
  from v$pwfile_users order by username;
SQL
)"
        fi
        if grep -q '^ROW|' <<< "$out"; then
            rows="$(_dba_tag "$out" ROW | awk -F'|' -v OFS='|' -v s="$asid" '
                    { w = ($1 == "ASMSNMP" || $1 == "SYS") ? "Y" : "N"; print s, "-", $1, $2, $3, $4, $5, $6, w, "N" }' | _dbusers_rules)"
            [[ -n "$rows" ]] && data+=$'\n'"$rows"
            if ! _dba_tag "$out" ROW | grep -q '^ASMSNMP|'; then
                data+=$'\n'"$asid|-|ASMSNMP|-|-|-|-|-|WARN (not in the ASM password file)"
            fi
        else
            err="$(_dba_qerr "$out")"
            data+=$'\n'"$asid|-|-|-|-|-|-|-|ERROR: $(_dba_clean "${err:-cannot query v\$pwfile_users}")"
            overall=1
        fi
    fi

    while IFS='|' read -r sid home; do
        [[ -z "$sid" ]] && continue
        any=1
        out="$(_dba_q "$sid" "$home" <<SQL
select 'OM|' || open_mode || '|' || cdb from v\$database;
select 'PDB|' || name || '|' || open_mode from v\$pdbs where name <> 'PDB\$SEED' and open_mode not like 'READ%';
select 'DP|' || con_id || '|' || username from cdb_users_with_defpwd;
select 'ROW|' || nvl((select c.name from v\$containers c where c.con_id = u.con_id), '-') || '|' ||
       u.username || '|' || u.account_status || '|' ||
       nvl(to_char(u.expiry_date, 'YYYY-MM-DD'), '-') || '|' ||
       nvl(to_char(trunc(u.expiry_date) - trunc(sysdate)), '-') || '|' ||
       nvl(to_char(u.lock_date, 'YYYY-MM-DD HH24:MI'), '-') || '|' || u.profile || '|' ||
       case when u.username in ($inlist) then 'Y' else 'N' end || '|' || u.con_id
  from cdb_users u
 where u.oracle_maintained = 'N' or u.username in ($inlist)
 order by u.con_id, u.username;
SQL
)"
        om="$(_dba_tag "$out" OM | head -1)"
        if [[ -z "$om" ]]; then
            err="$(_dba_qerr "$out")"
            data+=$'\n'"$sid|-|-|-|-|-|-|-|ERROR: $(_dba_clean "${err:-no output}")"
            overall=1
            continue
        fi
        if [[ "${om%%|*}" != READ* ]]; then
            data+=$'\n'"$sid|-|-|-|-|-|-|-|SKIPPED (${om%%|*})"
            continue
        fi
        local dplist
        if grep -q '^DP|' <<< "$out" || ! grep -qE 'ORA-0*942' <<< "$out"; then
            dplist="$(_dba_tag "$out" DP | sed 's/[[:space:]]*$//' | paste -sd, -)"
        else
            # cdb_users_with_defpwd not available: fall back to the current container only
            dplist="$(_dba_q "$sid" "$home" <<< "select 'DP|0|' || username from dba_users_with_defpwd;" | sed -n 's/^DP|//p' | paste -sd, -)"
        fi
        rows="$(_dba_tag "$out" ROW | awk -F'|' -v OFS='|' -v s="$sid" -v dpl="$dplist" '
                BEGIN { n = split(dpl, t, ","); for (i = 1; i <= n; i++) { split(t[i], x, "|"); dp[x[1] "|" x[2]] = 1; dp0[x[2]] = 1 } }
                {
                    isdp = ((($9 "|" $2) in dp) || (("0|" $2) in dp && $9 <= 1)) ? "Y" : "N"
                    print s, $1, $2, $3, $4, $5, $6, $7, $8, isdp
                }' | _dbusers_rules)"
        [[ -n "$rows" ]] && data+=$'\n'"$rows"
        while IFS='|' read -r pdbn pom; do
            [[ -z "$pdbn" ]] && continue
            data+=$'\n'"$sid|$(sed 's/[[:space:]]*$//' <<< "$pdbn")|-|-|-|-|-|-|WARN (PDB is $pom - not checked)"
        done < <(_dba_tag "$out" PDB)
    done < <(_dba_up_targets "$dbre")
    (( any )) || [[ -n "${asmline:-}" ]] || { _dba_err "No running databases found${dbre:+ matching '$dbre'}."; return 1; }
    grep -q '|CRIT' <<< "$data" && (( overall == 0 )) && overall=2
    if [[ "$data" != *$'\n'* ]]; then
        echo "No account issues found (use --all to list every account)."
        return 0
    fi
    _dba_emit "$data"
    return "$overall"
}
# DESC: Compare init parameters side by side across all running databases (and their PDBs)
function dbparam() {
    local diff_only=0 nondefault=0 hidden=0 dbre="" pdbs=0 pdbre="" width=40
    local -a names=()
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc
    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --diff)       diff_only=1 ;;
            --nondefault) nondefault=1 ;;
            --hidden)     hidden=1 ;;
            --pdbs)       pdbs=1 ;;
            --pdb)        _dba_need_val "$1" "${2-}" || return 1; pdbs=1; pdbre="$2"; shift ;;
            --width)
                _dba_need_val "$1" "${2-}" || return 1
                [[ "$2" =~ ^[0-9]+$ ]] && (( $2 == 0 || $2 >= 10 )) || { _dba_err "--width must be 0 (no wrapping) or 10 and more"; return 1; }
                width="$2"; shift
                ;;
            --db)         _dba_need_val "$1" "${2-}" || return 1; dbre="$2"; shift ;;
            -h|--help)
                cat <<'EOF'
Usage: dbparam [PARAM|PATTERN ...] [--nondefault] [--hidden] [--diff] [--pdbs | --pdb REGEX]
               [--width N] [--db REGEX] [--grep PATTERN] [--grep-v PATTERN]
               [--csv|--json|--raw] [--no-header] [--no-color]

Shows parameters side by side: one row per parameter, one column per database
(and per PDB with --pdbs), plus SAME = MATCH / DIFF.
Values come from v$system_parameter (display_value).

Selecting parameters (at least one is required):
  PARAM            Exact name, e.g. processes sga_target
  PATTERN          SQL LIKE pattern, e.g. 'pga%'  'db_%size'
  --nondefault     Every parameter explicitly set (isdefault = FALSE)
  --hidden         Every underscore (_) parameter that is set

Options:
  --diff           Only show parameters whose values differ between the columns
  --pdbs           Add one column per OPEN PDB, named SID/PDB (value seen inside the PDB,
                   i.e. the PDB's own setting or the value inherited from CDB$ROOT)
  --pdb REGEX      Like --pdbs, but only PDBs whose name matches REGEX
  --width N        Table mode only: wrap values longer than N characters at spaces
                   (default: 40, 0 = no wrapping). CSV/JSON/raw output is never wrapped.
  --db REGEX       Only query SIDs matching REGEX (case-insensitive)
  --grep / --grep-v, --csv|--json|--raw, --no-header, --no-color

Notes:
  - '-' means the parameter is not set / not present in that database or PDB.
  - The SID column of a CDB shows the CDB$ROOT value.
  - Non-CDBs simply have no SID/PDB columns.

Examples:
  dbparam processes sessions sga_target pga_aggregate_target
  dbparam 'pga%' 'sga%'
  dbparam control_files 'log_archive_dest_%'
  dbparam --nondefault --diff
  dbparam --hidden --pdbs
  dbparam open_cursors --pdb '^APP'
EOF
                return 0
                ;;
            -*) _dba_err "Unknown option: $1 (see dbparam --help)"; return 1 ;;
            *)
                [[ "$1" =~ ^[A-Za-z0-9_%#$.]+$ ]] || { _dba_err "Invalid parameter name/pattern: $1"; return 1; }
                names+=("${1,,}")
                ;;
        esac
        shift
    done
    _dba_check_modes || return 1
    if (( ${#names[@]} == 0 && ! nondefault && ! hidden )); then
        _dba_err "Give at least one parameter name/pattern, --nondefault or --hidden (see dbparam --help)."
        return 1
    fi

    local cond="" n
    for n in "${names[@]}"; do
        if [[ "$n" == *%* ]]; then cond+="${cond:+ or }name like '$n'"; else cond+="${cond:+ or }name = '$n'"; fi
    done
    (( nondefault )) && cond+="${cond:+ or }isdefault = 'FALSE'"
    (( hidden ))     && cond+="${cond:+ or }(name like '\_%' escape '\' and isdefault = 'FALSE')"
    local psql_tpl="select '__TAG__|' || name || '|' || nvl(replace(replace(display_value, '|', '/'), chr(10), ' '), '(null)')
  from v\$system_parameter where ($cond) order by name;"
    local psql="${psql_tpl/__TAG__/ROW}"

    local sid home out err any=0 long="" pdb pscript
    local -a cols=() plist=()
    while IFS='|' read -r sid home; do
        [[ -z "$sid" ]] && continue
        any=1
        pscript="$psql"$'\n'"select 'OK|done' from dual;"
        if (( pdbs )); then
            pscript+=$'\n'"select 'PDB|' || name from v\$pdbs where open_mode like 'READ%' and name <> 'PDB\$SEED' order by con_id;"
        fi
        out="$(_dba_q "$sid" "$home" <<< "$pscript")"
        if ! grep -q '^OK|done' <<< "$out"; then
            err="$(_dba_qerr "$out")"
            _dba_warn "$sid: $(_dba_clean "${err:-no output}")"
            continue
        fi
        cols+=("$sid")
        long+="$(_dba_tag "$out" ROW | sed "s/^/$sid|/")"$'\n'
        if (( pdbs )); then
            mapfile -t plist < <(_dba_tag "$out" PDB | sed 's/[[:space:]]*$//')
            pscript=""
            for pdb in "${plist[@]}"; do
                [[ -z "$pdb" ]] && continue
                if [[ -n "$pdbre" ]]; then
                    [[ "$(_dba_filter_rows "H"$'\n'"$pdb" "$pdbre" "")" == *$'\n'* ]] || continue
                fi
                cols+=("$sid/$pdb")
                pscript+="alter session set container = \"$pdb\";"$'\n'"${psql_tpl/__TAG__/P|$pdb}"$'\n'
            done
            if [[ -n "$pscript" ]]; then
                out="$(_dba_q "$sid" "$home" <<< "$pscript")"
                long+="$(sed -n "s#^P|\\([^|]*\\)|#$sid/\\1|#p" <<< "$out")"$'\n'
            fi
        fi
    done < <(_dba_up_targets "$dbre")
    (( any )) || { _dba_err "No running databases found${dbre:+ matching '$dbre'}."; return 1; }
    (( ${#cols[@]} )) || { _dba_err "No database could be queried."; return 1; }

    local data
    data="$(awk -F'|' -v OFS='|' -v cols="$(IFS=,; echo "${cols[*]}")" -v d="$diff_only" '
        BEGIN { nc = split(cols, c, ",") }
        NF >= 3 {
            v = $3; for (i = 4; i <= NF; i++) v = v "/" $i
            if (!($2 in seen)) { seen[$2] = 1; p[++np] = $2 }
            val[$2, $1] = v
        }
        END {
            h = "PARAMETER"; for (i = 1; i <= nc; i++) h = h OFS c[i]; print h OFS "SAME"
            n = asort(p)
            for (k = 1; k <= n; k++) {
                q = p[k]; line = q; same = 1; first = ""
                for (i = 1; i <= nc; i++) {
                    x = ((q, c[i]) in val) ? val[q, c[i]] : "-"
                    line = line OFS x
                    if (i == 1) first = x; else if (x != first) same = 0
                }
                if (d && same) continue
                print line OFS (same ? "MATCH" : "DIFF")
            }
        }' <<< "$long")"
    if [[ "$data" != *$'\n'* ]]; then
        if (( diff_only )); then echo "No differences found."; else echo "No matching parameters found."; fi
        return 0
    fi
    data="$(_dba_filter_rows "$data" "$_o_grep" "$_o_grepv")"
    if [[ "$_o_mode" == table ]] && (( width > 0 )); then
        data="$(_dba_wrap_cols "$data" "$width" 2)"
    fi
    _dba_render "$_o_mode" "$_o_nohdr" "$data"
}
# DESC: Failed or broken scheduler jobs within a time window (detail or per-job summary)
function dbjobs() {
    local hours=24 summary=0 dbre=""
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc
    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --hours)   _dba_need_val "$1" "${2-}" || return 1; hours="$2"; shift ;;
            --summary) summary=1 ;;
            --db)      _dba_need_val "$1" "${2-}" || return 1; dbre="$2"; shift ;;
            -h|--help)
                cat <<'EOF'
Usage: dbjobs [--hours N] [--summary] [--db REGEX]
              [--grep PATTERN] [--grep-v PATTERN] [--csv|--json|--raw] [--no-header] [--no-color]

Scheduler job runs that did not succeed (CDB_SCHEDULER_JOB_RUN_DETAILS) within
the window, plus jobs currently BROKEN (scheduler) and broken DBMS_JOB jobs.

Detail (default): DB, CON, OWNER, JOB_NAME, STATUS, LOG_DATE, ERROR#, DETAIL
--summary:        DB, CON, OWNER, JOB_NAME, FAILURES, LAST_FAILURE, LAST_ERROR#

Options:
  --hours N      Look-back window in hours (default: 24)
  --summary      One row per job with the failure count
  --db REGEX     Only query SIDs matching REGEX (case-insensitive)
  --grep / --grep-v  Filter rows, e.g. --grep-v 'ORA\$AT_'  (hide automatic maintenance jobs)
  --csv|--json|--raw, --no-header, --no-color

Return code: 0 = none found, 2 = failures found, 1 = error

Examples:
  dbjobs
  dbjobs --hours 168 --summary
  dbjobs --grep-v 'ORA\$AT_'
EOF
                return 0
                ;;
            *) _dba_err "Unknown option: $1 (see dbjobs --help)"; return 1 ;;
        esac
        shift
    done
    _dba_check_modes || return 1
    [[ "$hours" =~ ^[1-9][0-9]*$ ]] || { _dba_err "--hours must be a positive number"; return 1; }

    local data="DB|CON|OWNER|JOB_NAME|STATUS|LOG_DATE|ERROR#|DETAIL"
    local sid home out err om any=0 overall=0 rows
    while IFS='|' read -r sid home; do
        [[ -z "$sid" ]] && continue
        any=1
        out="$(_dba_q "$sid" "$home" <<SQL
select 'OM|' || open_mode from v\$database;
select 'ROW|' || nvl((select c.name from v\$containers c where c.con_id = d.con_id), '-') || '|' ||
       d.owner || '|' || d.job_name || '|' || d.status || '|' ||
       to_char(d.log_date, 'YYYY-MM-DD HH24:MI') || '|' || d.error# || '|' ||
       replace(replace(replace(to_char(substr(d.additional_info, 1, 150)), chr(10), ' '), chr(13), ''), '|', '/')
  from cdb_scheduler_job_run_details d
 where d.log_date > systimestamp - numtodsinterval($hours, 'HOUR')
   and d.status <> 'SUCCEEDED'
 order by d.log_date desc;
select 'ROW|' || nvl((select c.name from v\$containers c where c.con_id = j.con_id), '-') || '|' ||
       j.owner || '|' || j.job_name || '|BROKEN|' ||
       nvl(to_char(j.last_start_date, 'YYYY-MM-DD HH24:MI'), '-') || '|-|failure_count=' || j.failure_count
  from cdb_scheduler_jobs j
 where j.state = 'BROKEN';
select 'ROW|-|' || schema_user || '|DBMS_JOB ' || job || '|BROKEN|' ||
       nvl(to_char(last_date, 'YYYY-MM-DD HH24:MI'), '-') || '|-|failures=' || failures
  from dba_jobs
 where broken = 'Y';
SQL
)"
        om="$(_dba_tag "$out" OM | head -1)"
        if [[ -z "$om" ]]; then
            err="$(_dba_qerr "$out")"
            data+=$'\n'"$sid|-|-|-|ERROR: $(_dba_clean "${err:-no output}")|-|-|-"
            overall=1
            continue
        fi
        if [[ "$om" != READ* ]]; then
            data+=$'\n'"$sid|-|-|-|SKIPPED ($om)|-|-|-"
            continue
        fi
        rows="$(_dba_tag "$out" ROW | sed "s/^/$sid|/")"
        [[ -n "$rows" ]] && data+=$'\n'"$rows"
    done < <(_dba_up_targets "$dbre")
    (( any )) || { _dba_err "No running databases found${dbre:+ matching '$dbre'}."; return 1; }

    local real
    real="$(awk -F'|' 'NR > 1 && $5 !~ /^(SKIPPED|ERROR)/ { n++ } END { print n + 0 }' <<< "$data")"
    if [[ "$data" != *$'\n'* ]]; then
        echo "No failed or broken jobs in the last ${hours}h."
        return 0
    fi
    if (( summary )); then
        data="$(awk -F'|' -v OFS='|' '
            NR == 1 { print "DB|CON|OWNER|JOB_NAME|FAILURES|LAST_FAILURE|LAST_ERROR#"; next }
            $5 ~ /^(SKIPPED|ERROR)/ { k = $1 OFS $2 OFS $3 OFS $4; order[++m] = k; n[k] = $5; last[k] = "-"; le[k] = "-"; skip[k] = 1; next }
            {
                k = $1 OFS $2 OFS $3 OFS $4
                if (!(k in n)) { order[++m] = k; last[k] = $6; le[k] = $7 }
                n[k]++
            }
            END { for (i = 1; i <= m; i++) print order[i], n[order[i]], last[order[i]], le[order[i]] }' <<< "$data")"
    fi
    (( real > 0 && overall == 0 )) && overall=2
    _dba_emit "$data"
    return "$overall"
}

