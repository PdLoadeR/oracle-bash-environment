            -h|--help)
                cat <<'EOF'
Usage: dbash [--minutes N] [--top N] [--by event|sql|both] [--force] [--db REGEX]
             [--grep PATTERN] [--grep-v PATTERN] [--csv|--json|--raw] [--no-header] [--no-color]

"What is the database doing right now?" - from GV$ACTIVE_SESSION_HISTORY (one-second
samples kept in memory) over the last N minutes, for every running database.

Columns: DB, TYPE, ITEM, DETAIL, SAMPLES, PCT, AAS
  TYPE    LOAD   one row per database: total average active sessions vs CPU count
          EVENT  top wait events ('ON CPU' = sessions running on CPU)
          SQL    top SQL_IDs (DETAIL = container, top event and the start of the SQL text)
  AAS     average active sessions = SAMPLES / seconds in the window
  LOAD STATUS (in DETAIL): OK, WARN when AAS > CPU count (sessions queue for CPU or wait)

Options:
  --minutes N     Window in minutes (default: 15, max: 1440)
  --top N         Rows per type (default: 5)
  --by TYPE       event, sql or both (default)
  --force         Run even when CONTROL_MANAGEMENT_PACK_ACCESS does not include DIAGNOSTIC
  --db REGEX      Only query SIDs matching REGEX (case-insensitive)
  --grep / --grep-v, --csv|--json|--raw, --no-header, --no-color

Licensing: ASH is part of the Oracle Diagnostics Pack. Databases whose
CONTROL_MANAGEMENT_PACK_ACCESS does not include DIAGNOSTIC are SKIPPED unless --force.

Examples:
  dbash
  dbash --minutes 5 --by sql --top 10
  dbash --db PRD --csv
EOF
                return 0
                ;;
            *) _dba_err "Unknown option: $1 (see dbash --help)"; return 1 ;;
        esac
        shift
    done
    _dba_check_modes || return 1
    [[ "$minutes" =~ ^[0-9]+$ ]] && (( minutes >= 1 && minutes <= 1440 )) || { _dba_err "--minutes must be 1-1440"; return 1; }
    [[ "$top" =~ ^[1-9][0-9]*$ ]] || { _dba_err "--top must be a positive number"; return 1; }

    local data="DB|TYPE|ITEM|DETAIL|SAMPLES|PCT|AAS"
    local sid home out err any=0 secs=$(( minutes * 60 ))
    while IFS='|' read -r sid home; do
        [[ -z "$sid" ]] && continue
        any=1
        if (( ! force )) && ! _dba_diag_pack "$sid" "$home"; then
            data+=$'\n'"$sid|LOAD|-|SKIPPED (Diagnostics Pack not enabled - use --force)|-|-|-"
            continue
        fi
        out="$(_dba_q "$sid" "$home" <<SQL
with a as (select nvl(con_id, 0) con_id, decode(session_state, 'ON CPU', 'ON CPU', nvl(event, 'unknown')) ev, sql_id
             from gv\$active_session_history
            where sample_time > systimestamp - numtodsinterval($minutes, 'MINUTE'))
select 'TOT|' || count(*) || '|' || (select sum(to_number(value)) from gv\$parameter where name = 'cpu_count') from a;
with a as (select decode(session_state, 'ON CPU', 'ON CPU', nvl(event, 'unknown')) ev
             from gv\$active_session_history
            where sample_time > systimestamp - numtodsinterval($minutes, 'MINUTE'))
select 'EV|' || replace(ev, '|', '/') || '|' || cnt || '|' || to_char(pct, 'FM990.0')
  from (select ev, count(*) cnt, 100 * ratio_to_report(count(*)) over () pct from a group by ev order by cnt desc)
 fetch first $top rows only;
with a as (select nvl(con_id, 0) con_id, sql_id, decode(session_state, 'ON CPU', 'ON CPU', nvl(event, 'unknown')) ev
             from gv\$active_session_history
            where sample_time > systimestamp - numtodsinterval($minutes, 'MINUTE') and sql_id is not null),
     t as (select sql_id, count(*) cnt, 100 * ratio_to_report(count(*)) over () pct,
                  max(con_id) con_id, stats_mode(ev) topev
             from a group by sql_id order by cnt desc fetch first $top rows only)
select 'SQ|' || t.sql_id || '|' || nvl((select c.name from v\$containers c where c.con_id = t.con_id), '-') || '|' ||
       replace(t.topev, '|', '/') || '|' ||
       nvl((select replace(replace(substr(s.sql_text, 1, 60), chr(10), ' '), '|', '/') from gv\$sqlstats s where s.sql_id = t.sql_id and rownum = 1), '-')
       || '|' || t.cnt || '|' || to_char(t.pct, 'FM990.0')
  from t order by t.cnt desc;
select 'OK|done' from dual;
SQL
)"
        if ! grep -q '^OK|done' <<< "$out"; then
            err="$(_dba_qerr "$out")"
            data+=$'\n'"$sid|LOAD|-|ERROR: $(_dba_clean "${err:-no output}")|-|-|-"
            continue
        fi
        local tot cpus aas st
        IFS='|' read -r tot cpus <<< "$(_dba_tag "$out" TOT | head -1)"
        aas="$(awk -v n="${tot:-0}" -v s="$secs" 'BEGIN { printf "%.2f", n / s }')"
        st="OK"; awk -v a="$aas" -v c="${cpus:-0}" 'BEGIN { exit !(c > 0 && a > c) }' && st="WARN"
        data+=$'\n'"$sid|LOAD|total (${minutes}m)|$st (cpu_count ${cpus:-?})|${tot:-0}|100.0|$aas"
        if [[ "$by" != sql ]]; then
            data+="$(_dba_tag "$out" EV | awk -F'|' -v OFS='|' -v s="$sid" -v secs="$secs" '{ printf "\n%s|EVENT|%s|-|%s|%s|%.2f", s, $1, $2, $3, $2 / secs }')"
        fi
        if [[ "$by" != event ]]; then
            data+="$(_dba_tag "$out" SQ | awk -F'|' -v OFS='|' -v s="$sid" -v secs="$secs" '{ printf "\n%s|SQL|%s|%s / %s / %s|%s|%s|%.2f", s, $1, $2, $3, $4, $5, $6, $5 / secs }')"
        fi
    done < <(_dba_up_targets "$dbre")
    (( any )) || { _dba_err "No running databases found${dbre:+ matching '$dbre'}."; return 1; }
    _dba_emit "$data"
}

