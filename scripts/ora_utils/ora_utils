    fi

    local data="DB|CON|CHECK_ID|CHECK|VALUE|STATUS"
    local rows="" cur_db=""
    # _dbpc <con> <id> <label> <value> <status>
    _dbpc() {
        local st="$5"
        if [[ "$st" == FAIL || "$st" == WARN ]] && _dba_match_list "$2" "$ignore"; then st="$st (ignored)"; fi
        rows+=$'\n'"$cur_db|$1|$2|$(_dba_clean "$3")|$(_dba_clean "$4")|$st"
    }
    _dbpc_cnt() {   # <con> <id> <label> <value> <status-if-nonzero>
        if [[ "$4" =~ ^[0-9]+$ ]]; then
            if (( $4 == 0 )); then _dbpc "$1" "$2" "$3" "0" PASS; else _dbpc "$1" "$2" "$3" "$4" "$5"; fi
        else
            _dbpc "$1" "$2" "$3" "${4:-not available}" WARN
        fi
    }
    _dbpc_overall() {   # appends OVERALL for cur_db based on rows
        local nf nw ni
        nf="$(grep -c '|FAIL$' <<< "$rows")"; nw="$(grep -c '|WARN$' <<< "$rows")"; ni="$(grep -c '(ignored)$' <<< "$rows")"
        if (( nf > 0 )); then
            rows+=$'\n'"$cur_db|-|overall|OVERALL|$nf FAIL, $nw WARN, $ni ignored|NO-GO"
            nogo=1
        else
            rows+=$'\n'"$cur_db|-|overall|OVERALL|$nf FAIL, $nw WARN, $ni ignored|GO"
        fi
        if (( summary )); then
            data+=$'\n'"$(grep '|overall|' <<< "$rows")"
        elif (( issues )); then
            local r; r="$(grep -v '|PASS$' <<< "$rows" | sed '/^$/d')"
            [[ -n "$r" ]] && data+=$'\n'"$r"
        else
            data+="$rows"
        fi
        rows=""
    }

    local sid home out om role err any=0 nogo=0 v st bk bks lag base free cdb con
    local -a cons=()
    while IFS='|' read -r sid home; do
        [[ -z "$sid" ]] && continue
        any=1
        cur_db="$sid"
        rows=""
        out="$(_dba_q "$sid" "$home" <<'SQL'
select 'OM|' || open_mode || '|' || database_role || '|' || cdb from v$database;
select 'FRA|' || nvl(max(to_char(100 * (space_used - space_reclaimable) / nullif(space_limit, 0), 'FM990.0')), '-') from v$recovery_file_dest;
select 'GRP|' || count(*) from v$restore_point where guarantee_flashback_database = 'YES';
select 'TX|' || count(*) from v$transaction where start_date < sysdate - 1 / 24;
select 'BLK|' || count(*) from v$session where blocking_session is not null;
select 'JOBS|' || count(*) from cdb_scheduler_running_jobs;
select 'DPJ|' || count(*) from cdb_datapump_jobs where state <> 'NOT RUNNING';
select 'PDB|' || name || '|' || open_mode from v$pdbs where name <> 'PDB$SEED' order by con_id;
SQL
)"
        om="$(_dba_tag "$out" OM | head -1)"
        if [[ -z "$om" ]]; then
            err="$(_dba_qerr "$out")"
            _dbpc - connect "Connect" "${err:-no output}" FAIL
            _dbpc_overall
            continue
        fi
        IFS='|' read -r om role cdb <<< "$om"
        if [[ "$om" == "READ WRITE" || "$role" == *STANDBY* ]]; then _dbpc - open_mode "Open mode / role" "$om / $role" PASS
        else _dbpc - open_mode "Open mode / role" "$om / $role" WARN; fi
        if [[ "$target" == 26ai ]]; then
            if [[ "$cdb" == YES ]]; then _dbpc - target_cdb "26ai: multitenant (CDB)" "CDB" PASS
            else _dbpc - target_cdb "26ai: multitenant (CDB)" "non-CDB - convert to a PDB first" FAIL; fi
        fi

        cons=()
        if [[ "$cdb" == YES ]]; then
            cons=("CDB\$ROOT")
            local pn pom
            while IFS='|' read -r pn pom; do
                pn="$(sed 's/[[:space:]]*$//' <<< "$pn")"
                [[ -z "$pn" ]] && continue
                if [[ "$pom" == READ* ]]; then
                    cons+=("$pn")
                    _dbpc "$pn" pdb_open "PDB open state" "$pom" PASS
                elif [[ "$role" == PRIMARY ]]; then
                    _dbpc "$pn" pdb_open "PDB open state" "$pom" WARN
                else
                    _dbpc "$pn" pdb_open "PDB open state" "$pom (standby)" PASS
                fi
            done < <(_dba_tag "$out" PDB)
        else
            cons=("-")
        fi

        v="$(_dba_tag "$out" TX | head -1)";   _dbpc_cnt - long_tx "Transactions open > 1h" "$v" WARN
        v="$(_dba_tag "$out" BLK | head -1)";  _dbpc_cnt - blocked "Blocked sessions" "$v" WARN
        v="$(_dba_tag "$out" GRP | head -1)";  _dbpc_cnt - restore_points "Guaranteed restore points" "$v" WARN
        if [[ "$om" == READ* ]]; then
            v="$(_dba_tag "$out" JOBS | head -1)"; _dbpc_cnt - jobs_running "Running scheduler jobs" "$v" WARN
            v="$(_dba_tag "$out" DPJ | head -1)";  _dbpc_cnt - datapump_jobs "Running Data Pump jobs" "$v" WARN
        fi
        v="$(_dba_tag "$out" FRA | head -1)"
        if [[ "$v" == "-" || -z "$v" ]]; then _dbpc - fra "FRA usage" "no FRA" PASS
        else
            st="$(_dba_level "$v" 80 90)"
            case "$st" in OK) st=PASS ;; CRIT) st=FAIL ;; esac
            _dbpc - fra "FRA usage" "${v}%" "$st"
        fi

        bk="$(_dbbkp_rows "$sid" "$home" "$db_hours" 4)"
        bks="${bk##*|}"
        case "$bks" in
            OK*)   _dbpc - backup "Recent backup" "DB age $(cut -d'|' -f7 <<< "$bk")h" PASS ;;
            WARN*) v="${bks#WARN (}"; _dbpc - backup "Recent backup" "${v%)}" WARN ;;
            CRIT*) v="${bks#CRIT (}"; _dbpc - backup "Recent backup" "${v%)}" FAIL ;;
            *)     _dbpc - backup "Recent backup" "$bks" FAIL ;;
        esac

        lag="$(dbdglag "$sid" --raw 2>/dev/null | awk -F'\t' '
            $8 == "CRIT" { c = 1 } $8 == "WARN" { w = 1 } $3 == "NO_BROKER" { nb = 1 } $8 == "ERROR" { e = 1 }
            END { if (c) print "CRIT"; else if (w) print "WARN"; else if (e) print "ERROR"; else if (nb) print "NO_BROKER"; else print "OK" }')"
        case "$lag" in
            CRIT)      _dbpc - dg_lag "Data Guard lag" "CRIT (see dbdglag)" FAIL ;;
            WARN)      _dbpc - dg_lag "Data Guard lag" "WARN (see dbdglag)" WARN ;;
            ERROR)     _dbpc - dg_lag "Data Guard lag" "broker error (see dbdglag)" WARN ;;
            NO_BROKER) _dbpc - dg_lag "Data Guard lag" "no broker configuration" PASS ;;
            *)         _dbpc - dg_lag "Data Guard lag" "OK" PASS ;;
        esac

        base="$(_dba_obase "$sid" "$home")"
        free="$(df -Pk "$base" 2>/dev/null | awk 'NR == 2 { printf "%.1f", $4 / 1048576 }')"
        if [[ -n "$free" ]] && awk -v f="$free" -v m="$min_free" 'BEGIN { exit !(f + 0 >= m + 0) }'; then
            _dbpc - base_free "Free space $base" "${free} GB" PASS
        else
            _dbpc - base_free "Free space $base" "${free:-?} GB (need $min_free)" FAIL
        fi

        # Container-level checks (one sqlplus session, switching containers)
        if [[ "$om" != READ* ]]; then
            _dbpc - registry "Container checks" "skipped ($om)" PASS
        else
            local script="" cname
            for con in "${cons[@]}"; do
                cname="$con"
                [[ "$con" != "-" ]] && script+="alter session set container = \"$con\";"$'\n'
                script+="$(sed "s/__C__/$cname/g" <<'SQL'
select 'C|__C__|registry|' || listagg(comp_id || '=' || status, ' ') within group (order by comp_id)
  from dba_registry where status not in ('VALID', 'OPTION OFF', 'REMOVED');
select 'C|__C__|datapatch|' || count(*) from (select status, row_number() over (partition by patch_id order by action_time desc) rn
                                                from dba_registry_sqlpatch) where rn = 1 and status <> 'SUCCESS';
select 'C|__C__|invalid_oracle|' || count(*) from dba_objects o join dba_users u on u.username = o.owner
 where o.status = 'INVALID' and u.oracle_maintained = 'Y';
select 'C|__C__|invalid_other|' || count(*) from dba_objects o join dba_users u on u.username = o.owner
 where o.status = 'INVALID' and u.oracle_maintained = 'N';
select 'C|__C__|recyclebin|' || count(*) from dba_recyclebin;
select 'C|__C__|stats_dict|' || nvl(to_char(max(last_analyzed), 'YYYY-MM-DD HH24:MI'), 'never') || '|' ||
       nvl(to_char(round(sysdate - max(last_analyzed), 1)), '-') from dba_tables where owner = 'SYS';
select 'C|__C__|stats_fixed|' || nvl(to_char(max(last_analyzed), 'YYYY-MM-DD HH24:MI'), 'never') || '|' ||
       nvl(to_char(round(sysdate - max(last_analyzed), 1)), '-') from dba_tab_statistics where object_type = 'FIXED TABLE';
with df as (select tablespace_name, sum(bytes) alloc,
                   sum(greatest(decode(autoextensible, 'YES', maxbytes, bytes), bytes)) maxb
              from dba_data_files group by tablespace_name),
     fs as (select tablespace_name, sum(bytes) free from dba_free_space group by tablespace_name)
select 'C|__C__|ts_' || lower(df.tablespace_name) || '|' || df.tablespace_name || '|' ||
       to_char((df.maxb - df.alloc + nvl(fs.free, 0)) / 1073741824, 'FM9999990.00')
  from df left join fs on fs.tablespace_name = df.tablespace_name
 where df.tablespace_name in ('SYSTEM', 'SYSAUX');
with df as (select tablespace_name, sum(greatest(decode(autoextensible, 'YES', maxbytes, bytes), bytes)) maxb
              from dba_data_files group by tablespace_name),
     ux as (select tablespace_name, sum(bytes) used from dba_undo_extents
             where status in ('ACTIVE', 'UNEXPIRED') group by tablespace_name)
select 'C|__C__|ts_undo|' || df.tablespace_name || '|' ||
       to_char((df.maxb - nvl(ux.used, 0)) / 1073741824, 'FM9999990.00')
  from df left join ux on ux.tablespace_name = df.tablespace_name
 where df.tablespace_name = (select upper(value) from v$parameter where name = 'undo_tablespace');
with tf as (select tablespace_name, sum(greatest(decode(autoextensible, 'YES', maxbytes, bytes), bytes)) maxb
              from dba_temp_files group by tablespace_name),
     tu as (select tablespace, sum(blocks) blks from v$tempseg_usage group by tablespace),
     dt as (select property_value tsn from database_properties where property_name = 'DEFAULT_TEMP_TABLESPACE')
select 'C|__C__|ts_temp|' || tf.tablespace_name || '|' ||
       to_char((tf.maxb - nvl(tu.blks, 0) * (select block_size from dba_tablespaces t where t.tablespace_name = tf.tablespace_name)) / 1073741824, 'FM9999990.00')
  from tf join dt on dt.tsn = tf.tablespace_name
  left join tu on tu.tablespace = tf.tablespace_name;
SQL
)"$'\n'
            done
            local cout cid cval cval2 lbl
            cout="$(_dba_q "$sid" "$home" <<< "$script")"
            for con in "${cons[@]}"; do
                local got=0
                while IFS='|' read -r cid cval cval2; do
                    got=1
                    case "$cid" in
                        registry)
                            if [[ -z "$cval" ]]; then _dbpc "$con" registry "Registry components" "all VALID" PASS
                            else _dbpc "$con" registry "Registry components" "$cval" FAIL; fi ;;
                        datapatch)      _dbpc_cnt "$con" datapatch "Datapatch actions not SUCCESS" "$cval" FAIL ;;
                        invalid_oracle) _dbpc_cnt "$con" invalid_oracle "Invalid objects (Oracle-maintained)" "$cval" FAIL ;;
                        invalid_other)  _dbpc_cnt "$con" invalid_other "Invalid objects (other schemas)" "$cval" WARN ;;
                        recyclebin)
                            if [[ "$cval" =~ ^[0-9]+$ ]] && (( cval > 100 )); then _dbpc "$con" recyclebin "Recycle bin objects" "$cval" WARN
                            else _dbpc "$con" recyclebin "Recycle bin objects" "${cval:-?}" "$( [[ "$cval" =~ ^[0-9]+$ ]] && echo PASS || echo WARN )"; fi ;;
                        stats_dict|stats_fixed)
                            lbl="Dictionary (SYS) statistics"; [[ "$cid" == stats_fixed ]] && lbl="Fixed objects statistics"
                            if [[ "$cval" == never || -z "$cval2" || "$cval2" == "-" ]]; then
                                _dbpc "$con" "$cid" "$lbl" "never gathered" WARN
                            elif awk -v d="$cval2" 'BEGIN { exit !(d + 0 > 2) }'; then
                                _dbpc "$con" "$cid" "$lbl" "$cval (${cval2} days ago)" WARN
                            else
                                _dbpc "$con" "$cid" "$lbl" "$cval (${cval2} days ago)" PASS
                            fi ;;
                        ts_system|ts_sysaux|ts_undo|ts_temp)
                            st=PASS
                            if awk -v f="$cval2" 'BEGIN { exit !(f + 0 < 5) }'; then
                                case "$cid" in ts_system|ts_sysaux) st=FAIL ;; *) st=WARN ;; esac
                            fi
                            _dbpc "$con" "$cid" "Free space $cval" "${cval2} GB" "$st" ;;
                    esac
                done < <(sed -n "s/^C|$(sed 's/[$]/\\$/g' <<< "$con")|//p" <<< "$cout")
                (( got )) || _dbpc "$con" registry "Container checks" "$(_dba_qerr "$cout" || true)" WARN
            done
        fi
        _dbpc_overall
    done < <(_dba_up_targets "$dbre")
    (( any )) || { _dba_err "No running databases found${dbre:+ matching '$dbre'}."; return 1; }

    # HOST checks
    cur_db="HOST"
    rows=""
    local swap_kb; swap_kb="$(awk '/^SwapTotal:/ { print $2 }' /proc/meminfo)"
    v="$(awk -v k="${swap_kb:-0}" 'BEGIN { printf "%.1f GB", k / 1048576 }')"
    if (( ${swap_kb:-0} == 0 )); then _dbpc - swap "Swap configured" "none" FAIL
    elif (( swap_kb < 16 * 1048576 * 95 / 100 )); then _dbpc - swap "Swap configured" "$v (expected >= 16 GB)" WARN
    else _dbpc - swap "Swap configured" "$v" PASS; fi

    local hp_kb nr need=0 amm="" sga line s h asmline
    hp_kb="$(awk '/^Hugepagesize:/ { print $2 }' /proc/meminfo)"
    nr="$(cat /proc/sys/vm/nr_hugepages 2>/dev/null || awk '/^HugePages_Total:/ { print $2 }' /proc/meminfo)"
    local sgas=""
    while IFS='|' read -r s h; do
        [[ -z "$s" ]] && continue
        out="$(_dba_q "$s" "$h" <<< "select 'SGA|' || (select value from v\$parameter where name = 'sga_max_size') || '|' || (select value from v\$parameter where name = 'memory_target') from dual;")"
        line="$(_dba_tag "$out" SGA | head -1)"
        [[ -z "$line" ]] && { sgas+="$s=?;"; continue; }
        sga="${line%%|*}"
        [[ "${line#*|}" =~ ^[1-9] ]] && amm+="${amm:+,}$s"
        need=$(( need + (sga + hp_kb * 1024 - 1) / (hp_kb * 1024) ))
        sgas+="$s;"
    done < <(_dba_running_dbs)
    if asmline="$(_dba_asm_instance)"; then
        line="$(_dba_asm_q <<< "select 'SGA|' || value from v\$parameter where name = 'sga_max_size';" | sed -n 's/^SGA|//p' | head -1)"
        if [[ "$line" =~ ^[0-9]+$ ]]; then
            need=$(( need + (line + hp_kb * 1024 - 1) / (hp_kb * 1024) ))
            sgas+="${asmline%%|*};"
        fi
    fi
    if [[ -n "$sgas" && "$hp_kb" =~ ^[0-9]+$ && "$nr" =~ ^[0-9]+$ ]]; then
        need=$(( need + 5 ))
        if [[ "$sgas" == *"=?"* ]]; then
            _dbpc - hugepages "HugePages (vm.nr_hugepages)" "$nr configured, SGA unknown for ${sgas//;/ }" WARN
        elif (( nr < need )); then
            _dbpc - hugepages "HugePages (vm.nr_hugepages)" "$nr configured, $need required (${hp_kb}K pages)" FAIL
        elif [[ -n "$amm" ]]; then
            _dbpc - hugepages "HugePages (vm.nr_hugepages)" "$nr >= $need, but AMM (memory_target) used by $amm" WARN
        else
            _dbpc - hugepages "HugePages (vm.nr_hugepages)" "$nr configured, $need required" PASS
        fi
    else
        _dbpc - hugepages "HugePages (vm.nr_hugepages)" "no running instances or HugePages not supported" PASS
    fi

    local tmpf; tmpf="$(df -Pk /tmp 2>/dev/null | awk 'NR == 2 { printf "%.1f", $4 / 1048576 }')"
    if [[ -n "$tmpf" ]] && awk -v f="$tmpf" 'BEGIN { exit !(f + 0 >= 2) }'; then _dbpc - tmp_free "/tmp free" "${tmpf} GB" PASS
    else _dbpc - tmp_free "/tmp free" "${tmpf:-?} GB" WARN; fi

    local oid ock osc occ oce ost
    while IFS=$'\t' read -r oid ock osc occ oce ost; do
        [[ -z "$oid" ]] && continue
        if [[ "$oid" == cert ]]; then
            _dbpc - cert "$ock $osc" "$occ" "$ost"
            continue
        fi
        (( full )) || continue
        case "$oid" in swap|hugepages|hugepages_used|tmp_free|os_release) continue ;; esac
        [[ "$osc" != host ]] && ock="$ock ($osc)"
        _dbpc - "os.$oid" "$ock" "$occ (expected $oce)" "$ost"
    done < <(oscheck --raw 2>/dev/null)
    if [[ -n "$target" ]]; then
        local tst tdet
        IFS='|' read -r tst tdet <<< "$(_dba_cert_planned "$target_rel" "$target_ru")"
        _dbpc - target_os "$target${target_ru:+ $(_dba_ver_short "$target_ru")} on this OS" "$tdet" "$tst"
    fi
    _dbpc_overall

    _dba_emit "$data"
    (( nogo )) && return 2
    return 0
}
# DESC: Compare the patches of two Oracle homes (or a database's running home vs its oratab home)
function ohdiff() {
    local show_all=0 old="" new="" ign_oneoff=0 ign_list=""
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc
    local -a args=()
    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --all) show_all=1 ;;
            --ignore-oneoff)
                ign_oneoff=1
                if [[ "${2-}" =~ ^[0-9]+(,[0-9]+)*$ ]]; then ign_list="${ign_list:+$ign_list,}$2"; shift; fi
                ;;
            -h|--help)
                cat <<'EOF'
Usage: ohdiff OLD_HOME NEW_HOME [--all] [--ignore-oneoff [ID1,ID2,...]] [--grep PATTERN] [--grep-v PATTERN]
              [--csv|--json|--raw] [--no-header] [--no-color]
       ohdiff SID [...]     OLD = home the instance is RUNNING from, NEW = home in oratab

Compares 'opatch lspatches' of two homes - typically the old and new home of an
out-of-place patch - and shows what the new home adds and drops.

Columns: PATCH_ID, TYPE, DESCRIPTION, OLD, NEW, STATUS
  TYPE     RU, OJVM, DATAPUMP, OCW, ACFS, DBWLM, TOMCAT, JDK or ONE-OFF
  STATUS   SAME      in both homes                       (only shown with --all)
           ADDED     only in the new home
           REPLACED  bundle (RU/OJVM/...) only in the old home - normally replaced
                     by the newer bundle in the new home
           MISSING   ONE-OFF patch only in the old home: check whether it is
                     included in the new RU or must be re-applied to the new home

           MISSING (ignored)  as MISSING, but accepted with --ignore-oneoff

Options:
  --all          Also show patches present in both homes
  --ignore-oneoff [IDS]
                 Accept missing one-off patches: without IDS every missing one-off is
                 ignored, with a comma-separated list only those patch IDs. Ignored
                 patches are still listed (MISSING (ignored)) but do not affect the return code.
  --grep / --grep-v, --csv|--json|--raw, --no-header, --no-color

Return code: 0 = no MISSING one-offs (or all ignored), 2 = MISSING one-off patches found, 1 = error

Examples:
  ohdiff /u01/app/oracle/product/19.31.0/dbhome_1 /u01/app/oracle/product/19.32.2/dbhome_1
  ohdiff PRD1
  ohdiff PRD1 --ignore-oneoff
  ohdiff PRD1 --ignore-oneoff 34567890,35111222
EOF
                return 0
                ;;
            -*) _dba_err "Unknown option: $1 (see ohdiff --help)"; return 1 ;;
            *)  args+=("$1") ;;
        esac
        shift
    done
    _dba_check_modes || return 1
    if (( ${#args[@]} == 2 )); then
        old="${args[0]%/}"; new="${args[1]%/}"
    elif (( ${#args[@]} == 1 )); then
        local line
        line="$(_dba_running_dbs | awk -F'|' -v s="${args[0]}" 'toupper($1) == toupper(s) { print; exit }')"
        [[ -n "$line" ]] || { _dba_err "Instance '${args[0]}' is not running (give two homes instead)."; return 1; }
        old="${line#*|}"
        new="$(_dba_oratab_home "${line%%|*}")"
        [[ -n "$new" ]] || { _dba_err "'${args[0]}' not found in oratab."; return 1; }
        if [[ "${old%/}" == "${new%/}" ]]; then
            echo "${args[0]} runs from the home oratab points to ($old) - nothing to compare."
            return 0
        fi
        echo "OLD (running): $old"
        echo "NEW (oratab) : $new"
    else
        _dba_err "Give OLD_HOME NEW_HOME or a SID (see ohdiff --help)."
        return 1
    fi
    local h
    for h in "$old" "$new"; do
        [[ -x "$h/OPatch/opatch" ]] || { _dba_err "OPatch not found in $h"; return 1; }
    done

    local tmpdir
    tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/ohdiff.XXXXXX")" || return 1
    echo "Running opatch lspatches on both homes - please wait..." >&2
    (
        _dba_opatch_ids "$old" > "$tmpdir/old" &
        _dba_opatch_ids "$new" > "$tmpdir/new" &
        wait
    )
    if [[ ! -s "$tmpdir/old" || ! -s "$tmpdir/new" ]]; then
        rm -rf -- "$tmpdir"
        _dba_err "opatch lspatches returned no patches for one of the homes."
        return 1
    fi

    local data="PATCH_ID|TYPE|DESCRIPTION|OLD|NEW|STATUS" pid desc typ in_old in_new st
    local -A d_old=() d_new=() all=()
    while IFS= read -r line; do d_old["${line%%;*}"]="${line#*;}"; all["${line%%;*}"]=1; done < "$tmpdir/old"
    while IFS= read -r line; do d_new["${line%%;*}"]="${line#*;}"; all["${line%%;*}"]=1; done < "$tmpdir/new"
    rm -rf -- "$tmpdir"
    local missing=0
    for pid in $(printf '%s\n' "${!all[@]}" | sort -n); do
        desc="${d_new[$pid]:-${d_old[$pid]:-}}"
        typ="$(_dba_patch_type "$desc")"
        in_old="-"; in_new="-"
        [[ -n "${d_old[$pid]+x}" ]] && in_old="yes"
        [[ -n "${d_new[$pid]+x}" ]] && in_new="yes"
        if [[ "$in_old" == yes && "$in_new" == yes ]]; then
            (( show_all )) || continue
            st="SAME"
        elif [[ "$in_new" == yes ]]; then
            st="ADDED"
        elif [[ "$typ" == ONE-OFF ]]; then
            if (( ign_oneoff )) && { [[ -z "$ign_list" ]] || [[ ",$ign_list," == *",$pid,"* ]]; }; then
                st="MISSING (ignored)"
            else
                st="MISSING"; missing=1
            fi
        else
            st="REPLACED"
        fi
        data+=$'\n'"$pid|$typ|$(_dba_clean "$desc")|$in_old|$in_new|$st"
    done
    if [[ "$data" != *$'\n'* ]]; then
        echo "Both homes have exactly the same patches."
        return 0
    fi
    _dba_emit "$data"
    (( missing )) && return 2
    return 0
}
# DESC: Progress of AutoUpgrade jobs on this host (status.json + latest job log line)
function lsautoupg() {
    local -a dirs=()
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc
    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --dir) _dba_need_val "$1" "${2-}" || return 1; dirs+=("${2%/}"); shift ;;
            -h|--help)
                cat <<'EOF'
Usage: lsautoupg [--dir AUTOUPG_LOG_DIR ...] [--grep PATTERN] [--grep-v PATTERN]
                 [--csv|--json|--raw] [--no-header] [--no-color]

Shows AutoUpgrade jobs on this host:
  JOB, SID, STAGE, OPERATION, STATUS, PROGRESS, UPDATED, LAST_LOG_LINE, LOG_DIR

Where it looks (global.autoupg_log_dir):
  1. --dir arguments, or DBA_AUTOUPG_LOG_DIR
  2. the config file (-config) of every running AutoUpgrade java process
  3. <ORACLE_BASE>/cfgtoollogs/autoupgrade and /tmp/autoupgrade (AutoUpgrade defaults)

Job data is read from <log_dir>/cfgtoollogs/upgrade/auto/status/status.json (python3
is used to parse it). When status.json is not available the job directories
<log_dir>/<SID>/<job#>/ are listed with the last line of their newest log file.

Options:
  --dir DIR      AutoUpgrade log directory (repeatable)
  --grep / --grep-v, --csv|--json|--raw, --no-header, --no-color

Notes:
  - The number of running AutoUpgrade processes is printed above the table.
  - Field names in status.json can differ between AutoUpgrade versions; missing
