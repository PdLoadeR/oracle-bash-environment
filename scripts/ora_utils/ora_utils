  PGA_TARGET_GB PGA_LIMIT_GB PGA_ALLOC_GB PGA_MAX_ALLOC_GB
  SHARED_POOL_GB SHARED_POOL_CUR_GB DB_CACHE_GB DB_CACHE_CUR_GB
