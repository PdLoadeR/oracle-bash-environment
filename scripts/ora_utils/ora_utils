# fatal <message> : print to stderr and return 1.
# Deliberately does NOT 'exit' - this file is sourced into interactive shells,
# and exit would close the user's session.
function fatal()
{
    printf '%b\n' "${1:-FATAL : unknown error}" >&2
    return 1
}

# printTable <delimiter> <data> [colorHeader true|false] [displayTotalCount true|false]
# Single-pass renderer (uses the common _dba_table_awk). Cell text is printed literally:
# backslashes and '#' in the data are safe.
function printTable()
{
    local -r delimiter="${1-}"
    local -r tableData="${2-}"
    local -r colorHeader="${3-}"
    local -r displayTotalCount="${4-}"
    local output numberOfLines

    [[ -z "$delimiter" ]] && return 0
    output="$(_dba_table_awk "$delimiter" "$tableData")"
    [[ -z "$output" ]] && return 0

    if [[ "$colorHeader" == 'true' ]]; then
        awk '/^  \+/ { ns++ } { if (ns < 2 || (ns == 2 && /^  \+/)) printf "\033[1;32m%s\033[0m\n", $0; else print }' <<< "$output"
    else
        printf '%s\n' "$output"
    fi

    if [[ "$displayTotalCount" == 'true' ]]; then
        numberOfLines="$(grep -cv '^[[:space:]]*$' <<< "$tableData")"
        if [[ "$colorHeader" == 'true' ]]; then
            printf '\n\033[1;36mTOTAL ROWS : %d\033[0m\n' "$(( numberOfLines - 1 ))"
        else
            printf '\nTOTAL ROWS : %d\n' "$(( numberOfLines - 1 ))"
        fi
    fi
}

function removeEmptyLines()
{
    printf '%s\n' "${1-}" | sed '/^[[:space:]]*$/d'
}

function isEmptyString()
{
    if [[ -z "$(trimString "${1-}")" ]]; then
        echo 'true' && return 0
    fi
    echo 'false' && return 1
}

function trimString()
{
    local s="${1-}"
    s="${s#"${s%%[![:blank:]]*}"}"
    s="${s%"${s##*[![:blank:]]}"}"
    printf '%s\n' "$s"
}

function repeatString()
{
    local -r string="${1-}"
    local -r numberToRepeat="${2-}"
    if [[ -n "$string" && "$(isPositiveInteger "$numberToRepeat")" == 'true' ]]; then
        local result
        result="$(printf "%${numberToRepeat}s")"
        printf '%s\n' "${result// /${string}}"
    fi
}

function replaceString()
{
    local -r content="${1-}"
    local -r oldValue="$(escapeSearchPattern "${2-}")"
    local -r newValue="$(escapeSearchPattern "${3-}")"
    sed "s@${oldValue}@${newValue}@g" <<< "$content"
}

function escapeSearchPattern()
{
    sed -e 's@\\@\\\\@g' -e 's@\@@\\@@g' -e 's@\[@\\[@g' -e 's@\*@\\*@g' -e 's@%@\\%@g' -e 's@&@\\&@g' <<< "${1-}"
}

function escapeGrepSearchPattern()
{
    sed 's/[]\.|$(){}?+*^[]/\\&/g' <<< "${1-}"
}

function checkNonEmptyString()
{
    local -r string="${1-}"
    local -r errorMessage="${2-}"
    if [[ "$(isEmptyString "$string")" == 'true' ]]; then
        if [[ "$(isEmptyString "$errorMessage")" == 'true' ]]; then
            fatal '\nFATAL : empty value detected'
        else
            fatal "\nFATAL : ${errorMessage}"
        fi
        return 1
    fi
    return 0
}

function header()
{
    local -r title="${1-}"
    if [[ "$(isEmptyString "$title")" == 'false' ]]; then
        printf '\n\033[1;33m>>>>>>>>>> \033[1;4;35m%s\033[0m \033[1;33m<<<<<<<<<<\033[0m\n\n' "$title"
    fi
}

#################################
##### File/Folder UTILITIES #####
#################################
function checkExistFile()
{
    local -r file="${1-}"
    local -r errorMessage="${2-}"
    if [[ -z "$file" || ! -f "$file" ]]; then
        if [[ "$(isEmptyString "$errorMessage")" == 'true' ]]; then
            fatal "\nFATAL : file '${file}' not found"
        else
            fatal "\nFATAL : ${errorMessage}"
        fi
        return 1
    fi
    return 0
}

function checkExistFolder()
{
    local -r folder="${1-}"
    local -r errorMessage="${2-}"
    if [[ -z "$folder" || ! -d "$folder" ]]; then
        if [[ "$(isEmptyString "$errorMessage")" == 'true' ]]; then
            fatal "\nFATAL : folder '${folder}' not found"
        else
            fatal "\nFATAL : ${errorMessage}"
        fi
        return 1
    fi
    return 0
}

function getFileExtension()
{
    local -r string="${1-}"
    basename -- "${string##*.}"
}

function getFileName()
{
    local -r string="${1-}"
    basename -- "${string%.*}"
}

function getTemporaryFile()
{
    local extension="${1-}"
    if [[ -n "$extension" && "${extension:0:1}" != '.' ]]; then
        extension=".${extension}"
    fi
    mktemp "$(getTemporaryFolderRoot)/$(date +'%Y%m%d-%H%M%S')-XXXXXXXXXX${extension}"
}

function getTemporaryFolder()
{
    mktemp -d "$(getTemporaryFolderRoot)/$(date +'%Y%m%d-%H%M%S')-XXXXXXXXXX"
}

function getTemporaryFolderRoot()
{
    if [[ -n "${TMPDIR:-}" ]]; then
        formatPath "$TMPDIR"
    else
        echo '/tmp'
    fi
}

function isValidJSONContent()
{
    local -r content="${1-}"
    if python3 -m json.tool <<< "$content" &>/dev/null || python -m json.tool <<< "$content" &>/dev/null; then
        echo 'true' && return 0
    fi
    echo 'false' && return 1
}

function isValidJSONFile()
{
    local -r file="${1-}"
    checkExistFile "$file" || { echo 'false'; return 1; }
    isValidJSONContent "$(cat "$file")"
}

# formatPath: collapse repeated slashes and drop a trailing slash ("/" stays "/")
function formatPath()
{
    local path
    path="$(sed -e 's#//*#/#g' <<< "${1-}")"
    [[ "$path" != "/" ]] && path="${path%/}"
    printf '%s\n' "$path"
}

##############################
##### Number Utilities  ######
##############################
function checkNaturalNumber()
{
    local -r string="${1-}"
    local -r errorMessage="${2-}"
    if [[ "$(isNaturalNumber "$string")" == 'false' ]]; then
        if [[ "$(isEmptyString "$errorMessage")" == 'true' ]]; then
            fatal '\nFATAL : not natural number detected'
        else
            fatal "\nFATAL : ${errorMessage}"
        fi
        return 1
    fi
    return 0
}

function checkPositiveInteger()
{
    local -r string="${1-}"
    local -r errorMessage="${2-}"
    if [[ "$(isPositiveInteger "$string")" == 'false' ]]; then
        if [[ "$(isEmptyString "$errorMessage")" == 'true' ]]; then
            fatal '\nFATAL : not positive number detected'
        else
            fatal "\nFATAL : ${errorMessage}"
        fi
        return 1
    fi
    return 0
}

function isNaturalNumber()
{
    if [[ "${1-}" =~ ^[0-9]+$ ]]; then
        echo 'true' && return 0
    fi
    echo 'false' && return 1
}

function isPositiveInteger()
{
    if [[ "${1-}" =~ ^[1-9][0-9]*$ ]]; then
        echo 'true' && return 0
    fi
    echo 'false' && return 1
}

####################
# SYSTEM UTILITIES #
####################
function displayListeningPorts()
{
    local -r sleepTimeInSecond="${1-}"
    header 'DISPLAYING OPEN PORTS'
    if [[ -n "$sleepTimeInSecond" ]]; then
        sleep "$sleepTimeInSecond"
    fi
    lsof -iTCP -sTCP:LISTEN -n -P
}

function isPortInUse()
{
    local -r ports=("${@}")
    local -r headerRegex='^COMMAND\s\+PID\s\+USER\s\+FD\s\+TYPE\s\+DEVICE\s\+SIZE\/OFF\s\+NODE\s\+NAME$'
    local -r status="$(lsof -i -n -P | grep "\( (LISTEN)$\)\|\(${headerRegex}\)")"
    local open='' port='' found=''
    for port in "${ports[@]}"; do
        found="$(grep -i ":${port} (LISTEN)$" <<< "$status" || true)"
        if [[ -n "$found" ]]; then
            open="${open}"$'\n'"${found}"
        fi
    done
    if [[ -n "$open" ]]; then
        printf '\033[1;31m%s\033[0m\n' "Following ports are still opened. Make sure you uninstall or stop them before a new installation!"
        printf '\033[1;34m\n%s\033[0m' "$(grep "${headerRegex}" <<< "$status")"
        printf '\033[1;36m%s\033[0m\n\n' "$open"
    fi
}
