    [[ "$fwarn" =~ ^[0-9]+$ && "$fcrit" =~ ^[0-9]+$ ]] || { _dba_err "--warn/--crit must be whole numbers"; return 1; }

    local sid home out lmode fra err any=0 overall=0 rows
    local sum_data="SID|LOG_MODE|SWITCHES|GB|AVG_GB_PER_HOUR|PEAK_HOUR|PEAK_GB|FRA_PCT|STATUS"
    local hr_data="SID|HOUR|SWITCHES|GB|BAR"
    while IFS='|' read -r sid home; do
        [[ -z "$sid" ]] && continue
        any=1
        out="$(_dba_q "$sid" "$home" <<SQL
select 'LM|' || log_mode from v\$database;
select 'FRA|' || to_char(nvl(max(100 * (space_used - space_reclaimable) / nullif(space_limit, 0)), -1), 'FM990.0')
  from v\$recovery_file_dest;
select 'HR|' || to_char(h, 'YYYY-MM-DD HH24') || ':00|' || count(*) || '|' || to_char(sum(sz) / 1073741824, 'FM9999990.00')
  from (select trunc(first_time, 'HH24') h, thread#, sequence#, resetlogs_change#, max(blocks * block_size) sz
          from v\$archived_log
         where first_time > sysdate - ${hours} / 24 and standby_dest = 'NO'
         group by trunc(first_time, 'HH24'), thread#, sequence#, resetlogs_change#)
 group by h order by h;
SQL
)"
        lmode="$(_dba_tag "$out" LM | head -1)"
        if [[ -z "$lmode" ]]; then
            err="$(_dba_qerr "$out")"
            sum_data+=$'\n'"$sid|-|-|-|-|-|-|-|ERROR: $(_dba_clean "${err:-no output}")"
            overall=1
            continue
        fi
        fra="$(_dba_tag "$out" FRA | head -1)"
        rows="$(_dba_tag "$out" HR)"
        local st="OK" fra_show="$fra"
        if [[ -z "$fra" || "$fra" == "-1.0" ]]; then
            fra_show="no FRA"
        else
            st="$(_dba_level "$fra" "$fwarn" "$fcrit")"
        fi
        sum_data+=$'\n'"$(awk -F'|' -v OFS='|' -v s="$sid" -v lm="$lmode" -v h="$hours" -v f="$fra_show" -v st="$st" '
            NF >= 3 { n += $2; g += $3; if ($3 + 0 > pg + 0 || ph == "") { pg = $3; ph = $1 } }
            END { printf "%s|%s|%d|%.2f|%.2f|%s|%s|%s|%s\n", s, lm, n, g, g / h, (ph == "" ? "-" : ph), (ph == "" ? "-" : pg), f, st }
        ' <<< "$rows")"
        [[ "$st" == "CRIT" && $overall -eq 0 ]] && overall=2
        if (( hourly )) && [[ -n "$rows" ]]; then
            hr_data+=$'\n'"$(awk -F'|' -v OFS='|' -v s="$sid" '
                { r[NR] = $0; if ($3 + 0 > m) m = $3 + 0 }
                END {
                    for (i = 1; i <= NR; i++) {
                        split(r[i], a, "|")
                        n = (m > 0) ? int(a[3] / m * 40 + 0.5) : 0
                        if (n == 0 && a[3] + 0 > 0) n = 1
                        b = sprintf("%" n "s", ""); gsub(/ /, "#", b)
                        print s, a[1], a[2], a[3], b
                    }
                }' <<< "$rows")"
        fi
    done < <(_dba_up_targets "$dbre")
    (( any )) || { _dba_err "No running databases found${dbre:+ matching '$dbre'}."; return 1; }

    if (( hourly )); then
        if [[ "${_o_mode:-table}" != "table" ]]; then
            hr_data="$(_dba_select_columns "$hr_data" "SID,HOUR,SWITCHES,GB")"
        fi
        _dba_emit "$hr_data"
    else
        _dba_emit "$sum_data"
    fi
    return "$overall"
}

