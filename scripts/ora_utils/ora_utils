select 'W|' || nvl((select c.name from v$containers c where c.con_id = w.con_id), '-') || '|' ||
       w.wrl_type || '|' || nvl(w.wrl_parameter, '-') || '|' || w.status || '|' || w.wallet_type || '|' ||
       nvl(w.keystore_mode, '-') || '|' || w.fully_backed_up || '|' ||
       (select count(*) from cdb_tablespaces t where t.encrypted = 'YES' and t.con_id = w.con_id)
  from v$encryption_wallet w;
select 'OK|done' from dual;
SQL
)"
        if ! grep -q '^OK|done' <<< "$out"; then
            err="$(_dba_qerr "$out")"
            data+=$'\n'"$sid|-|-|-|-|-|-|-|-|-|ERROR: $(_dba_clean "${err:-no output}")"
            overall=1
            continue
        fi
        ks="$(_dba_tag "$out" KS | head -1)"
        rows="$(_dba_tag "$out" W | awk -F'|' -v OFS='|' -v s="$sid" -v ks="$ks" '{
            st = "OK"; enc = $8 + 0
            if ($4 ~ /CLOSED|NOT_AVAILABLE/) st = (enc > 0) ? "CRIT (encrypted tablespaces, keystore " $4 ")" : "-"
            else if ($4 ~ /NO_MASTER_KEY/) st = "WARN (no master key)"
            else if ($7 == "NO") st = "WARN (keystore not backed up)"
            else if ($5 == "PASSWORD") st = "WARN (password keystore - manual open after restart)"
            print s, $1, ks, $2, $3, $4, $5, $6, $7, enc, st }')"
