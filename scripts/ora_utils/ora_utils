# DESC: Random Password Generator
function passgen() {
    local length="" rounds=1 pw i
    local char_pool='a-zA-Z0-9_'

    _passgen_validate() {
        local p="$1"
        [[ "$p" == *_* ]]       || return 1
        [[ "$p" =~ [A-Z] ]]     || return 1
        [[ "$p" =~ [a-z] ]]     || return 1
        [[ "$p" =~ [0-9] ]]     || return 1
        [[ ! "$p" =~ ^[0-9_] ]] || return 1
        [[ ! "$p" =~ _$ ]]      || return 1
        return 0
    }

    case "${1-}" in
        -h|--help|"")
            cat <<'EOF'
Usage:
  passgen <length> [rounds]

Description:
  Generate one or more strong random passwords.
  Passwords are written to stdout (one per line); the banner goes to stderr,
  so  pw=$(passgen 20)  captures only the password.

Password Rules:
  - Minimum length: 15
  - Must contain at least one uppercase letter
  - Must contain at least one lowercase letter
  - Must contain at least one digit
  - Must contain at least one underscore (_)
  - Cannot start with a digit or an underscore
  - Cannot end with an underscore

Notes:
  - Oracle releases before 23ai limit passwords to 30 characters; a warning is shown above 30.

Arguments:
  length    Password length (minimum 15)
  rounds    Number of passwords to generate (default: 1, minimum 1)

Examples:
  passgen 20
  passgen 24 5
  pw=$(passgen 20)
EOF
            [[ -z "${1-}" ]] && return 1
            return 0
            ;;
    esac

    length="$1"
    rounds="${2:-1}"

    if ! [[ "$length" =~ ^[0-9]+$ ]]; then
        _dba_err "Length must be a numeric value. Try: passgen --help"
        return 1
    fi
    if ! [[ "$rounds" =~ ^[0-9]+$ ]] || (( rounds < 1 )); then
        _dba_err "Rounds must be a positive number. Try: passgen --help"
        return 1
    fi
    if (( length < 15 )); then
        _dba_err "Password length must be at least 15. Try: passgen --help"
        return 1
    fi
    if (( length > 30 )); then
        _dba_warn "Length $length exceeds 30 characters (limit for Oracle releases before 23ai)."
    fi

    {
        echo
        echo "------------------------------"
        echo " Password Length : $length"
        echo " Password Count  : $rounds"
        echo "------------------------------"
        echo
    } >&2

    for (( i = 1; i <= rounds; i++ )); do
        while true; do
            pw="$(LC_ALL=C tr -dc "$char_pool" < /dev/urandom | head -c "$length")"
            _passgen_validate "$pw" || continue
            printf '%s\n' "$pw"
            break
        done
    done
}

# DESC: Identify and optionally kill orphaned 'menu' processes
function lsmenu() {
    local action="list" assume_yes=0 menu_user="oracle" pattern='/bin/sh ./menu' show_all=0
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc
    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --kill)    action="kill" ;;
            --yes|-y)  assume_yes=1 ;;
            --all)     show_all=1 ;;
            --user)    _dba_need_val "$1" "${2-}" || return 1; menu_user="$2"; shift ;;
            --pattern) _dba_need_val "$1" "${2-}" || return 1; pattern="$2"; shift ;;
            -h|--help)
                cat <<'EOF'
Usage: lsmenu [--all] [--kill [--yes]] [--user USER] [--pattern TEXT]
              [--grep PATTERN] [--grep-v PATTERN] [--csv|--json|--raw] [--no-header] [--no-color]

Identify and optionally kill orphaned 'menu' processes ('/bin/sh ./menu').

A menu process is considered orphaned when:
  - it has no controlling terminal (TTY '?'): the login session that started it is
    gone (closed PuTTY window, dropped VPN, ssh timeout) - the usual case, even when
    its parent shell still exists; or
  - its parent has exited (parent PID 1 or a 'systemd' process).
Menus whose session has ended often loop on the closed terminal and burn a full
CPU each - check the CPU_TIME column.

Columns: PID, PPID, PARENT (parent command), USER, TTY, STARTED, ELAPSED, CPU_TIME,
         ORPHANED (YES/NO), REASON
Rows are sorted by CPU_TIME, highest first.

Options:
  --all             Also list menu processes that still have a terminal (ORPHANED = NO);
                    --kill never touches those
  --kill            Kill the orphaned processes: SIGTERM first, then SIGKILL for any
                    process still alive after 5 seconds. Asks for confirmation.
  --yes, -y         Do not ask for confirmation with --kill.
  --user USER       Owner of the menu processes (default: oracle).
  --pattern TEXT    Command line to look for (default: '/bin/sh ./menu'). The process
                    command line must be exactly TEXT (optionally followed by arguments),
                    so shells that merely mention it are never matched.
  --grep / --grep-v, --csv|--json|--raw, --no-header, --no-color
  -h, --help        Display this help message.

Notes:
  - Only the menu processes are killed, never their parent shells.
  - A menu started from cron, nohup or setsid also has no terminal and is listed as
    orphaned - review the list before using --kill.

Return code: 0 = none found or all killed, 2 = orphaned processes found (list mode),
             1 = error or a process could not be killed

Examples:
  lsmenu
  lsmenu --all
  lsmenu --kill
  lsmenu --kill --yes
EOF
                return 0
                ;;
            *)
                _dba_err "Unknown option: $1 (see lsmenu --help)"
                return 1
                ;;
        esac
        shift
    done
    _dba_check_modes || return 1

    _lsmenu_secs() {    # [DD-]HH:MM:SS or MM:SS -> seconds
        awk -v t="$1" 'BEGIN { d = 0; if (index(t, "-")) { split(t, x, "-"); d = x[1]; t = x[2] }
                               n = split(t, a, ":"); s = 0; for (i = 1; i <= n; i++) s = s * 60 + a[i]
                               print d * 86400 + s }'
    }

    local -a pids=()
    local rows="" pid ppid user tty lstart etime cputime args pcomm orphan reason
    local nfound=0
    while read -r pid ppid user tty cputime etime args; do
        [[ "$user" == "$menu_user" ]] || continue
        # exact command line (plus optional arguments) - never parent shells that only mention it
        [[ "$args" == "$pattern" || "$args" == "$pattern "* ]] || continue
        pcomm="$(ps -o comm= -p "$ppid" 2>/dev/null)"
        reason=""
        [[ "$tty" == "?" || -z "$tty" ]] && reason="no terminal"
        if [[ "$ppid" == "1" || "$pcomm" == systemd* ]]; then
            reason="${reason:+$reason, }parent exited"
        fi
        if [[ -n "$reason" ]]; then
            orphan="YES"
            pids+=("$pid")
            nfound=$(( nfound + 1 ))
        else
            orphan="NO"
            reason="session active"
            (( show_all )) || continue
        fi
        lstart="$(date -d "$(ps -o lstart= -p "$pid" 2>/dev/null)" '+%Y-%m-%d %H:%M' 2>/dev/null)"
        rows+="$(_lsmenu_secs "$cputime")|$pid|$ppid|${pcomm:--}|$user|$tty|${lstart:--}|$etime|$cputime|$orphan|$reason"$'\n'
    done < <(ps -eo pid=,ppid=,user:32=,tty=,time=,etime=,args=)

    if [[ -z "$rows" ]]; then
        echo "No orphaned 'menu' processes found for user '$menu_user'."
        return 0
    fi

    local data="PID|PPID|PARENT|USER|TTY|STARTED|ELAPSED|CPU_TIME|ORPHANED|REASON"
    data+=$'\n'"$(sort -t'|' -k1,1nr <<< "${rows%$'\n'}" | cut -d'|' -f2-)"

    if (( nfound == 0 )); then
        echo "No orphaned 'menu' processes found for user '$menu_user' (menus with an active session are listed below)."
        _dba_emit "$data"
        return 0
    fi
    echo "Orphaned 'menu' processes found for user '$menu_user': $nfound"
    _dba_emit "$data"

    [[ "$action" == "kill" ]] || return 2

    if (( ! assume_yes )); then
        local answer
        if [[ ! -t 0 ]]; then
            _dba_err "Refusing to kill without a terminal. Re-run with --yes."
            return 1
        fi
        read -r -p "Kill ${#pids[@]} orphaned process(es)? Type YES to continue: " answer
        [[ "$answer" == "YES" ]] || { echo "Aborted."; return 1; }
    fi

    local count=0 failed=0 waited
    kill -TERM "${pids[@]}" 2>/dev/null
    for (( waited = 0; waited < 5; waited++ )); do
        local alive=0
        for pid in "${pids[@]}"; do kill -0 "$pid" 2>/dev/null && alive=1; done
        (( alive )) || break
        sleep 1
    done
    for pid in "${pids[@]}"; do
        if kill -0 "$pid" 2>/dev/null; then
            if kill -KILL "$pid" 2>/dev/null; then
                echo "Killed process ID: $pid (SIGKILL)"
                count=$(( count + 1 ))
            else
                echo "Failed to kill process ID: $pid" >&2
                failed=$(( failed + 1 ))
            fi
        else
            echo "Terminated process ID: $pid (SIGTERM)"
            count=$(( count + 1 ))
        fi
    done
    echo "Total orphaned processes killed: $count"
    (( failed == 0 ))
}

# DESC: List Oracle homes with type, version and usage status (ACTIVE/CONFIGURED/INSTALLED)
function lsoh() {
    local type_filter="" column_filter="" status_filter="" full_mode=0 size_mode=0
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc
    local usage_line="Usage: lsoh [--full] [--size] [--type TYPE] [--status REGEX] [--column COL] [--csv|--json|--raw] [--grep PATTERN] [--grep-v PATTERN] [--no-header] [--no-color]"

    _lsoh_type_match() {
        local actual="${1^^}" requested="${2,,}"
        case "$requested" in
            db|dbms)      [[ "$actual" == DBMS* ]] ;;
            grid)         [[ "$actual" == GRID* ]] ;;
            ogg)          [[ "$actual" == OGG* ]] ;;
            agent|agnt)   [[ "$actual" == "AGNT" ]] ;;
            client|clnt)  [[ "$actual" == "CLNT" ]] ;;
            ohs)          [[ "$actual" == "OHS" ]] ;;
            ocmn)         [[ "$actual" == "OCMN" ]] ;;
            *)            printf '%s\n' "$actual" | grep -Eiq -- "$2" ;;
        esac
    }

    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --full) full_mode=1 ;;
            --size) size_mode=1 ;;
            --type)
                _dba_need_val "$1" "${2-}" || { echo "$usage_line" >&2; return 1; }
                type_filter="$2"; shift
                ;;
            --status)
                _dba_need_val "$1" "${2-}" || return 1
                status_filter="$2"; shift
                ;;
            --column)
                _dba_need_val "$1" "${2-}" || return 1
                column_filter="${2,,}"; shift
                case "$column_filter" in
                    name|location|version|type|status|detail|rooh) ;;
                    size) size_mode=1 ;;
                    *) _dba_err "Invalid --column value: $column_filter (valid: name, location, version, type, status, detail, rooh, size)"; return 1 ;;
                esac
                ;;
            -h|--help)
                cat <<'EOF'
Usage: lsoh [options]

Lists the Oracle homes registered in the central inventory (oraInst.loc -> inventory.xml).

Default columns: NAME, LOCATION, VERSION, TYPE, STATUS
--full adds    : DETAIL, ROOH
--size adds    : SIZE_GB

TYPE   DBMS EE / DBMS SE2 / ..., GRID, AGNT, CLNT, OHS, OCMN, OGG MA, OGG CA
STATUS
  DBMS     ACTIVE (N DBs)         N database instances run from this home (from the running
                                  PMON binary, so out-of-place patching is counted correctly)
           ACTIVE (N processes)   no database, but other processes (e.g. a listener) run from it
           CONFIGURED (N in oratab, down)  oratab references it but nothing runs from it
           INSTALLED              not used
  GRID     ACTIVE (CRS)           the active Clusterware / Oracle Restart home
           ACTIVE (N processes) / INSTALLED
  OGG MA   ACTIVE (N deployments) adminsrvr processes running from this home
           ACTIVE (ServiceManager only) / INSTALLED
  others   ACTIVE (N processes) / INSTALLED
DETAIL     SIDs (DBMS/GRID) or deployment names (OGG MA) using the home
ROOH       YES = read-only Oracle home (orabasehome differs from the home), NO, or '-'
SIZE_GB    du of the home (slow - only with --size or --column size)

Options:
  --full              Add DETAIL and ROOH columns
  --size              Add SIZE_GB (runs du on every home, limited to 5 minutes in total)
  --type TYPE         Filter by TYPE (see below)
  --status REGEX      Filter by STATUS (case-insensitive regex), e.g. installed, active
  --column COL        Show only one column: name|location|version|type|status|detail|rooh|size
  --csv|--json|--raw  Output format (default: table)
  --grep PATTERN      Include only rows matching PATTERN (case-insensitive regex)
  --grep -v PATTERN   Exclude rows matching PATTERN (same as --grep-v)
  --no-header         Suppress header row (table/csv only)
  --no-color          Do not color the STATUS column
  -h, --help          Show this help

TYPE values:
  db | dbms        Database homes        grid            Grid homes
  ogg              GoldenGate homes      agent | agnt    OEM agent homes
  client | clnt    Oracle client homes   ohs             Oracle HTTP Server homes
  ocmn             Oracle common homes   <regex>         Any regex matched against TYPE

Notes:
  - Homes flagged REMOVED="T" (detached) in the central inventory are not listed.
  - Process detection needs read access to /proc/<pid>/exe (run as the software owner).
  - OGG deployment names are taken from the adminsrvr command line (--deployment /
    --deploymentName) or its OGG_ETC_HOME environment; 'unnamed' when not found.
  - --raw with --column prints one value per line; --no-header has no effect on --json/--raw.

Examples:
  lsoh
  lsoh --full
  lsoh --type db --status installed        (clean-up candidates after patching)
  lsoh --type ogg --full
  lsoh --size --csv
  lsoh --column location --raw
EOF
                return 0
                ;;
            *)
                _dba_err "Unknown option: $1"
                echo "$usage_line" >&2
                return 1
                ;;
        esac
        shift
    done
    _dba_check_modes || return 1

    local central_inv
    local orainst_loc="${DBA_ORAINST_LOC:-/etc/oraInst.loc}"
    [[ -r "$orainst_loc" ]] || orainst_loc="/var/opt/oracle/oraInst.loc"
    central_inv="$(awk -F= '$1 == "inventory_loc" { print $2; exit }' "$orainst_loc" 2>/dev/null)"
    [[ -z "$central_inv" ]] && { _dba_err "Could not determine central inventory location ($orainst_loc)."; return 1; }
    [[ -f "$central_inv/ContentsXML/inventory.xml" ]] || { _dba_err "No inventory file found: $central_inv/ContentsXML/inventory.xml"; return 1; }

    # 1) Inventory: NAME|LOCATION|VERSION|TYPE|COMP
    local -a homes=()
    local line oh oh_name comp_file comp_xml comp_name comp_vers edition version major install_type
    while IFS= read -r line; do
        [[ "$(_dba_xml_attr "$line" REMOVED)" == "T" ]] && continue
        oh="$(_dba_xml_attr "$line" LOC)"
        [[ -z "$oh" || ! -d "$oh" ]] && continue
        oh="${oh%/}"
        oh_name="$(_dba_xml_attr "$line" NAME)"
        comp_file="$oh/inventory/ContentsXML/comps.xml"
        [[ -f "$comp_file" ]] || continue
        comp_xml="$(grep 'COMP NAME' "$comp_file" | grep -m1 'oracle.sysman.top.agent')"
        [[ -z "$comp_xml" ]] && comp_xml="$(grep -m1 'COMP NAME' "$comp_file")"
        [[ -z "$comp_xml" ]] && continue
        comp_name="$(_dba_xml_attr "$comp_xml" NAME)"
        comp_vers="$(_dba_xml_attr "$comp_xml" VER)"
        edition=""
        version="$comp_vers"
        case "$comp_name" in
            oracle.crs)
                edition="GRID"
                [[ -x "$oh/bin/oraversion" ]] && version="$("$oh/bin/oraversion" -compositeVersion 2>/dev/null)"
                ;;
            oracle.sysman.top.agent|oracle.sysman.emagent.installer)
                edition="AGNT"
                ;;
            oracle.server)
                version="$(_dba_xml_attr "$(grep -m1 'PATCH NAME="oracle.server"' "$comp_file" 2>/dev/null)" VER)"
                [[ -z "$version" ]] && version="$comp_vers"
                [[ -x "$oh/bin/oraversion" ]] && version="$("$oh/bin/oraversion" -compositeVersion 2>/dev/null)"
                major="${version%%.*}"
                install_type=""
                case "$major" in
                    10)
                        install_type="$(_dba_xml_attr "$(grep -h -m1 's_serverInstallType' "$oh"/inventory/Components21/oracle.server/*/context.xml 2>/dev/null)" VALUE)"
                        ;;
                    1[1-9]|2[0-9])
                        install_type="$(_dba_xml_attr "$(grep -m1 'oracle_install_db_InstallType' "$oh/inventory/globalvariables/oracle.server/globalvariables.xml" 2>/dev/null)" VALUE)"
                        ;;
                esac
                edition="DBMS${install_type:+ $install_type}"
                ;;
            oracle.client)            edition="CLNT" ;;
            oracle.as.webtiercd.top)  edition="OHS" ;;
            oracle.as.common.top)     edition="OCMN" ;;
            oracle.oggcore.top)       edition="OGG CA" ;;
            oracle.oggcore.services)
                edition="OGG MA"
                [[ -x "$oh/bin/adminclient" ]] && version="$("$oh/bin/adminclient" --version 2>/dev/null | grep -i -m1 version | awk '{print $2}')"
                [[ -z "$version" ]] && version="$comp_vers"
                ;;
            *)
                edition="$comp_name"
                ;;
        esac
        case "$comp_name" in
            oracle.client|oracle.as.webtiercd.top|oracle.as.common.top|oracle.oggcore.top)
                [[ -x "$oh/bin/oraversion" ]] && version="$("$oh/bin/oraversion" -compositeVersion 2>/dev/null)"
                ;;
        esac
        [[ -z "$version" ]] && version="$comp_vers"
        if [[ -n "$type_filter" ]]; then
            _lsoh_type_match "$edition" "$type_filter" || continue
        fi
        homes+=("$(_dba_clean "$oh_name")|$(_dba_clean "$oh")|$(_dba_clean "$version")|$(_dba_clean "$edition")")
    done < <(grep '<HOME NAME=' "$central_inv/ContentsXML/inventory.xml" 2>/dev/null)

    # 2) Usage information (one pass over /proc, PMON list, oratab, OGG processes)
    local hlist="" h
    for h in "${homes[@]}"; do hlist+="$(cut -d'|' -f2 <<< "$h")"$'\n'; done
    local -A nproc=() dbs=() dbn=() tabn=() deps=() depn=() smn=()
    local pid exe hh sid args
    while IFS='|' read -r pid hh; do
        [[ -n "$hh" ]] && nproc["$hh"]=$(( ${nproc[$hh]:-0} + 1 ))
    done < <(_dba_proc_exes | awk -F'|' -v hl="$hlist" '
        BEGIN { n = split(hl, H, "\n") }
        { for (i = 1; i <= n; i++) if (H[i] != "" && index($2, H[i] "/") == 1) { print $1 "|" H[i]; break } }')
    while IFS='|' read -r sid hh; do
        [[ -z "$sid" || -z "$hh" ]] && continue
        hh="${hh%/}"
        dbn["$hh"]=$(( ${dbn[$hh]:-0} + 1 ))
        dbs["$hh"]+="${dbs[$hh]:+,}$sid"
    done < <(_dba_running_dbs)
    local asmline
    if asmline="$(_dba_asm_instance)"; then
        hh="${asmline#*|}"; hh="${hh%/}"
        dbs["$hh"]+="${dbs[$hh]:+,}${asmline%%|*}"
    fi
    local ot name tabhome
    if ot="$(_dba_oratab)"; then
        while IFS=: read -r name tabhome _; do
            [[ -z "$name" || "$name" == \#* || "$name" == [+*-]* ]] && continue
            tabhome="${tabhome%/}"
            tabn["$tabhome"]=$(( ${tabn[$tabhome]:-0} + 1 ))
        done < "$ot"
    fi
    while read -r pid exe args; do
        [[ "$exe" == */bin/adminsrvr || "$exe" == */bin/ServiceManager ]] || continue
        hh="${exe%/bin/*}"
        if [[ "$exe" == */ServiceManager ]]; then
            smn["$hh"]=1
            continue
        fi
        local dep=""
        if [[ "$args" =~ --deployment(Name)?[=[:space:]]+([^[:space:]]+) ]]; then
            dep="${BASH_REMATCH[2]}"
        else
            dep="$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | sed -n 's/^OGG_ETC_HOME=//p' | head -1)"
            [[ -n "$dep" ]] && dep="$(basename "$(dirname "${dep%/}")")"
        fi
        depn["$hh"]=$(( ${depn[$hh]:-0} + 1 ))
        deps["$hh"]+="${deps[$hh]:+,}${dep:-unnamed}"
    done < <(ps -eo pid=,args= | awk '$2 ~ /\/bin\/(adminsrvr|ServiceManager)$/ { print }')

    local data="NAME|LOCATION|VERSION|TYPE|STATUS|DETAIL|ROOH|SIZE_GB"
    local typ st det rooh size obh crs=""
    local gh; gh="$(_dba_grid_home 2>/dev/null)" && crs="${gh%/}"
    (( size_mode )) && echo "Measuring Oracle home sizes - please wait..." >&2
    local deadline=$(( $(date +%s) + 300 ))
    for h in "${homes[@]}"; do
        IFS='|' read -r oh_name oh version typ <<< "$h"
        det="-"
        case "$typ" in
            DBMS*)
                local n_db="${dbn[$oh]:-0}"
                if (( n_db > 0 )); then st="ACTIVE ($n_db DB$( (( n_db > 1 )) && echo s))"; det="${dbs[$oh]}"
                elif (( ${nproc[$oh]:-0} > 0 )); then st="ACTIVE (${nproc[$oh]} processes)"
                elif (( ${tabn[$oh]:-0} > 0 )); then st="CONFIGURED (${tabn[$oh]} in oratab, down)"
                else st="INSTALLED"; fi
                ;;
            GRID*)
                local active_crs=0
                if [[ -x "$oh/srvm/admin/getcrshome" ]]; then
                    [[ "$("$oh/srvm/admin/getcrshome" 2>/dev/null)" == "$oh" ]] && active_crs=1
                elif [[ -n "$crs" && "$crs" == "$oh" ]]; then
                    active_crs=1
                fi
                if (( active_crs )); then st="ACTIVE (CRS)"
                elif (( ${nproc[$oh]:-0} > 0 )); then st="ACTIVE (${nproc[$oh]} processes)"
                else st="INSTALLED"; fi
                [[ -n "${dbs[$oh]:-}" ]] && det="${dbs[$oh]}"
                ;;
            "OGG MA")
                local n_dep="${depn[$oh]:-0}"
                if (( n_dep > 0 )); then st="ACTIVE ($n_dep deployment$( (( n_dep > 1 )) && echo s))"; det="${deps[$oh]}"
                elif [[ -n "${smn[$oh]:-}" ]]; then st="ACTIVE (ServiceManager only)"
                elif (( ${nproc[$oh]:-0} > 0 )); then st="ACTIVE (${nproc[$oh]} processes)"
                else st="INSTALLED"; fi
                ;;
            *)
                if (( ${nproc[$oh]:-0} > 0 )); then st="ACTIVE (${nproc[$oh]} processes)"; else st="INSTALLED"; fi
                ;;
        esac
        rooh="-"
        if (( full_mode )) || [[ "$column_filter" == rooh ]]; then
            if [[ -x "$oh/bin/orabasehome" ]]; then
                obh="$(_dba_env_run "" "$oh" "$oh/bin/orabasehome" 2>/dev/null | tail -1)"
                if [[ -n "$obh" ]]; then
                    if [[ "${obh%/}" == "$oh" ]]; then rooh="NO"; else rooh="YES"; fi
                fi
            fi
        fi
        size="-"
        if (( size_mode )); then
            local left=$(( deadline - $(date +%s) ))
            if (( left > 0 )); then
                size="$(timeout "$left" du -sk "$oh" 2>/dev/null | awk '{ printf "%.1f", $1 / 1048576 }')"
                [[ -z "$size" ]] && size="timeout"
            else
                size="timeout"
            fi
        fi
        data+=$'\n'"$oh_name|$oh|$version|$typ|$st|$(_dba_clean "$det")|$rooh|$size"
    done

    if [[ -n "$status_filter" ]]; then
        data="$(_dba_filter_rows "$data" "$status_filter" "" "5")"
    fi
    data="$(_dba_filter_rows "$data" "$_o_grep" "$_o_grepv")"
    local cols="NAME,LOCATION,VERSION,TYPE,STATUS"
    (( full_mode )) && cols+=",DETAIL,ROOH"
    (( size_mode )) && cols+=",SIZE_GB"
    if [[ -n "$column_filter" ]]; then
        cols="${column_filter^^}"
        [[ "$cols" == SIZE ]] && cols="SIZE_GB"
    fi
    data="$(_dba_select_columns "$data" "$cols")" || return 1
    _dba_render "$_o_mode" "$_o_nohdr" "$data"
}
# DESC: Display Oracle patch levels across homes
function lspatches() {
    local display_mode="short" column_filter="" parallel=4
    local -a homes=()
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc

    _lspatches_normalize_column() {
        case "${1,,}" in
            home|oracle_home) echo "HOME" ;;
            java)             echo "Java" ;;
            jdk)              echo "JDK" ;;
            ojvm)             echo "OJVM" ;;
            database|db)      echo "Database" ;;
            datapump|dp)      echo "Datapump" ;;
            tomcat)           echo "TOMCAT" ;;
            ocw)              echo "OCW" ;;
            acfs)             echo "ACFS" ;;
            dbwlm)            echo "DBWLM" ;;
            *)                return 1 ;;
        esac
    }

    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --full)  display_mode="full" ;;
            --short) display_mode="short" ;;
            --column)
                _dba_need_val "$1" "${2-}" || return 1
                column_filter="$(_lspatches_normalize_column "$2")" || {
                    _dba_err "Invalid --column value: $2 (valid: home, java, jdk, ojvm, database, datapump, tomcat, ocw, acfs, dbwlm)"
                    return 1
                }
                shift
                ;;
            --parallel)
                _dba_need_val "$1" "${2-}" || return 1
                [[ "$2" =~ ^[1-9][0-9]*$ ]] || { _dba_err "--parallel must be a positive number"; return 1; }
                parallel="$2"; shift
                ;;
            -h|--help)
                cat <<'EOF'
Usage: lspatches [options] [ORACLE_HOME ...]

Patch detail modes:
  --short                      Show default patch columns (default)
  --full                       Show all supported patch columns

Output modes:
  --csv                        Output in CSV format
  --json                       Output in JSON format
  --raw                        Script-friendly raw output (tab separated, no header)
  --no-header                  Suppress header row (table/csv only)

Filtering:
  --grep PATTERN               Include only rows matching PATTERN (case-insensitive regex)
  --grep -v PATTERN            Exclude rows matching PATTERN (case-insensitive regex)
  --grep-v PATTERN             Same as: --grep -v PATTERN
  --column COL                 Show only one column

Performance:
  --parallel N                 Number of 'opatch lspatches' run concurrently (default: 4).
                               Use --parallel 1 to run them one at a time.

Column values:
  home | oracle_home, java, jdk, ojvm, database | db, datapump | dp,
  tomcat, ocw, acfs, dbwlm  (tomcat/ocw/acfs/dbwlm require --full)

Notes:
  - If no ORACLE_HOME values are given, DB and Grid homes are discovered with lsoh,
    falling back to oratab.
  - If opatch fails for a home, the Database column shows ERROR (opatch rc=N).
  - Database = 'Database Release Update'; any other '... Release Update' line (other
    wording in newer releases such as 26ai) is used when that is not found.

Examples:
  lspatches
  lspatches --full
  lspatches --csv
  lspatches --grep 19.31
  lspatches --column database
  lspatches --column home --raw
  lspatches --full --column ocw
  lspatches /u01/app/oracle/product/19.31.0/dbhome_1
EOF
                return 0
                ;;
            --*)
                _dba_err "Unknown option: $1 (see lspatches --help)"
                return 1
                ;;
            *)
                homes+=("$1")
                ;;
        esac
        shift
    done
    _dba_check_modes || return 1

    local -a all_components=("HOME" "Java" "JDK" "OJVM" "Database" "Datapump" "TOMCAT" "OCW" "ACFS" "DBWLM")
    local -a short_components=("HOME" "Java" "JDK" "OJVM" "Database" "Datapump")
    local -a components
    if [[ "$display_mode" == "full" ]]; then
        components=("${all_components[@]}")
    else
        components=("${short_components[@]}")
    fi

    if [[ -n "$column_filter" ]]; then
        local c ok=0
        for c in "${components[@]}"; do [[ "$c" == "$column_filter" ]] && ok=1; done
        if (( ! ok )); then
            _dba_err "Column '$column_filter' is only available in --full mode."
            return 1
        fi
    fi

    # Discover homes: lsoh first (inventory), oratab as fallback
    if (( ${#homes[@]} == 0 )); then
        mapfile -t homes < <(lsoh --raw --type '^(DBMS|GRID)' --column location 2>/dev/null | sort -u)
        if (( ${#homes[@]} == 0 )); then
            local ot
            if ot="$(_dba_oratab)"; then
                mapfile -t homes < <(awk -F: '$0 !~ /^[[:space:]]*#/ && NF >= 2 && $2 != "" { print $2 }' "$ot" | sort -u)
            fi
        fi
        if (( ${#homes[@]} == 0 )); then
            _dba_err "No Oracle homes found (inventory and oratab) and none provided."
            return 1
        fi
    fi

    # Validate homes first so the count shown to the user is accurate
    local -a valid_homes=()
    local home idx
    for home in "${homes[@]}"; do
        [[ -z "$home" ]] && continue
        if [[ ! -x "$home/OPatch/opatch" ]]; then
            _dba_warn "Skipping $home (OPatch not found)"
            continue
        fi
        valid_homes+=("$home")
    done
    if (( ${#valid_homes[@]} == 0 )); then
        _dba_err "No Oracle homes with OPatch found."
        return 1
    fi

    local tmpdir
    tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/lspatches.XXXXXX")" || return 1

    if (( parallel > 1 && ${#valid_homes[@]} > 1 )); then
        printf 'Found %d Oracle homes, running lspatches in parallel - please wait...\n' "${#valid_homes[@]}" >&2
    else
        printf 'Found %d Oracle home(s), running lspatches - please wait...\n' "${#valid_homes[@]}" >&2
    fi

    # Background jobs are started inside a subshell so the interactive shell
    # does not print job-control messages ([1] 12345 / Done ...)
    (
        running=0
        for idx in "${!valid_homes[@]}"; do
            home="${valid_homes[$idx]}"
            (
                _dba_env_run "" "$home" "$home/OPatch/opatch" lspatches -oh "$home" > "$tmpdir/$idx.out" 2>&1
                echo $? > "$tmpdir/$idx.rc"
            ) &
            running=$(( running + 1 ))
            if (( running >= parallel )); then
                wait
                running=0
            fi
        done
        wait
    )

    local data comp line opatch_rc java_ver i
    local old_ifs="$IFS"
    IFS='|'; data="${components[*]}"; IFS="$old_ifs"
    local -A patches
    for (( i = 0; i < ${#valid_homes[@]}; i++ )); do
        home="${valid_homes[$i]}"
        patches=()
        for comp in "${all_components[@]}"; do patches["$comp"]="n/a"; done
        patches["HOME"]="$home"

        if [[ -x "$home/jdk/bin/java" ]]; then
            java_ver="$("$home/jdk/bin/java" -version 2>&1 | sed -n 's/.*version "\(.*\)".*/\1/p' | head -1)"
            [[ -n "$java_ver" ]] && patches["Java"]="$java_ver"
        fi

        opatch_rc="$(cat "$tmpdir/$i.rc" 2>/dev/null)"
        if [[ "$opatch_rc" != "0" ]] || grep -q 'OPatch failed' "$tmpdir/$i.out" 2>/dev/null; then
            patches["Database"]="ERROR (opatch rc=${opatch_rc:-?})"
        else
            while IFS= read -r line; do
                case "$line" in
                    *"JDK BUNDLE PATCH"*)
                        patches["JDK"]="$(grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+(\.[0-9]+)?' <<< "$line" | head -1)" ;;
                    *"OJVM RELEASE UPDATE"*)
                        patches["OJVM"]="$(sed -n 's/.*OJVM RELEASE UPDATE:* *//p' <<< "$line")" ;;
                    *[Dd]"atabase "[Rr][Ee][Ll][Ee][Aa][Ss][Ee]" "[Uu][Pp][Dd][Aa][Tt][Ee]*)
                        patches["Database"]="$(sed -n 's/.*Database [Rr][Ee][Ll][Ee][Aa][Ss][Ee] [Uu][Pp][Dd][Aa][Tt][Ee][[:space:]:]*//p' <<< "$line")" ;;
                    *"DATAPUMP BUNDLE PATCH"*)
                        patches["Datapump"]="$(sed -n 's/.*DATAPUMP BUNDLE PATCH *//p' <<< "$line")" ;;
                    *"TOMCAT RELEASE UPDATE"*)
                        patches["TOMCAT"]="$(sed -n 's/.*TOMCAT RELEASE UPDATE *//p' <<< "$line")" ;;
                    *"OCW RELEASE UPDATE"*)
                        patches["OCW"]="$(sed -n 's/.*OCW RELEASE UPDATE *//p' <<< "$line")" ;;
                    *"ACFS RELEASE UPDATE"*)
                        patches["ACFS"]="$(sed -n 's/.*ACFS RELEASE UPDATE *//p' <<< "$line")" ;;
                    *"DBWLM RELEASE UPDATE"*)
                        patches["DBWLM"]="$(sed -n 's/.*DBWLM RELEASE UPDATE *//p' <<< "$line")" ;;
                    *[Rr][Ee][Ll][Ee][Aa][Ss][Ee]" "[Uu][Pp][Dd][Aa][Tt][Ee]*)
                        # Other Release Update wording (e.g. 26ai): use it for Database when not set yet
                        if [[ "${patches[Database]}" == "n/a" ]]; then
                            patches["Database"]="$(sed -n 's/.*[Rr][Ee][Ll][Ee][Aa][Ss][Ee] [Uu][Pp][Dd][Aa][Tt][Ee][[:space:]:]*//p' <<< "$line")"
                        fi ;;
                esac
            done < "$tmpdir/$i.out"
        fi

        line=""
        for comp in "${components[@]}"; do
            [[ -z "${patches[$comp]}" ]] && patches["$comp"]="n/a"
            line+="$(_dba_clean "${patches[$comp]}")|"
        done
        data+=$'\n'"${line%|}"
    done
    rm -rf -- "$tmpdir"

    data="$(_dba_filter_rows "$data" "$_o_grep" "$_o_grepv")"
    if [[ -n "$column_filter" ]]; then
        data="$(_dba_select_columns "$data" "$column_filter")" || return 1
    fi
    _dba_render "$_o_mode" "$_o_nohdr" "$data"
}
# DESC: List listeners (CRS-managed, SCAN and standalone) with filtering
function lslsnr() {
    local column_filter="" status_filter=""
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc

    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --column)
                _dba_need_val "$1" "${2-}" || return 1
                case "${2,,}" in
                    name|listener_name)  column_filter="LISTENER_NAME" ;;
                    type)                column_filter="TYPE" ;;
                    home|oracle_home)    column_filter="ORACLE_HOME" ;;
                    port|listener_port)  column_filter="LISTENER_PORT" ;;
                    status)              column_filter="STATUS" ;;
                    running)             column_filter="RUNNING" ;;
                    *) _dba_err "Invalid --column value: $2 (valid: name, type, home, port, status, running)"; return 1 ;;
                esac
                shift
                ;;
            --status)
                _dba_need_val "$1" "${2-}" || return 1
                status_filter="${2,,}"
                case "$status_filter" in
                    enabled|disabled) ;;
                    *) _dba_err "Invalid --status value: $2 (valid: enabled, disabled)"; return 1 ;;
                esac
                shift
                ;;
            -h|--help)
                cat <<'EOF'
Usage: lslsnr [options]

Lists listeners on this host:
  LOCAL       CRS/HAS-managed listeners       (srvctl config/status listener)
  SCAN        SCAN listeners on RAC clusters  (srvctl config/status scan_listener)
  STANDALONE  Running tnslsnr processes not registered in CRS (port from lsnrctl status)

Columns:
  LISTENER_NAME, TYPE, ORACLE_HOME, LISTENER_PORT,
  STATUS  (srvctl enabled/disabled - configuration, NOT whether it is running)
  RUNNING (yes/no from srvctl status; standalone listeners are always 'yes')

Options:
  --csv | --json | --raw        Output format (default: table)
  --grep PATTERN                Include only rows matching PATTERN (case-insensitive regex)
  --grep -v PATTERN | --grep-v  Exclude rows matching PATTERN
  --column COL                  Show only one column: name|type|home|port|status|running
  --status STATUS               Filter by srvctl status: enabled|disabled
  --no-header                   Suppress header row (table/csv only)
  -h, --help                    Show this help

Notes:
  - The Grid home is read from /etc/oracle/olr.loc (works with +ASM1, +ASM2 ...).
  - Multiple ports are shown as a semicolon-separated list.

Examples:
  lslsnr
  lslsnr --csv
  lslsnr --grep -v SCAN
  lslsnr --column port
  lslsnr --status enabled --column name --raw
EOF
                return 0
                ;;
            *)
                _dba_err "Unknown option: $1 (see lslsnr --help)"
                return 1
                ;;
        esac
        shift
    done
    _dba_check_modes || return 1

    local grid data="LISTENER_NAME|TYPE|ORACLE_HOME|LISTENER_PORT|STATUS|RUNNING"
    local -A known=() running=()
    local line name home port status

    _lslsnr_flush() {
        [[ -z "$name" ]] && return 0
        [[ -z "$home" || "$home" == "<CRS home>" ]] && home="$grid"
        known["${name^^}"]=1
        data+=$'\n'"$name|LOCAL|$home|$port|$status|${running[${name^^}]:-no}"
    }

    grid="$(_dba_grid_home)"
    if [[ -n "$grid" ]]; then
        local cfg_out status_out
        status_out="$(_dba_env_run "" "$grid" srvctl status listener 2>/dev/null)"
        while IFS= read -r line; do
            if [[ "$line" =~ ^Listener[[:space:]]+([^[:space:]]+)[[:space:]]+is[[:space:]]+running ]]; then
                running["${BASH_REMATCH[1]^^}"]="yes"
            fi
        done <<< "$status_out"

        cfg_out="$(_dba_env_run "" "$grid" srvctl config listener 2>/dev/null)"
        if [[ $? -ne 0 && -z "$cfg_out" ]]; then
            _dba_warn "srvctl config listener failed (Grid home: $grid)"
        fi
        name="" home="" port="" status=""
        while IFS= read -r line; do
            case "$line" in
                Name:*)
                    _lslsnr_flush
                    name="$(awk '{print $2}' <<< "$line")"; home=""; port=""; status=""
                    ;;
                Home:*)
                    home="${line#Home:}"
                    home="${home#"${home%%[![:space:]]*}"}"
                    ;;
                End\ points:*|Endpoints:*)
                    port="$(grep -oE 'TCP[S]?:[0-9]{2,5}(/[0-9]{2,5})*' <<< "$line" | grep -oE '[0-9]{2,5}' | sort -un | paste -sd';' -)"
                    ;;
                Listener\ is\ enabled*)  status="enabled" ;;
                Listener\ is\ disabled*) status="disabled" ;;
            esac
        done <<< "$cfg_out"
        _lslsnr_flush

        # SCAN listeners (clusters only - command fails quietly on single instance HAS)
        local scan_status scan_port
        scan_status="$(_dba_env_run "" "$grid" srvctl status scan_listener 2>/dev/null)"
        if [[ -n "$scan_status" ]] && grep -q 'SCAN [Ll]istener' <<< "$scan_status"; then
            scan_port="$(_dba_env_run "" "$grid" srvctl config scan_listener 2>/dev/null | grep -oE 'TCP:[0-9]{2,5}' | grep -oE '[0-9]+' | sort -un | paste -sd';' -)"
            local -A scan_en=() scan_run=()
            local -a scan_names=()
            while IFS= read -r line; do
                if [[ "$line" =~ SCAN[[:space:]][Ll]istener[[:space:]]+([^[:space:]]+)[[:space:]]+is[[:space:]]+(enabled|disabled) ]]; then
                    scan_names+=("${BASH_REMATCH[1]}")
                    scan_en["${BASH_REMATCH[1]}"]="${BASH_REMATCH[2]}"
                elif [[ "$line" =~ SCAN[[:space:]][Ll]istener[[:space:]]+([^[:space:]]+)[[:space:]]+is[[:space:]]+running[[:space:]]+on[[:space:]]+node[[:space:]]+([^[:space:]]+) ]]; then
                    scan_run["${BASH_REMATCH[1]}"]="yes (${BASH_REMATCH[2]})"
                fi
            done <<< "$scan_status"
            for name in "${scan_names[@]}"; do
                known["${name^^}"]=1
                data+=$'\n'"$name|SCAN|$grid|$scan_port|${scan_en[$name]}|${scan_run[$name]:-no}"
            done
        fi
    fi

    # Standalone listeners: running tnslsnr processes not registered in CRS
    local pid exe lhome lname tns_admin
    while read -r pid exe lname; do
        [[ -z "$lname" || "$lname" == -* ]] && lname="LISTENER"
        [[ -n "${known[${lname^^}]:-}" ]] && continue
        lhome="${exe%/bin/tnslsnr}"
        tns_admin="$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | sed -n 's/^TNS_ADMIN=//p')"
        port="$(
            if [[ -n "$tns_admin" ]]; then export TNS_ADMIN="$tns_admin"; fi
            _dba_env_run "" "$lhome" "$lhome/bin/lsnrctl" status "$lname" 2>/dev/null \
                | grep -oiE '\(PORT=[0-9]+\)' | grep -oE '[0-9]+' | sort -un | paste -sd';' -
        )"
        known["${lname^^}"]=1
        data+=$'\n'"$lname|STANDALONE|$lhome|${port:-unknown}|n/a|yes"
    done < <(ps -eo pid=,args= | awk '$2 ~ /\/bin\/tnslsnr$/ { print $1, $2, $3 }')

    if [[ -z "$grid" ]] && [[ "$data" != *$'\n'* ]]; then
        _dba_warn "No Grid/HAS home found and no running listeners detected."
    fi

    if [[ -n "$status_filter" ]]; then
        data="$(awk -F'|' -v s="$status_filter" 'NR == 1 || tolower($5) == s' <<< "$data")"
    fi
    data="$(_dba_filter_rows "$data" "$_o_grep" "$_o_grepv")"
    if [[ -n "$column_filter" ]]; then
        data="$(_dba_select_columns "$data" "$column_filter")" || return 1
    fi
    _dba_render "$_o_mode" "$_o_nohdr" "$data"
}

# DESC: Show the uptime for all the DBs on the host (running and down)
function dbuptime() {
    local full_mode=0
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc
    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --full) full_mode=1 ;;
            -h|--help)
                cat <<'EOF'
Usage: dbuptime [--grep PATTERN] [--grep-v PATTERN] [--full] [--csv|--json|--raw] [--no-header]

Shows startup time and uptime of every database instance on the host.
Running instances come from PMON (ORACLE_HOME from the running binary);
oratab database entries with no running instance are shown as DOWN.

Options:
  --grep PATTERN     Include only SIDs matching PATTERN (case-insensitive regex)
  --grep-v PATTERN   Exclude SIDs matching PATTERN
  --full             Show all columns
  --csv|--json|--raw Output format (default: table)
  --no-header        Suppress header row (table/csv only)
  -h, --help         Show help

Default columns:
  SID, DB_NAME, INSTANCE_ID, HOST_NAME, OPEN_MODE,
  DATABASE_ROLE, STATUS, CURRENT_START, UPTIME, PREV_START

Full columns:
  SID, DB_NAME, DB_UNIQUE_NAME, INSTANCE_ID, INSTANCE_NUMBER,
  INSTANCE_NAME, HOST_NAME, OPEN_MODE, DATABASE_ROLE, STATUS,
  CURRENT_START, UPTIME, PREV_START, ORACLE_HOME

Notes:
  - Mounted standbys are fully reported; PREV_START needs an OPEN database
    (AWR history) and is blank otherwise.
  - PREV_START is the latest AWR-recorded startup before the current one.

Examples:
  dbuptime
  dbuptime --grep em
  dbuptime --full --csv
  dbuptime --grep '^PRD'
EOF
                return 0
                ;;
            *)
                _dba_err "Unknown option: $1 (see dbuptime --help)"
                return 1
                ;;
        esac
        shift
    done
    _dba_check_modes || return 1

    local data="SID|DB_NAME|DB_UNIQUE_NAME|INSTANCE_ID|INSTANCE_NUMBER|INSTANCE_NAME|HOST_NAME|OPEN_MODE|DATABASE_ROLE|STATUS|CURRENT_START|UPTIME|PREV_START|ORACLE_HOME"
    local sid home state out line r_db r_uniq r_iid r_inum r_iname r_host r_om r_role r_start r_up got key
    local -A prev
    while IFS='|' read -r sid home state; do
        [[ -z "$sid" ]] && continue
        if [[ -n "$_o_grep" || -n "$_o_grepv" ]]; then
            [[ "$(_dba_filter_rows "H"$'\n'"$sid" "$_o_grep" "$_o_grepv")" == *$'\n'* ]] || continue
        fi
        if [[ "$state" != "UP" ]]; then
            data+=$'\n'"$sid|||||||||DOWN||||$home"
            continue
        fi
        out="$(_dba_sql "$sid" "$home" 2>&1 <<'SQL'
set heading off feedback off pagesize 0 linesize 32767 trimspool on verify off echo off tab off
whenever sqlerror continue
select 'ROW|' || d.name || '|' || d.db_unique_name || '|' || i.inst_id || '|' || i.instance_number || '|' ||
       i.instance_name || '|' || i.host_name || '|' || d.open_mode || '|' || d.database_role || '|' ||
       to_char(i.startup_time, 'YYYY-MM-DD HH24:MI:SS') || '|' ||
       floor(sysdate - i.startup_time) || 'd ' ||
       trunc(mod(24 * (sysdate - i.startup_time), 24)) || 'h ' ||
       trunc(mod(1440 * (sysdate - i.startup_time), 60)) || 'm'
  from gv$instance i cross join v$database d
 order by i.inst_id;
select 'PREV|' || i.instance_number || '|' || to_char(max(h.startup_time), 'YYYY-MM-DD HH24:MI:SS')
  from dba_hist_database_instance h
  join v$database d on h.dbid = d.dbid
  join gv$instance i on h.instance_number = i.instance_number
 where h.startup_time < i.startup_time
 group by i.instance_number;
exit
SQL
)"
        prev=()
        while IFS= read -r line; do
            [[ "$line" == PREV\|* ]] || continue
            IFS='|' read -r _ key r_start <<< "$line"
            prev["$key"]="$r_start"
        done <<< "$out"
        got=0
        while IFS= read -r line; do
            [[ "$line" == ROW\|* ]] || continue
            IFS='|' read -r _ r_db r_uniq r_iid r_inum r_iname r_host r_om r_role r_start r_up <<< "$line"
            data+=$'\n'"$sid|$r_db|$r_uniq|$r_iid|$r_inum|$r_iname|$r_host|$r_om|$r_role|UP|$r_start|$r_up|${prev[$r_inum]:-}|$home"
            got=1
        done <<< "$out"
        (( got )) || data+=$'\n'"$sid|||||||||ERROR||||$home"
    done < <(_dba_db_targets | sort -t'|' -k1,1)

    if (( ! full_mode )); then
        data="$(_dba_select_columns "$data" "SID,DB_NAME,INSTANCE_ID,HOST_NAME,OPEN_MODE,DATABASE_ROLE,STATUS,CURRENT_START,UPTIME,PREV_START")"
    fi
    _dba_render "$_o_mode" "$_o_nohdr" "$data"
}

