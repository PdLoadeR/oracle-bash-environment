EOF
                return 0
                ;;
            *) _dba_err "Unknown option: $1 (see lsautoupg --help)"; return 1 ;;
        esac
        shift
    done
    _dba_check_modes || return 1

    local -A seen=()
    local pid cfg cwd d nproc=0
    _au_add() { local x="${1%/}"; [[ -n "$x" && -d "$x" && -z "${seen[$x]:-}" ]] && { seen[$x]=1; dirs+=("$x"); }; return 0; }
    if (( ${#dirs[@]} == 0 )); then
        [[ -n "${DBA_AUTOUPG_LOG_DIR:-}" ]] && _au_add "$DBA_AUTOUPG_LOG_DIR"
        while read -r pid; do
            [[ -z "$pid" ]] && continue
            nproc=$(( nproc + 1 ))
            cfg="$(tr '\0' '\n' < "/proc/$pid/cmdline" 2>/dev/null | awk 'p { print; exit } $0 == "-config" { p = 1 }')"
            [[ -z "$cfg" ]] && continue
            cwd="$(readlink "/proc/$pid/cwd" 2>/dev/null)"
            [[ "$cfg" != /* ]] && cfg="$cwd/$cfg"
            [[ -r "$cfg" ]] || continue
            while IFS= read -r d; do _au_add "$d"; done < <(sed -n 's/^[[:space:]]*global\.autoupg_log_dir[[:space:]]*=[[:space:]]*//p' "$cfg" | sed 's/[[:space:]]*$//')
        done < <(ps -eo pid=,args= | awk '/[a]utoupgrade/ && /java/ { print $1 }')
        local label p
        while IFS='|' read -r label p; do
            [[ "$label" == BASE ]] && _au_add "$p/cfgtoollogs/autoupgrade"
        done < <(_dba_oracle_paths)
        _au_add /tmp/autoupgrade
    else
        nproc="$(ps -eo args= | awk '/[a]utoupgrade/ && /java/' | wc -l)"
    fi
    echo "AutoUpgrade processes running: $nproc" >&2
    (( ${#dirs[@]} )) || { echo "No AutoUpgrade log directory found (use --dir)."; return 0; }

    local data="JOB|SID|STAGE|OPERATION|STATUS|PROGRESS|UPDATED|LAST_LOG_LINE|LOG_DIR"
    local sj rows py=""
    command -v python3 >/dev/null 2>&1 && py=python3
    [[ -z "$py" && -x /usr/libexec/platform-python ]] && py=/usr/libexec/platform-python
    _au_lastline() {    # <log_dir> <sid> <job> : last non-empty line of the newest log in the job dir
        local f
        f="$(ls -t "$1/$2/$3"/*.log 2>/dev/null | head -1)"
        [[ -n "$f" ]] || { echo "-"; return; }
        tac "$f" 2>/dev/null | awk 'NF { print; exit }' | cut -c1-120 | tr '|' '/'
    }
    for d in "${dirs[@]}"; do
        sj="$d/cfgtoollogs/upgrade/auto/status/status.json"
        rows=""
        if [[ -r "$sj" && -n "$py" ]]; then
            rows="$("$py" - "$sj" <<'PY' 2>/dev/null
import json, sys
def first(d, *keys):
    for k in keys:
        if k in d and d[k] not in (None, ""):
            return str(d[k])
    return "-"
def jobs(o):
    if isinstance(o, list):
        if o and all(isinstance(x, dict) for x in o) and any(("sid" in x or "dbName" in x) for x in o):
            return o
        for x in o:
            r = jobs(x)
            if r: return r
    elif isinstance(o, dict):
        for v in o.values():
            r = jobs(v)
            if r: return r
    return []
with open(sys.argv[1]) as f:
    data = json.load(f)
upd = first(data, "lastUpdateTime", "lastUpdate", "updateTime") if isinstance(data, dict) else "-"
for j in jobs(data):
    vals = [first(j, "jobNo", "jobNumber", "job", "jobId"),
            first(j, "sid", "dbName", "dbname"),
            first(j, "stage", "currentStage", "stageName"),
            first(j, "operation", "stageOperation", "currentOperation"),
            first(j, "status", "jobStatus", "state"),
            first(j, "percentage", "stageProgress", "progress", "percent"),
            first(j, "lastUpdateTime", "updateTime") if first(j, "lastUpdateTime", "updateTime") != "-" else upd]
    print("|".join(v.replace("|", "/").replace("\n", " ") for v in vals))
PY
)"
        fi
        if [[ -n "$rows" ]]; then
            local job sid stage op st pr up
            while IFS='|' read -r job sid stage op st pr up; do
                [[ "$pr" =~ ^[0-9]+$ ]] && pr="${pr}%"
                data+=$'\n'"$job|$sid|$stage|$op|$st|$pr|$up|$(_au_lastline "$d" "$sid" "$job")|$d"
            done <<< "$rows"
        else
            local sdir jdir
            for sdir in "$d"/*/; do
                sdir="${sdir%/}"
                [[ "$(basename "$sdir")" =~ ^(cfgtoollogs|temp)$ ]] && continue
                for jdir in "$sdir"/[0-9]*/; do
                    [[ -d "$jdir" ]] || continue
                    jdir="${jdir%/}"
                    data+=$'\n'"$(basename "$jdir")|$(basename "$sdir")|-|-|$( [[ -r "$sj" ]] && echo "see status.json" || echo "-")|-|$(date -r "$jdir" '+%Y-%m-%d %H:%M' 2>/dev/null)|$(_au_lastline "$d" "$(basename "$sdir")" "$(basename "$jdir")")|$d"
                done
            done
        fi
    done
    if [[ "$data" != *$'\n'* ]]; then
        echo "No AutoUpgrade jobs found in: ${dirs[*]}"
        return 0
    fi
    _dba_emit "$data"
}

