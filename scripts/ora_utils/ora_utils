    local data="SID|ROLE|LOG_MODE|LAST_FULL|LAST_INCR|LAST_ARCH|DB_AGE_H|ARCH_AGE_H|LAST_JOB|FAILED_24H|STATUS"
    local sid home any=0 overall=0
    while IFS='|' read -r sid home; do
