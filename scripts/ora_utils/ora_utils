# _dba_pivot <long data "KEY|COLUMN|VALUE" lines> <column list (comma)> <diff_only> <first header> <missing value>
# Pivots key/column/value lines into KEY|COL1|COL2...|SAME (MATCH/DIFF) rows (shared by dbparam-style views)
_dba_pivot() {
    awk -F'|' -v OFS='|' -v cols="$2" -v d="$3" -v h1="$4" -v miss="$5" '
        BEGIN { nc = split(cols, c, ",") }
        NF >= 3 {
            v = $3; for (i = 4; i <= NF; i++) v = v "/" $i
            if (!($1 in seen)) { seen[$1] = 1; p[++np] = $1 }
            val[$1, $2] = v
        }
        END {
            h = h1; for (i = 1; i <= nc; i++) h = h OFS c[i]; print h OFS "SAME"
            n = asort(p)
            for (k = 1; k <= n; k++) {
                q = p[k]; line = q; same = 1; first = ""
                for (i = 1; i <= nc; i++) {
                    x = ((q, c[i]) in val) ? val[q, c[i]] : miss
                    line = line OFS x
                    if (i == 1) first = x; else if (x != first) same = 0
                }
                if (d && same) continue
                print line OFS (same ? "MATCH" : "DIFF")
            }
        }' <<< "$1"
}

# DESC: RMAN configuration side by side across databases (retention, autobackup, compression, encryption, BCT ...)
function dbrmancfg() {
    local diff_only=0 dbre="" width=40
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc
    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --diff)  diff_only=1 ;;
            --width)
                _dba_need_val "$1" "${2-}" || return 1
                [[ "$2" =~ ^[0-9]+$ ]] && (( $2 == 0 || $2 >= 10 )) || { _dba_err "--width must be 0 (no wrapping) or 10 and more"; return 1; }
                width="$2"; shift ;;
            --db)    _dba_need_val "$1" "${2-}" || return 1; dbre="$2"; shift ;;
            -h|--help)
                cat <<'EOF'
Usage: dbrmancfg [--diff] [--width N] [--db REGEX]
                 [--grep PATTERN] [--grep-v PATTERN] [--csv|--json|--raw] [--no-header] [--no-color]

RMAN persistent configuration of every running database side by side, one row per
setting, one column per database, plus SAME = MATCH / DIFF.

Rows:
  Every setting in V$RMAN_CONFIGURATION (RETENTION POLICY, CONTROLFILE AUTOBACKUP,
  DEVICE TYPE, CHANNEL, COMPRESSION ALGORITHM, ENCRYPTION ..., ARCHIVELOG DELETION POLICY,
  SNAPSHOT CONTROLFILE NAME ...). '(default)' = not configured (RMAN default applies).
  BLOCK CHANGE TRACKING   ENABLED / DISABLED (V$BLOCK_CHANGE_TRACKING)
  CONTROL_FILE_RECORD_KEEP_TIME   parameter value (days of backup history in the control file)

Options:
  --diff         Only settings that differ between the databases
  --width N      Table mode only: wrap values longer than N characters (default 40, 0 = off)
  --db REGEX     Only query SIDs matching REGEX (case-insensitive)
  --grep / --grep-v, --csv|--json|--raw, --no-header, --no-color

Examples:
  dbrmancfg
  dbrmancfg --diff
  dbrmancfg --grep 'RETENTION|DELETION'
EOF
                return 0
                ;;
            *) _dba_err "Unknown option: $1 (see dbrmancfg --help)"; return 1 ;;
        esac
        shift
    done
    _dba_check_modes || return 1

    local sid home out err any=0 long=""
    local -a cols=()
    while IFS='|' read -r sid home; do
        [[ -z "$sid" ]] && continue
        any=1
        out="$(_dba_q "$sid" "$home" <<'SQL'
select 'R|' || name || '|' || replace(value, '|', '/') from v$rman_configuration;
select 'R|BLOCK CHANGE TRACKING|' || status from v$block_change_tracking;
select 'R|CONTROL_FILE_RECORD_KEEP_TIME|' || value from v$parameter where name = 'control_file_record_keep_time';
select 'OK|done' from dual;
SQL
)"
        if ! grep -q '^OK|done' <<< "$out"; then
            err="$(_dba_qerr "$out")"
            _dba_warn "$sid: $(_dba_clean "${err:-no output}")"
            continue
        fi
        cols+=("$sid")
        # several CHANNEL / DEVICE settings can exist: number duplicates so each one is a row
        long+="$(_dba_tag "$out" R | awk -F'|' -v s="$sid" '{ k = $1; n[k]++; if (n[k] > 1) k = k " #" n[k]; v = $2; for (i = 3; i <= NF; i++) v = v "/" $i; print k "|" s "|" v }')"$'\n'
    done < <(_dba_up_targets "$dbre")
    (( any )) || { _dba_err "No running databases found${dbre:+ matching '$dbre'}."; return 1; }
    (( ${#cols[@]} )) || { _dba_err "No database could be queried."; return 1; }

    local data
    data="$(_dba_pivot "$long" "$(IFS=,; echo "${cols[*]}")" "$diff_only" "SETTING" "(default)")"
    if [[ "$data" != *$'\n'* ]]; then echo "No differences found."; return 0; fi
    data="$(_dba_filter_rows "$data" "$_o_grep" "$_o_grepv")"
    if [[ "$_o_mode" == table ]] && (( width > 0 )); then data="$(_dba_wrap_cols "$data" "$width" 2)"; fi
    _dba_render "$_o_mode" "$_o_nohdr" "$data"
}

