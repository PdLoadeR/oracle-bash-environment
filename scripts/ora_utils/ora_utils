  GROWTH_GB      used space now minus used space at the start of the window
  DAYS_TO_FULL   (MAX_GB - USED_GB) / GB_PER_DAY ('-' when not growing)
  STATUS         CRIT when DAYS_TO_FULL <= --crit, WARN when <= --warn, else OK
  A TOTAL row per database sums all tablespaces.

Options:
  --days N       History window in days (default: 30; limited by the AWR retention)
  --warn DAYS    WARN threshold for DAYS_TO_FULL (default: 90)
  --crit DAYS    CRIT threshold for DAYS_TO_FULL (default: 30)
  --all          Also list tablespaces that are not growing (hidden by default)
  --force        Run even when CONTROL_MANAGEMENT_PACK_ACCESS does not include DIAGNOSTIC
  --db REGEX     Only query SIDs matching REGEX (case-insensitive)
  --grep / --grep-v, --csv|--json|--raw, --no-header, --no-color

Notes:
  - Licensing: AWR history is part of the Oracle Diagnostics Pack.
  - In a CDB, PDB tablespaces appear when AWR snapshots include them (CDB-level
    snapshots capture tablespace usage for the open PDBs).
  - TEMP and UNDO are excluded (their usage is not growth).

Return code: 0 = all OK/WARN, 2 = at least one CRIT, 1 = error

Examples:
  dbgrowth
  dbgrowth --days 90 --all
  dbgrowth --grep TOTAL
EOF
                return 0
                ;;
            *) _dba_err "Unknown option: $1 (see dbgrowth --help)"; return 1 ;;
        esac
        shift
    done
    _dba_check_modes || return 1
    [[ "$days" =~ ^[1-9][0-9]*$ && "$warn" =~ ^[0-9]+$ && "$crit" =~ ^[0-9]+$ ]] || { _dba_err "--days/--warn/--crit must be whole numbers"; return 1; }

    local data="DB|CON|TABLESPACE|USED_GB|MAX_GB|GROWTH_GB|GB_PER_DAY|DAYS_TO_FULL|STATUS"
    local sid home out err any=0 overall=0 rows
    while IFS='|' read -r sid home; do
        [[ -z "$sid" ]] && continue
        any=1
        if (( ! force )) && ! _dba_diag_pack "$sid" "$home"; then
            data+=$'\n'"$sid|-|-|-|-|-|-|-|SKIPPED (Diagnostics Pack not enabled - use --force)"
            continue
        fi
        out="$(_dba_q "$sid" "$home" <<SQL
with s as (select h.con_id, h.tablespace_id, to_date(h.rtime, 'MM/DD/YYYY HH24:MI:SS') t,
                  h.tablespace_usedsize u, h.tablespace_maxsize m
             from dba_hist_tbspc_space_usage h
            where h.dbid = (select dbid from v\$database)
              and to_date(h.rtime, 'MM/DD/YYYY HH24:MI:SS') > sysdate - $days),
     g as (select con_id, tablespace_id, min(t) t1, max(t) t2,
                  max(u) keep (dense_rank first order by t) u1,
                  max(u) keep (dense_rank last order by t) u2,
                  max(m) keep (dense_rank last order by t) m2
             from s group by con_id, tablespace_id)
select 'ROW|' || nvl((select c.name from v\$containers c where c.con_id = g.con_id), '-') || '|' || ts.name || '|' ||
       to_char(g.u2 * dt.block_size / 1073741824, 'FM9999990.00') || '|' ||
       to_char(g.m2 * dt.block_size / 1073741824, 'FM9999990.00') || '|' ||
       to_char((g.u2 - g.u1) * dt.block_size / 1073741824, 'FM9999990.00') || '|' ||
       to_char(case when g.t2 > g.t1 then (g.u2 - g.u1) * dt.block_size / 1073741824 / (g.t2 - g.t1) else 0 end, 'FM9999990.000')
  from g
  join v\$tablespace ts on ts.ts# = g.tablespace_id and ts.con_id = g.con_id
  join cdb_tablespaces dt on dt.tablespace_name = ts.name and dt.con_id = g.con_id
 where dt.contents = 'PERMANENT'
 order by g.con_id, ts.name;
select 'OK|done' from dual;
SQL
)"
        if ! grep -q '^OK|done' <<< "$out"; then
            err="$(_dba_qerr "$out")"
            data+=$'\n'"$sid|-|-|-|-|-|-|-|ERROR: $(_dba_clean "${err:-no output}")"
            overall=1
            continue
        fi
        rows="$(_dba_tag "$out" ROW | awk -F'|' -v OFS='|' -v s="$sid" -v w="$warn" -v c="$crit" -v all="$all" '
            {
                used = $3; mx = $4; gr = $5; pd = $6
                tu += used; tm += mx; tg += gr; tp += pd
                if (pd + 0 > 0) {
                    dtf = (mx - used) / pd; if (dtf < 0) dtf = 0
                    st = (dtf <= c) ? "CRIT" : (dtf <= w) ? "WARN" : "OK"
                    d = sprintf("%.0f", dtf)
                } else { if (!all) next; d = "-"; st = "OK" }
                print s, $1, $2, used, mx, gr, pd, d, st
                n++
            }
            END {
                if (NR == 0) { print s, "-", "(no AWR history)", "-", "-", "-", "-", "-", "UNKNOWN"; exit }
                if (tp > 0) { dtf = (tm - tu) / tp; d = sprintf("%.0f", dtf); st = (dtf <= c) ? "CRIT" : (dtf <= w) ? "WARN" : "OK" }
                else { d = "-"; st = "OK" }
                printf "%s|-|TOTAL|%.2f|%.2f|%.2f|%.3f|%s|%s\n", s, tu, tm, tg, tp, d, st
            }')"
        data+=$'\n'"$rows"
    done < <(_dba_up_targets "$dbre")
    (( any )) || { _dba_err "No running databases found${dbre:+ matching '$dbre'}."; return 1; }
    grep -q '|CRIT$' <<< "$data" && (( overall == 0 )) && overall=2
    _dba_emit "$data"
    return "$overall"
}

# DESC: Redo log groups, sizes, members, standby redo logs and log switch rate per database
function dbredo() {
    local detail=0 max_sw=12 dbre=""
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc
    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --detail)       detail=1 ;;
            --max-switches) _dba_need_val "$1" "${2-}" || return 1; max_sw="$2"; shift ;;
            --db)           _dba_need_val "$1" "${2-}" || return 1; dbre="$2"; shift ;;
            -h|--help)
                cat <<'EOF'
Usage: dbredo [--detail] [--max-switches N] [--db REGEX]
              [--grep PATTERN] [--grep-v PATTERN] [--csv|--json|--raw] [--no-header] [--no-color]

Summary (default) - one row per database and redo thread:
  DB, THREAD, GROUPS, SIZE_MB, MIN_MEMBERS, SRL_GROUPS, SRL_SIZE_MB, SWITCHES_24H,
  MAX_PER_HOUR, STATUS
  STATUS WARN when:
    - MAX_PER_HOUR > --max-switches (default 12, i.e. a switch every 5 minutes or more
      often; Oracle's common guideline is about 3-4 switches per hour at peak)
    - a group has fewer than 2 members (no multiplexing)
    - standby redo logs exist but are fewer than GROUPS + 1 per thread, or smaller than
      the online logs (Data Guard best practice)
    - any member is INVALID / STALE (see --detail)

--detail - one row per log group and member:
  DB, THREAD, GROUP, TYPE (ONLINE/STANDBY), SIZE_MB, STATUS, ARCHIVED, MEMBER, MEMBER_STATUS

Options:
  --detail          Per group / member rows
  --max-switches N  WARN threshold for the busiest hour in the last 24h (default: 12)
  --db REGEX        Only query SIDs matching REGEX (case-insensitive)
  --grep / --grep-v, --csv|--json|--raw, --no-header, --no-color

Examples:
  dbredo
  dbredo --detail --db PRD
EOF
                return 0
                ;;
            *) _dba_err "Unknown option: $1 (see dbredo --help)"; return 1 ;;
        esac
        shift
    done
    _dba_check_modes || return 1
    [[ "$max_sw" =~ ^[1-9][0-9]*$ ]] || { _dba_err "--max-switches must be a positive number"; return 1; }

    local data sid home out err any=0 rows
    if (( detail )); then data="DB|THREAD|GROUP|TYPE|SIZE_MB|STATUS|ARCHIVED|MEMBER|MEMBER_STATUS"
    else data="DB|THREAD|GROUPS|SIZE_MB|MIN_MEMBERS|SRL_GROUPS|SRL_SIZE_MB|SWITCHES_24H|MAX_PER_HOUR|STATUS"; fi
    while IFS='|' read -r sid home; do
        [[ -z "$sid" ]] && continue
        any=1
        out="$(_dba_q "$sid" "$home" <<'SQL'
select 'L|' || l.thread# || '|' || l.group# || '|ONLINE|' || round(l.bytes / 1048576) || '|' || l.status || '|' ||
       l.archived || '|' || l.members || '|' || f.member || '|' || nvl(f.status, 'OK')
  from v$log l join v$logfile f on f.group# = l.group#;
select 'S|' || s.thread# || '|' || s.group# || '|STANDBY|' || round(s.bytes / 1048576) || '|' || s.status || '|' ||
       s.archived || '|1|' || f.member || '|' || nvl(f.status, 'OK')
  from v$standby_log s join v$logfile f on f.group# = s.group#;
select 'H|' || thread# || '|' || count(*) || '|' ||
       (select max(c) from (select count(*) c from v$log_history h2
                             where h2.thread# = h.thread# and h2.first_time > sysdate - 1
                             group by trunc(h2.first_time, 'HH24')))
  from v$log_history h where first_time > sysdate - 1 group by thread#;
select 'OK|done' from dual;
SQL
)"
        if ! grep -q '^OK|done' <<< "$out"; then
            err="$(_dba_qerr "$out")"
            if (( detail )); then data+=$'\n'"$sid|-|-|-|-|ERROR: $(_dba_clean "${err:-no output}")|-|-|-"
            else data+=$'\n'"$sid|-|-|-|-|-|-|-|-|ERROR: $(_dba_clean "${err:-no output}")"; fi
            continue
        fi
        if (( detail )); then
            rows="$( { _dba_tag "$out" L; _dba_tag "$out" S; } | awk -F'|' -v OFS='|' -v s="$sid" '{ print s, $1, $2, $3, $4, $5, $6, $8, $9 }' | sort -t'|' -k2,2n -k4,4 -k3,3n)"
        else
            rows="$( { _dba_tag "$out" L | sed 's/^/L|/'; _dba_tag "$out" S | sed 's/^/S|/'; _dba_tag "$out" H | sed 's/^/H|/'; } | awk -F'|' -v OFS='|' -v s="$sid" -v mx="$max_sw" '
                $1 == "L" { t = $2; th[t] = 1; if (!(($3) in seenl)) { seenl[$3] = 1; g[t]++; sz[t] = $5; mm = $8 + 0; if (!(t in mn) || mm < mn[t]) mn[t] = mm }
                            if ($10 ~ /INVALID|STALE/) bad[t] = 1 }
                $1 == "S" { t = $2; th[t] = 1; if (!(($3) in seens)) { seens[$3] = 1; sg[t]++; ss[t] = $5 } }
                $1 == "H" { t = $2; th[t] = 1; sw[t] = $3; mph[t] = $4 }
                END {
                    for (t in th) {
                        st = "OK"; why = ""
                        if (mph[t] + 0 > mx)               why = why ", " mph[t] " switches in one hour"
                        if (t in mn && mn[t] < 2)          why = why ", single-member group(s)"
                        if (sg[t] > 0 && sg[t] < g[t] + 1) why = why ", too few standby logs"
                        if (sg[t] > 0 && ss[t] + 0 < sz[t] + 0) why = why ", standby logs smaller"
                        if (bad[t])                        why = why ", INVALID/STALE member"
                        if (why != "") st = "WARN (" substr(why, 3) ")"
                        print s, t, g[t] + 0, (sz[t] == "" ? "-" : sz[t]), (t in mn ? mn[t] : "-"), sg[t] + 0,
                              (ss[t] == "" ? "-" : ss[t]), sw[t] + 0, mph[t] + 0, st
                    }
                }' | sort -t'|' -k2,2n)"
        fi
        [[ -n "$rows" ]] && data+=$'\n'"$rows"
    done < <(_dba_up_targets "$dbre")
    (( any )) || { _dba_err "No running databases found${dbre:+ matching '$dbre'}."; return 1; }
    _dba_emit "$data"
}

# DESC: Optimizer statistics health - automatic stats job status and stale/missing statistics per schema and PDB
function dbstats() {
    local dbre="" all=0 flush=0 jobdays=2
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc
    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --all)      all=1 ;;
            --flush)    flush=1 ;;
            --job-days) _dba_need_val "$1" "${2-}" || return 1; jobdays="$2"; shift ;;
            --db)       _dba_need_val "$1" "${2-}" || return 1; dbre="$2"; shift ;;
            -h|--help)
                cat <<'EOF'
Usage: dbstats [--all] [--flush] [--job-days N] [--db REGEX]
               [--grep PATTERN] [--grep-v PATTERN] [--csv|--json|--raw] [--no-header] [--no-color]

Optimizer statistics health for every running database and every OPEN container.

Rows:
  AUTO STATS JOB   'auto optimizer stats collection' autotask: ENABLED/DISABLED and the
                   last SUCCEEDED run (DBA_AUTOTASK_CLIENT / DBA_AUTOTASK_JOB_HISTORY)
                   STATUS CRIT if disabled, WARN if no successful run in --job-days days
  SCHEMA <owner>   tables of non Oracle-maintained schemas (DBA_TAB_STATISTICS):
                   TOTAL, STALE (STALE_STATS = YES), MISSING (never analyzed), LOCKED
                   STATUS WARN if any table is stale or missing statistics
  By default only schemas with stale or missing statistics are listed (--all: every schema).

Columns: DB, CON, ITEM, TOTAL, STALE, MISSING, LOCKED, LAST_RUN, STATUS

Options:
  --all          List every schema, also the healthy ones
  --flush        Run DBMS_STATS.FLUSH_DATABASE_MONITORING_INFO first, so STALE_STATS
                 reflects the latest DML (otherwise up to ~15 minutes old). Harmless,
                 but it is a write - therefore opt-in.
  --job-days N   WARN when the last successful auto stats run is older (default: 2)
  --db REGEX     Only query SIDs matching REGEX (case-insensitive)
  --grep / --grep-v, --csv|--json|--raw, --no-header, --no-color

Notes:
  - Dictionary and fixed-object statistics are checked by dbprecheck (stats_dict / stats_fixed).
  - MOUNTED standbys are skipped.

Examples:
  dbstats
  dbstats --all --db PRD
  dbstats --flush --grep APP
EOF
                return 0
                ;;
            *) _dba_err "Unknown option: $1 (see dbstats --help)"; return 1 ;;
        esac
        shift
    done
    _dba_check_modes || return 1
    [[ "$jobdays" =~ ^[1-9][0-9]*$ ]] || { _dba_err "--job-days must be a positive number"; return 1; }

    local data="DB|CON|ITEM|TOTAL|STALE|MISSING|LOCKED|LAST_RUN|STATUS"
    local sid home out err any=0 om cons con script rows
    while IFS='|' read -r sid home; do
        [[ -z "$sid" ]] && continue
        any=1
        out="$(_dba_q "$sid" "$home" <<'SQL'
select 'OM|' || open_mode || '|' || cdb from v$database;
select 'CON|' || name from v$containers where open_mode like 'READ%' and name <> 'PDB$SEED' order by con_id;
SQL
)"
        om="$(_dba_tag "$out" OM | head -1)"
        if [[ -z "$om" ]]; then
            err="$(_dba_qerr "$out")"
            data+=$'\n'"$sid|-|-|-|-|-|-|-|ERROR: $(_dba_clean "${err:-no output}")"
            continue
        fi
        if [[ "${om%%|*}" != READ* ]]; then
            data+=$'\n'"$sid|-|-|-|-|-|-|-|SKIPPED (${om%%|*})"
            continue
        fi
        mapfile -t cons < <(_dba_tag "$out" CON | sed 's/[[:space:]]*$//')
        [[ "${om#*|}" != YES ]] && cons=("-")
        script=""
        for con in "${cons[@]}"; do
            [[ -z "$con" ]] && continue
            [[ "$con" != "-" ]] && script+="alter session set container = \"$con\";"$'\n'
            (( flush )) && script+="exec dbms_stats.flush_database_monitoring_info"$'\n'
            script+="$(sed "s/__C__/$con/g" <<SQL
select 'J|__C__|' || c.status || '|' ||
       nvl((select to_char(max(h.job_start_time), 'YYYY-MM-DD HH24:MI') from dba_autotask_job_history h
             where h.client_name = c.client_name and h.job_status = 'SUCCEEDED'), 'never') || '|' ||
       nvl((select to_char(round(sysdate - cast(max(h.job_start_time) as date), 1)) from dba_autotask_job_history h
             where h.client_name = c.client_name and h.job_status = 'SUCCEEDED'), '-')
  from dba_autotask_client c where c.client_name = 'auto optimizer stats collection';
select 'S|__C__|' || t.owner || '|' || count(*) || '|' ||
       sum(decode(t.stale_stats, 'YES', 1, 0)) || '|' || sum(case when t.last_analyzed is null then 1 else 0 end) || '|' ||
       sum(case when t.stattype_locked is not null then 1 else 0 end) || '|' ||
       nvl(to_char(max(t.last_analyzed), 'YYYY-MM-DD HH24:MI'), 'never')
  from dba_tab_statistics t join dba_users u on u.username = t.owner
 where u.oracle_maintained = 'N' and t.object_type = 'TABLE'
 group by t.owner order by t.owner;
SQL
)"$'\n'
        done
        out="$(_dba_q "$sid" "$home" <<< "$script")"
        rows="$( { _dba_tag "$out" J | sed 's/^/J|/'; _dba_tag "$out" S | sed 's/^/S|/'; } | awk -F'|' -v OFS='|' -v s="$sid" -v jd="$jobdays" -v all="$all" '
            $1 == "J" {
                st = "OK"
                if ($3 != "ENABLED") st = "CRIT (disabled)"
                else if ($5 == "-" || $5 + 0 > jd) st = "WARN (no successful run in " jd " days)"
                print s, $2, "AUTO STATS JOB", "-", "-", "-", "-", $4, st; next }
            $1 == "S" {
                st = ($5 + $6 > 0) ? "WARN" : "OK"
                if (st == "OK" && !all) next
                print s, $2, "SCHEMA " $3, $4, $5, $6, $7, $8, st }')"
        [[ -n "$rows" ]] && data+=$'\n'"$rows"
        local qe; qe="$(_dba_qerr "$out")"
        [[ -n "$qe" ]] && data+=$'\n'"$sid|-|-|-|-|-|-|-|ERROR: $(_dba_clean "$qe")"
    done < <(_dba_up_targets "$dbre")
    (( any )) || { _dba_err "No running databases found${dbre:+ matching '$dbre'}."; return 1; }
    _dba_emit "$data"
}

