######################################################################
#####                 Shared internal helpers (_dba_*)          ######
#####   Names starting with '_' are hidden from dbahelp.        ######
######################################################################

_dba_err()  { printf 'ERROR: %s\n' "$*" >&2; }
_dba_warn() { printf 'WARNING: %s\n' "$*" >&2; }

# _dba_need_val <option> <value> : fail if an option value is missing
_dba_need_val() {
    if [[ -z "${2-}" ]]; then
        _dba_err "$1 requires a value"
        return 1
    fi
    return 0
}

# Print the readable oratab path
_dba_oratab() {
    local f
    for f in "${DBA_ORATAB:-}" /etc/oratab /var/opt/oracle/oratab; do
        if [[ -n "$f" && -r "$f" ]]; then
            printf '%s\n' "$f"
            return 0
        fi
    done
    return 1
}

# _dba_oratab_home <SID> : ORACLE_HOME from oratab.
# Tries exact SID, then the SID with the RAC instance suffix removed (PRDDB1 / PRDDB_1 -> PRDDB).
_dba_oratab_home() {
    local sid="$1" ot base home try
    ot="$(_dba_oratab)" || return 1
    base="$sid"
    while [[ "$base" == *[0-9] ]]; do base="${base%?}"; done
    base="${base%_}"
    for try in "$sid" "$base"; do
        [[ -z "$try" ]] && continue
        home="$(awk -F: -v s="$try" '$0 !~ /^[[:space:]]*#/ && $1 == s { print $2; exit }' "$ot")"
        if [[ -n "$home" ]]; then
            printf '%s\n' "$home"
            return 0
        fi
    done
    return 1
}

# _dba_running_dbs : one line per running DB instance -> SID|ORACLE_HOME
# ORACLE_HOME comes from the running PMON binary (/proc/<pid>/exe), so it is correct even
# during out-of-place patching when oratab already points to the new home.
# Falls back to oratab when /proc/<pid>/exe is not readable (different OS user).
_dba_running_dbs() {
    local pid pname sid exe home
    while read -r pid pname; do
        sid="${pname#ora_pmon_}"
        [[ -z "$sid" ]] && continue
        case "$sid" in
            +*|-*|_*|ASM*|MGMTDB*) continue ;;
        esac
        home=""
        exe="$(readlink "/proc/${pid}/exe" 2>/dev/null)"
        if [[ -n "$exe" ]]; then
            exe="${exe% (deleted)}"
            [[ "$exe" == */bin/oracle ]] && home="${exe%/bin/oracle}"
        fi
        [[ -z "$home" ]] && home="$(_dba_oratab_home "$sid")"
        printf '%s|%s\n' "$sid" "$home"
    done < <(ps -eo pid=,args= | awk '$2 ~ /^ora_pmon_/ { print $1, $2 }') | sort -t'|' -k1,1 -u
}

# _dba_db_targets : SID|ORACLE_HOME|UP for running instances, plus NAME|ORACLE_HOME|DOWN for
# oratab database entries with no running instance (RAC instance names PRDDB1/PRDDB_1 are
# matched to the oratab entry PRDDB). Non-database homes (agent, client, OGG) are ignored.
_dba_db_targets() {
    local -a run=()
    local line sid name home ot matched
    local -A seen=()
    mapfile -t run < <(_dba_running_dbs)
    for line in "${run[@]}"; do
        [[ -z "$line" ]] && continue
        printf '%s|UP\n' "$line"
        seen["${line%%|*}"]=1
    done
    ot="$(_dba_oratab)" || return 0
    while IFS=: read -r name home _; do
        name="${name#"${name%%[![:space:]]*}"}"
        [[ -z "$name" || "$name" == \#* || "$name" == [+*-]* ]] && continue
        case "${name^^}" in ASM*|MGMTDB*|_MGMTDB*) continue ;; esac
        [[ -n "${seen[$name]:-}" ]] && continue
        [[ -x "$home/bin/oracle" ]] || continue
        matched=0
        for line in "${run[@]}"; do
            sid="${line%%|*}"
            if [[ "$sid" == "$name" || "$sid" =~ ^"$name"_?[0-9]+$ ]]; then
                matched=1
                break
            fi
        done
        seen["$name"]=1
        (( matched )) && continue
        printf '%s|%s|DOWN\n' "$name" "$home"
    done < "$ot"
}

# _dba_grid_home : Grid Infrastructure / HAS home (olr.loc first, then +ASM in oratab)
_dba_grid_home() {
    local h="" ot
    if [[ -r /etc/oracle/olr.loc ]]; then
        h="$(awk -F= '$1 == "crs_home" { print $2; exit }' /etc/oracle/olr.loc)"
    fi
    if [[ -z "$h" ]] && ot="$(_dba_oratab)"; then
        h="$(awk -F: '$1 ~ /^\+ASM/ { print $2; exit }' "$ot")"
    fi
    [[ -n "$h" && -x "$h/bin/srvctl" ]] || return 1
    printf '%s\n' "$h"
}

# _dba_env_run <SID|""> <ORACLE_HOME> <command...>
# Runs a command in a SUBSHELL with an isolated Oracle environment.
# Nothing (ORACLE_SID, ORACLE_HOME, PATH, LD_LIBRARY_PATH, ...) leaks back to the caller.
# TWO_TASK and ORACLE_PDB_SID are cleared so "/ as sysdba" always reaches the local CDB root.
_dba_env_run() {
    local sid="$1" home="$2"
    shift 2
    (
        unset TWO_TASK ORACLE_PDB_SID ORACLE_BASE ORACLE_SID
        export ORACLE_HOME="$home"
        [[ -n "$sid" ]] && export ORACLE_SID="$sid"
        export PATH="$home/bin:$home/OPatch:$PATH"
        export LD_LIBRARY_PATH="$home/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
        "$@"
    )
}

# _dba_sql <SID> <ORACLE_HOME> : runs SQL read from stdin as "/ as sysdba" (isolated env)
_dba_sql() {
    local sid="$1" home="$2"
    if [[ ! -x "$home/bin/sqlplus" ]]; then
        echo "SP2-DBA: sqlplus not found under $home/bin" 
        return 127
    fi
    _dba_env_run "$sid" "$home" "$home/bin/sqlplus" -s -L / as sysdba
}

# _dba_common_opt "$@" : common output/filter options shared by the reporting functions.
# Uses the CALLER's local variables (bash dynamic scoping):
#   _o_mode (table|csv|json|raw), _o_nohdr, _o_grep, _o_grepv, _o_modes, _o_nocolor, _o_shift
# Returns 0 = handled (caller shifts _o_shift), 1 = not a common option, 2 = error
_dba_common_opt() {
    _o_shift=1
    case "$1" in
        --csv)        _o_mode="csv";  _o_modes=$(( _o_modes + 1 )) ;;
        --json)       _o_mode="json"; _o_modes=$(( _o_modes + 1 )) ;;
        --raw)        _o_mode="raw";  _o_modes=$(( _o_modes + 1 )) ;;
        --no-header)  _o_nohdr=1 ;;
        --no-color)   _o_nocolor=1 ;;
        --grep)
            if [[ "${2-}" == "-v" ]]; then
                _dba_need_val "--grep -v" "${3-}" || return 2
                _o_grepv="$3"; _o_shift=3
            else
                _dba_need_val "--grep" "${2-}" || return 2
                _o_grep="$2"; _o_shift=2
            fi
            ;;
        --grep=*)     _o_grep="${1#*=}"; _dba_need_val "--grep" "$_o_grep" || return 2 ;;
        --grep-v|-grep-v)
            _dba_need_val "--grep-v" "${2-}" || return 2
            _o_grepv="$2"; _o_shift=2
            ;;
        --grep-v=*)   _o_grepv="${1#*=}"; _dba_need_val "--grep-v" "$_o_grepv" || return 2 ;;
        *)            return 1 ;;
    esac
    return 0
}

_dba_check_modes() {
    if (( ${_o_modes:-0} > 1 )); then
        _dba_err "Please specify only one output mode: --csv, --json, or --raw"
        return 1
    fi
    return 0
}

# _dba_filter_rows <data> <include_regex> <exclude_regex> [fields]
# data is '|' delimited with a header line. Matching is case-insensitive (ERE).
# fields: optional comma list of 1-based columns to match against (default: whole row).
_dba_filter_rows() {
    local data="$1" inc="$2" exc="$3" fields="${4:-}"
    local first=1 line key f restore_nocase=0
    local -a cols flist
    if [[ -z "$inc" && -z "$exc" ]]; then
        printf '%s\n' "$data"
        return 0
    fi
    shopt -q nocasematch && restore_nocase=1
    shopt -s nocasematch
    [[ -n "$fields" ]] && IFS=',' read -r -a flist <<< "$fields"
    while IFS= read -r line; do
        if (( first )); then
            printf '%s\n' "$line"
            first=0
            continue
        fi
        [[ -z "$line" ]] && continue
        if [[ -n "$fields" ]]; then
            IFS='|' read -r -a cols <<< "$line"
            key=""
            for f in "${flist[@]}"; do key+="${cols[$((f-1))]:-} "; done
        else
            key="$line"
        fi
        [[ -n "$inc" && ! "$key" =~ $inc ]] && continue
        [[ -n "$exc" && "$key" =~ $exc ]] && continue
        printf '%s\n' "$line"
    done <<< "$data"
    (( restore_nocase )) || shopt -u nocasematch
    return 0
}

# _dba_select_columns <data> <COL1,COL2,...> : keep/reorder columns by header name (case-insensitive)
_dba_select_columns() {
    awk -F'|' -v OFS='|' -v want="$2" '
        NR == 1 {
            n = split(want, w, ",")
            for (i = 1; i <= NF; i++) idx[toupper($i)] = i
            bad = ""
            for (k = 1; k <= n; k++) {
                c = toupper(w[k])
                if (!(c in idx)) bad = bad " " w[k]
                sel[k] = idx[c]
            }
            if (bad != "") {
                print "ERROR: invalid column(s):" bad > "/dev/stderr"
                exit 2
            }
        }
        {
            o = ""
            for (k = 1; k <= n; k++) o = o (k > 1 ? OFS : "") $(sel[k])
            print o
        }
    ' <<< "$1"
}

# _dba_sort_body <data> <sort args...> : sort data rows, keep header first
_dba_sort_body() {
    local data="$1"
    shift
    printf '%s\n' "${data%%$'\n'*}"
    [[ "$data" == *$'\n'* ]] || return 0
    printf '%s\n' "${data#*$'\n'}" | sed '/^[[:space:]]*$/d' | sort -t'|' "$@"
}

# _dba_table_awk <delimiter> <data> [no_header]
# COMMON TABLE RENDERER - pure awk, single pass, no dependency on other functions.
# Used by printTable and by _dba_render. Multi-line cells are supported: the
# character \037 (ASCII unit separator) inside a cell starts a new line in that cell
# (inserted by _dba_wrap_cols / _dba_wrap_header in table mode only).
_dba_table_awk() {
    local delim="$1" data="$2" nohdr="${3:-0}"
    awk -F"$delim" -v nh="$nohdr" -v NLM=$'\037' '
        /^[[:space:]]*$/ { next }
        {
            n++
            if (NF > maxf) maxf = NF
            h[n] = 1
            for (i = 1; i <= NF; i++) {
                v = $i
                gsub(/^[ \t]+|[ \t]+$/, "", v)
                k = split(v, part, NLM)
                if (k == 0) { k = 1; part[1] = "" }
                if (k > h[n]) h[n] = k
                for (j = 1; j <= k; j++) {
                    p = part[j]; gsub(/^[ \t]+|[ \t]+$/, "", p)
                    cell[n, i, j] = p
                    if (length(p) > w[i]) w[i] = length(p)
                }
                cnt[n, i] = k
            }
        }
        function sep(   s, i, d) {
            s = "  +"
            for (i = 1; i <= maxf; i++) {
                d = sprintf("%" (w[i] + 4) "s", "")
                gsub(/ /, "-", d)
                s = s d "+"
            }
            return s
        }
        function row(r,   s, i, j) {
            for (j = 1; j <= h[r]; j++) {
                s = "  |"
                for (i = 1; i <= maxf; i++) s = s sprintf("  %-" w[i] "s  |", (j <= cnt[r, i]) ? cell[r, i, j] : "")
                print s
            }
        }
        END {
            if (n == 0) exit
            if (nh == 1) {
                if (n < 2) exit
                print sep()
                for (r = 2; r <= n; r++) row(r)
                print sep()
                exit
            }
            print sep()
            row(1)
            print sep()
            for (r = 2; r <= n; r++) row(r)
            if (n > 1) print sep()
        }
    ' <<< "$data"
}

# _dba_wrap_cols <data> <width> [first_col] : TABLE MODE ONLY - wrap data cells (not the header)
# at spaces so that no line is longer than <width>. Words longer than <width> are kept whole.
# Columns before [first_col] (1-based, default 1) are never wrapped.
_dba_wrap_cols() {
    awk -F'|' -v OFS='|' -v W="$2" -v FC="${3:-1}" -v NLM=$'\037' '
        function wrap(s,   n, a, i, out, line) {
            if (length(s) <= W) return s
            n = split(s, a, / +/); out = ""; line = ""
            for (i = 1; i <= n; i++) {
                if (line == "") line = a[i]
                else if (length(line) + 1 + length(a[i]) <= W) line = line " " a[i]
                else { out = out (out == "" ? "" : NLM) line; line = a[i] }
            }
            return out (out == "" ? "" : NLM) line
        }
        NR == 1 { print; next }
        { for (i = FC; i <= NF; i++) $i = wrap($i); print }
    ' <<< "$1"
}

# _dba_wrap_header <data> <width> : TABLE MODE ONLY - wrap header names longer than <width>
# at the "_" character (never in the middle of a word); "_" stays at the end of the line.
_dba_wrap_header() {
    awk -F'|' -v OFS='|' -v W="$2" -v NLM=$'\037' '
        NR == 1 {
            for (i = 1; i <= NF; i++) {
                if (length($i) <= W) continue
                n = split($i, a, "_"); out = ""; line = ""
                for (j = 1; j <= n; j++) {
                    seg = a[j] (j < n ? "_" : "")
                    if (line == "") line = seg
                    else if (length(line) + length(seg) <= W) line = line seg
                    else { out = out (out == "" ? "" : NLM) line; line = seg }
                }
                $i = out (out == "" ? "" : NLM) line
            }
        }
        { print }
    ' <<< "$1"
}
# _dba_render <mode> <no_header> <data>
# Single output path used by every reporting function.
#   mode: table (printTable, or the common fallback if printTable is not loaded) | csv | json | raw
#   data: '|' delimited, first line is the header
_dba_render() {
    local mode="${1:-table}" nohdr="${2:-0}" data="$3"
    [[ "$mode" != table ]] && data="${data//$'\037'/ }"
    case "$mode" in
        csv)
            awk -F'|' -v nh="$nohdr" '
                /^[[:space:]]*$/ { next }
                NR == 1 && nh == 1 { next }
                {
                    o = ""
                    for (i = 1; i <= NF; i++) {
                        v = $i
                        if (v ~ /[",]/) { gsub(/"/, "\"\"", v); v = "\"" v "\"" }
                        o = o (i > 1 ? "," : "") v
                    }
                    print o
                }
            ' <<< "$data"
            ;;
        raw)
            awk -F'|' -v OFS='\t' 'NR > 1 && !/^[[:space:]]*$/ { $1 = $1; print }' <<< "$data"
            ;;
        json)
            awk -F'|' '
                function esc(s,   o, i, c) {
                    o = ""
                    for (i = 1; i <= length(s); i++) {
                        c = substr(s, i, 1)
                        if (c == "\\")      o = o "\\\\"
                        else if (c == "\"") o = o "\\\""
                        else if (c == "\t") o = o "\\t"
                        else if (c == "\r") o = o "\\r"
                        else                o = o c
                    }
                    return o
                }
                NR == 1 { for (i = 1; i <= NF; i++) h[i] = $i; nh = NF; print "["; next }
                /^[[:space:]]*$/ { next }
                {
                    line = "  {"
                    for (i = 1; i <= nh; i++) line = line (i > 1 ? "," : "") "\"" esc(h[i]) "\":\"" esc($i) "\""
                    line = line "}"
                    if (c++) print ","
                    printf "%s", line
                }
                END { if (c) print ""; if (NR) print "]" }
            ' <<< "$data"
            ;;
        *)
            local _tbl
            if [[ "$nohdr" -ne 1 ]] && declare -F printTable >/dev/null 2>&1; then
                _tbl="$(printTable '|' "$data")"
            else
                _tbl="$(_dba_table_awk '|' "$data" "$nohdr")"
            fi
            [[ -z "$_tbl" ]] && return 0
            if _dba_use_color; then
                printf '%s\n' "$_tbl" | _dba_colorize "$( [[ "$nohdr" -eq 1 ]] && echo 1 || echo 2 )"
            else
                printf '%s\n' "$_tbl"
            fi
            ;;
    esac
}

# _dba_emit <data> [grep_fields] : apply caller's --grep/--grep-v then render with caller's options
_dba_emit() {
    local data
    data="$(_dba_filter_rows "$1" "${_o_grep:-}" "${_o_grepv:-}" "${2:-}")"
    _dba_render "${_o_mode:-table}" "${_o_nohdr:-0}" "$data"
}

# _dba_clean <value> : make a value safe for the '|' delimited row format
_dba_clean() {
    local v="$1"
    v="${v//|//}"
    v="${v//$'\r'/}"
    v="${v//$'\n'/ }"
    printf '%s' "$v"
}

# _dba_xml_attr <line> <attribute> : value of attribute="..." in an XML line (no forks)
_dba_xml_attr() {
    local re="(^|[[:space:]<])$2=\"([^\"]*)\""
    [[ "$1" =~ $re ]] && printf '%s' "${BASH_REMATCH[2]}"
}

######################################################################
#####          Shared helpers added in v3.2 (_dba_*)            ######
######################################################################

# _dba_use_color : true when table output should be colored
# (stdout is a terminal, NO_COLOR is not set and --no-color was not given)
_dba_use_color() {
    [[ -t 1 && -z "${NO_COLOR:-}" && "${_o_nocolor:-0}" != "1" ]]
}

# _dba_colorize [separators] : colors whole-cell status keywords inside a rendered table (stdin -> stdout).
# Nothing is colored until [separators] border lines have been seen (2 = after the header, the
# default; 1 = table without header), so multi-line headers are never colored.
# A cell containing '(ignored)' is always yellow.
# Only cells whose text STARTS with a keyword are colored; column alignment is preserved.
#   red    : CRIT FAIL FAILED ERROR DOWN NO-GO EXPIRED MISMATCH MISSING BLOCKER BROKEN LOCKED(TIMED) INVALID
#   yellow : WARN WARNING PENDING UNKNOWN STALE EXPIRING LOCKED EXPIRED(GRACE)
#   green  : OK PASS GO UP VALID SUCCESS SUCCEEDED COMPLETED MATCH FINISHED ADDED ACTIVE
_dba_colorize() {
    awk -v seps="${1:-2}" -v R=$'\033[1;31m' -v Y=$'\033[1;33m' -v G=$'\033[1;32m' -v N=$'\033[0m' '
        BEGIN { FS = OFS = "|" }
        /^  \+/ { ns++; print; next }
        ns < seps || $0 !~ /^  \|/ { print; next }
        {
            for (i = 2; i < NF; i++) {
                v = $i
                p = match(v, /[^ ]/)
                if (!p) continue
                t = substr(v, p)
                sub(/[ ]+$/, "", t)
                c = ""
                if      (t ~ /\(ignored\)/) c = Y
                else if (t ~ /^EXPIRED\(GRACE\)/) c = Y
                else if (t ~ /^(CRIT|FAIL|FAILED|ERROR|DOWN|NO-GO|EXPIRED|MISMATCH|MISSING|BLOCKER|BROKEN|LOCKED\(TIMED\)|INVALID)([^A-Za-z0-9_]|$)/) c = R
                else if (t ~ /^(WARN|WARNING|PENDING|UNKNOWN|STALE|EXPIRING|LOCKED)([^A-Za-z0-9_]|$)/) c = Y
                else if (t ~ /^(OK|PASS|GO|UP|VALID|SUCCESS|SUCCEEDED|COMPLETED|MATCH|FINISHED|ADDED|ACTIVE)([^A-Za-z0-9_]|$)/) c = G
                if (c != "") $i = substr(v, 1, p - 1) c t N substr(v, p + length(t))
            }
            print
        }'
}

# _dba_q <SID> <ORACLE_HOME> : run SQL read from stdin with standard settings; prints raw output.
# Put a tag in front of every result line ('ROW|...', 'X|...') and extract with _dba_tag.
_dba_q() {
    {
        printf '%s\n' "set heading off feedback off pagesize 0 linesize 32767 trimspool on trimout on" \
                      "set verify off echo off tab off long 4000 longchunksize 4000 serveroutput off" \
                      "alter session set nls_date_format = 'YYYY-MM-DD HH24:MI:SS';" \
                      "whenever sqlerror continue"
        cat
        printf '\nexit\n'
    } | _dba_sql "$1" "$2" 2>&1
}

# _dba_tag <output> <TAG> : result lines of one tag, tag removed
_dba_tag() { sed -n "s/^$2|//p" <<< "$1"; }

# _dba_qerr <output> : first Oracle/SQL*Plus error outside tagged result lines (empty if none)
_dba_qerr() {
    grep -v '^[A-Z0-9_]*|' <<< "$1" | grep -m1 -E '(ORA|SP2|TNS)-[0-9]+|idle instance' | sed 's/[[:space:]]*$//'
}

# _dba_up_targets [regex] : SID|ORACLE_HOME of running DB instances, optionally filtered by SID regex
_dba_up_targets() {
    local re="${1:-}" line sid restore=0
    if [[ -z "$re" ]]; then
        _dba_running_dbs
        return 0
    fi
    shopt -q nocasematch && restore=1
    shopt -s nocasematch
    while IFS= read -r line; do
        sid="${line%%|*}"
        [[ "$sid" =~ $re ]] && printf '%s\n' "$line"
    done < <(_dba_running_dbs)
    (( restore )) || shopt -u nocasematch
    return 0
}

# _dba_num <value> <default> : value if it is a non-negative number, else default
_dba_num() {
    if [[ "${1-}" =~ ^[0-9]+([.][0-9]+)?$ ]]; then printf '%s' "$1"; else printf '%s' "$2"; fi
}

# _dba_level <value> <warn> <crit> : OK / WARN / CRIT for a numeric value (higher is worse)
_dba_level() {
    awk -v v="$1" -v w="$2" -v c="$3" 'BEGIN {
        if (v !~ /^-?[0-9]+([.][0-9]+)?$/) { print "UNKNOWN"; exit }
        if (v + 0 >= c + 0) print "CRIT"; else if (v + 0 >= w + 0) print "WARN"; else print "OK" }'
}

# _dba_dur_secs <2h|30m|1d|90s|N> : duration in seconds (plain number = hours); empty on error
_dba_dur_secs() {
    local v="${1,,}"
    case "$v" in
        *d) v="${v%d}"; [[ "$v" =~ ^[0-9]+$ ]] && echo $(( v * 86400 )) ;;
        *h) v="${v%h}"; [[ "$v" =~ ^[0-9]+$ ]] && echo $(( v * 3600 )) ;;
        *m) v="${v%m}"; [[ "$v" =~ ^[0-9]+$ ]] && echo $(( v * 60 )) ;;
        *s) v="${v%s}"; [[ "$v" =~ ^[0-9]+$ ]] && echo "$v" ;;
        *)  [[ "$v" =~ ^[0-9]+$ ]] && echo $(( v * 3600 )) ;;
    esac
}

# _dba_obase <SID> <ORACLE_HOME> : ORACLE_BASE for a home (orabase, then <home>/../..)
_dba_obase() {
    local b=""
    [[ -x "$2/bin/orabase" ]] && b="$(_dba_env_run "$1" "$2" "$2/bin/orabase" 2>/dev/null | tail -1)"
    [[ -z "$b" || ! -d "$b" ]] && b="$(dirname "$(dirname "$2")")"
    printf '%s\n' "$b"
}

# _dba_alert_log <SID> <ORACLE_HOME> : newest alert_<SID>.log under the ADR of the home's ORACLE_BASE
_dba_alert_log() {
    local sid="$1" base f alert=""
    base="$(_dba_obase "$1" "$2")"
    for f in "$base"/diag/rdbms/*/"$sid"/trace/alert_"$sid".log "$base"/diag/rdbms/*/*/trace/alert_"$sid".log; do
        [[ -f "$f" ]] || continue
        if [[ -z "$alert" || "$f" -nt "$alert" ]]; then alert="$f"; fi
    done
    [[ -n "$alert" ]] || return 1
    printf '%s\n' "$alert"
}

# _dba_agent_inst : OEM agent instance directory (agent_inst) - env DBA_AGENT_INST, running agent, lsoh
_dba_agent_inst() {
    local d=""
    if [[ -n "${DBA_AGENT_INST:-}" && -d "$DBA_AGENT_INST" ]]; then
        printf '%s\n' "$DBA_AGENT_INST"
        return 0
    fi
    d="$(ps -eo args= 2>/dev/null | grep -oE '[^[:space:]]+/sysman/log/emagent\.nohup' | head -1)"
    d="${d%/sysman/log/emagent.nohup}"
    if [[ -z "$d" ]]; then
        local ah
        ah="$(lsoh --raw --type agent --column location 2>/dev/null | head -1)"
        if [[ -n "$ah" ]]; then
            for d in "$(dirname "$ah")/agent_inst" "$ah/../agent_inst"; do
                [[ -d "$d" ]] && break
                d=""
            done
        fi
    fi
    [[ -n "$d" && -d "$d" ]] || return 1
    readlink -f "$d"
}

# _dba_emctl : path to emctl of the local agent
_dba_emctl() {
    local ai
    ai="$(_dba_agent_inst)" || return 1
    [[ -x "$ai/bin/emctl" ]] || return 1
    printf '%s\n' "$ai/bin/emctl"
}

# _dba_opatch_ids <ORACLE_HOME> : "PATCH_ID;DESCRIPTION" lines from opatch lspatches
_dba_opatch_ids() {
    [[ -x "$1/OPatch/opatch" ]] || return 1
    _dba_env_run "" "$1" "$1/OPatch/opatch" lspatches -oh "$1" 2>/dev/null | grep -E '^[0-9]+;'
}

# _dba_age_h <date-string> : hours between a date and now (one decimal), empty when unparsable
_dba_age_h() {
    local e
    [[ -z "${1-}" ]] && return 0
    e="$(date -d "$1" +%s 2>/dev/null)" || return 0
    awk -v e="$e" -v n="$(date +%s)" 'BEGIN { printf "%.1f", (n - e) / 3600 }'
}

# _dba_confirm <prompt> : returns 0 only when the user types YES (needs a terminal)
_dba_confirm() {
    local answer
    if [[ ! -t 0 ]]; then
        _dba_err "Confirmation required but no terminal is attached. Re-run with --yes."
        return 1
    fi
    read -r -p "$1 Type YES to continue: " answer
    [[ "$answer" == "YES" ]]
}


