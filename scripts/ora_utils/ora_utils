# _dba_diag_pack <SID> <HOME> : true when CONTROL_MANAGEMENT_PACK_ACCESS includes DIAGNOSTIC (licensed AWR/ASH use)
_dba_diag_pack() {
    local v
    v="$(_dba_q "$1" "$2" <<< "select 'CMP|' || value from v\$parameter where name = 'control_management_pack_access';" | sed -n 's/^CMP|//p' | head -1)"
    [[ "${v^^}" == *DIAGNOSTIC* ]]
}

# DESC: Top wait events and top SQL_IDs from Active Session History (last N minutes) per database - needs Diagnostics Pack
function dbash() {
    local minutes=15 top=5 by="both" dbre="" force=0
