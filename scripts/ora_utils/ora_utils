            --top)     _dba_need_val "$1" "${2-}" || return 1; top="$2"; shift ;;
            --by)
                _dba_need_val "$1" "${2-}" || return 1
                case "${2,,}" in event|sql|both) by="${2,,}" ;; *) _dba_err "--by must be event, sql or both"; return 1 ;; esac
                shift ;;
