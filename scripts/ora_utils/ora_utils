  dbfeatures --grep 'Compression|Diagnostics' --csv
EOF
                return 0
                ;;
            *) _dba_err "Unknown option: $1 (see dbfeatures --help)"; return 1 ;;
        esac
        shift
    done
    _dba_check_modes || return 1

    local map; map="$(_dbfeatures_map)"
    local data="DB|OPTION_PACK|FEATURE|CURRENTLY_USED|DETECTED_USAGES|FIRST_USAGE|LAST_USAGE|LAST_SAMPLE"
    local sid home out err any=0 rows om
    while IFS='|' read -r sid home; do
        [[ -z "$sid" ]] && continue
        any=1
        out="$(_dba_q "$sid" "$home" <<'SQL'
select 'OM|' || open_mode from v$database;
select 'F|' || replace(name, '|', '/') || '|' || currently_used || '|' || detected_usages || '|' ||
       nvl(to_char(first_usage_date, 'YYYY-MM-DD'), '-') || '|' || nvl(to_char(last_usage_date, 'YYYY-MM-DD'), '-') || '|' ||
       nvl(to_char(last_sample_date, 'YYYY-MM-DD'), '-')
  from (select f.*, row_number() over (partition by name order by version desc, last_sample_date desc nulls last) rn
          from dba_feature_usage_statistics f where detected_usages > 0)
 where rn = 1 order by name;
select 'PDBS|' || count(*) from v$pdbs where con_id > 2;
select 'OK|done' from dual;
SQL
)"
        om="$(_dba_tag "$out" OM | head -1)"
        if [[ "$om" != READ* ]] || ! grep -q '^OK|done' <<< "$out"; then
            err="$(_dba_qerr "$out")"
            if [[ -n "$om" && "$om" != READ* ]]; then data+=$'\n'"$sid|-|-|-|-|-|-|SKIPPED ($om)"
            else data+=$'\n'"$sid|-|ERROR: $(_dba_clean "${err:-no output}")|-|-|-|-|-"; fi
            continue
        fi
        local npdb; npdb="$(_dba_tag "$out" PDBS | head -1)"
        rows="$(_dba_tag "$out" F | DBA_FMAP="$map" awk -F'|' -v OFS='|' -v s="$sid" -v all="$all" -v cur="$current" '
            BEGIN { n = split(ENVIRON["DBA_FMAP"], L, "\n"); for (i = 1; i <= n; i++) { k = L[i]; p = k; sub(/\|[^|]*$/, "", p); o = k; sub(/^.*\|/, "", o); re[i] = p; op[i] = o } }
            {
                if (cur && $2 != "TRUE") next
                o = "-"
                for (i = 1; i <= n; i++) if ($1 ~ re[i]) { o = op[i]; break }
                if (o == "-" && !all) next
                print s, o, $1, $2, $3, $4, $5, $6
            }')"
        [[ -n "$rows" ]] && data+=$'\n'"$rows"
        if [[ "$npdb" =~ ^[0-9]+$ ]] && (( npdb > 3 )); then
            data+=$'\n'"$sid|Multitenant (more than 3 user PDBs)|$npdb user PDBs in this CDB|TRUE|-|-|-|-"
        fi
    done < <(_dba_up_targets "$dbre")
    (( any )) || { _dba_err "No running databases found${dbre:+ matching '$dbre'}."; return 1; }
    _dba_emit "$data"
    [[ "$_o_mode" == table ]] && echo "Indicator only - confirm with MOS Doc ID 1317265.1 (options_packs_usage_statistics.sql) before any licensing decision."
    return 0
}

# DESC: Database services: where each runs now vs where Clusterware/Restart is configured to run it (per PDB)
function dbservices() {
    local dbre="" issues=0
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc
    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --issues) issues=1 ;;
            --db)     _dba_need_val "$1" "${2-}" || return 1; dbre="$2"; shift ;;
            -h|--help)
                cat <<'EOF'
Usage: dbservices [--issues] [--db REGEX] [--grep PATTERN] [--grep-v PATTERN]
                  [--csv|--json|--raw] [--no-header] [--no-color]

Application services of every running database: the configuration in Clusterware /
Oracle Restart (srvctl config service) compared with where each service is running now
(GV$ACTIVE_SERVICES). Use it before and after rolling / out-of-place patching to see
which services must be relocated or restarted.

Columns: DB, SERVICE, PDB, ROLE, PREFERRED, AVAILABLE, RUNNING_ON, STATUS
  ROLE        service role from srvctl (PRIMARY, PHYSICAL_STANDBY ...)
  RUNNING_ON  instance(s) the service is active on
  STATUS      OK          running on all preferred instances
              WARN        running on an available (non-preferred) instance - relocated -
                          or only on some preferred instances
              DOWN        not running although its role matches the database role
              OK (role)   not running because its role does not match the database role
              RUNNING (not in CRS)  created with DBMS_SERVICE / SERVICE_NAMES only

Internal services (SYS$*, the default DB_UNIQUE_NAME / PDB services, XDB) are hidden.

Options:
  --issues       Only rows that are not OK
  --db REGEX     Only query SIDs matching REGEX (case-insensitive)
  --grep / --grep-v, --csv|--json|--raw, --no-header, --no-color

Return code: 0 = all OK, 2 = DOWN or WARN found, 1 = error

Examples:
  dbservices
  dbservices --issues
EOF
                return 0
                ;;
            *) _dba_err "Unknown option: $1 (see dbservices --help)"; return 1 ;;
        esac
        shift
    done
    _dba_check_modes || return 1

    local grid=""; grid="$(_dba_grid_home 2>/dev/null)"
    local data="DB|SERVICE|PDB|ROLE|PREFERRED|AVAILABLE|RUNNING_ON|STATUS"
    local sid home out err any=0 overall=0 uq role
    while IFS='|' read -r sid home; do
        [[ -z "$sid" ]] && continue
        any=1
        out="$(_dba_q "$sid" "$home" <<'SQL'
select 'D|' || db_unique_name || '|' || database_role || '|' || name from v$database;
select 'A|' || lower(s.name) || '|' || nvl((select c.name from v$containers c where c.con_id = s.con_id), '-') || '|' ||
       listagg(i.instance_name, ',') within group (order by i.instance_name)
  from gv$active_services s join gv$instance i on i.inst_id = s.inst_id
 where s.name not like 'SYS$%' and s.name not like '%XDB'
 group by lower(s.name), s.con_id;
select 'P|' || lower(name) from v$pdbs;
select 'OK|done' from dual;
SQL
)"
        if ! grep -q '^OK|done' <<< "$out"; then
            err="$(_dba_qerr "$out")"
            data+=$'\n'"$sid|-|-|-|-|-|-|ERROR: $(_dba_clean "${err:-no output}")"
            overall=1
            continue
        fi
        local dline dbn
        dline="$(_dba_tag "$out" D | head -1)"
        IFS='|' read -r uq role dbn <<< "$dline"
        local cfg=""
        if [[ -n "$grid" ]]; then
            cfg="$(_dba_env_run "" "$home" "$home/bin/srvctl" config service -d "$uq" 2>/dev/null)"
            [[ -z "$cfg" ]] && cfg="$(_dba_env_run "" "$home" "$home/bin/srvctl" config service -db "$uq" 2>/dev/null)"
        fi
        local rows
        rows="$( { printf '%s\n' "$cfg" | sed 's/^/C|/'; _dba_tag "$out" A | sed 's/^/A|/'; _dba_tag "$out" P | sed 's/^/P|/'; } | awk -F'|' -v OFS='|' -v s="$sid" -v uq="${uq,,}" -v dbn="${dbn,,}" -v role="${role// /_}" '
            function flush() {
                if (svc == "") return
                n++; S[n] = svc; PD[n] = pdb; RL[n] = rl; PR[n] = pref; AV[n] = avail; inCRS[svc] = 1
                svc = pdb = rl = pref = avail = ""
            }
            $1 == "C" {
                line = substr($0, 3)
                if (line ~ /^Service name:/)            { flush(); svc = tolower(line); sub(/^service name:[ \t]*/, "", svc) }
                else if (line ~ /^Pluggable database name:/) { pdb = line; sub(/^[^:]*:[ \t]*/, "", pdb) }
                else if (line ~ /^Service role:/)       { rl = line; sub(/^[^:]*:[ \t]*/, "", rl) }
                else if (line ~ /^Preferred instances:/){ pref = line; sub(/^[^:]*:[ \t]*/, "", pref) }
                else if (line ~ /^Available instances:/){ avail = line; sub(/^[^:]*:[ \t]*/, "", avail) }
                next
            }
            $1 == "A" { run[$2] = $4; rcon[$2] = $3; next }
            $1 == "P" { pdbsvc[$2] = 1; next }
            END {
                flush()
                for (i = 1; i <= n; i++) {
                    sv = S[i]; on = run[sv]
                    if (on == "") {
                        if (RL[i] != "" && index(toupper(RL[i]), toupper(role)) == 0) st = "OK (role " RL[i] ")"
                        else st = "DOWN"
                    } else {
                        st = "OK"
                        np = split(PR[i], pp, ","); missing = 0
                        for (j = 1; j <= np; j++) if (pp[j] != "" && index("," on ",", "," pp[j] ",") == 0) missing++
                        na = split(AV[i], aa, ",")
                        for (j = 1; j <= na; j++) if (aa[j] != "" && index("," on ",", "," aa[j] ",") > 0) { st = "WARN (running on available instance " aa[j] ")"; break }
                        if (st == "OK" && missing > 0 && np > 0) st = "WARN (not on " missing " preferred instance(s))"
                    }
                    print s, sv, (PD[i] == "" ? "-" : PD[i]), (RL[i] == "" ? "-" : RL[i]), (PR[i] == "" ? "-" : PR[i]), (AV[i] == "" ? "-" : AV[i]), (on == "" ? "-" : on), st
                }
                for (sv in run) {
                    if (sv in inCRS) continue
                    b = sv; sub(/\..*$/, "", b)
                    if (b == uq || b == dbn || (b in pdbsvc) || sv in pdbsvc) continue
                    print s, sv, rcon[sv], "-", "-", "-", run[sv], "RUNNING (not in CRS)"
                }
            }' | sort -t'|' -k2,2)"
        [[ -n "$rows" ]] && data+=$'\n'"$rows"
    done < <(_dba_up_targets "$dbre")
    (( any )) || { _dba_err "No running databases found${dbre:+ matching '$dbre'}."; return 1; }
    grep -qE '\|(DOWN|WARN)' <<< "$data" && (( overall == 0 )) && overall=2
    if (( issues )); then data="$(awk -F'|' 'NR == 1 || $8 !~ /^(OK|RUNNING)/' <<< "$data")"; fi
    if [[ "$data" != *$'\n'* ]]; then
        echo "No application services found$( (( issues )) && echo ' with issues')."
        return "$overall"
    fi
    _dba_emit "$data"
    return "$overall"
}

# DESC: Clusterware / Oracle Restart resources whose STATE does not match the TARGET (filtered crsctl stat res)
function lscrs() {
    local all=0 tfilter=""
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc
    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --all)  all=1 ;;
            --type) _dba_need_val "$1" "${2-}" || return 1; tfilter="$2"; shift ;;
            -h|--help)
                cat <<'EOF'
Usage: lscrs [--all] [--type REGEX] [--grep PATTERN] [--grep-v PATTERN]
             [--csv|--json|--raw] [--no-header] [--no-color]

Clusterware (RAC) or Oracle Restart (HAS) resources from 'crsctl stat res', one row per
resource and server, with the stack status first.

Columns: NAME, TYPE, TARGET, STATE, SERVER, STATUS
  STATUS  OK        STATE matches TARGET
          MISMATCH  TARGET is ONLINE but STATE is OFFLINE / INTERMEDIATE / UNKNOWN
          WARN      TARGET is OFFLINE (resource stopped or disabled on purpose?)
By default only rows that are not OK are shown (plus the stack row); --all shows everything.

Options:
  --all          Show every resource
  --type REGEX   Only resource types matching REGEX, e.g. 'database|listener', 'diskgroup'
  --grep / --grep-v, --csv|--json|--raw, --no-header, --no-color

Notes:
  - The Grid home is read from /etc/oracle/olr.loc.
  - Resources with an empty TARGET (e.g. ora.cvu on some releases) are reported as OK.

Return code: 0 = all OK, 2 = MISMATCH found, 1 = error

Examples:
  lscrs
  lscrs --all --type database
EOF
                return 0
                ;;
            *) _dba_err "Unknown option: $1 (see lscrs --help)"; return 1 ;;
        esac
        shift
    done
    _dba_check_modes || return 1

    local grid out chk stack
    grid="$(_dba_grid_home)" || { _dba_err "Grid Infrastructure / Oracle Restart home not found (/etc/oracle/olr.loc)."; return 1; }
    chk="$(_dba_env_run "" "$grid" "$grid/bin/crsctl" check has 2>&1)"
    if grep -q 'CRS-4638' <<< "$chk"; then stack="OK (HAS online)"
    elif grep -q 'CRS-4639' <<< "$chk"; then stack="DOWN (HAS not running)"
    else stack="UNKNOWN ($(_dba_clean "$(head -1 <<< "$chk")"))"; fi
    local cluster="no"
    if _dba_env_run "" "$grid" "$grid/bin/crsctl" check crs 2>/dev/null | grep -q 'CRS-4537'; then cluster="yes"; fi

    local data="NAME|TYPE|TARGET|STATE|SERVER|STATUS"
    data+=$'\n'"(stack)|$( [[ $cluster == yes ]] && echo 'Clusterware' || echo 'Oracle Restart')|ONLINE|-|$(hostname -s 2>/dev/null || uname -n)|$stack"
    if [[ "$stack" == DOWN* ]]; then
        _dba_emit "$data"
        return 2
    fi
    out="$(_dba_env_run "" "$grid" "$grid/bin/crsctl" stat res 2>&1)"
    if ! grep -q '^NAME=' <<< "$out"; then
        _dba_err "crsctl stat res returned no resources: $(head -1 <<< "$out")"
        return 1
    fi
    local rows
    rows="$(awk -v all="$all" -v tf="$tfilter" '
        function flush(   nt, ns, i, t, s, srv, st) {
            if (name == "") return
            if (tf != "" && type !~ tf) { name = ""; return }
            nt = split(tgt, T, /, */); ns = split(sta, S, /, */)
            if (nt < ns) nt = ns
            for (i = 1; i <= nt; i++) {
                t = T[i]; s = S[i]; srv = "-"
                if (match(s, / on [^ ]+/)) { srv = substr(s, RSTART + 4, RLENGTH - 4); s = substr(s, 1, RSTART - 1) substr(s, RSTART + RLENGTH) }
                gsub(/^ +| +$/, "", s)
                if (t == "") st = "OK"
                else if (t == "OFFLINE") st = (s ~ /^OFFLINE/) ? "WARN (target OFFLINE)" : "OK"
                else st = (s ~ /^ONLINE/) ? "OK" : "MISMATCH"
                if (st == "OK" && !all) continue
                gsub(/\|/, "/", s)
                print name "|" type "|" (t == "" ? "-" : t) "|" (s == "" ? "-" : s) "|" srv "|" st
            }
            name = ""
        }
        /^NAME=/   { flush(); name = substr($0, 6); type = tgt = sta = "" }
        /^TYPE=/   { type = substr($0, 6) }
        /^TARGET=/ { tgt = substr($0, 8) }
        /^STATE=/  { sta = substr($0, 7) }
        END { flush() }' <<< "$out")"
    [[ -n "$rows" ]] && data+=$'\n'"$rows"
    _dba_emit "$data"
    grep -q '|MISMATCH$' <<< "$data" && return 2
    [[ "$stack" == OK* ]] || return 2
    return 0
}

