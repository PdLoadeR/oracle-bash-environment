# (keeps ssh X11 forwarding such as localhost:10.0 intact; no-op for scp/ansible/cron)
if [[ $- == *i* && -z "${DISPLAY:-}" ]]; then
    _dba_rhost="$(who am i 2>/dev/null | sed -n 's/^.*(\([^()]*\)).*$/\1/p')"
