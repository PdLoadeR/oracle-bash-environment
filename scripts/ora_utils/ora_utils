# DESC: Check OS settings (HugePages, THP, swap, kernel params, per-instance limits, time sync) against Oracle requirements; --describe explains each check
function oscheck() {
    local describe=0 desc_id="" sidre="" release="auto" ru_arg="" ru_rel="" ru_full=""
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc
    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --describe)
                describe=1
                if [[ -n "${2-}" && "${2-}" != -* ]]; then desc_id="$2"; shift; fi
                ;;
            --sid) _dba_need_val "$1" "${2-}" || return 1; sidre="$2"; shift ;;
            --release)
                _dba_need_val "$1" "${2-}" || return 1
                case "${2,,}" in 19c|19) release=19c ;; 26ai|23ai|26|23) release=26ai ;; both|all) release=both ;; auto) release=auto ;;
                    *) _dba_err "--release must be 19c, 26ai, both or auto"; return 1 ;; esac
                shift ;;
            --ru)
                _dba_need_val "$1" "${2-}" || return 1
                ru_arg="$2"; shift ;;
            -h|--help)
                cat <<'EOF'
Usage: oscheck [--release 19c|26ai|both|auto] [--ru VERSION] [--sid REGEX] [--grep PATTERN] [--grep-v PATTERN]
               [--csv|--json|--raw] [--no-header] [--no-color]
       oscheck --describe [ID]

Checks this host against the Oracle Linux installation requirements of the Oracle
releases in use (19c and/or 26ai) and Oracle's recommendations. Every kernel parameter
and limit is checked individually - the preinstall RPM is not required.

Release and OS awareness (RHEL / Oracle Linux 8, 9, 10):
  - The releases are detected from the homes in use (running databases, ASM / Grid);
    with nothing running, from the DBMS / GRID homes in the inventory. --release overrides.
  - 26ai adds kernel.panic = 10 and allows ip_local_port_range up to 65535.
  - 'cert' rows check every home in use for OS / kernel / Release Update / required
    patch certification (e.g. 19c on RHEL 10 needs 19.32+, 26ai needs 23.26.2 + 39268330).

Checking a host BEFORE installing a release (pre-install check):
  --release 19c / 26ai / both adds a 'Certification (planned)' row per release, evaluated
  for this OS and kernel even when no home of that release exists yet:
    without --ru   the minimum Release Update for a new installation on this OS is
                   evaluated and shown (e.g. 'minimum RU for a new install on RHEL/OL 9: 19.19';
                   RHEL/OL 8: 19.18, the RU Oracle's release notes apply during installation)
    with --ru      the Release Update you plan to install, e.g. --ru 19.32 or --ru 23.26.2
                   (one-off patches still required on top of that RU are listed)
  The planned row uses the database home patch list; a Grid home can need a different list.
  The kernel parameter rules of the requested release(s) are applied as well.

Columns: ID, CHECK, SCOPE, CURRENT, EXPECTED, STATUS
  ID       Short check name - use it with --describe and with dbprecheck --ignore os.<ID>
  SCOPE    'host' for system-wide settings; for the per-process limits (nofile, nproc,
           stack, memlock) the instance the values were read from (one row per running
           database / ASM instance), or 'shell' when no instance is running.
  STATUS   PASS / WARN / FAIL (FAIL for settings known to cause instability, e.g.
           Transparent HugePages enabled, and for uncertified OS / release combinations);
           INFO rows are informational only

Why limits are checked per instance:
  A running instance keeps the limits of the process that started it. Instances started
  by srvctl/Clusterware get the CRS limits, instances started from sqlplus get the login
  shell limits, and an instance started before limits.conf was changed keeps the old
  values until it is restarted. One instance can pass while another one fails.

Checks:
  Platform  os_release (INFO), cert (one row per home in use)
  Memory    hugepages, hugepages_used, thp, swap, swappiness
  Kernel    sem, shmall, shmmax, shmmni, panic_on_oops, kernel_panic (26ai), file_max,
            aio_max_nr, port_range, rmem_default, rmem_max, wmem_default, wmem_max
  Limits    nofile, nproc, stack, memlock   (per running instance)
  Other     time_sync, tmp_free, dev_shm

Options:
  --describe [ID]   Without ID: one-line description of every check.
                    With an ID: full description and the documentation source.
  --release REL     Apply the rules of 19c, 26ai or both (default: auto-detect) and add a
                    'Certification (planned)' row per release (pre-install check)
  --ru VERSION      Release Update for the planned row: 19.N[.N.N.N] or 23.26.N[.N.N].
                    Implies --release of that RU when --release is not given.
  --sid REGEX       Only check the limits of instances whose SID matches REGEX
  --grep / --grep-v, --csv|--json|--raw, --no-header, --no-color

Return code: 0 = no FAIL, 2 = at least one FAIL

Examples:
  oscheck
  oscheck --grep -v PASS
  oscheck --describe
  oscheck --describe memlock
  oscheck --sid PRD --grep 'nofile|nproc'
  oscheck --grep '^cert'
  oscheck --release 19c               (before installing 19c: minimum RU on this OS)
  oscheck --release 19c --ru 19.32    (before installing 19c RU 19.32)
  oscheck --ru 23.26.2                (before installing 26ai RU 23.26.2)
  oscheck --release 26ai              (before installing 26ai on this host)
EOF
                return 0
                ;;
            *) _dba_err "Unknown option: $1 (see oscheck --help)"; return 1 ;;
        esac
        shift
    done
    _dba_check_modes || return 1
    if [[ -n "$ru_arg" ]]; then
        local pr
        if ! pr="$(_dba_parse_ru "$ru_arg")" || [[ "${pr#*|}" == "" ]]; then
            _dba_err "--ru must be a Release Update such as 19.32, 19.32.0.0.0 or 23.26.2"; return 1
        fi
        ru_rel="${pr%%|*}"; ru_full="${pr#*|}"
        case "$release:$ru_rel" in
            auto:19) release=19c ;;
            auto:23) release=26ai ;;
            19c:23|26ai:19) _dba_err "--ru $ru_arg does not belong to --release $release"; return 1 ;;
        esac
    fi

    if (( describe )); then
        if [[ -z "$desc_id" ]]; then
            _dba_emit "$(_oscheck_catalog | awk -F'|' -v OFS='|' '
                NR == 1 { print "ID|CHECK|DESCRIPTION"; next }
                { d = $3; if (length(d) > 90) { d = substr(d, 1, 90); sub(/[^ ]*$/, "", d); d = d "..." } print $1, $2, d }')"
            [[ "$_o_mode" == table ]] && echo "Run 'oscheck --describe <ID>' for the full description and the documentation source."
            return 0
        fi
        local line
        # resolve "Same as <id>" references to the full source text
        line="$(_oscheck_catalog | awk -F'|' -v OFS='|' -v id="${desc_id,,}" '
            NR > 1 { src[$1] = $4; row[$1] = $0 }
            END {
                if (!(id in row)) exit
                split(row[id], f, "|"); s = f[4]
                if (match(s, /^Same as [a-z_]+/)) { r = substr(s, 9, RLENGTH - 8); s = src[r] substr(s, RLENGTH + 1) }
                print f[1], f[2], f[3], s
            }')"
        [[ -n "$line" ]] || { _dba_err "Unknown check ID: $desc_id (see oscheck --describe)"; return 1; }
        local i_id i_chk i_desc i_src
        IFS='|' read -r i_id i_chk i_desc i_src <<< "$line"
        if [[ "$_o_mode" != table ]]; then
            _dba_render "$_o_mode" "$_o_nohdr" "ID|CHECK|DESCRIPTION|SOURCE"$'\n'"$line"
            return 0
        fi
        echo "ID          : $i_id"
        echo "CHECK       : $i_chk"
        echo "DESCRIPTION :"
        fold -s -w 90 <<< "$i_desc" | sed 's/^/    /'
        echo "SOURCE      :"
        # URLs on their own line and never wrapped
        sed -E 's#[:,]? *(https?://[^ ,]+),?#\n\1\n#g' <<< "$i_src" | sed 's/^[[:space:],]*//; s/[[:space:],]*$//; /^$/d' \
            | while IFS= read -r line; do
                  if [[ "$line" == http* ]]; then printf '    %s\n' "$line"; else fold -s -w 90 <<< "$line" | sed 's/^/    /'; fi
              done
        return 0
    fi

    local data="ID|CHECK|SCOPE|CURRENT|EXPECTED|STATUS"
    _oscheck_add() { data+=$'\n'"$1|$2|$3|$(_dba_clean "$4")|$5|$6"; }   # id check scope current expected status
    _oscheck_sysv() {
        local v
        v="$(sysctl -n "$1" 2>/dev/null)"
        [[ -z "$v" && -r "/proc/sys/${1//.//}" ]] && v="$(cat "/proc/sys/${1//.//}" 2>/dev/null)"
        tr -s '[:space:]' ' ' <<< "$v" | sed 's/^ //; s/ $//'
    }
    _oscheck_ge() { awk -v a="$1" -v b="$2" 'BEGIN { exit !(a + 0 >= b + 0) }'; }

    local mem_kb hp_total hp_free hp_rsvd hp_size thp swap_kb swp page
    mem_kb="$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)"
    hp_total="$(awk '/^HugePages_Total:/ { print $2 }' /proc/meminfo)"
    hp_free="$(awk '/^HugePages_Free:/ { print $2 }' /proc/meminfo)"
    hp_rsvd="$(awk '/^HugePages_Rsvd:/ { print $2 }' /proc/meminfo)"
    hp_size="$(awk '/^Hugepagesize:/ { print $2 }' /proc/meminfo)"
    swap_kb="$(awk '/^SwapTotal:/ { print $2 }' /proc/meminfo)"
    page="$(getconf PAGE_SIZE 2>/dev/null || echo 4096)"
    local mem_gb; mem_gb="$(awk -v k="$mem_kb" 'BEGIN { printf "%.1f", k / 1048576 }')"

    # Platform: OS, releases in use, certification
    local osid omaj omin okern ouek has19=0 has26=0 h kind v rels=""
    IFS='|' read -r osid omaj omin okern ouek <<< "$(_dba_os_info)"
    local -a cert_rows=()
    while IFS='|' read -r h kind; do
        [[ -z "$h" ]] && continue
        v="$(_dba_home_release "$h")"
        case "${v%%.*}" in 19) has19=1 ;; 23) has26=1 ;; esac
        rels+="${rels:+, }$(_dba_release_name "$v") $v"
        cert_rows+=("$h|$kind|$v")
    done < <(_dba_homes_in_use)
    case "$release" in 19c) has19=1; has26=0 ;; 26ai) has19=0; has26=1 ;; both) has19=1; has26=1 ;; esac
    (( has19 || has26 )) || has19=1
    _oscheck_add os_release "OS release" host "$osid $omaj.$omin, kernel $okern$( (( ouek )) && echo ' (UEK)')" "${rels:-no Oracle homes found}" INFO
    local crow cst cdet
    for crow in "${cert_rows[@]}"; do
        IFS='|' read -r h kind v <<< "$crow"
        IFS='|' read -r cst cdet <<< "$(_dba_cert_eval "$v" "$h" "$kind")"
        _oscheck_add cert "Certification ($kind)" "$h" "$cdet" "certified" "$cst"
    done
    # Pre-install check: planned release(s) requested with --release / --ru
    local prel prels="" pru pscope
    case "$release" in 19c) prels="19" ;; 26ai) prels="23" ;; both) prels="19 23" ;; esac
    for prel in $prels; do
        pru=""; [[ "$ru_rel" == "$prel" ]] && pru="$ru_full"
        IFS='|' read -r cst cdet <<< "$(_dba_cert_planned "$prel" "$pru")"
        pscope="$(_dba_release_name "$prel.0")${pru:+ $(_dba_ver_short "$pru")}"
        _oscheck_add cert "Certification (planned)" "$pscope" "$cdet" "certified" "$cst"
    done

    # Memory
    if (( ${hp_total:-0} > 0 )); then
        _oscheck_add hugepages "HugePages configured" host "${hp_total} x ${hp_size}K ($(awk -v t="$hp_total" -v s="$hp_size" 'BEGIN { printf "%.1f", t * s / 1048576 }') GB)" "> 0" PASS
        local in_use=$(( hp_total - hp_free + hp_rsvd ))
        if [[ -n "$(_dba_running_dbs)" ]] && (( in_use == 0 )); then
            _oscheck_add hugepages_used "HugePages in use" host "0 of $hp_total" "> 0 while databases run" WARN
        else
            _oscheck_add hugepages_used "HugePages in use" host "$in_use of $hp_total" "-" PASS
        fi
    else
        _oscheck_add hugepages "HugePages configured" host "0" "> 0 (SGA in HugePages)" WARN
    fi
    thp="$(sed -n 's/.*\[\(.*\)\].*/\1/p' /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null)"
    if [[ "$thp" == "never" ]]; then _oscheck_add thp "Transparent HugePages" host "$thp" "never" PASS
    elif [[ -z "$thp" ]]; then _oscheck_add thp "Transparent HugePages" host "not available" "never" PASS
    else _oscheck_add thp "Transparent HugePages" host "$thp" "never" FAIL; fi

    local swap_need_kb
    if (( mem_kb <= 2097152 )); then swap_need_kb=$(( mem_kb * 3 / 2 ))
    elif (( mem_kb <= 16777216 )); then swap_need_kb=$mem_kb
    else swap_need_kb=16777216; fi
    swp="$(awk -v k="$swap_kb" 'BEGIN { printf "%.1f GB", k / 1048576 }')"
    local swexp; swexp=">= $(awk -v k="$swap_need_kb" 'BEGIN { printf "%.1f GB", k / 1048576 }')"
    if (( swap_kb >= swap_need_kb * 95 / 100 )); then _oscheck_add swap "Swap size" host "$swp (RAM $mem_gb GB)" "$swexp" PASS
    else _oscheck_add swap "Swap size" host "$swp (RAM $mem_gb GB)" "$swexp" WARN; fi
    local sw; sw="$(_oscheck_sysv vm.swappiness)"
    if [[ "$sw" =~ ^[0-9]+$ ]] && (( sw <= 10 )); then _oscheck_add swappiness vm.swappiness host "$sw" "<= 10" PASS
    else _oscheck_add swappiness vm.swappiness host "${sw:-?}" "<= 10" WARN; fi

    # Kernel parameters: id|name|minimum
    local kv id k min cur
    for kv in "shmmni|kernel.shmmni|4096" "file_max|fs.file-max|6815744" "aio_max_nr|fs.aio-max-nr|1048576" \
              "rmem_default|net.core.rmem_default|262144" "rmem_max|net.core.rmem_max|4194304" \
              "wmem_default|net.core.wmem_default|262144" "wmem_max|net.core.wmem_max|1048576"; do
        IFS='|' read -r id k min <<< "$kv"
        cur="$(_oscheck_sysv "$k")"
        if [[ -n "$cur" ]] && _oscheck_ge "$cur" "$min"; then _oscheck_add "$id" "$k" host "$cur" ">= $min" PASS
        else _oscheck_add "$id" "$k" host "${cur:-?}" ">= $min" WARN; fi
    done
    local sem s1 s2 s3 s4
    sem="$(_oscheck_sysv kernel.sem)"
    read -r s1 s2 s3 s4 <<< "$sem"
    if _oscheck_ge "${s1:-0}" 250 && _oscheck_ge "${s2:-0}" 32000 && _oscheck_ge "${s3:-0}" 100 && _oscheck_ge "${s4:-0}" 128; then
        _oscheck_add sem kernel.sem host "$sem" ">= 250 32000 100 128" PASS
    else
        _oscheck_add sem kernel.sem host "${sem:-?}" ">= 250 32000 100 128" WARN
    fi
    local shmmax; shmmax="$(_oscheck_sysv kernel.shmmax)"
    if [[ -n "$shmmax" ]] && _oscheck_ge "$shmmax" "$(( mem_kb * 1024 / 2 ))"; then _oscheck_add shmmax kernel.shmmax host "$shmmax" ">= half of RAM" PASS
    else _oscheck_add shmmax kernel.shmmax host "${shmmax:-?}" ">= half of RAM" WARN; fi
    cur="$(_oscheck_sysv kernel.shmall)"
    if [[ -n "$cur" && -n "$shmmax" ]] && awk -v a="$cur" -v p="$page" -v m="$shmmax" 'BEGIN { exit !(a * p >= m || a >= 1e15) }'; then
        _oscheck_add shmall kernel.shmall host "$cur pages" ">= shmmax in pages" PASS
    else
        _oscheck_add shmall kernel.shmall host "${cur:-?} pages" ">= shmmax in pages" WARN
    fi
    cur="$(_oscheck_sysv kernel.panic_on_oops)"
    if [[ "$cur" == "1" ]]; then _oscheck_add panic_on_oops kernel.panic_on_oops host "$cur" "1" PASS
    else _oscheck_add panic_on_oops kernel.panic_on_oops host "${cur:-?}" "1" WARN; fi
    cur="$(_oscheck_sysv net.ipv4.ip_local_port_range)"
    read -r s1 s2 <<< "$cur"
    local pexp="" pok=0
    if (( has19 && has26 )); then pexp="9000 65500 (19c) or 9000 65535 (26ai)"
    elif (( has26 )); then pexp="9000 65535"
    else pexp="9000 65500"; fi
    if [[ "$s1" == 9000 ]]; then
        (( has19 )) && [[ "$s2" == 65500 ]] && pok=1
        (( has26 )) && [[ "$s2" == 65535 ]] && pok=1
    fi
    if (( pok )); then _oscheck_add port_range net.ipv4.ip_local_port_range host "$cur" "$pexp" PASS
    else _oscheck_add port_range net.ipv4.ip_local_port_range host "${cur:-?}" "$pexp" WARN; fi
    if (( has26 )); then
        cur="$(_oscheck_sysv kernel.panic)"
        if [[ "$cur" == 10 ]]; then _oscheck_add kernel_panic kernel.panic host "$cur" "10 (26ai)" PASS
        else _oscheck_add kernel_panic kernel.panic host "${cur:-?}" "10 (26ai)" WARN; fi
    fi

    # Per-instance limits: every running database and ASM instance (PMON), or the shell
    local -a lim_src=()
    local pid pname psid
    while read -r pid pname; do
        psid="${pname#ora_pmon_}"; psid="${psid#asm_pmon_}"
        if [[ -n "$sidre" ]]; then
            [[ "$(_dba_filter_rows "H"$'\n'"$psid" "$sidre" "")" == *$'\n'* ]] || continue
        fi
        if [[ -r "/proc/$pid/limits" ]]; then lim_src+=("$psid|/proc/$pid/limits")
        else _oscheck_add nofile "limits" "$psid" "cannot read /proc/$pid/limits" "-" WARN; fi
    done < <(ps -eo pid=,args= | awk '$2 ~ /^(ora|asm)_pmon_/ { print $1, $2 }' | sort -k2)
    (( ${#lim_src[@]} == 0 )) && [[ -z "$sidre" ]] && lim_src=("shell|")

    _oscheck_lim() {    # <limits file|""> <label> <ulimit flag> : "soft hard" (KB for stack/memlock)
        local f="$1" s h
        if [[ -n "$f" ]]; then
            read -r s h < <(awk -v l="$2" 'index($0, l) == 1 { x = substr($0, length(l) + 1); split(x, a, " "); print a[1], a[2]; exit }' "$f")
            if [[ "$3" == -s || "$3" == -l ]]; then
                [[ "$s" =~ ^[0-9]+$ ]] && s=$(( s / 1024 ))
                [[ "$h" =~ ^[0-9]+$ ]] && h=$(( h / 1024 ))
            fi
        else
            s="$(ulimit -S "$3")"; h="$(ulimit -H "$3")"
        fi
        printf '%s %s\n' "${s:-?}" "${h:-?}"
    }
    _oscheck_atleast() { [[ "$1" == unlimited || ( "$1" =~ ^[0-9]+$ && $1 -ge $2 ) ]]; }
    local src scope lf soft hard need_ml
    if (( ${hp_total:-0} > 0 )); then need_ml=$(( mem_kb * 9 / 10 )); else need_ml=3145728; fi
    for src in "${lim_src[@]}"; do
        scope="${src%%|*}"; lf="${src#*|}"
        read -r soft hard <<< "$(_oscheck_lim "$lf" "Max open files" -n)"
        if _oscheck_atleast "$soft" 1024 && _oscheck_atleast "$hard" 65536; then _oscheck_add nofile nofile "$scope" "$soft / $hard" ">= 1024 / 65536" PASS
        else _oscheck_add nofile nofile "$scope" "$soft / $hard" ">= 1024 / 65536" WARN; fi
        read -r soft hard <<< "$(_oscheck_lim "$lf" "Max processes" -u)"
        if _oscheck_atleast "$soft" 2047 && _oscheck_atleast "$hard" 16384; then _oscheck_add nproc nproc "$scope" "$soft / $hard" ">= 2047 / 16384" PASS
        else _oscheck_add nproc nproc "$scope" "$soft / $hard" ">= 2047 / 16384" WARN; fi
        read -r soft hard <<< "$(_oscheck_lim "$lf" "Max stack size" -s)"
        if _oscheck_atleast "$soft" 10240 && [[ "$hard" =~ ^[0-9]+$ ]] && (( hard >= 10240 && hard <= 32768 )); then
            _oscheck_add stack "stack KB" "$scope" "$soft / $hard" ">= 10240 / 10240-32768" PASS
        else
            _oscheck_add stack "stack KB" "$scope" "$soft / $hard" ">= 10240 / 10240-32768" WARN
        fi
        read -r soft hard <<< "$(_oscheck_lim "$lf" "Max locked memory" -l)"
        local mexp
        if (( ${hp_total:-0} > 0 )); then mexp=">= 90% of RAM ($need_ml)"; else mexp=">= 3145728 (no HugePages)"; fi
        if _oscheck_atleast "$soft" "$need_ml"; then _oscheck_add memlock "memlock KB" "$scope" "$soft" "$mexp" PASS
        else _oscheck_add memlock "memlock KB" "$scope" "$soft" "$mexp" WARN; fi
    done

    # Time synchronization
    if command -v chronyc >/dev/null 2>&1; then
        local leap; leap="$(chronyc tracking 2>/dev/null | awk -F': ' '/^Leap status/ { print $2 }')"
        if [[ "$leap" == "Normal" ]]; then _oscheck_add time_sync "Time sync (chrony)" host "$leap" "Normal" PASS
        else _oscheck_add time_sync "Time sync (chrony)" host "${leap:-not running}" "Normal" WARN; fi
    elif command -v ntpstat >/dev/null 2>&1; then
        if ntpstat >/dev/null 2>&1; then _oscheck_add time_sync "Time sync (ntpd)" host "synchronised" "synchronised" PASS
        else _oscheck_add time_sync "Time sync (ntpd)" host "not synchronised" "synchronised" WARN; fi
    else
        _oscheck_add time_sync "Time sync" host "chronyc/ntpstat not found" "chrony or ntpd" WARN
    fi

    # Filesystems
    local tmp_free; tmp_free="$(df -Pk /tmp 2>/dev/null | awk 'NR == 2 { print $4 }')"
    local tmp_gb; tmp_gb="$(awk -v k="${tmp_free:-0}" 'BEGIN { printf "%.1f GB", k / 1048576 }')"
    if [[ -n "$tmp_free" ]] && (( tmp_free >= 1048576 )); then _oscheck_add tmp_free "/tmp free" host "$tmp_gb" ">= 1 GB" PASS
    else _oscheck_add tmp_free "/tmp free" host "$tmp_gb" ">= 1 GB" WARN; fi
    local shm; shm="$(df -Pk /dev/shm 2>/dev/null | awk 'NR == 2 { printf "%.1f GB", $2 / 1048576 }')"
    if [[ -n "$shm" ]]; then _oscheck_add dev_shm "/dev/shm" host "$shm" "mounted" PASS
    else _oscheck_add dev_shm "/dev/shm" host "not mounted" "mounted" WARN; fi

    _dba_emit "$data"
    grep -q '|FAIL$' <<< "$data" && return 2
    return 0
}
# _dba_oracle_paths : "LABEL|PATH" for Oracle-related directories on this host (internal)
_dba_oracle_paths() {
    local -A seen=()
    local sid home state b ot g ai
    _dba_op_add() { [[ -n "$2" && -d "$2" && -z "${seen[$1|$2]:-}" ]] && { seen["$1|$2"]=1; printf '%s|%s\n' "$1" "$2"; }; return 0; }
    while IFS='|' read -r sid home state; do
        _dba_op_add HOME "$home"
        _dba_op_add BASE "$(_dba_obase "$sid" "$home")"
    done < <(_dba_db_targets)
    if ot="$(_dba_oratab)"; then
        while IFS=: read -r sid home _; do
            [[ -z "$sid" || "$sid" == \#* ]] && continue
            _dba_op_add HOME "$home"
        done < "$ot"
    fi
    if g="$(_dba_grid_home)"; then
        _dba_op_add GRID "$g"
        _dba_op_add BASE "$(_dba_obase "" "$g")"
    fi
    ai="$(_dba_agent_inst 2>/dev/null)" && _dba_op_add AGENT "$(dirname "$ai")"
    _dba_op_add TMP /tmp
}

# DESC: Usage of filesystems holding Oracle homes, bases, /stage, /dump and other custom paths (with --top consumers)
function lsfs() {
    # Custom filesystems / directories that are always reported.
    # Add more here, e.g.:  local -a lsfs_custom=(/stage /dump /backup /u05/exports)
    # A path that does not exist on a host is shown as N/A and never affects the return code.
    local -a lsfs_custom=(/stage /dump)

    local warn=80 crit=90 top=0 ignore=""
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc
    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --warn)   _dba_need_val "$1" "${2-}" || return 1; warn="$2"; shift ;;
            --crit)   _dba_need_val "$1" "${2-}" || return 1; crit="$2"; shift ;;
            --ignore) _dba_need_val "$1" "${2-}" || return 1; ignore="${ignore:+$ignore,}$2"; shift ;;
            --top)
                if [[ "${2-}" =~ ^[0-9]+$ ]]; then top="$2"; shift; else top=10; fi
                ;;
            -h|--help)
                cat <<'EOF'
Usage: lsfs [--top [N]] [--warn PCT] [--crit PCT] [--ignore PATH1,PATH2]
            [--grep PATTERN] [--grep-v PATTERN] [--csv|--json|--raw] [--no-header] [--no-color]

Default: one row per filesystem that holds Oracle data on this host
  MOUNT, SIZE_GB, USED_GB, FREE_GB, PCT_USED, USED_BY, STATUS
  USED_BY lists what lives there: HOME, BASE, GRID, AGENT, TMP and the custom
  paths (by default /stage and /dump - edit the lsfs_custom variable at the top of
  the function to add more).
  A custom path that does not exist is shown with STATUS 'N/A (not found)' and never
  affects the return code.

--top [N]: the N largest Oracle "housekeeping" directories (default 10):
  diag trace/alert/incident/cdump directories (rdbms, listener, asm),
  audit dump directories (adump, rdbms/audit), .patch_storage, cfgtoollogs
  Columns: PATH, KIND, SIZE_GB   (du is limited to 5 minutes in total)

Options:
  --warn PCT          WARN threshold (default: 80)
  --crit PCT          CRIT threshold (default: 90)
  --ignore LIST       Comma-separated mount points or custom paths whose WARN/CRIT must not
                      affect the return code (still shown, STATUS gets '(ignored)').
                      A filesystem is ignored when its MOUNT is in the list, or when every
                      entry in its USED_BY is in the list. Repeatable.
  --grep / --grep-v, --csv|--json|--raw, --no-header, --no-color

Return code: 0 = all OK/WARN/ignored, 2 = at least one CRIT (not ignored)

Examples:
  lsfs
  lsfs --ignore /stage,/dump
  lsfs --top
  lsfs --top 20 --csv
EOF
                return 0
                ;;
            *) _dba_err "Unknown option: $1 (see lsfs --help)"; return 1 ;;
        esac
        shift
    done
    _dba_check_modes || return 1
    [[ "$warn" =~ ^[0-9]+$ && "$crit" =~ ^[0-9]+$ ]] || { _dba_err "--warn/--crit must be whole numbers"; return 1; }

    local paths label p
    paths="$(_dba_oracle_paths)"

    if (( top > 0 )); then
        local -a cands=()
        local d
        while IFS='|' read -r label p; do
            case "$label" in
                BASE)
                    for d in "$p"/diag/rdbms/*/*/{trace,alert,incident,cdump} "$p"/diag/tnslsnr/*/*/{trace,alert} \
                             "$p"/diag/asm/*/*/{trace,alert} "$p"/diag/crs/*/*/trace "$p"/admin/*/adump \
                             "$p"/audit "$p"/cfgtoollogs; do
                        [[ -d "$d" ]] && cands+=("$d")
                    done
                    ;;
                HOME|GRID)
                    for d in "$p"/.patch_storage "$p"/rdbms/audit "$p"/cfgtoollogs "$p"/log; do
                        [[ -d "$d" ]] && cands+=("$d")
                    done
                    ;;
            esac
        done <<< "$paths"
        (( ${#cands[@]} )) || { echo "No Oracle housekeeping directories found."; return 0; }
        echo "Measuring ${#cands[@]} directories - please wait..." >&2
        local data="PATH|KIND|SIZE_GB"
        data+=$'\n'"$(timeout 300 du -sk "${cands[@]}" 2>/dev/null | sort -k1,1nr | head -n "$top" | awk -v OFS='|' '{
            p = $2; for (i = 3; i <= NF; i++) p = p " " $i
            k = "other"
            if (p ~ /\/adump$|\/rdbms\/audit$|\/audit$/) k = "audit"
            else if (p ~ /\.patch_storage$/) k = "patch_storage"
            else if (p ~ /cfgtoollogs$/) k = "cfgtoollogs"
            else if (p ~ /\/diag\/tnslsnr\//) k = "listener diag"
            else if (p ~ /\/diag\/asm\//) k = "asm diag"
            else if (p ~ /\/diag\//) { n = split(p, a, "/"); k = "diag " a[n] }
            else if (p ~ /\/log$/) k = "grid log"
            print p, k, sprintf("%.2f", $1 / 1048576) }')"
        _dba_emit "$data"
        return 0
    fi

    # Custom paths: label = the path itself
    local missing="" c
    for c in "${lsfs_custom[@]}"; do
        c="${c%/}"; [[ -z "$c" ]] && continue
        if [[ -e "$c" ]]; then
            paths+=$'\n'"$c|$c"
        else
            missing+="$c"$'\n'
        fi
    done

    local data
    data="$(while IFS='|' read -r label p; do
                [[ -z "$p" ]] && continue
                df -Pk "$p" 2>/dev/null | awk -v l="$label" 'NR == 2 { print $6 "|" $2 "|" $3 "|" $4 "|" l }'
            done <<< "$paths" | awk -F'|' -v OFS='|' -v w="$warn" -v c="$crit" -v ign="$ignore" '
        BEGIN { n = split(ign, a, ","); for (i = 1; i <= n; i++) { x = a[i]; gsub(/^[ \t]+|[ \t]+$|\/+$/, "", x); if (x == "") x = "/"; I[x] = 1 } }
        {
            if (!($1 in sz)) { order[++n2] = $1; sz[$1] = $2; us[$1] = $3; fr[$1] = $4 }
            if (index("," lab[$1] ",", "," $5 ",") == 0) lab[$1] = (lab[$1] == "" ? $5 : lab[$1] "," $5)
        }
        END {
            print "MOUNT|SIZE_GB|USED_GB|FREE_GB|PCT_USED|USED_BY|STATUS"
            for (i = 1; i <= n2; i++) {
                m = order[i]
                pct = (us[m] + fr[m] > 0) ? 100 * us[m] / (us[m] + fr[m]) : 0
                st = (pct >= c) ? "CRIT" : (pct >= w) ? "WARN" : "OK"
                ig = (m in I)
                if (!ig) { k = split(lab[m], L, ","); ig = 1; for (j = 1; j <= k; j++) if (!(L[j] in I)) { ig = 0; break } }
                if (ig && st != "OK") st = st " (ignored)"
                print m, sprintf("%.1f", sz[m] / 1048576), sprintf("%.1f", us[m] / 1048576),
                      sprintf("%.1f", fr[m] / 1048576), sprintf("%.1f", pct), lab[m], st
            }
        }')"
    while IFS= read -r c; do
        [[ -z "$c" ]] && continue
        if _dba_match_list "$c" "$ignore"; then
            data+=$'\n'"$c|-|-|-|-|$c|N/A (not found, ignored)"
        else
            data+=$'\n'"$c|-|-|-|-|$c|N/A (not found)"
        fi
    done <<< "$missing"
    _dba_emit "$data"
    grep -q '|CRIT$' <<< "$data" && return 2
    return 0
}
# DESC: Purge old ADR diagnostic data (trace/incident/cdump/hm) and optionally audit files - dry run by default
function dbpurge() {
    local days=30 execute=0 assume_yes=0 audit=0
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc
    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --days)          _dba_need_val "$1" "${2-}" || return 1; days="$2"; shift ;;
            --execute)       execute=1 ;;
            --yes|-y)        assume_yes=1 ;;
            --include-audit) audit=1 ;;
            -h|--help)
                cat <<'EOF'
Usage: dbpurge [--days N] [--include-audit] [--execute [--yes]]
               [--grep PATTERN] [--grep-v PATTERN] [--csv|--json|--raw] [--no-header] [--no-color]

Purges diagnostic data older than N days from every ADR home found under the
ORACLE_BASE(s) of this host (rdbms, tnslsnr, asm, crs, clients).

DRY RUN BY DEFAULT: without --execute nothing is deleted; the table shows how many
files and how much space would be released.

What is purged (adrci purge -age <minutes> -type ...):
  TRACE, CDUMP, INCIDENT, HM, UTSCDMP
What is NEVER purged:
  ALERT (alert logs) - and the text alert_<SID>.log / listener.log files

Options:
  --days N           Age in days (default: 30, minimum: 1)
  --include-audit    Also delete *.aud files older than N days in admin/*/adump and
                     <ORACLE_HOME>/rdbms/audit. Check your audit retention policy first!
  --execute          Really purge (asks for confirmation: type YES)
  --yes, -y          Do not ask for confirmation (for scripts)
  --grep / --grep-v  Limit the ADR homes / directories processed (matched against the TARGET column)
  --csv|--json|--raw, --no-header, --no-color

Examples:
  dbpurge                              (dry run, 30 days)
  dbpurge --days 14 --include-audit    (dry run)
  dbpurge --days 14 --execute
  dbpurge --grep tnslsnr --execute --yes
EOF
                return 0
                ;;
            *) _dba_err "Unknown option: $1 (see dbpurge --help)"; return 1 ;;
        esac
        shift
    done
    _dba_check_modes || return 1
    [[ "$days" =~ ^[0-9]+$ ]] && (( days >= 1 )) || { _dba_err "--days must be 1 or more"; return 1; }
    local mins=$(( days * 1440 ))

    # adrci binary (any DB or Grid home)
    local adrci_home="" sid home state g
    while IFS='|' read -r sid home state; do
        [[ -x "$home/bin/adrci" ]] && { adrci_home="$home"; break; }
    done < <(_dba_db_targets)
    if [[ -z "$adrci_home" ]] && g="$(_dba_grid_home)"; then adrci_home="$g"; fi

    # Targets: ADR homes and audit directories
    local paths label p hp
    local -a targets=()
    paths="$(_dba_oracle_paths)"
    while IFS='|' read -r label p; do
        if [[ "$label" == BASE ]]; then
            for hp in "$p"/diag/{rdbms,tnslsnr,asm,crs,clients}/*/*; do
                [[ -d "$hp/trace" || -d "$hp/incident" ]] && targets+=("ADR|$p|${hp#$p/}")
            done
            if (( audit )); then
                for hp in "$p"/admin/*/adump; do [[ -d "$hp" ]] && targets+=("AUD|$hp|$hp"); done
            fi
        elif [[ "$label" == HOME || "$label" == GRID ]] && (( audit )); then
            [[ -d "$p/rdbms/audit" ]] && targets+=("AUD|$p/rdbms/audit|$p/rdbms/audit")
        fi
    done <<< "$paths"
    (( ${#targets[@]} )) || { echo "No ADR homes found."; return 0; }

    # Estimate
    local data="TARGET|TYPE|FILES|SIZE_MB|ACTION" t kind base rel est files bytes
    local -a selected=()
    for t in "${targets[@]}"; do
        IFS='|' read -r kind base rel <<< "$t"
        if [[ -n "$_o_grep" || -n "$_o_grepv" ]]; then
            [[ "$(_dba_filter_rows "H"$'\n'"$rel" "$_o_grep" "$_o_grepv")" == *$'\n'* ]] || continue
        fi
        if [[ "$kind" == ADR ]]; then
            est="$(find "$base/$rel"/{trace,cdump,incident,hm} -type f -mmin +"$mins" \
                     ! -name 'alert_*.log' ! -name '*listener*.log' -printf '%s\n' 2>/dev/null \
                   | awk '{ n++; s += $1 } END { printf "%d %.1f", n, s / 1048576 }')"
        else
            est="$(find "$base" -maxdepth 1 -type f -name '*.aud' -mmin +"$mins" -printf '%s\n' 2>/dev/null \
                   | awk '{ n++; s += $1 } END { printf "%d %.1f", n, s / 1048576 }')"
        fi
        read -r files bytes <<< "$est"
        selected+=("$t|$files|$bytes")
    done
    (( ${#selected[@]} )) || { echo "Nothing selected."; return 0; }

    local total_files total_mb
    read -r total_files total_mb <<< "$(printf '%s\n' "${selected[@]}" | awk -F'|' '{ n += $4; s += $5 } END { printf "%d %.1f", n, s }')"

    if (( ! execute )); then
        for t in "${selected[@]}"; do
            IFS='|' read -r kind base rel files bytes <<< "$t"
            data+=$'\n'"$rel|$( [[ $kind == ADR ]] && echo "ADR (older than ${days}d)" || echo "AUDIT *.aud" )|$files|$bytes|DRY-RUN"
        done
        data+=$'\n'"TOTAL||$total_files|$total_mb|"
        _dba_render "$_o_mode" "$_o_nohdr" "$data"
        echo
        echo "Dry run only - nothing was deleted. Re-run with --execute to purge."
        return 0
    fi

    if [[ -z "$adrci_home" ]] && printf '%s\n' "${selected[@]}" | grep -q '^ADR|'; then
        _dba_err "adrci not found in any Oracle home."
        return 1
    fi
    if (( ! assume_yes )); then
        echo "About to purge ${total_files} files (~${total_mb} MB) older than ${days} days in ${#selected[@]} location(s)."
        _dba_confirm "Proceed?" || { echo "Aborted."; return 1; }
    fi

    local overall=0 res typ out
    for t in "${selected[@]}"; do
        IFS='|' read -r kind base rel files bytes <<< "$t"
        res="PURGED"
        if [[ "$kind" == ADR ]]; then
            for typ in TRACE CDUMP INCIDENT HM UTSCDMP; do
                out="$(_dba_env_run "" "$adrci_home" "$adrci_home/bin/adrci" \
                        exec="set base $base; set homepath $rel; purge -age $mins -type $typ" 2>&1)"
                if grep -qE 'DIA-[0-9]+' <<< "$out" && ! grep -qE 'DIA-48(415|448)' <<< "$out"; then
                    res="FAILED ($(grep -m1 -oE 'DIA-[0-9]+' <<< "$out") on $typ)"
                    overall=1
                fi
            done
        else
            find "$base" -maxdepth 1 -type f -name '*.aud' -mmin +"$mins" -delete 2>/dev/null || { res="FAILED"; overall=1; }
        fi
        data+=$'\n'"$rel|$( [[ $kind == ADR ]] && echo "ADR (older than ${days}d)" || echo "AUDIT *.aud" )|$files|$bytes|$res"
    done
    data+=$'\n'"TOTAL||$total_files|$total_mb|"
    _dba_render "$_o_mode" "$_o_nohdr" "$data"
    return "$overall"
}

# DESC: Certificate expiry for Oracle/OWM wallets (auto-login and password), PKCS#12, Java keystores (OGG/OHS) and PEM/DER files
function lscert() {
    # Extra directories that are always searched for wallets, keystores and certificate files
    # (e.g. OHS instance keystores, OGG deployment ssl directories). Add more here, e.g.:
    #   local -a lscert_paths=(/u01/app/oracle/ohs/keystores /u01/app/ogg/deployments)
    # DBA_CERT_PATHS (colon separated) is added to this list as well.
    local -a lscert_paths=()

    local warn=30 crit=7 trusted=0 prompt=1 depth=4
    local -a locs=()
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc
    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --warn)      _dba_need_val "$1" "${2-}" || return 1; warn="$2"; shift ;;
            --crit)      _dba_need_val "$1" "${2-}" || return 1; crit="$2"; shift ;;
            --trusted)   trusted=1 ;;
            --no-prompt) prompt=0 ;;
            --depth)     _dba_need_val "$1" "${2-}" || return 1; depth="$2"; shift ;;
            -h|--help)
                cat <<'EOF'
Usage: lscert [LOCATION ...] [--trusted] [--no-prompt] [--warn DAYS] [--crit DAYS] [--depth N]
              [--grep PATTERN] [--grep-v PATTERN] [--csv|--json|--raw] [--no-header] [--no-color]

Lists certificates and their expiry dates from every kind of store a DBA meets:

  FORMAT  Store                                        Password needed?
  SSO     Oracle / OWM auto-login wallet (cwallet.sso)  no
  P12     Oracle / OWM password wallet (ewallet.p12     yes - prompted per wallet
          without cwallet.sso), .p12 / .pfx files
  JKS     Java keystores (.jks, .keystore) - OGG, OHS   yes - prompted per keystore
          (Enter on an empty prompt lists a JKS without integrity check)
  PEM/DER Certificate files (.pem .crt .cer .der)       no

Discovery (when no LOCATION is given):
  <ORACLE_BASE>/admin/*/{wallet,xdb_wallet,tls_wallet}, /u01/app/oracle/.wallet,
  WALLET_LOCATION in sqlnet.ora of every home (ORACLE_BASE_HOME aware, so read-only
  Oracle homes are covered), the OEM agent wallet,
  the etc/ssl directory of every running OGG Microservices deployment, the
  lscert_paths variable at the top of this function and DBA_CERT_PATHS (colon separated).
  Directories are searched up to --depth levels (default 4).
LOCATION can be a wallet directory, a directory to search, or a single file.

Passwords:
  Each password-protected store gets its own hidden prompt (different passwords per
  wallet are expected). Press Enter to skip a store. Passwords are never put on a
  command line (they are passed to openssl / keytool through a file descriptor),
  are not stored and are cleared after use.
  Without a terminal, or with --no-prompt, password stores are listed with STATUS
  'PASSWORD REQUIRED' (DBA_WALLET_PWD is used if set - for scripted single-store runs).

Columns: LOCATION, FORMAT, TYPE, SUBJECT, EXPIRES, DAYS_LEFT, STATUS
  TYPE    USER (certificate with a private key), TRUSTED (CA / trusted certificate),
          CERT (single certificate file)
  STATUS  EXPIRED / CRIT (<= --crit days) / WARN (<= --warn days) / OK /
          UNKNOWN (no validity date reported) / PASSWORD REQUIRED / ERROR

Options:
  --trusted        Include trusted (CA) certificates (default: user certificates only)
  --no-prompt      Never prompt for passwords
  --warn DAYS      WARN threshold (default: 30)
  --crit DAYS      CRIT threshold (default: 7)
  --depth N        Directory search depth (default: 4)
  --grep / --grep-v, --csv|--json|--raw, --no-header, --no-color

Tools used: orapki (auto-login wallets), openssl (P12 and PEM/DER; '-legacy' is added
automatically when OpenSSL 3 needs it for older wallets), keytool (JKS; taken from the
PATH or the jdk of any Oracle home). If openssl cannot open a password wallet, orapki
is run and asks for the password itself.

Return code: 0 = nothing expiring within --crit, 2 = EXPIRED/CRIT found, 1 = error

Examples:
  lscert
  lscert --trusted
  lscert /u01/app/oracle/admin/PRD/wallet
  lscert /u01/app/ogg/deployments --grep -v TRUSTED
  lscert /u01/app/oracle/ohs/keystores/server.jks
EOF
                return 0
                ;;
            -*) _dba_err "Unknown option: $1 (see lscert --help)"; return 1 ;;
            *)  locs+=("$1") ;;
        esac
        shift
    done
    _dba_check_modes || return 1
    [[ "$warn" =~ ^[0-9]+$ && "$crit" =~ ^[0-9]+$ && "$depth" =~ ^[0-9]+$ ]] || { _dba_err "--warn/--crit/--depth must be whole numbers"; return 1; }

    # Tools
    local orapki_home="" keytool="" sid home state g h
    while IFS='|' read -r sid home state; do
        [[ -x "$home/bin/orapki" ]] && { orapki_home="$home"; break; }
    done < <(_dba_db_targets)
    if [[ -z "$orapki_home" ]] && g="$(_dba_grid_home)" && [[ -x "$g/bin/orapki" ]]; then orapki_home="$g"; fi
    keytool="$(command -v keytool 2>/dev/null)"
    if [[ -z "$keytool" ]]; then
        for h in $(lsoh --raw --column location 2>/dev/null) ${orapki_home:+"$orapki_home"}; do
            [[ -x "$h/jdk/bin/keytool" ]] && { keytool="$h/jdk/bin/keytool"; break; }
        done
    fi
    local have_ossl=0; command -v openssl >/dev/null 2>&1 && have_ossl=1

    # Discovery
    local -a search=()
    local -A seen=()
    local label p d ai
    if (( ${#locs[@]} == 0 )); then
        while IFS='|' read -r label p; do
            case "$label" in
                BASE) for d in "$p"/admin/*/{wallet,xdb_wallet,tls_wallet}; do [[ -d "$d" ]] && search+=("$d"); done ;;
                HOME|GRID)
                    local na; na="$(_dba_net_admin "$p")"
                    if [[ -r "$na/sqlnet.ora" ]]; then
                        d="$(tr -d '\n' < "$na/sqlnet.ora" | grep -oiE 'DIRECTORY *= *[^)]+' | head -1 | sed 's/^[^=]*= *//; s/ *$//')"
                        d="${d//\"/}"
                        [[ -n "$d" && -d "$d" ]] && search+=("$d")
                    fi
                    ;;
            esac
        done < <(_dba_oracle_paths)
        [[ -d /u01/app/oracle/.wallet ]] && search+=("/u01/app/oracle/.wallet")
        ai="$(_dba_agent_inst 2>/dev/null)" && [[ -d "$ai/sysman/config/server" ]] && search+=("$ai/sysman/config/server")
        # OGG Microservices deployments: OGG_ETC_HOME of running adminsrvr processes
        local opid oetc
        while read -r opid; do
            oetc="$(tr '\0' '\n' < "/proc/$opid/environ" 2>/dev/null | sed -n 's/^OGG_ETC_HOME=//p' | head -1)"
            [[ -n "$oetc" && -d "$oetc/ssl" ]] && search+=("$oetc/ssl")
        done < <(ps -eo pid=,args= | awk '$2 ~ /\/bin\/adminsrvr$/ { print $1 }')
        search+=("${lscert_paths[@]}")
        if [[ -n "${DBA_CERT_PATHS:-}" ]]; then
            local -a extra=()
            IFS=':' read -r -a extra <<< "$DBA_CERT_PATHS"
            search+=("${extra[@]}")
        fi
    else
        search=("${locs[@]}")
    fi

    # Expand search locations into stores: KIND|PATH  (SSO dir, P12 dir, P12 file, JKS file, PEM file)
    local -a stores=()
    _lscert_add() { [[ -z "${seen[$1|$2]:-}" ]] && { seen["$1|$2"]=1; stores+=("$1|$2"); }; return 0; }
    _lscert_scan_file() {
        case "${1,,}" in
            */cwallet.sso)                 _lscert_add SSO "$(dirname "$1")" ;;
            */ewallet.p12)                 [[ -f "$(dirname "$1")/cwallet.sso" ]] || _lscert_add P12W "$(dirname "$1")" ;;
            *.p12|*.pfx)                   _lscert_add P12 "$1" ;;
            *.jks|*.keystore)              _lscert_add JKS "$1" ;;
            *.pem|*.crt|*.cer|*.der)       _lscert_add PEM "$1" ;;
        esac
    }
    local s f
    for s in "${search[@]}"; do
        [[ -z "$s" ]] && continue
        if [[ -f "$s" ]]; then
            _lscert_scan_file "$s"
            case "${s,,}" in *.p12|*.pfx|*.jks|*.keystore|*.pem|*.crt|*.cer|*.der|*/cwallet.sso|*/ewallet.p12) ;; *) _lscert_add PEM "$s" ;; esac
        elif [[ -d "$s" ]]; then
            while IFS= read -r f; do _lscert_scan_file "$f"; done < <(find "$s" -maxdepth "$depth" -type f \
                \( -name cwallet.sso -o -name ewallet.p12 -o -iname '*.p12' -o -iname '*.pfx' -o -iname '*.jks' \
                   -o -iname '*.keystore' -o -iname '*.pem' -o -iname '*.crt' -o -iname '*.cer' -o -iname '*.der' \) 2>/dev/null | sort)
        elif (( ${#locs[@]} )); then
            stores+=("MISSING|$s")
        fi
    done
    (( ${#stores[@]} )) || { echo "No wallets, keystores or certificate files found (pass a location, set DBA_CERT_PATHS or edit lscert_paths)."; return 0; }

    local data="LOCATION|FORMAT|TYPE|SUBJECT|EXPIRES|DAYS_LEFT|STATUS" now
    now="$(date +%s)"
    _lscert_row() {    # <loc> <format> <type> <subject> <date-string>
        local e left st exp_s="${5:-}"
        [[ "$3" == TRUSTED && $trusted -eq 0 ]] && return 0
        if [[ -n "$exp_s" ]] && e="$(date -d "$exp_s" +%s 2>/dev/null)"; then
            if (( e < now )); then left=$(( (e - now - 86399) / 86400 )); st="EXPIRED"
            else
                left=$(( (e - now) / 86400 ))
                if (( left <= crit )); then st="CRIT"; elif (( left <= warn )); then st="WARN"; else st="OK"; fi
            fi
            exp_s="$(date -d "@$e" '+%Y-%m-%d %H:%M')"
        else
            left="-"; st="UNKNOWN"; exp_s="${exp_s:--}"
        fi
        data+=$'\n'"$(_dba_clean "$1")|$2|$3|$(_dba_clean "$4")|$exp_s|$left|$st"
    }
    _lscert_msg() { data+=$'\n'"$(_dba_clean "$1")|$2|-|-|-|-|$3"; }

    # Password prompt (one per store). Prints the password on stdout; returns 1 when skipped.
    _lscert_pw() {
        local pw=""
        if [[ -n "${DBA_WALLET_PWD:-}" ]]; then printf '%s' "$DBA_WALLET_PWD"; return 0; fi
        (( prompt )) || return 1
        [[ -r /dev/tty && -t 0 ]] || return 1
        read -r -s -p "Password for $1 (Enter to skip): " pw < /dev/tty
        echo >&2
        [[ -z "$pw" && "$2" != allow_empty ]] && return 1
        printf '%s' "$pw"
        return 0
    }

    # openssl pkcs12 -> PEM certificates with bag attributes (password via fd 3, -legacy retry)
    _lscert_p12_pem() {   # <file> <password>
        local out
        out="$(openssl pkcs12 -in "$1" -nokeys -passin fd:3 3< <(printf '%s' "$2") 2>&1)"
        if ! grep -q 'BEGIN CERTIFICATE' <<< "$out" && grep -qiE 'unsupported|RC2|legacy|digital envelope' <<< "$out"; then
            out="$(openssl pkcs12 -legacy -in "$1" -nokeys -passin fd:3 3< <(printf '%s' "$2") 2>&1)"
        fi
        printf '%s\n' "$out"
    }
    # Split PEM output into rows: a cert preceded by a localKeyID bag attribute is a USER cert
    _lscert_from_pem() {   # <loc> <format> <pem text>
        local block="" line typ="TRUSTED" inblk=0 subj enddate
        while IFS= read -r line; do
            case "$line" in
                *localKeyID*) typ="USER" ;;
                "-----BEGIN CERTIFICATE-----") inblk=1; block="$line"$'\n' ;;
                "-----END CERTIFICATE-----")
                    block+="$line"$'\n'; inblk=0
                    subj="$(openssl x509 -noout -subject <<< "$block" 2>/dev/null | sed 's/^subject= *//')"
                    enddate="$(openssl x509 -noout -enddate <<< "$block" 2>/dev/null | sed 's/^notAfter=//')"
                    _lscert_row "$1" "$2" "$typ" "$subj" "$enddate"
                    typ="TRUSTED"; block=""
                    ;;
                *) (( inblk )) && block+="$line"$'\n' ;;
            esac
        done <<< "$3"
    }
    # orapki display -> rows
    _lscert_orapki_rows() {   # <loc> <format> <output>
        local section="" subj="" exp="" line
        _lscert_oflush() {
            [[ -z "$subj" ]] && return 0
            case "$section" in USER|REQUESTED) _lscert_row "$1" "$2" "$section" "$subj" "$exp" ;; *) _lscert_row "$1" "$2" TRUSTED "$subj" "$exp" ;; esac
            subj=""; exp=""
        }
        while IFS= read -r line; do
            case "$line" in
                *"User Certificates"*)      _lscert_oflush "$1" "$2"; section="USER" ;;
                *"Trusted Certificates"*)   _lscert_oflush "$1" "$2"; section="TRUSTED" ;;
                *"Requested Certificates"*) _lscert_oflush "$1" "$2"; section="REQUESTED" ;;
                Subject:*)                  _lscert_oflush "$1" "$2"; subj="$(sed 's/^Subject:[[:space:]]*//' <<< "$line")" ;;
                *)
                    if [[ "$line" =~ (Valid[[:space:]]*Until|Not[[:space:]]*After|Valid[[:space:]]*To|Expir[a-z]*)[^:]*:[[:space:]]*(.+)$ ]]; then
                        exp="${BASH_REMATCH[2]}"
                    fi
                    ;;
            esac
        done <<< "$3"
        _lscert_oflush "$1" "$2"
    }

    local st kind loc out pw
    for st in "${stores[@]}"; do
        kind="${st%%|*}"; loc="${st#*|}"
        case "$kind" in
            MISSING) _lscert_msg "$loc" "-" "ERROR: not found" ;;
            SSO)
                if [[ -z "$orapki_home" ]]; then _lscert_msg "$loc" SSO "ERROR: orapki not found"; continue; fi
                out="$(_dba_env_run "" "$orapki_home" "$orapki_home/bin/orapki" wallet display -wallet "$loc" -complete 2>&1 </dev/null)"
                if grep -q 'Subject:' <<< "$out"; then _lscert_orapki_rows "$loc" SSO "$out"
                else _lscert_msg "$loc" SSO "ERROR: $(grep -m1 -iE 'error|PKI-' <<< "$out" || echo 'no certificates')"; fi
                ;;
            P12W|P12)
                local file="$loc" fmt=P12
                [[ "$kind" == P12W ]] && file="$loc/ewallet.p12"
                if ! pw="$(_lscert_pw "$file")"; then _lscert_msg "$loc" "$fmt" "PASSWORD REQUIRED"; continue; fi
                if (( have_ossl )); then
                    out="$(_lscert_p12_pem "$file" "$pw")"
                    if grep -q 'BEGIN CERTIFICATE' <<< "$out"; then
                        _lscert_from_pem "$loc" "$fmt" "$out"
                        pw=""; continue
                    fi
                    if grep -qiE 'mac verify|invalid password|bad decrypt' <<< "$out"; then
                        _lscert_msg "$loc" "$fmt" "ERROR: wrong password"; pw=""; continue
                    fi
                fi
                pw=""
                if [[ "$kind" == P12W && -n "$orapki_home" && -t 0 ]]; then
                    echo "openssl could not read $file - orapki will ask for the wallet password:" >&2
                    out="$(_dba_env_run "" "$orapki_home" "$orapki_home/bin/orapki" wallet display -wallet "$loc" -complete 2>&1)"
                    if grep -q 'Subject:' <<< "$out"; then _lscert_orapki_rows "$loc" "$fmt" "$out"
                    else _lscert_msg "$loc" "$fmt" "ERROR: $(grep -m1 -iE 'error|PKI-|password' <<< "$out" || echo 'cannot open wallet')"; fi
                else
                    _lscert_msg "$loc" "$fmt" "ERROR: cannot open (openssl $( ((have_ossl)) && echo failed || echo 'not found'))"
                fi
                ;;
            JKS)
                if [[ -z "$keytool" ]]; then _lscert_msg "$loc" JKS "ERROR: keytool not found"; continue; fi
                if pw="$(_lscert_pw "$loc" allow_empty)"; then :; else
                    # no terminal / no-prompt: JKS can still be listed without integrity check
                    pw=""
                fi
                if [[ -n "$pw" ]]; then
                    out="$("$keytool" -list -v -keystore "$loc" -storepass:file /dev/fd/3 3< <(printf '%s' "$pw") 2>&1 </dev/null)"
                else
                    out="$(printf '\n' | "$keytool" -list -v -keystore "$loc" 2>&1)"
                fi
                pw=""
                if ! grep -q 'Alias name:' <<< "$out"; then
                    if grep -qiE 'password was incorrect|tampered' <<< "$out"; then _lscert_msg "$loc" JKS "ERROR: wrong password"
                    elif [[ -z "${DBA_WALLET_PWD:-}" ]] && grep -qiE 'password' <<< "$out"; then _lscert_msg "$loc" JKS "PASSWORD REQUIRED"
                    else _lscert_msg "$loc" JKS "ERROR: $(grep -m1 -iE 'error|exception' <<< "$out" || echo 'cannot read keystore')"; fi
                    continue
                fi
                local alias="" etype="" owner="" until="" line first=0
                while IFS= read -r line; do
                    case "$line" in
                        "Alias name:"*)
                            [[ -n "$alias" && -n "$owner" ]] && _lscert_row "$loc" JKS "$etype" "$alias: $owner" "$until"
                            alias="${line#Alias name: }"; etype="TRUSTED"; owner=""; until=""; first=1 ;;
                        "Entry type:"*PrivateKey*) etype="USER" ;;
                        "Owner:"*) (( first )) && owner="${line#Owner: }" ;;
                        "Valid from:"*) if (( first )); then until="$(sed -n 's/.* until: //p' <<< "$line")"; first=0; fi ;;
                    esac
                done <<< "$out"
                [[ -n "$alias" && -n "$owner" ]] && _lscert_row "$loc" JKS "$etype" "$alias: $owner" "$until"
                ;;
            PEM)
                if (( ! have_ossl )); then _lscert_msg "$loc" PEM "ERROR: openssl not found"; continue; fi
                local fmt=PEM
                if grep -q 'BEGIN CERTIFICATE' "$loc" 2>/dev/null; then
                    out="$(openssl x509 -in "$loc" -noout -subject -enddate 2>/dev/null)"
                else
                    out="$(openssl x509 -inform DER -in "$loc" -noout -subject -enddate 2>/dev/null)"; fmt=DER
                fi
                if [[ -z "$out" ]]; then _lscert_msg "$loc" PEM "ERROR: not a certificate"; continue; fi
                _lscert_row "$loc" "$fmt" CERT "$(sed -n 's/^subject= *//p' <<< "$out")" "$(sed -n 's/^notAfter=//p' <<< "$out")"
                ;;
        esac
    done
    unset pw

    if [[ "$data" != *$'\n'* ]]; then
        echo "No user certificates found (use --trusted to include trusted certificates)."
        return 0
    fi
    _dba_emit "$data"
    grep -qE '\|(EXPIRED|CRIT)$' <<< "$data" && return 2
    grep -q '|ERROR' <<< "$data" && return 1
    return 0
}
# DESC: Pick a database (or ASM) from a menu and set ORACLE_SID/HOME/BASE, PATH, LD_LIBRARY_PATH and ADR_HOME
function setdb() {
    local choice="${1-}"
    case "$choice" in
        -h|--help)
            cat <<'EOF'
Usage: setdb [SID|NUMBER]

Sets the Oracle environment of the CURRENT shell for one database or ASM instance:
  ORACLE_SID, ORACLE_HOME, ORACLE_BASE, PATH, LD_LIBRARY_PATH, ADR_HOME
(the previous ORACLE_HOME is removed from PATH / LD_LIBRARY_PATH first).

Without an argument a numbered menu is shown: the ASM instance first (when running),
then every database sorted by SID. For running instances the menu also shows the
database ROLE (PRIMARY / PHYSICAL STANDBY / ...) and the STATUS (READ WRITE, MOUNTED,
READ ONLY WITH APPLY, STARTED, ...); DOWN oratab databases are listed too.
For RUNNING instances the ORACLE_HOME is taken from the
running binary, so it is correct during out-of-place patching even when oratab
already points to the new home (a NOTE is printed when they differ).

ADR_HOME is set to the instance's diag directory, so the 'cda' alias works.

Examples:
  setdb             (menu)
  setdb PRD1
  setdb 2
  setdb +ASM1

Note: named setdb (not setsid) so the Linux 'setsid' command is not hidden.
EOF
            return 0
            ;;
    esac

    local -a items=()
    local sid home state asmline
    if asmline="$(_dba_asm_instance)"; then
        items+=("$asmline|UP")
    fi
    while IFS='|' read -r sid home state; do
        [[ -n "$sid" ]] && items+=("$sid|$home|$state")
    done < <(_dba_db_targets | sort -t'|' -k1,1)
    (( ${#items[@]} )) || { _dba_err "No databases found (no PMON processes and no oratab database entries)."; return 1; }

    local i sel=""
    if [[ -z "$choice" ]]; then
        local data="NO|SID|STATE|ROLE|STATUS|ORACLE_HOME" isid ihome istate irole ist out
        for i in "${!items[@]}"; do
            IFS='|' read -r isid ihome istate <<< "${items[$i]}"
            irole="-"; ist="-"
            if [[ "$istate" == UP ]]; then
                if [[ "$isid" == +* ]]; then
                    out="$(_dba_asm_q <<< "select 'I|' || status from v\$instance;")"
                    irole="ASM"
                    ist="$(_dba_tag "$out" I | head -1)"
                else
                    out="$(_dba_q "$isid" "$ihome" <<'SQL'
select 'I|' || status from v$instance;
select 'D|' || database_role || '|' || open_mode from v$database;
SQL
)"
                    ist="$(_dba_tag "$out" I | head -1)"
                    if grep -q '^D|' <<< "$out"; then
                        irole="$(_dba_tag "$out" D | head -1)"
                        ist="${irole#*|}"
                        irole="${irole%%|*}"
                    fi
                fi
                [[ -z "$ist" ]] && ist="UNKNOWN (cannot connect)"
            fi
            data+=$'\n'"$(( i + 1 ))|$isid|$istate|$irole|$ist|$ihome"
        done
        _dba_render table 0 "$data"
        [[ -t 0 ]] || { _dba_err "No terminal - pass a SID or number."; return 1; }
        read -r -p "Select number or SID: " choice
        [[ -z "$choice" ]] && return 1
    fi
    if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#items[@]} )); then
        sel="${items[$((choice - 1))]}"
    else
        for i in "${items[@]}"; do
            if [[ "${i%%|*}" == "$choice" || "${i%%|*}" == "${choice^^}" ]]; then sel="$i"; break; fi
        done
    fi
    [[ -n "$sel" ]] || { _dba_err "No such database: $choice"; return 1; }
    IFS='|' read -r sid home state <<< "$sel"
    [[ -d "$home" ]] || { _dba_err "ORACLE_HOME not found: $home"; return 1; }

    # Remove the previous home from PATH and LD_LIBRARY_PATH
    local old="${ORACLE_HOME:-}" p newpath="" newld=""
    local -a parts=()
    IFS=':' read -r -a parts <<< "$PATH"
    for p in "${parts[@]}"; do
        [[ -z "$p" ]] && continue
        [[ -n "$old" && ( "$p" == "$old/bin" || "$p" == "$old/OPatch" ) ]] && continue
        [[ "$p" == "$home/bin" || "$p" == "$home/OPatch" ]] && continue
        newpath+="${newpath:+:}$p"
    done
    parts=()
    IFS=':' read -r -a parts <<< "${LD_LIBRARY_PATH:-}"
    for p in "${parts[@]}"; do
        [[ -z "$p" ]] && continue
        [[ -n "$old" && "$p" == "$old/lib" ]] && continue
        [[ "$p" == "$home/lib" ]] && continue
        newld+="${newld:+:}$p"
    done

    export ORACLE_SID="$sid"
    export ORACLE_HOME="$home"
    export PATH="$home/bin:$home/OPatch${newpath:+:$newpath}"
    export LD_LIBRARY_PATH="$home/lib${newld:+:$newld}"
    local base; base="$(_dba_obase "$sid" "$home")"
    [[ -n "$base" ]] && export ORACLE_BASE="$base"
    local alert adr=""
    if [[ "$sid" == +ASM* ]]; then
        for p in "$base"/diag/asm/+asm/"$sid"; do [[ -d "$p" ]] && adr="$p"; done
    else
        alert="$(_dba_alert_log "$sid" "$home")" && adr="$(dirname "$(dirname "$alert")")"
    fi
    if [[ -n "$adr" ]]; then export ADR_HOME="$adr"; else unset ADR_HOME; fi

    echo "ORACLE_SID  = $ORACLE_SID   ($state)"
    echo "ORACLE_HOME = $ORACLE_HOME"
    echo "ORACLE_BASE = ${ORACLE_BASE:-}"
    echo "ADR_HOME    = ${ADR_HOME:-not found}"
    local oh_tab
    oh_tab="$(_dba_oratab_home "$sid")"
    if [[ "$state" == UP && -n "$oh_tab" && "$oh_tab" != "$home" && "$sid" != +* ]]; then
        echo "NOTE: oratab points to $oh_tab - using the RUNNING home above (out-of-place patching in progress?)"
    fi
    [[ -n "${TWO_TASK:-}" ]] && echo "NOTE: TWO_TASK is set ($TWO_TASK) - '/ as sysdba' will not reach the local instance."
    return 0
}
######################################################################
#####      v3.2 - Out-of-place patching / AutoUpgrade support    ######
######################################################################

# _dba_oem_homes : "SID|ORACLE_HOME" for oracle_database targets in the local agent's targets.xml (internal)
_dba_oem_homes() {
    local ai f
    ai="$(_dba_agent_inst 2>/dev/null)" || return 0
    f="$ai/sysman/emd/targets.xml"
    [[ -r "$f" ]] || return 0
    awk '
        function attr(s, n,   r) {
            r = n "=\"[^\"]*\""
            if (match(s, r)) return substr(s, RSTART + length(n) + 2, RLENGTH - length(n) - 3)
            return ""
        }
        /<Target[ >]/ { type = attr($0, "TYPE"); sid = ""; oh = "" }
        /<Property / {
            n = attr($0, "NAME")
            if (n == "SID") sid = attr($0, "VALUE")
            else if (n == "OracleHome") oh = attr($0, "VALUE")
        }
        /<\/Target>/ { if (type == "oracle_database" && sid != "") print sid "|" oh; type = "" }
    ' "$f"
}

# _dba_crs_homes : "INSTANCE|ORACLE_HOME|DB_NAME|DB_UNIQUE_NAME" from srvctl config database (internal)
_dba_crs_homes() {
    local grid db cfg oh inst dbn
    grid="$(_dba_grid_home)" || return 0
    while read -r db; do
        [[ -z "$db" ]] && continue
        cfg="$(_dba_env_run "" "$grid" "$grid/bin/srvctl" config database -d "$db" 2>/dev/null)"
        oh="$(sed -n 's/^Oracle home:[[:space:]]*//p' <<< "$cfg" | head -1)"
        inst="$(sed -n 's/^Database instances\{0,1\}:[[:space:]]*//p' <<< "$cfg" | head -1)"
        dbn="$(sed -n 's/^Database name:[[:space:]]*//p' <<< "$cfg" | head -1)"
        [[ -z "$inst" ]] && inst="$db"
        tr ',' '\n' <<< "$inst" | while read -r i; do
            [[ -n "$i" ]] && printf '%s|%s|%s|%s\n' "$i" "$oh" "${dbn:-$db}" "$db"
        done
    done < <(_dba_env_run "" "$grid" "$grid/bin/srvctl" config database 2>/dev/null)
}

# DESC: Running vs oratab vs CRS vs OEM ORACLE_HOME for every database (out-of-place patching drift)
function lsdbhome() {
    local short=0
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc
    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --short) short=1 ;;
            -h|--help)
                cat <<'EOF'
Usage: lsdbhome [--short] [--grep PATTERN] [--grep-v PATTERN] [--csv|--json|--raw] [--no-header] [--no-color]

For every database instance on the host, shows the ORACLE_HOME known to each layer:
  RUNNING_HOME   home of the running PMON binary (/proc/<pid>/exe)
  ORATAB_HOME    /etc/oratab
  CRS_HOME       srvctl config database (Oracle Restart / RAC registration)
  OEM_HOME       OracleHome property of the oracle_database target in the local
                 agent's targets.xml (<agent_inst>/sysman/emd/targets.xml)
  STATUS         MATCH when all known values agree, MISMATCH otherwise
                 ('-' = not known by that layer; not counted as a mismatch)

After out-of-place patching all four should point to the new home; any
MISMATCH shows what still needs to be updated (oratab, srvctl modify database -oraclehome,
or the OEM target property).

Options:
  --short        Show only the last two path components of each home
  --grep / --grep-v, --csv|--json|--raw, --no-header, --no-color

Notes:
  - Set DBA_AGENT_INST=/path/to/agent_inst if the agent is not running or not auto-detected.

Return code: 0 = all MATCH, 2 = at least one MISMATCH

Examples:
  lsdbhome
  lsdbhome --short
  lsdbhome --grep MISMATCH
EOF
                return 0
                ;;
            *) _dba_err "Unknown option: $1 (see lsdbhome --help)"; return 1 ;;
        esac
        shift
    done
    _dba_check_modes || return 1

    local -A crs=() crsdb=() oem=()
    local i oh dbn uq sid home state
    while IFS='|' read -r i oh dbn uq; do
        [[ -z "$i" ]] && continue
        crs["$i"]="$oh"; crsdb["${dbn^^}"]="$oh"; crsdb["${uq^^}"]="$oh"
    done < <(_dba_crs_homes)
    while IFS='|' read -r i oh; do
        [[ -n "$i" ]] && oem["$i"]="$oh"
    done < <(_dba_oem_homes)

    local data="SID|STATE|RUNNING_HOME|ORATAB_HOME|CRS_HOME|OEM_HOME|STATUS"
    local run tab c o base st
    while IFS='|' read -r sid home state; do
        [[ -z "$sid" ]] && continue
        run="-"; [[ "$state" == UP ]] && run="$home"
        tab="$(_dba_oratab_home "$sid")"
        base="$sid"; while [[ "$base" == *[0-9] ]]; do base="${base%?}"; done; base="${base%_}"
        c="${crs[$sid]:-${crsdb[${sid^^}]:-${crsdb[${base^^}]:-}}}"
        o="${oem[$sid]:-}"
        st="$(printf '%s\n' "$run" "${tab:--}" "${c:--}" "${o:--}" | grep -v '^-$' | sed 's:/*$::' | sort -u | wc -l)"
        if (( st <= 1 )); then st="MATCH"; else st="MISMATCH"; fi
        data+=$'\n'"$sid|$state|$run|${tab:--}|${c:--}|${o:--}|$st"
    done < <(_dba_db_targets | sort -t'|' -k1,1)

    if (( short )); then
        data="$(awk -F'|' -v OFS='|' 'NR > 1 { for (i = 3; i <= 6; i++) if ($i != "-") { n = split($i, a, "/"); $i = (n >= 2 ? ".../" a[n-1] "/" a[n] : $i) } } 1' <<< "$data")"
    fi
    _dba_emit "$data"
    grep -q '|MISMATCH$' <<< "$data" && return 2
    return 0
}


# _dba_agent_targets : "TYPE|NAME|OracleHome|ListenerOraDir|SID|LsnrName|InstallLocation" from the agent's targets.xml (internal)
_dba_agent_targets() {
    local ai f
    ai="$(_dba_agent_inst 2>/dev/null)" || return 1
    f="$ai/sysman/emd/targets.xml"
    [[ -r "$f" ]] || return 1
    awk '
        function attr(s, n,   r) {
            r = "[ \t]" n "=\"[^\"]*\""
            if (match(s, r)) return substr(s, RSTART + length(n) + 3, RLENGTH - length(n) - 4)
            return ""
        }
        /<Target[ >]/ {
            type = attr($0, "TYPE"); name = attr($0, "NAME")
            delete P
        }
        /<Property / {
            pn = attr($0, "NAME"); pv = attr($0, "VALUE")
            if (pn != "") P[pn] = pv
        }
        /<\/Target>/ || (/<Target / && /\/>[ \t]*$/) {
            il = ("InstallLocation" in P) ? P["InstallLocation"] : (("INSTALL_LOCATION" in P) ? P["INSTALL_LOCATION"] : (("HOME_LOCATION" in P) ? P["HOME_LOCATION"] : ""))
            if (type != "") print type "|" name "|" P["OracleHome"] "|" P["ListenerOraDir"] "|" P["SID"] "|" P["LsnrName"] "|" il
            type = ""
        }
    ' "$f"
}

# DESC: OEM agent targets (DB, listener, ASM, HAS, cluster, Oracle home) vs the homes really in use - detect stale properties after OOP patching
function lsemtgt() {
    local fix=0 apply=0 assume_yes=0 all=0 types="oracle_database,oracle_listener,osm_instance,has,cluster,oracle_home"
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc
    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --fix)     fix=1 ;;
            --apply)   fix=1; apply=1 ;;
            --yes|-y)  assume_yes=1 ;;
            --all)     all=1 ;;
            --type)    _dba_need_val "$1" "${2-}" || return 1; types="$2"; shift ;;
            -h|--help)
                cat <<'EOF'
Usage: lsemtgt [--all] [--type T1,T2] [--fix | --apply [--yes]]
               [--grep PATTERN] [--grep-v PATTERN] [--csv|--json|--raw] [--no-header] [--no-color]

Compares the properties of the targets registered with the LOCAL OEM agent
(<agent_inst>/sysman/emd/targets.xml) with what is really in use on this host.
Typical use: after out-of-place patching, find targets that still point to the old home.

Target types and properties checked:
  oracle_database   OracleHome      running PMON binary home (oratab when the DB is down)
  oracle_listener   OracleHome      running tnslsnr binary home (srvctl config when not running)
                    ListenerOraDir  TNS_ADMIN of the running listener, else the home's network/admin
                                    (ORACLE_BASE_HOME aware - correct for read-only homes)
  osm_instance      OracleHome      running ASM binary home (Grid home when ASM is down)
  has               OracleHome      Grid Infrastructure / Oracle Restart home (olr.loc)
  cluster           OracleHome      Grid Infrastructure home (olr.loc)
  oracle_home       install location   the directory still exists (stale target after a home was removed)

Columns: TARGET, TYPE, PROPERTY, AGENT_VALUE, EXPECTED, SOURCE, STATUS
  STATUS  MATCH / MISMATCH / UNKNOWN (expected value could not be determined) /
          MISSING (oracle_home target whose directory no longer exists)
  By default only MISMATCH / MISSING / UNKNOWN rows are shown; --all shows every row.

Fixing the targets (updates the OMS repository; the agent is updated too when the
installed EMCLI supports -on_agent):
  --fix        Print one 'emcli modify_target' command per target that needs changes.
  --apply      Run those commands after you type YES (or --yes). Needs EMCLI in the PATH
               (or DBA_EMCLI=/path/to/emcli) and an EMCLI session that is already
               logged in ('emcli login -username=...' + 'emcli sync').
               '-on_agent' is only added when 'emcli help modify_target' lists it.
  Do NOT edit targets.xml by hand - the OMS would not see the change.

Options:
  --all            Show matching rows too
  --type LIST      Only these target types (comma separated)
  --fix            Print the emcli commands
  --apply          Run the emcli commands (asks for confirmation)
  --yes, -y        No confirmation with --apply
  --grep / --grep-v, --csv|--json|--raw, --no-header, --no-color

Notes:
  - Agent discovery: DBA_AGENT_INST, the running agent process, then lsoh (AGNT home).
  - RAC-level targets (rac_database, cluster databases) are not checked.

Return code: 0 = nothing to fix, 2 = MISMATCH/MISSING found, 1 = error

Examples:
  lsemtgt
  lsemtgt --all --type oracle_listener
  lsemtgt --fix
  lsemtgt --apply
EOF
                return 0
                ;;
            *) _dba_err "Unknown option: $1 (see lsemtgt --help)"; return 1 ;;
        esac
        shift
    done
    _dba_check_modes || return 1

    local tlist
    tlist="$(_dba_agent_targets)" || { _dba_err "OEM agent targets.xml not found (set DBA_AGENT_INST=/path/to/agent_inst)."; return 1; }

    # What is really in use
    local grid=""; grid="$(_dba_grid_home 2>/dev/null)"; grid="${grid%/}"
    local -A run_db=() lsnr_home=() lsnr_adm=() srv_lsnr=()
    local sid home pid exe lname tns line
    while IFS='|' read -r sid home; do [[ -n "$sid" ]] && run_db["$sid"]="${home%/}"; done < <(_dba_running_dbs)
    local asm_sid="" asm_home=""
    if line="$(_dba_asm_instance)"; then asm_sid="${line%%|*}"; asm_home="${line#*|}"; asm_home="${asm_home%/}"; fi
    while read -r pid exe lname; do
        [[ -z "$lname" || "$lname" == -* ]] && lname="LISTENER"
        home="${exe%/bin/tnslsnr}"
        tns="$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | sed -n 's/^TNS_ADMIN=//p' | head -1)"
        lsnr_home["${lname^^}"]="$home"
        [[ -z "$tns" ]] && tns="$(_dba_net_admin "$home")"
        lsnr_adm["${lname^^}"]="$tns"
    done < <(ps -eo pid=,args= | awk '$2 ~ /\/bin\/tnslsnr$/ { print $1, $2, $3 }')
    if [[ -n "$grid" ]]; then
        local n h
        while IFS='|' read -r n h; do
            [[ -z "$n" ]] && continue
            [[ -z "$h" || "$h" == "<CRS home>" ]] && h="$grid"
            srv_lsnr["${n^^}"]="${h%/}"
        done < <(_dba_env_run "" "$grid" "$grid/bin/srvctl" config listener 2>/dev/null | awk '
            /^Name:/ { if (n != "") print n "|" h; n = $2; h = "" }
            /^Home:/ { h = $0; sub(/^Home:[ \t]*/, "", h) }
            END { if (n != "") print n "|" h }')
    fi

    local data="TARGET|TYPE|PROPERTY|AGENT_VALUE|EXPECTED|SOURCE|STATUS"
    local typ name oh lod tsid tlname il exp src st
    local -A fixes=()
    _lsemtgt_row() {   # <name> <type> <prop> <agent> <expected> <source>
        local a="${4%/}" e="${5%/}" s
        if [[ -z "$e" ]]; then s="UNKNOWN"
        elif [[ "$a" == "$e" ]]; then s="MATCH"
        else
            s="MISMATCH"
            fixes["$1|$2"]+="${fixes[$1|$2]:+;}$3:$e"
        fi
        data+=$'\n'"$1|$2|$3|${4:--}|${e:--}|$6|$s"
    }
    while IFS='|' read -r typ name oh lod tsid tlname il; do
        [[ -z "$typ" ]] && continue
        _dba_match_list "$typ" "$types" || continue
        case "$typ" in
            oracle_database)
                exp=""; src="-"
                if [[ -n "${run_db[$tsid]:-}" ]]; then exp="${run_db[$tsid]}"; src="running PMON"
                elif exp="$(_dba_oratab_home "$tsid")"; then src="oratab (DB down)"
                else exp=""; src="SID $tsid not found"; fi
                _lsemtgt_row "$name" "$typ" OracleHome "$oh" "$exp" "$src"
                ;;
            oracle_listener)
                local ln="${tlname:-LISTENER}"; ln="${ln^^}"
                exp=""; src="-"
                if [[ -n "${lsnr_home[$ln]:-}" ]]; then exp="${lsnr_home[$ln]}"; src="running tnslsnr"
                elif [[ -n "${srv_lsnr[$ln]:-}" ]]; then exp="${srv_lsnr[$ln]}"; src="srvctl (not running)"
                else src="listener $ln not found"; fi
                _lsemtgt_row "$name" "$typ" OracleHome "$oh" "$exp" "$src"
                local eadm=""
                if [[ -n "${lsnr_adm[$ln]:-}" ]]; then eadm="${lsnr_adm[$ln]}"
                elif [[ -n "$exp" ]]; then eadm="$(_dba_net_admin "$exp")"; fi
                _lsemtgt_row "$name" "$typ" ListenerOraDir "$lod" "$eadm" "$src"
                ;;
            osm_instance)
                if [[ -n "$asm_home" && ( -z "$tsid" || "$tsid" == "$asm_sid" ) ]]; then exp="$asm_home"; src="running ASM"
                else exp="$grid"; src="Grid home (olr.loc)"; fi
                _lsemtgt_row "$name" "$typ" OracleHome "$oh" "$exp" "$src"
                ;;
            has|cluster)
                _lsemtgt_row "$name" "$typ" OracleHome "$oh" "$grid" "Grid home (olr.loc)"
                ;;
            oracle_home)
                local loc="${il:-$oh}"
                if [[ -z "$loc" ]]; then data+=$'\n'"$name|$typ|install location|-|-|-|UNKNOWN"
                elif [[ -d "$loc" ]]; then data+=$'\n'"$name|$typ|install location|$loc|exists|filesystem|MATCH"
                else data+=$'\n'"$name|$typ|install location|$loc|exists|filesystem|MISSING (home removed - delete the target)"; fi
                ;;
        esac
    done <<< "$tlist"

    local rcode=0
    grep -qE '\|(MISMATCH|MISSING)' <<< "$data" && rcode=2
    if (( ! all )); then
        data="$(awk -F'|' 'NR == 1 || $7 !~ /^MATCH$/' <<< "$data")"
    fi
    if [[ "$data" != *$'\n'* ]]; then
        echo "All checked agent targets match the homes in use (use --all to list them)."
        return 0
    fi
    _dba_emit "$data"

    (( fix )) || return "$rcode"
    if (( ${#fixes[@]} == 0 )); then
        echo; echo "Nothing to fix."
        return "$rcode"
    fi
    local emcli="${DBA_EMCLI:-$(command -v emcli 2>/dev/null)}" on_agent=""
    if [[ -n "$emcli" && -x "$emcli" ]] && "$emcli" help modify_target 2>/dev/null | grep -q -- '-on_agent'; then
        on_agent=" -on_agent"
    fi
    local -a cmds=()
    local k
    for k in "${!fixes[@]}"; do
        cmds+=("emcli modify_target -name=\"${k%%|*}\" -type=\"${k#*|}\" -properties=\"${fixes[$k]}\"${on_agent}")
    done
    echo
    echo "-- emcli commands (run 'emcli login' and 'emcli sync' first):"
    printf '%s\n' "${cmds[@]}" | sort
    [[ -z "$on_agent" ]] && echo "-- NOTE: -on_agent not added (EMCLI not found or does not support it): after the OMS update run 'emctl reload agent' or re-sync the agent."
    (( apply )) || return "$rcode"

    if [[ -z "$emcli" || ! -x "$emcli" ]]; then
        _dba_err "emcli not found (put it in the PATH or set DBA_EMCLI)."
        return 1
    fi
    if (( ! assume_yes )); then _dba_confirm "Run ${#cmds[@]} emcli modify_target command(s)?" || { echo "Aborted."; return 1; }; fi
    local res="TARGET|TYPE|RESULT" out c tn tt props failed=0
    for k in "${!fixes[@]}"; do
        tn="${k%%|*}"; tt="${k#*|}"; props="${fixes[$k]}"
        if [[ -n "$on_agent" ]]; then
            out="$("$emcli" modify_target -name="$tn" -type="$tt" -properties="$props" -on_agent 2>&1)"; c=$?
        else
            out="$("$emcli" modify_target -name="$tn" -type="$tt" -properties="$props" 2>&1)"; c=$?
        fi
        if (( c == 0 )); then res+=$'\n'"$tn|$tt|OK"
        else res+=$'\n'"$tn|$tt|FAILED (rc=$c) $(_dba_clean "$(head -1 <<< "$out")")"; failed=1; fi
    done
    echo
    _dba_render table 0 "$res"
    (( failed )) && return 1
    grep -q '|MISSING' <<< "$data" && return 2
    return 0
}
# _dba_patch_type <description> : RU / OJVM / DATAPUMP / OCW / ACFS / DBWLM / TOMCAT / JDK / ONE-OFF
_dba_patch_type() {
    local d="${1^^}"
    case "$d" in
        *OJVM*)                                     echo OJVM ;;
        *DATAPUMP*)                                 echo DATAPUMP ;;
        *OCW*)                                      echo OCW ;;
        *ACFS*)                                     echo ACFS ;;
        *DBWLM*)                                    echo DBWLM ;;
        *TOMCAT*)                                   echo TOMCAT ;;
        *JDK*)                                      echo JDK ;;
        *"RELEASE UPDATE"*|*"BUNDLE PATCH"*|*"PATCH SET UPDATE"*) echo RU ;;
        *)                                          echo ONE-OFF ;;
    esac
}

# DESC: datapatch status per database/PDB: binary RU/OJVM/Datapump patches vs dba_registry_sqlpatch
function dbdatapatch() {
    local dbre=""
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc
    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --db) _dba_need_val "$1" "${2-}" || return 1; dbre="$2"; shift ;;
            -h|--help)
                cat <<'EOF'
Usage: dbdatapatch [--db REGEX] [--grep PATTERN] [--grep-v PATTERN]
                   [--csv|--json|--raw] [--no-header] [--no-color]

Answers "is this database fully patched?" for every running database and every
OPEN container (CDB$ROOT and PDBs).

The SQL-relevant patches installed in the RUNNING home (opatch lspatches: Release
Update, OJVM, Datapump bundle) are compared with CDB_REGISTRY_SQLPATCH (latest
action per patch):

  HOME_RU    Release Update installed in the running home's binaries
  SQL_RU     Latest Release Update successfully applied by datapatch
  MISSING    Binary patch IDs with no successful APPLY in this container
  FAILED     Binary patch IDs whose latest datapatch action did not succeed
  STATUS     OK / PENDING (run datapatch) / FAILED (datapatch errors - check the
             logs under $ORACLE_BASE/cfgtoollogs/sqlpatch)

Options:
  --db REGEX     Only query SIDs matching REGEX (case-insensitive)
  --grep / --grep-v, --csv|--json|--raw, --no-header, --no-color

Notes:
  - MOUNTED standbys are skipped: datapatch runs on the primary and is replicated.
  - Running 'opatch lspatches' takes a few seconds per home.

Return code: 0 = all OK, 2 = PENDING or FAILED found, 1 = error

Examples:
  dbdatapatch
  dbdatapatch --grep -v OK
EOF
                return 0
                ;;
            *) _dba_err "Unknown option: $1 (see dbdatapatch --help)"; return 1 ;;
        esac
        shift
    done
    _dba_check_modes || return 1

    local -a targets=()
    mapfile -t targets < <(_dba_up_targets "$dbre")
    (( ${#targets[@]} )) || { _dba_err "No running databases found${dbre:+ matching '$dbre'}."; return 1; }

    # Binary patches per distinct running home
    local -A req=() home_ru=()
    local t sid home line pid desc typ
    for t in "${targets[@]}"; do
        home="${t#*|}"
        [[ -n "${req[$home]+x}" ]] && continue
        echo "Reading patches of $home - please wait..." >&2
        req["$home"]=""
        home_ru["$home"]="-"
        while IFS= read -r line; do
            pid="${line%%;*}"; desc="${line#*;}"
            typ="$(_dba_patch_type "$desc")"
            case "$typ" in
                RU)       req["$home"]+="$pid,"; home_ru["$home"]="$(grep -oE '[0-9]+(\.[0-9]+){3,4}' <<< "$desc" | head -1)" ;;
                OJVM|DATAPUMP) req["$home"]+="$pid," ;;
            esac
        done < <(_dba_opatch_ids "$home")
    done

    local data="DB|CON|HOME_RU|SQL_RU|MISSING|FAILED|STATUS"
    local out om err overall=0 con reqlist
    for t in "${targets[@]}"; do
        sid="${t%%|*}"; home="${t#*|}"
        out="$(_dba_q "$sid" "$home" <<'SQL'
select 'OM|' || open_mode from v$database;
select 'CON|' || name from v$containers where open_mode like 'READ%' and name <> 'PDB$SEED';
select 'REG|' || nvl((select c.name from v$containers c where c.con_id = r.con_id), '-') || '|' ||
       r.patch_id || '|' || r.action || '|' || r.status || '|' ||
       nvl(regexp_substr(r.description, '[0-9]+(\.[0-9]+){3,4}'), '-') || '|' ||
       case when upper(r.description) like '%RELEASE UPDATE%' and upper(r.description) not like '%OJVM%'
             and upper(r.description) not like '%DATAPUMP%' then 'RU' else 'X' end || '|' ||
       to_char(r.action_time, 'YYYYMMDDHH24MISS')
  from (select con_id, patch_id, action, status, description, action_time,
               row_number() over (partition by con_id, patch_id order by action_time desc) rn
          from cdb_registry_sqlpatch) r
 where r.rn = 1;
SQL
)"
        om="$(_dba_tag "$out" OM | head -1)"
        if [[ -z "$om" ]]; then
            err="$(_dba_qerr "$out")"
            data+=$'\n'"$sid|-|${home_ru[$home]}|-|-|-|ERROR: $(_dba_clean "${err:-no output}")"
            overall=1
            continue
        fi
        if [[ "$om" != READ* ]]; then
            data+=$'\n'"$sid|-|${home_ru[$home]}|-|-|-|SKIPPED ($om - check the primary)"
            continue
        fi
        reqlist="${req[$home]%,}"
        while IFS= read -r con; do
            [[ -z "$con" ]] && continue
            data+=$'\n'"$(awk -F'|' -v OFS='|' -v s="$sid" -v c="$con" -v req="$reqlist" -v hru="${home_ru[$home]}" '
                $1 == c {
                    st[$2] = $4; act[$2] = $3
                    if ($6 == "RU" && $3 == "APPLY" && $4 == "SUCCESS" && $7 > rut) { rut = $7; sru = $5 }
                }
                END {
                    n = split(req, r, ","); miss = ""; fail = ""
                    for (i = 1; i <= n; i++) {
                        p = r[i]; if (p == "") continue
                        if (!(p in st) || act[p] == "ROLLBACK") miss = miss (miss == "" ? "" : ",") p
                        else if (st[p] != "SUCCESS") fail = fail (fail == "" ? "" : ",") p
                    }
                    status = (fail != "") ? "FAILED" : (miss != "") ? "PENDING (run datapatch)" : "OK"
                    if (n == 0 || req == "") status = "UNKNOWN (no RU found in home)"
                    print s, c, hru, (sru == "" ? "-" : sru), (miss == "" ? "-" : miss), (fail == "" ? "-" : fail), status
                }' <<< "$(_dba_tag "$out" REG)")"
        done < <(_dba_tag "$out" CON | sed 's/[[:space:]]*$//')
    done
    grep -qE '\|(PENDING|FAILED)' <<< "$data" && (( overall == 0 )) && overall=2
    _dba_emit "$data"
    return "$overall"
}
# _dbprecheck_catalog : CHECK_ID|LEVEL|DESCRIPTION|FAIL WHEN|WARN WHEN (internal, used by --list-checks and --ignore)
