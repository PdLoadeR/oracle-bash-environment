# DESC: One-row-per-database inventory (role, open mode, RU, CDB/PDBs, size, log mode, flashback)
function dbsummary() {
    local full_mode=0 dbre=""
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc
    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --full) full_mode=1 ;;
            --db)   _dba_need_val "$1" "${2-}" || return 1; dbre="$2"; shift ;;
            -h|--help)
                cat <<'EOF'
Usage: dbsummary [--full] [--db REGEX] [--grep PATTERN] [--grep-v PATTERN]
                 [--csv|--json|--raw] [--no-header] [--no-color]

One row per database on the host (running instances + DOWN oratab entries).

Default columns:
  SID, DB_NAME, ROLE, OPEN_MODE, RU, CDB, PDBS, SIZE_GB, LOG_MODE, FLASHBACK, STATUS
--full adds:
  DB_UNIQUE_NAME, VERSION, FORCE_LOG, CHARSET, ORACLE_HOME

Column notes:
  VERSION   Full release (V$INSTANCE.VERSION_FULL), e.g. 19.32.0.0.0 or 23.26.1.0.0
            (26ai reports VERSION 23.0.0.0.0 - VERSION_FULL shows the real release)
  RU        Latest Release Update successfully applied by datapatch (dba_registry_sqlpatch)
  PDBS      Number of PDBs (PDB$SEED excluded)
  SIZE_GB   Datafiles + tempfiles (works on MOUNTED standbys too)
  RU and CHARSET need an OPEN database; they are blank on MOUNTED standbys.

Options:
  --full               Show all columns
  --db REGEX           Only query SIDs matching REGEX (case-insensitive)
  --grep / --grep-v    Filter output rows (case-insensitive regex)
  --csv|--json|--raw   Output format (default: table)
  --no-header          Suppress header row (table/csv only)
  --no-color           Do not color status values

Examples:
  dbsummary
  dbsummary --full --csv
  dbsummary --grep STANDBY
EOF
                return 0
                ;;
            *) _dba_err "Unknown option: $1 (see dbsummary --help)"; return 1 ;;
        esac
        shift
    done
    _dba_check_modes || return 1

    local data="SID|DB_NAME|DB_UNIQUE_NAME|ROLE|OPEN_MODE|VERSION|RU|CDB|PDBS|SIZE_GB|LOG_MODE|FORCE_LOG|FLASHBACK|CHARSET|STATUS|ORACLE_HOME"
    local sid home state out row sz ru cs err
    while IFS='|' read -r sid home state; do
        [[ -z "$sid" ]] && continue
        if [[ -n "$dbre" ]]; then
            [[ "$(_dba_filter_rows "H"$'\n'"$sid" "$dbre" "")" == *$'\n'* ]] || continue
        fi
        if [[ "$state" != "UP" ]]; then
            data+=$'\n'"$sid||||||||||||||DOWN|$home"
            continue
        fi
        out="$(_dba_q "$sid" "$home" <<'SQL'
select 'ROW|' || d.name || '|' || d.db_unique_name || '|' || d.database_role || '|' || d.open_mode || '|' ||
       nvl(i.version_full, i.version) || '|' || d.cdb || '|' || (select count(*) from v$pdbs where con_id > 2) || '|' ||
       d.log_mode || '|' || d.force_logging || '|' || d.flashback_on
  from v$database d cross join v$instance i;
select 'SZ|' || to_char(round(((select nvl(sum(bytes), 0) from v$datafile) +
                               (select nvl(sum(bytes), 0) from v$tempfile)) / 1073741824, 1), 'FM999999990.0')
  from dual;
select 'RU|' || max(regexp_substr(description, '[0-9]+(\.[0-9]+){3,4}')) keep (dense_rank last order by action_time)
  from dba_registry_sqlpatch
 where status = 'SUCCESS' and action = 'APPLY'
   and (upper(description) like '%RELEASE UPDATE%' or upper(description) like '%BUNDLE PATCH%'
        or upper(description) like '%PATCH SET UPDATE%')
   and upper(description) not like '%OJVM%' and upper(description) not like '%DATAPUMP%'
   and upper(description) not like '%JDK%';
select 'CS|' || value from nls_database_parameters where parameter = 'NLS_CHARACTERSET';
SQL
)"
        row="$(_dba_tag "$out" ROW | head -1)"
        if [[ -z "$row" ]]; then
            err="$(_dba_qerr "$out")"
            data+=$'\n'"$sid||||||||||||||ERROR: $(_dba_clean "${err:-no output}")|$home"
            continue
        fi
        sz="$(_dba_tag "$out" SZ | head -1)"
        ru="$(_dba_tag "$out" RU | head -1)"
        cs="$(_dba_tag "$out" CS | head -1)"
        local r_db r_uq r_role r_om r_ver r_cdb r_pdbs r_log r_fl r_fb
        IFS='|' read -r r_db r_uq r_role r_om r_ver r_cdb r_pdbs r_log r_fl r_fb <<< "$row"
        [[ "$r_cdb" != "YES" ]] && r_pdbs="-"
        data+=$'\n'"$sid|$r_db|$r_uq|$r_role|$r_om|$r_ver|$ru|$r_cdb|$r_pdbs|$sz|$r_log|$r_fl|$r_fb|$cs|UP|$home"
    done < <(_dba_db_targets | sort -t'|' -k1,1)

    if (( ! full_mode )); then
        data="$(_dba_select_columns "$data" "SID,DB_NAME,ROLE,OPEN_MODE,RU,CDB,PDBS,SIZE_GB,LOG_MODE,FLASHBACK,STATUS")"
    fi
    _dba_emit "$data"
}
# DESC: Tablespace, TEMP, UNDO and FRA usage (autoextend-aware) with WARN/CRIT thresholds
function dbspace() {
    local warn=85 crit=95 alerts_only=0 dbre="" show_fra=1 show_temp=1
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc
    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --warn)    _dba_need_val "$1" "${2-}" || return 1; warn="$2"; shift ;;
            --crit)    _dba_need_val "$1" "${2-}" || return 1; crit="$2"; shift ;;
            --alerts)  alerts_only=1 ;;
            --no-fra)  show_fra=0 ;;
            --no-temp) show_temp=0 ;;
            --db)      _dba_need_val "$1" "${2-}" || return 1; dbre="$2"; shift ;;
            -h|--help)
                cat <<'EOF'
Usage: dbspace [--warn PCT] [--crit PCT] [--alerts] [--no-fra] [--no-temp] [--db REGEX]
               [--grep PATTERN] [--grep-v PATTERN] [--csv|--json|--raw] [--no-header] [--no-color]

Space usage for every running database, every OPEN container (CDB root + PDBs).

Rows:
  PERMANENT  used = allocated - free
  UNDO       used = ACTIVE + UNEXPIRED undo extents (EXPIRED space is reusable)
  TEMPORARY  used = segments in use right now (v$tempseg_usage)
  FRA        used = space_used - space_reclaimable (v$recovery_file_dest)

BIGFILE is YES for bigfile tablespaces (one datafile up to 32 TB with 8K blocks) and NO
for regular (smallfile) tablespaces; '-' for the FRA row.

PCT_USED is relative to MAX_GB: the autoextend maximum (or the allocated size
for files without autoextend). This is the real "how full can it get" number.

Options:
  --warn PCT     WARN threshold (default: 85)
  --crit PCT     CRIT threshold (default: 95)
  --alerts       Only show rows that are WARN or CRIT
  --no-fra       Skip the FRA row
  --no-temp      Skip TEMPORARY tablespaces
  --db REGEX     Only query SIDs matching REGEX (case-insensitive)
  --grep / --grep-v, --csv|--json|--raw, --no-header, --no-color

Notes:
  - MOUNTED standbys only report the FRA (dictionary views need an OPEN database).
  - Only OPEN PDBs are reported (CDB_* views).

Return code: 0 = all OK/WARN, 1 = error, 2 = at least one CRIT

Examples:
  dbspace
  dbspace --alerts
  dbspace --db PRD --grep -v TEMPORARY
  dbspace --warn 80 --crit 90 --csv
  dbspace --grep '[|]YES[|]'            (bigfile tablespaces only)
EOF
                return 0
                ;;
            *) _dba_err "Unknown option: $1 (see dbspace --help)"; return 1 ;;
        esac
        shift
    done
    _dba_check_modes || return 1
    [[ "$warn" =~ ^[0-9]+$ && "$crit" =~ ^[0-9]+$ ]] || { _dba_err "--warn/--crit must be whole numbers"; return 1; }

    local data="SID|CONTAINER|TABLESPACE|TYPE|BIGFILE|USED_GB|ALLOC_GB|MAX_GB|PCT_USED|STATUS"
    local sid home out line om err any=0 overall=0
    local c_con c_ts c_type c_big c_used c_alloc c_max c_pct st
    while IFS='|' read -r sid home; do
        [[ -z "$sid" ]] && continue
        any=1
        out="$(_dba_q "$sid" "$home" <<'SQL'
select 'OM|' || open_mode from v$database;
select 'FRA|' || name || '|' ||
       to_char((space_used - space_reclaimable) / 1073741824, 'FM9999990.00') || '|' ||
       to_char(space_limit / 1073741824, 'FM9999990.00') || '|' ||
       to_char(100 * (space_used - space_reclaimable) / space_limit, 'FM990.0')
  from v$recovery_file_dest where space_limit > 0;
with df as (select con_id, tablespace_name, sum(bytes) alloc,
                   sum(greatest(decode(autoextensible, 'YES', maxbytes, bytes), bytes)) maxb
              from cdb_data_files group by con_id, tablespace_name),
     fs as (select con_id, tablespace_name, sum(bytes) free from cdb_free_space group by con_id, tablespace_name),
     ux as (select con_id, tablespace_name, sum(bytes) ub from cdb_undo_extents
             where status in ('ACTIVE', 'UNEXPIRED') group by con_id, tablespace_name),
     u  as (select t.con_id, t.tablespace_name, t.contents, t.bigfile, df.alloc, df.maxb,
                   decode(t.contents, 'UNDO', nvl(ux.ub, 0), df.alloc - nvl(fs.free, 0)) used
              from cdb_tablespaces t
              join df on df.con_id = t.con_id and df.tablespace_name = t.tablespace_name
              left join fs on fs.con_id = t.con_id and fs.tablespace_name = t.tablespace_name
              left join ux on ux.con_id = t.con_id and ux.tablespace_name = t.tablespace_name
             where t.contents <> 'TEMPORARY')
select 'ROW|' || nvl((select c.name from v$containers c where c.con_id = u.con_id), '-') || '|' ||
       u.tablespace_name || '|' || u.contents || '|' || u.bigfile || '|' ||
       to_char(u.used / 1073741824, 'FM9999990.00') || '|' || to_char(u.alloc / 1073741824, 'FM9999990.00') || '|' ||
       to_char(u.maxb / 1073741824, 'FM9999990.00') || '|' || to_char(100 * u.used / nullif(u.maxb, 0), 'FM990.0')
  from u;
with tf as (select con_id, tablespace_name, sum(bytes) alloc,
                   sum(greatest(decode(autoextensible, 'YES', maxbytes, bytes), bytes)) maxb
              from cdb_temp_files group by con_id, tablespace_name),
     tu as (select con_id, tablespace, sum(blocks) blks from v$tempseg_usage group by con_id, tablespace),
     u  as (select t.con_id, t.tablespace_name, t.bigfile, tf.alloc, tf.maxb, nvl(tu.blks, 0) * t.block_size used
              from cdb_tablespaces t
              join tf on tf.con_id = t.con_id and tf.tablespace_name = t.tablespace_name
              left join tu on tu.con_id = t.con_id and tu.tablespace = t.tablespace_name
             where t.contents = 'TEMPORARY')
select 'TMP|' || nvl((select c.name from v$containers c where c.con_id = u.con_id), '-') || '|' ||
       u.tablespace_name || '|TEMPORARY|' || u.bigfile || '|' ||
       to_char(u.used / 1073741824, 'FM9999990.00') || '|' || to_char(u.alloc / 1073741824, 'FM9999990.00') || '|' ||
       to_char(u.maxb / 1073741824, 'FM9999990.00') || '|' || to_char(100 * u.used / nullif(u.maxb, 0), 'FM990.0')
  from u;
SQL
)"
        om="$(_dba_tag "$out" OM | head -1)"
        if [[ -z "$om" ]]; then
            err="$(_dba_qerr "$out")"
            data+=$'\n'"$sid|-|-|-|-|-|-|-|-|ERROR: $(_dba_clean "${err:-no output}")"
            overall=1
            continue
        fi
        while IFS='|' read -r c_con c_ts c_type c_big c_used c_alloc c_max c_pct; do
            [[ -z "$c_ts" ]] && continue
            [[ "$c_type" == "TEMPORARY" && $show_temp -eq 0 ]] && continue
            st="$(_dba_level "$c_pct" "$warn" "$crit")"
            data+=$'\n'"$sid|$c_con|$c_ts|$c_type|$c_big|$c_used|$c_alloc|$c_max|$c_pct|$st"
        done < <(_dba_tag "$out" ROW; _dba_tag "$out" TMP)
        if [[ "$om" != READ* ]]; then
            data+=$'\n'"$sid|-|(dictionary)|-|-|-|-|-|-|SKIPPED ($om)"
        fi
        if (( show_fra )); then
            while IFS='|' read -r c_ts c_used c_max c_pct; do
                [[ -z "$c_ts" ]] && continue
                st="$(_dba_level "$c_pct" "$warn" "$crit")"
                data+=$'\n'"$sid|-|FRA:$c_ts|FRA|-|$c_used|$c_max|$c_max|$c_pct|$st"
            done < <(_dba_tag "$out" FRA)
        fi
    done < <(_dba_up_targets "$dbre")
    (( any )) || { _dba_err "No running databases found${dbre:+ matching '$dbre'}."; return 1; }

    data="$(_dba_sort_body "$data" -k1,1 -k2,2 -k9,9nr)"
    if (( alerts_only )); then
        data="$(awk -F'|' 'NR == 1 || $10 ~ /^(WARN|CRIT|ERROR)/' <<< "$data")"
    fi
    grep -q '|CRIT$' <<< "$data" && (( overall == 0 )) && overall=2
    _dba_emit "$data"
    return "$overall"
}
# DESC: ASM diskgroup usage including usable space after mirroring (and optional disk list)
function lsasm() {
    local warn=80 crit=90 disks=0
    local _o_mode="table" _o_nohdr=0 _o_grep="" _o_grepv="" _o_modes=0 _o_nocolor=0 _o_shift=1 rc
    while [[ $# -gt 0 ]]; do
        _dba_common_opt "$@"; rc=$?
        if (( rc == 0 )); then shift "$_o_shift"; continue; elif (( rc == 2 )); then return 1; fi
        case "$1" in
            --warn)  _dba_need_val "$1" "${2-}" || return 1; warn="$2"; shift ;;
            --crit)  _dba_need_val "$1" "${2-}" || return 1; crit="$2"; shift ;;
            --disks) disks=1 ;;
            -h|--help)
                cat <<'EOF'
Usage: lsasm [--disks] [--warn PCT] [--crit PCT] [--grep PATTERN] [--grep-v PATTERN]
             [--csv|--json|--raw] [--no-header] [--no-color]

ASM diskgroup usage from the local ASM instance (v$asm_diskgroup).

Columns:
  TOTAL_GB / FREE_GB        Raw capacity (all mirror copies counted)
  USABLE_TOTAL_GB           (TOTAL - REQUIRED_MIRROR_FREE) / redundancy factor
  USABLE_FREE_GB            USABLE_FILE_MB: space you can really use for new files
                            while still being able to restore redundancy after a disk failure
  PCT_USED                  1 - USABLE_FREE / USABLE_TOTAL
  OFFLINE                   Number of offline disks
  STATUS                    OK / WARN / CRIT by PCT_USED; CRIT if USABLE_FREE < 0;
                            WARN if any disk is offline or the group is not MOUNTED

  Redundancy factor: EXTERN = 1, NORMAL/FLEX/EXTEND = 2, HIGH = 3

Options:
  --disks          List ASM disks instead (path, state, mode, header status, size)
  --warn PCT       WARN threshold (default: 80)
  --crit PCT       CRIT threshold (default: 90)
  --grep / --grep-v, --csv|--json|--raw, --no-header, --no-color

Notes:
  - Connects to the local ASM instance (+ASM / +ASM1 ...) from the Grid home as SYSASM,
    falling back to SYSDBA. The OS user must be in the ASM admin/dba group.

Return code: 0 = all OK/WARN, 1 = error, 2 = at least one CRIT

Examples:
  lsasm
  lsasm --disks
  lsasm --grep DATA --csv
EOF
                return 0
                ;;
            *) _dba_err "Unknown option: $1 (see lsasm --help)"; return 1 ;;
        esac
        shift
    done
    _dba_check_modes || return 1
    [[ "$warn" =~ ^[0-9]+$ && "$crit" =~ ^[0-9]+$ ]] || { _dba_err "--warn/--crit must be whole numbers"; return 1; }

    local grid asm_sid out
    grid="$(_dba_grid_home)" || { _dba_err "Grid Infrastructure home not found (/etc/oracle/olr.loc or +ASM in oratab)."; return 1; }
    asm_sid="$(ps -eo args= | awk '$1 ~ /^asm_pmon_\+ASM/ { sub(/^asm_pmon_/, "", $1); print $1; exit }')"
    [[ -z "$asm_sid" ]] && { _dba_err "No running ASM instance found (asm_pmon_+ASM*)."; return 1; }

    local sql
    if (( disks )); then
        sql="select 'ROW|' || nvl(g.name, '-') || '|' || d.name || '|' || d.path || '|' || d.state || '|' ||
       d.mode_status || '|' || d.header_status || '|' || nvl(d.failgroup, '-') || '|' ||
       to_char(d.total_mb / 1024, 'FM9999990.00') || '|' || to_char(d.free_mb / 1024, 'FM9999990.00')
  from v\$asm_disk d left join v\$asm_diskgroup g on g.group_number = d.group_number
 order by g.name, d.path;"
    else
        sql="select 'ROW|' || name || '|' || state || '|' || type || '|' || total_mb || '|' || free_mb || '|' ||
       required_mirror_free_mb || '|' || usable_file_mb || '|' || offline_disks
  from v\$asm_diskgroup order by name;"
    fi
    out="$(printf '%s\n' "set heading off feedback off pagesize 0 linesize 32767 trimspool on verify off echo off" \
                         "$sql" "exit" | _dba_env_run "$asm_sid" "$grid" "$grid/bin/sqlplus" -s -L / as sysasm 2>&1)"
    if ! grep -q '^ROW|' <<< "$out"; then
        out="$(printf '%s\n' "set heading off feedback off pagesize 0 linesize 32767 trimspool on verify off echo off" \
                             "$sql" "exit" | _dba_env_run "$asm_sid" "$grid" "$grid/bin/sqlplus" -s -L / as sysdba 2>&1)"
    fi
    if ! grep -q '^ROW|' <<< "$out"; then
        _dba_err "Could not query $asm_sid: $(_dba_qerr "$out")"
        return 1
    fi

    if (( disks )); then
        _dba_emit "DISKGROUP|DISK|PATH|STATE|MODE|HEADER|FAILGROUP|TOTAL_GB|FREE_GB"$'\n'"$(_dba_tag "$out" ROW)"
        return 0
    fi

    local data
    data="$(_dba_tag "$out" ROW | awk -F'|' -v OFS='|' -v w="$warn" -v c="$crit" '
        BEGIN { print "DISKGROUP|STATE|TYPE|TOTAL_GB|FREE_GB|USABLE_TOTAL_GB|USABLE_FREE_GB|PCT_USED|OFFLINE|STATUS" }
        {
            f = 2
            if ($3 == "EXTERN") f = 1; else if ($3 == "HIGH") f = 3
            ut = ($4 - $6) / f
            uf = $7
            pct = (ut > 0) ? 100 * (1 - uf / ut) : 0
            if (pct < 0) pct = 0
            st = "OK"
            if (pct >= c || uf < 0) st = "CRIT"; else if (pct >= w) st = "WARN"
            if (st == "OK" && ($8 > 0 || $2 != "MOUNTED")) st = "WARN"
            print $1, $2, $3, sprintf("%.2f", $4 / 1024), sprintf("%.2f", $5 / 1024),
                  sprintf("%.2f", ut / 1024), sprintf("%.2f", uf / 1024), sprintf("%.1f", pct), $8, st
        }')"
    _dba_emit "$data"
    grep -q '|CRIT$' <<< "$data" && return 2
    return 0
}

# _dbbkp_rows <SID> <HOME> <db_hours> <arch_hours> : backup status row(s) for one DB (internal)
_dbbkp_rows() {
    local sid="$1" home="$2" dbh="$3" arh="$4" out row err
    out="$(_dba_q "$sid" "$home" <<'SQL'
select 'ROW|' || d.log_mode || '|' || d.database_role || '|' ||
  (select to_char(max(completion_time), 'YYYY-MM-DD HH24:MI') from v$backup_set
    where backup_type = 'D' or (backup_type = 'I' and incremental_level = 0)) || '|' ||
  (select to_char(max(completion_time), 'YYYY-MM-DD HH24:MI') from v$backup_set
    where backup_type = 'I' and incremental_level > 0) || '|' ||
  (select to_char(max(completion_time), 'YYYY-MM-DD HH24:MI') from v$backup_set where backup_type = 'L') || '|' ||
  (select max(status) keep (dense_rank last order by start_time) from v$rman_backup_job_details) || '|' ||
  (select count(*) from v$rman_backup_job_details
    where start_time > sysdate - 1 and (status like '%FAIL%' or status like '%ERRORS%'))
  from v$database d;
SQL
)"
    row="$(_dba_tag "$out" ROW | head -1)"
    if [[ -z "$row" ]]; then
        err="$(_dba_qerr "$out")"
        printf '%s|-|-|-|-|-|-|-|-|-|ERROR: %s\n' "$sid" "$(_dba_clean "${err:-no output}")"
        return 1
    fi
    local lmode role full incr arch last_job failed24 full_age incr_age arch_age db_age st note=""
    IFS='|' read -r lmode role full incr arch last_job failed24 <<< "$row"
    full_age="$(_dba_age_h "$full")"
    incr_age="$(_dba_age_h "$incr")"
    arch_age="$(_dba_age_h "$arch")"
    db_age="$(awk -v a="${full_age:-}" -v b="${incr_age:-}" 'BEGIN {
        if (a == "" && b == "") { print ""; exit }
        if (a == "") print b; else if (b == "") print a; else print (a + 0 < b + 0 ? a : b) }')"
    st="OK"
    if [[ -z "$db_age" ]]; then
        st="CRIT"; note="no DB backup found"
    elif awk -v a="$db_age" -v l="$dbh" 'BEGIN { exit !(a + 0 > l + 0) }'; then
        st="CRIT"; note="DB backup older than ${dbh}h"
    fi
    if [[ "$lmode" == "ARCHIVELOG" && "$st" == "OK" ]]; then
        if [[ -z "$arch_age" ]]; then
            st="WARN"; note="no archivelog backup found"
        elif awk -v a="$arch_age" -v l="$arh" 'BEGIN { exit !(a + 0 > l + 0) }'; then
            st="WARN"; note="archivelog backup older than ${arh}h"
        fi
    fi
    if [[ "$st" == "OK" && ( "$last_job" == *FAIL* || "$last_job" == *ERROR* || "${failed24:-0}" != "0" ) ]]; then
        st="WARN"; note="failed RMAN job(s) in the last 24h"
    fi
    printf '%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n' "$sid" "$role" "$lmode" "${full:--}" "${incr:--}" "${arch:--}" \
        "${db_age:--}" "${arch_age:--}" "${last_job:--}" "${failed24:-0}" "$st${note:+ ($note)}"
}

