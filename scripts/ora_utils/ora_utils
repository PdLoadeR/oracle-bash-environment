            -h|--help)
                cat <<'EOF'
Usage: dbincident [--days N] [--db REGEX] [--grep PATTERN] [--grep-v PATTERN]
                  [--csv|--json|--raw] [--no-header] [--no-color]
       dbincident --package INCIDENT_ID --db SID [--dir DIR] [--yes]

Lists the critical-error incidents recorded in the ADR of every database on the host
(adrci 'show incident'), e.g. ORA-00600, ORA-07445, ORA-04031.

Columns: DB, INCIDENT_ID, PROBLEM_KEY, CREATE_TIME, ADR_HOME

Packaging for an Oracle SR:
  --package ID   Create an IPS zip for incident ID (adrci 'ips pack incident ID in DIR').
                 Needs --db to select the database. Asks for confirmation (or --yes).
  --dir DIR      Target directory for the package (default: $ORACLE_BASE/ips_packages,
                 created when missing). Check the free space first - packages can be large.

Options:
  --days N       Only incidents created in the last N days (default: 7)
  --db REGEX     Only SIDs matching REGEX (case-insensitive)
  --grep / --grep-v, --csv|--json|--raw, --no-header, --no-color

Return code: 0 = no incidents, 2 = incidents found, 1 = error

Examples:
  dbincident
  dbincident --days 30 --grep 'ORA 600'
  dbincident --package 123456 --db PRD1
EOF
                return 0
                ;;
            *) _dba_err "Unknown option: $1 (see dbincident --help)"; return 1 ;;
        esac
        shift
    done
    _dba_check_modes || return 1
    [[ "$days" =~ ^[1-9][0-9]*$ ]] || { _dba_err "--days must be a positive number"; return 1; }
    if [[ -n "$pkg" ]]; then
        [[ "$pkg" =~ ^[0-9]+$ ]] || { _dba_err "--package needs a numeric incident ID"; return 1; }
        [[ -n "$dbre" ]] || { _dba_err "--package needs --db SID"; return 1; }
    fi

    local data="DB|INCIDENT_ID|PROBLEM_KEY|CREATE_TIME|ADR_HOME"
    local sid home state alert base adrhome out any=0 found=0 cutoff
    cutoff="$(date -d "-$days days" '+%Y-%m-%d %H:%M:%S')"
    local -a matched=()
    while IFS='|' read -r sid home state; do
        [[ -z "$sid" ]] && continue
        if [[ -n "$dbre" ]]; then
            [[ "$(_dba_filter_rows "H"$'\n'"$sid" "$dbre" "")" == *$'\n'* ]] || continue
        fi
        any=1
        [[ -x "$home/bin/adrci" ]] || { data+=$'\n'"$sid|-|ERROR: adrci not found in $home|-|-"; continue; }
        alert="$(_dba_alert_log "$sid" "$home")" || { data+=$'\n'"$sid|-|ERROR: ADR home not found|-|-"; continue; }
        adrhome="$(dirname "$(dirname "$alert")")"
        base="${adrhome%%/diag/*}"
        adrhome="diag/${adrhome#*/diag/}"
        matched+=("$sid|$home|$base|$adrhome")
        [[ -n "$pkg" ]] && continue
        out="$(_dba_env_run "$sid" "$home" "$home/bin/adrci" exec="set base $base; set homepath $adrhome; show incident -mode basic" 2>&1)"
        local rows
        rows="$(awk -v s="$sid" -v cut="$cutoff" -v ah="$adrhome" '
            $1 ~ /^[0-9]+$/ && NF >= 4 {
                t = $(NF-2) " " substr($(NF-1), 1, 8)
                if (t < cut) next
                k = ""; for (i = 2; i <= NF - 3; i++) k = k (k == "" ? "" : " ") $i
                gsub(/\|/, "/", k)
                print s "|" $1 "|" k "|" t "|" ah
            }' <<< "$out")"
        if [[ -n "$rows" ]]; then data+=$'\n'"$rows"; found=1; fi
        if grep -qE 'DIA-[0-9]+' <<< "$out" && ! grep -qE 'DIA-48(415|448|494)' <<< "$out"; then
            data+=$'\n'"$sid|-|ERROR: $(_dba_clean "$(grep -m1 -E 'DIA-[0-9]+' <<< "$out")")|-|$adrhome"
        fi
    done < <(_dba_db_targets | sort -t'|' -k1,1)
    (( any )) || { _dba_err "No databases found${dbre:+ matching '$dbre'}."; return 1; }

    if [[ -n "$pkg" ]]; then
        (( ${#matched[@]} == 1 )) || { _dba_err "--db must match exactly one database (matched ${#matched[@]})."; return 1; }
        local b ah
        IFS='|' read -r sid home b ah <<< "${matched[0]}"
        pkgdir="${pkgdir:-$b/ips_packages}"
        mkdir -p "$pkgdir" 2>/dev/null || { _dba_err "Cannot create $pkgdir"; return 1; }
        echo "Database : $sid"
        echo "ADR home : $b/$ah"
        echo "Incident : $pkg"
        echo "Target   : $pkgdir  ($(df -Ph "$pkgdir" | awk 'NR == 2 { print $4 }') free)"
        if (( ! assume_yes )); then _dba_confirm "Create the IPS package?" || { echo "Aborted."; return 1; }; fi
        out="$(_dba_env_run "$sid" "$home" "$home/bin/adrci" exec="set base $b; set homepath $ah; ips pack incident $pkg in $pkgdir" 2>&1)"
        printf '%s\n' "$out"
        grep -qiE 'generated package|created' <<< "$out" && return 0
        return 1
    fi

    if (( ! found )) && [[ "$data" != *ERROR* ]]; then
        echo "No incidents in the last $days day(s)."
        return 0
    fi
    _dba_emit "$data"
    (( found )) && return 2
    return 1
}

